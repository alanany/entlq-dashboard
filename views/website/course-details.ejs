<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= course.title || 'تفاصيل الكورس' %> - <%= t('brand_name') %></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        /* Back Button */
        .back-button-wrapper {
            position: fixed;
            top: 1.5rem;
            right: 1.5rem;
            z-index: 1000;
        }

        .btn-back {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #fff;
            border: 2px solid #f1f1f1;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
            transition: all 0.3s;
            color: var(--dark);
            font-size: 1.2rem;
        }

        .btn-back:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
            transform: translateY(-2px);
            box-shadow: 0 0.75rem 1.5rem rgba(254, 93, 55, 0.2);
        }

        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, var(--primary) 0%, #ff6b45 100%);
            padding: 3rem 0;
            color: #fff;
        }

        .hero-title {
            font-size: 2rem;
            font-weight: 900;
            line-height: 1.3;
            margin-bottom: 1rem;
        }

        .hero-description {
            font-size: 1.1rem;
            line-height: 1.6;
            opacity: 0.95;
            margin-bottom: 1.5rem;
        }

        .badge-category {
            background: rgba(255, 255, 255, 0.25);
            padding: 0.5rem 1.25rem;
            border-radius: 2rem;
            font-size: 0.85rem;
            font-weight: 700;
            display: inline-block;
            margin-bottom: 1rem;
        }

        /* Course Image */
        .course-image-wrapper {
            position: relative;
            border-radius: 1.5rem;
            overflow: hidden;
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.1);
            background: #fff;
            margin-bottom: 2rem;
        }

        .course-image-wrapper img {
            width: 100%;
            height: 450px;
            object-fit: cover;
            display: block;
        }

        .placeholder-image {
            width: 100%;
            height: 450px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            color: #fff;
        }

        .placeholder-image i {
            font-size: 4rem;
            opacity: 0.4;
            margin-bottom: 1.5rem;
        }

        .placeholder-image .course-title {
            font-size: 1.8rem;
            font-weight: 800;
            text-align: center;
            padding: 0 2rem;
            opacity: 0.9;
        }

        /* Content Cards */
        .content-card {
            background: #fff;
            border-radius: 1.5rem;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 0.25rem 1rem rgba(0,0,0,0.04);
            border: 1px solid #f1f1f1;
        }

        .content-card h3 {
            font-size: 1.5rem;
            font-weight: 900;
            margin-bottom: 1.5rem;
            color: var(--dark);
        }

        .content-card p {
            font-size: 1.05rem;
            line-height: 1.8;
            color: #6c757d;
        }

        /* Curriculum */
        .curriculum-item {
            background: #f8fafc;
            border-radius: 1rem;
            margin-bottom: 1rem;
            border: 1px solid #eef0f2;
            overflow: hidden;
        }

        .curriculum-header {
            background: var(--secondary);
            padding: 1.25rem 1.5rem;
            cursor: pointer;
            transition: all 0.3s;
        }

        .curriculum-header:hover {
            background: #ffd9cc;
        }

        .curriculum-header h5 {
            font-size: 1.1rem;
            font-weight: 800;
            margin: 0;
            color: var(--dark);
        }

        .curriculum-header .section-number {
            color: var(--primary);
            margin-left: 0.75rem;
            font-weight: 900;
        }

        .lesson-list {
            padding: 1rem 1.5rem;
        }

        .lesson-item {
            background: #fff;
            padding: 1rem 1.25rem;
            border-radius: 0.75rem;
            margin-bottom: 0.75rem;
            border: 1px solid #f1f1f1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.2s;
        }

        .lesson-item:hover {
            border-color: var(--primary);
            box-shadow: 0 0.25rem 0.5rem rgba(254, 93, 55, 0.1);
        }

        .lesson-item span {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--dark);
        }

        .lesson-badge {
            font-size: 0.75rem;
            padding: 0.35rem 0.85rem;
        }

        /* Pricing Sidebar */
        .pricing-sidebar {
            position: sticky;
            top: 2rem;
        }

        .pricing-box {
            background: #fff;
            border-radius: 1.5rem;
            padding: 2rem;
            box-shadow: 0 0.5rem 2rem rgba(0,0,0,0.08);
            border: 2px solid var(--primary);
        }

        .pricing-box h4 {
            font-size: 1.3rem;
            font-weight: 900;
            margin-bottom: 1.5rem;
            text-align: center;
            color: var(--dark);
        }

        .price-option {
            background: linear-gradient(135deg, #fff 0%, #f8fafc 100%);
            border: 2px solid #eef0f2;
            border-radius: 1.25rem;
            padding: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.3s;
        }

        .price-option:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.75rem 1.5rem rgba(254, 93, 55, 0.12);
            border-color: var(--primary);
        }

        .price-duration {
            font-size: 1.1rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 0.25rem;
        }

        .price-label {
            font-size: 0.85rem;
            color: #6c757d;
        }

        .price-amount {
            font-size: 2rem;
            font-weight: 900;
            color: #22c55e;
        }

        .price-currency {
            font-size: 0.9rem;
            color: #6c757d;
            font-weight: 600;
        }

        .pricing-note {
            text-align: center;
            padding-top: 1rem;
            border-top: 1px solid #f1f1f1;
            margin-top: 1rem;
        }

        .pricing-note small {
            font-size: 0.85rem;
            color: #6c757d;
        }

        /* Buttons */
        .btn-book {
            font-size: 1.1rem;
            padding: 0.85rem 2.5rem;
            font-weight: 800;
            border-radius: 3rem;
            box-shadow: 0 0.5rem 1.5rem rgba(255, 255, 255, 0.3);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            background: #f8fafc;
            border-radius: 1.5rem;
        }

        .empty-state i {
            font-size: 3.5rem;
            opacity: 0.2;
            margin-bottom: 1rem;
            color: var(--dark);
        }

        .empty-state p {
            font-size: 1rem;
            color: #6c757d;
        }

        /* Footer */
        footer {
            background: var(--dark);
            color: #fff;
            padding: 2rem 0;
            margin-top: 4rem;
        }

        footer p {
            font-size: 0.9rem;
            margin: 0;
        }

        /* Related Courses Section */
        .related-courses-section {
            background: #fff;
            padding: 3rem 0;
            margin-top: 3rem;
            border-top: 1px solid #f1f1f1;
        }

        .related-courses-section h3 {
            font-size: 1.75rem;
            font-weight: 900;
            margin-bottom: 2rem;
            color: var(--dark);
        }

        .courses-scroll-container {
            display: flex;
            gap: 1.5rem;
            overflow-x: auto;
            padding-bottom: 1rem;
            scroll-behavior: smooth;
            -webkit-overflow-scrolling: touch;
        }

        .courses-scroll-container::-webkit-scrollbar {
            height: 8px;
        }

        .courses-scroll-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .courses-scroll-container::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 10px;
        }

        .course-card-mini {
            min-width: 320px;
            max-width: 320px;
            background: #fff;
            border-radius: 1.25rem;
            overflow: hidden;
            border: 1px solid #f1f1f1;
            transition: all 0.3s;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.05);
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .course-card-mini:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.75rem 2rem rgba(0,0,0,0.1);
            border-color: var(--primary);
        }

        .course-card-mini-image {
            width: 100%;
            height: 180px;
            object-fit: cover;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .course-card-mini-placeholder {
            width: 100%;
            height: 180px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
        }

        .course-card-mini-placeholder i {
            font-size: 3rem;
            opacity: 0.4;
        }

        .course-card-mini-body {
            padding: 1.25rem;
        }

        .course-card-mini-category {
            font-size: 0.75rem;
            color: var(--primary);
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            display: block;
        }

        .course-card-mini-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 0.75rem;
            line-height: 1.4;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .course-card-mini-price {
            font-size: 1.25rem;
            font-weight: 900;
            color: #22c55e;
            margin-top: 0.75rem;
        }

        .course-card-mini-price small {
            font-size: 0.75rem;
            color: #6c757d;
            font-weight: 600;
        }

        .scroll-hint {
            text-align: center;
            margin-top: 1rem;
            color: #6c757d;
            font-size: 0.85rem;
        }

        .scroll-hint i {
            animation: slideRight 1.5s infinite;
        }

        @keyframes slideRight {
            0%, 100% { transform: translateX(0); }
            50% { transform: translateX(10px); }
        }

        /* Responsive */
        @media (max-width: 991.98px) {
            .hero-title {
                font-size: 1.75rem;
            }

            .hero-description {
                font-size: 1rem;
            }

            .course-image-wrapper img,
            .placeholder-image {
                height: 300px;
            }

            .pricing-sidebar {
                position: relative;
                top: 0;
                margin-top: 2rem;
            }
        }
    </style>
</head>
<body>
    <%
        const levelMap = { 'beginner': 'مبتدئ', 'intermediate': 'متوسط', 'advanced': 'متقدم' };
        const hasImage = course.coverImage && course.coverImage.trim() !== '';
    %>

    <!-- Back Button -->
    <div class="back-button-wrapper">
        <button onclick="history.back()" class="btn-back" title="رجوع">
            <i class="fas fa-arrow-right"></i>
        </button>
    </div>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-9">
                    <div class="badge-category animate__animated animate__fadeInDown">
                        <i class="fas fa-layer-group me-2"></i>
                        <%= course.category?.name || 'تخصص عام' %> • <%= levelMap[course.level] || 'غير محدد' %>
                    </div>
                    <h2 class="hero-title animate__animated animate__fadeInUp text-white">
                        <%= course.title || 'عنوان الكورس غير متوفر' %>
                    </h2>
                    <p class="hero-description animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                        <%= course.description || 'وصف مختصر للكورس يوضح قيمته المضافة للطالب.' %>
                    </p>
                    
                    <% if (user == null) { %>
                        <a href="/student/login" class="btn btn-light btn-book animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                            <i class="fas fa-calendar-check me-2"></i>
                            ابدأ التعلم الآن
                        </a>
                    <% } else { %>
                        <a href="/student/book_plan/<%= course._id %>" class="btn btn-light btn-book animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                            <i class="fas fa-calendar-check me-2"></i>
                            ابدأ التعلم الآن
                        </a>
                    <% } %>
                </div>
            </div>

         
        </div>
    </section>

    <!-- Main Content -->
    <section class="py-5">
        <div class="container">
            <div class="row g-4">
                <!-- Left Column -->
                <div class="col-lg-8">
                    <!-- Course Image -->
                    <div class="course-image-wrapper animate__animated animate__fadeInUp">
                        <img src="<%= getImageUrl(course.coverImage) %>" alt="<%= course.title %>" onerror="this.parentElement.innerHTML='<div class=\'placeholder-image\'><i class=\'fas fa-book-open\'></i><div class=\'course-title\'><%= course.title %></div></div>'">
                    </div>

                    <!-- About Course -->
                    <div class="content-card animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                        <h4>
                            <i class="fas fa-info-circle text-primary me-1.2"></i>
                            نبذة عن الكورس
                        </h4>
                        <p>
                            <%= course.description || 'لا يوجد وصف تفصيلي لهذا الكورس حالياً.' %>
                        </p>
                    </div>

                    <!-- Curriculum -->
                    <div class="content-card animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                        <h5>
                            <i class="fas fa-list-ul text-primary me-1.0"></i>
                            محتوى المنهج الدراسي
                        </h5>

                        <% if (course.curriculum && course.curriculum.length > 0) { %>
                            <div class="accordion" id="curriculumAccordion">
                                <% course.curriculum.forEach((section, sectionIndex) => { %>
                                    <div class="curriculum-item">
                                        <div class="curriculum-header" data-bs-toggle="collapse" data-bs-target="#section<%= sectionIndex %>">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <h5>
                                                    <span class="section-number"><%= sectionIndex + 1 %>.</span>
                                                    <%= section.title %>
                                                </h5>
                                                <span class="badge bg-primary rounded-pill">
                                                    <%= section.lessons.length %> دروس
                                                </span>
                                            </div>
                                        </div>
                                        <div id="section<%= sectionIndex %>" class="collapse <%= sectionIndex === 0 ? 'show' : '' %>" data-bs-parent="#curriculumAccordion">
                                            <div class="lesson-list">
                                                <% section.lessons.forEach((lesson) => { %>
                                                    <div class="lesson-item">
                                                        <div class="d-flex align-items-center">
                                                            <i class="fas fa-play-circle text-primary me-2"></i>
                                                            <span><%= lesson.title %></span>
                                                        </div>
                                                        <span class="badge bg-light text-primary lesson-badge">محتوى خاص</span>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <i class="fas fa-clipboard-list"></i>
                                <p>جاري إعداد المنهج التفصيلي لهذا الكورس</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Right Column - Pricing -->
                <div class="col-lg-4">
                    <div class="pricing-sidebar animate__animated animate__fadeInUp" style="animation-delay: 0.3s;">
                        <div class="pricing-box">
                            <h4>
                                <i class="fas fa-tags text-primary me-2"></i>
                                خطط الاشتراك
                            </h4>

                            <% if (course.pricingOptions && course.pricingOptions.length > 0) { %>
                                <% course.pricingOptions.sort((a, b) => a.duration - b.duration).forEach((option) => { %>
                                    <div class="price-option">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <div class="price-duration">
                                                    <i class="fas fa-clock text-primary me-1"></i>
                                                    <%= option.duration %> دقيقة
                                                </div>
                                                <div class="price-label">مدة الحصة الواحدة</div>
                                            </div>
                                            <div class="text-end">
                                                <div class="price-amount outfit-font"><%= option.price %></div>
                                                <div class="price-currency">ريال سعودي</div>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="alert alert-warning rounded-4 text-center mb-0">
                                    <i class="fas fa-exclamation-triangle me-2"></i>
                                    <small class="d-block mt-1">التسعير غير محدد حالياً</small>
                                </div>
                            <% } %>

                            <div class="pricing-note">
                                <small>
                                    <i class="fas fa-check-circle text-success me-1"></i>
                                    جدولة مرنة • اختيار المعلم • دعم مباشر
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
           <!-- Related Courses - Horizontal Scroll -->
            <% if (typeof relatedCourses !== 'undefined' && relatedCourses && relatedCourses.length > 0) { %>
                <div class="row mt-5">
                    <div class="col-12">
                        <h5 class="text-white mb-4">
                            <i class="fas fa-book-reader me-2"></i>
                            كورسات ذات صلة
                        </h5>
                        <div class="courses-scroll-container">
                            <% relatedCourses.forEach((relatedCourse) => { %>
                                <a href="/website-course/<%= relatedCourse._id %>" class="course-card-mini">
                                    <img src="<%= getImageUrl(relatedCourse.coverImage) %>" alt="<%= relatedCourse.title %>" class="course-card-mini-image" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <div class="course-card-mini-placeholder" style="display: none;">
                                        <i class="fas fa-book-open"></i>
                                    </div>
                                    
                                    <div class="course-card-mini-body">
                                        <span class="course-card-mini-category">
                                            <i class="fas fa-tag me-1"></i>
                                            <%= relatedCourse.category?.name || 'عام' %>
                                        </span>
                                        <h5 class="course-card-mini-title">
                                            <%= relatedCourse.title %>
                                        </h5>
                                        <% if (relatedCourse.pricingOptions && relatedCourse.pricingOptions.length > 0) { %>
                                            <div class="course-card-mini-price outfit-font">
                                                <%= Math.min(...relatedCourse.pricingOptions.map(p => p.price)) %>
                                                <small>ريال</small>
                                            </div>
                                        <% } %>
                                    </div>
                                </a>
                            <% }) %>
                        </div>
                        <div class="scroll-hint text-white">
                            <i class="fas fa-arrow-left me-1"></i>
                            اسحب لمشاهدة المزيد
                        </div>
                    </div>
                </div>
            <% } %>
    </section>

    <!-- Footer -->
    <footer>
        <div class="container text-center">
            <p>&copy; <%= new Date().getFullYear() %> <%= t('brand_name') %> • منصة تعليمية متميزة</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>