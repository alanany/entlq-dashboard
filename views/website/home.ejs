<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= dir %>">

<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - Online learning academy</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@600&family=Lobster+Two:wght@700&family=Cairo:wght@400;600;700;900&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="lib/animate/animate.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="css/style.css" rel="stylesheet">
</head>

<body>
    <div class="container-fluid bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->


        <!-- Navbar Start -->
        <nav class="navbar navbar-expand-lg bg-white navbar-light sticky-top px-4 px-lg-5 py-lg-0">
            <a href="/" class="navbar-brand">
                <h3 class="m-0 text-primary"><i class="fa fa-laptop-code me-3"></i><%= t('brand_name') %></h3>
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav mx-auto">
                    <a href="/" class="nav-item nav-link active"><%= t('home') %></a>
                    <a href="/about" class="nav-item nav-link"><%= t('about') %></a>
                    <a href="/website-courses" class="nav-item nav-link"><%= t('classes') %></a>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown"><%= t('pages') %></a>
                        <div class="dropdown-menu rounded-0 rounded-bottom border-0 shadow-sm m-0">
                            <a href="facility.html" class="dropdown-item">School Facilities</a>
                            <a href="team.html" class="dropdown-item">Popular Teachers</a>
                            <a href="call-to-action.html" class="dropdown-item">Become A Teachers</a>
                            <a href="appointment.html" class="dropdown-item">Make Appointment</a>
                            <a href="testimonial.html" class="dropdown-item">Testimonial</a>
                            <a href="404.html" class="dropdown-item">404 Error</a>
                        </div>
                    </div>
                    <a href="contact.html" class="nav-item nav-link"><%= t('contact') %></a>
                </div>
                
                <div class="d-flex align-items-center">
                    <a href="/lang/<%= currentLang === 'ar' ? 'en' : 'ar' %>" class="btn btn-sm btn-light border rounded-pill px-3 py-2 me-3 outfit-font fw-bold shadow-sm d-flex align-items-center gap-2" style="font-size: 0.75rem; color: var(--primary);">
                        <i class="fa fa-globe"></i>
                        <span><%= t('switch_language') %></span>
                    </a>
                    
                    <div class="d-none d-lg-flex align-items-center gap-2">
                        <a href="/student/login" class="btn btn-primary rounded-pill px-4"><%= t('login') %></a>
                        <a href="/student/register" class="btn btn-outline-primary rounded-pill px-4"><%= t('register') %></a>
                    </div>
                </div>
            </div>
        </nav>
        <!-- Navbar End -->


        <!-- Carousel Start -->
        <div class="container-fluid p-0 mb-5 section-edit-wrapper">
            <div class="owl-carousel header-carousel position-relative">
                <div class="owl-carousel-item position-relative">
                    <img class="img-fluid" src="img/carousel-1.jpg" alt="">

                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center" >
                        <div class="container">
                            <div class="row justify-content-start">
                                <div class="col-10 col-lg-8">
                                    <% if (user && user.role === 'admin') { %>
                                    <!-- العنوان قابل للتعديل مباشرة -->
                                    <h3 
                                        class="display-2 text-white animated slideInDown mb-4 editable-inline" 
                                        data-section="hero" 
                                        data-field="title"
                                        contenteditable="false"
                                        onclick="enableInlineEdit(this)"

                                        onkeydown="handleInlineKeydown(event, this)">
                                        <%= (sections && sections.hero && sections.hero.title) || t('hero_1_title') %>
                                    </h3>
                                    <% } else { %>
                                    <h3 class="display-2 text-white animated slideInDown mb-4"><%= (sections && sections.hero && sections.hero.title) || t('hero_1_title') %></h3>
                                    <% } %>
                                    
                                    <% if (user && user.role === 'admin') { %>
                                    <!-- المحتوى قابل للتعديل مباشرة -->
                                    <p 
                                        class="fs-5 fw-medium text-white mb-4 pb-2 editable-inline" 
                                        data-section="hero" 
                                        data-field="content"
                                        contenteditable="false"
                                        onclick="enableInlineEdit(this)"

                                        onkeydown="handleInlineKeydown(event, this)">
                                        <%= (sections && sections.hero && sections.hero.content) || t('hero_1_text') %>
                                    </p>
                                    <% } else { %>
                                    <p class="fs-5 fw-medium text-white mb-4 pb-2"><%= (sections && sections.hero && sections.hero.content) || t('hero_1_text') %></p>
                                    <% } %>
                                   
                                    <% if (user && user.role === 'admin') { %>
                                    <!-- الزر قابل للتعديل -->
                                    <a href="<%= (sections && sections.hero && sections.hero.buttonLink) || '/about' %>" 
                                       class="btn btn-primary rounded-pill py-sm-3 px-sm-5 me-3 mb-2 animated slideInLeft editable-button"
                                       data-section="hero"
                                       onclick="editButton(event, this)">
                                        <span class="button-text"><%= (sections && sections.hero && sections.hero.buttonText) || t('learn_more') %></span>
                                    </a>
                                    <% } else { %>
                                    <a href="<%= (sections && sections.hero && sections.hero.buttonLink) || '/about' %>" class="btn btn-primary rounded-pill py-sm-3 px-sm-5 me-3 mb-2 animated slideInLeft"><%= (sections && sections.hero && sections.hero.buttonText) || t('learn_more') %></a>
                                    <% } %>
                                    
                                    <a href="/website-courses" class="btn btn-dark rounded-pill py-sm-3 px-sm-5 mb-2 animated slideInRight"><%= t('our_classes') %></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="owl-carousel-item position-relative">
                    <img class="img-fluid" src="img/carousel-2.jpg" alt="">
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center" style="background: rgba(0, 0, 0, .2);">
                        <div class="container">
                            <div class="row justify-content-start">
                                <div class="col-10 col-lg-8">
                                    <h3 class="display-2 text-white animated slideInDown mb-4"><%= t('hero_2_title') %></h3>
                                    <p class="fs-5 fw-medium text-white mb-4 pb-2"><%= t('hero_2_text') %></p>
                                    <a href="/about" class="btn btn-primary rounded-pill py-sm-3 px-sm-5 me-3 animated slideInLeft"><%= t('learn_more') %></a>
                                    <a href="/website-courses" class="btn btn-dark rounded-pill py-sm-3 px-sm-5 animated slideInRight"><%= t('our_classes') %></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Carousel End -->


        <!-- Facilities Start -->
        <div class="container-fluid py-5 section-edit-wrapper">
            <% if (user && user.role === 'admin') { %>
            <button class="section-edit-btn" onclick="openEditModal('facilities', 'المميزات')" title="تعديل قسم المميزات">
                <i class="fas fa-edit"></i>
            </button>
            <div class="edit-indicator"></div>
            <% } %>
            <div class="container">
                <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 600px;">
                    <% if (user && user.role === 'admin') { %>
                    <h3 class="mb-3 editable-inline"
                        data-section="facilities"
                        data-field="title"
                        contenteditable="false"
                        onclick="enableInlineEdit(this)"
                        onblur="saveInlineEdit(this)"
                        onkeydown="handleInlineKeydown(event, this)">
                        <%= (sections && sections.facilities && sections.facilities.title) || t('facilities_title') %>
                    </h3>
                    <p class="editable-inline"
                        data-section="facilities"
                        data-field="content"
                        contenteditable="false"
                        onclick="enableInlineEdit(this)"
                        onblur="saveInlineEdit(this)"
                        onkeydown="handleInlineKeydown(event, this)">
                        <%= (sections && sections.facilities && sections.facilities.content) || t('facilities_text') %>
                    </p>
                    <% } else { %>
                    <h3 class="mb-3"><%= (sections && sections.facilities && sections.facilities.title) || t('facilities_title') %></h3>
                    <p><%= (sections && sections.facilities && sections.facilities.content) || t('facilities_text') %></p>
                    <% } %>
                </div>
                <div class="row g-4">
                    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.1s">
                        <div class="facility-item">
                            <div class="facility-icon bg-primary">
                                <span class="bg-primary"></span>
                                <i class="fa fa-video fa-3x text-primary"></i>
                                <span class="bg-primary"></span>
                            </div>
                            <div class="facility-text bg-primary">
                                <% if (user && user.role === 'admin') { %>
                                <h3 class="text-primary mb-3 editable-inline" data-section="facilities" data-field="facility_1_title" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.facilities && sections.facilities.facility_1_title) || 'قاعات بث تفاعلية' %></h3>
                                <p class="mb-0 editable-inline" data-section="facilities" data-field="facility_1_text" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.facilities && sections.facilities.facility_1_text) || 'حصص فيديو عالية الجودة مع أدوات تعاون في الوقت الفعلي ودعم للسبورات الذكية.' %></p>
                                <% } else { %>
                                <h3 class="text-primary mb-3"><%= (sections && sections.facilities && sections.facilities.facility_1_title) || 'قاعات بث تفاعلية' %></h3>
                                <p class="mb-0"><%= (sections && sections.facilities && sections.facilities.facility_1_text) || 'حصص فيديو عالية الجودة مع أدوات تعاون في الوقت الفعلي ودعم للسبورات الذكية.' %></p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.3s">
                        <div class="facility-item">
                            <div class="facility-icon bg-success">
                                <span class="bg-success"></span>
                                <i class="fa fa-book-open fa-3x text-success"></i>
                                <span class="bg-success"></span>
                            </div>
                            <div class="facility-text bg-success">
                                <% if (user && user.role === 'admin') { %>
                                <h3 class="text-success mb-3 editable-inline" data-section="facilities" data-field="facility_2_title" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.facilities && sections.facilities.facility_2_title) || 'مكتبة المحتوى المسجل' %></h3>
                                <p class="mb-0 editable-inline" data-section="facilities" data-field="facility_2_text" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.facilities && sections.facilities.facility_2_text) || 'وصول غير محدود للمحاضرات المسجلة والمواد التعليمية والأبحاث المتخصصة.' %></p>
                                <% } else { %>
                                <h3 class="text-success mb-3"><%= (sections && sections.facilities && sections.facilities.facility_2_title) || 'مكتبة المحتوى المسجل' %></h3>
                                <p class="mb-0"><%= (sections && sections.facilities && sections.facilities.facility_2_text) || 'وصول غير محدود للمحاضرات المسجلة والمواد التعليمية والأبحاث المتخصصة.' %></p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.5s">
                        <div class="facility-item">
                            <div class="facility-icon bg-warning">
                                <span class="bg-warning"></span>
                                <i class="fa fa-user-tie fa-3x text-warning"></i>
                                <span class="bg-warning"></span>
                            </div>
                            <div class="facility-text bg-warning">
                                <% if (user && user.role === 'admin') { %>
                                <h3 class="text-warning mb-3 editable-inline" data-section="facilities" data-field="facility_3_title" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.facilities && sections.facilities.facility_3_title) || 'برنامج الإرشاد المهني' %></h3>
                                <p class="mb-0 editable-inline" data-section="facilities" data-field="facility_3_text" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.facilities && sections.facilities.facility_3_text) || 'تواصل مباشر مع خبراء الصناعة وتوجيه مهني شخصي 1 لـ 1 لتطوير مسارك.' %></p>
                                <% } else { %>
                                <h3 class="text-warning mb-3"><%= (sections && sections.facilities && sections.facilities.facility_3_title) || 'برنامج الإرشاد المهني' %></h3>
                                <p class="mb-0"><%= (sections && sections.facilities && sections.facilities.facility_3_text) || 'تواصل مباشر مع خبراء الصناعة وتوجيه مهني شخصي 1 لـ 1 لتطوير مسارك.' %></p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 wow fadeInUp" data-wow-delay="0.7s">
                        <div class="facility-item">
                            <div class="facility-icon bg-info">
                                <span class="bg-info"></span>
                                <i class="fa fa-mobile-alt fa-3x text-info"></i>
                                <span class="bg-info"></span>
                            </div>
                            <div class="facility-text bg-info">
                                <% if (user && user.role === 'admin') { %>
                                <h3 class="text-info mb-3 editable-inline" data-section="facilities" data-field="facility_4_title" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.facilities && sections.facilities.facility_4_title) || 'تعلم عبر الجوال' %></h3>
                                <p class="mb-0 editable-inline" data-section="facilities" data-field="facility_4_text" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.facilities && sections.facilities.facility_4_text) || 'تعلم أثناء التنقل من خلال منصتنا المتجاوبة بالكامل والمحسنة لجميع أجهزتك الرقمية.' %></p>
                                <% } else { %>
                                <h3 class="text-info mb-3"><%= (sections && sections.facilities && sections.facilities.facility_4_title) || 'تعلم عبر الجوال' %></h3>
                                <p class="mb-0"><%= (sections && sections.facilities && sections.facilities.facility_4_text) || 'تعلم أثناء التنقل من خلال منصتنا المتجاوبة بالكامل والمحسنة لجميع أجهزتك الرقمية.' %></p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Facilities End -->


        <!-- About Start -->
        <div class="container-fluid py-5 section-edit-wrapper">
            <% if (user && user.role === 'admin') { %>
            <button class="section-edit-btn" onclick="openEditModal('about', 'من نحن')" title="تعديل قسم من نحن">
                <i class="fas fa-edit"></i>
            </button>
            <div class="edit-indicator"></div>
            <% } %>
            <div class="container">
                <div class="row g-5 align-items-center">
                    <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                        <% if (user && user.role === 'admin') { %>
                        <h3 class="mb-4 editable-inline"
                            data-section="about"
                            data-field="title"
                            contenteditable="false"
                            onclick="enableInlineEdit(this)"
                            onblur="saveInlineEdit(this)"
                            onkeydown="handleInlineKeydown(event, this)">
                            <%= (sections && sections.about && sections.about.title) || t('about_title') %>
                        </h3>
                        <p class="editable-inline"
                           data-section="about"
                           data-field="content"
                           contenteditable="false"
                           onclick="enableInlineEdit(this)"
                           onblur="saveInlineEdit(this)"
                           onkeydown="handleInlineKeydown(event, this)">
                           <%= (sections && sections.about && sections.about.content) || t('about_text_1') %>
                        </p>
                        <p class="mb-4 editable-inline"
                           data-section="about"
                           data-field="subtitle"
                           contenteditable="false"
                           onclick="enableInlineEdit(this)"
                           onblur="saveInlineEdit(this)"
                           onkeydown="handleInlineKeydown(event, this)">
                           <%= (sections && sections.about && sections.about.subtitle) || t('about_text_2') %>
                        </p>
                        <% } else { %>
                        <h3 class="mb-4"><%= (sections && sections.about && sections.about.title) || t('about_title') %></h3>
                        <p><%= (sections && sections.about && sections.about.content) || t('about_text_1') %></p>
                        <p class="mb-4"><%= (sections && sections.about && sections.about.subtitle) || t('about_text_2') %></p>
                        <% } %>
                        <div class="row g-4 align-items-center">
                            <div class="col-sm-6">
                                <a class="btn btn-primary rounded-pill py-3 px-5" href=""><%= t('read_more') %></a>
                            </div>
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center">
                                    <img class="rounded-circle flex-shrink-0" src="img/user.jpg" alt="" style="width: 45px; height: 45px;">
                                    <div class="ms-3">
                                        <% if (user && user.role === 'admin') { %>
                                        <h6 class="text-primary mb-1 editable-inline" data-section="about" data-field="ceo_name" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.about && sections.about.ceo_name) || t('ceo_name') %></h6>
                                        <small class="editable-inline" data-section="about" data-field="ceo_title" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.about && sections.about.ceo_title) || t('ceo_title') %></small>
                                        <% } else { %>
                                        <h6 class="text-primary mb-1"><%= (sections && sections.about && sections.about.ceo_name) || t('ceo_name') %></h6>
                                        <small><%= (sections && sections.about && sections.about.ceo_title) || t('ceo_title') %></small>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 about-img wow fadeInUp" data-wow-delay="0.5s">
                        <div class="row">
                            <div class="col-12 text-center">
                                <img class="img-fluid w-75 rounded-circle bg-light p-3" src="img/about-1.jpg" alt="">
                            </div>
                            <div class="col-6 text-start" style="margin-top: -150px;">
                                <img class="img-fluid w-100 rounded-circle bg-light p-3" src="img/about-2.jpg" alt="">
                            </div>
                            <div class="col-6 text-end" style="margin-top: -150px;">
                                <img class="img-fluid w-100 rounded-circle bg-light p-3" src="img/about-3.jpg" alt="">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- About End -->


        <!-- Statistics Start -->
        <div class="container-fluid py-5">
            <div class="container">
                <div class="row g-5">
                    <div class="col-lg-3 col-md-6 text-center wow fadeIn" data-wow-delay="0.1s">
                        <i class="fa fa-users fa-3x text-primary mb-3"></i>
                        <% if (user && user.role === 'admin') { %>
                        <h3 class="display-1 text-primary mb-0 editable-inline" data-section="stats" data-field="stat_1_count" contenteditable="false" onclick="enableInlineEdit(this)" data-toggle="counter-up"><%= (sections && sections.stats && sections.stats.stat_1_count) || '1234' %></h3>
                        <span class="fs-5 text-primary editable-inline" data-section="stats" data-field="stat_1_label" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.stats && sections.stats.stat_1_label) || t('admin') %></span>
                        <% } else { %>
                        <h3 class="display-1 text-primary mb-0" data-toggle="counter-up"><%= (sections && sections.stats && sections.stats.stat_1_count) || '1234' %></h3>
                        <span class="fs-5 text-primary"><%= (sections && sections.stats && sections.stats.stat_1_label) || t('admin') %></span>
                        <% } %>
                    </div>
                    <div class="col-lg-3 col-md-6 text-center wow fadeIn" data-wow-delay="0.3s">
                        <i class="fa fa-chalkboard-teacher fa-3x text-success mb-3"></i>
                        <% if (user && user.role === 'admin') { %>
                        <h3 class="display-1 text-success mb-0 editable-inline" data-section="stats" data-field="stat_2_count" contenteditable="false" onclick="enableInlineEdit(this)" data-toggle="counter-up"><%= (sections && sections.stats && sections.stats.stat_2_count) || '123' %></h3>
                        <span class="fs-5 text-success editable-inline" data-section="stats" data-field="stat_2_label" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.stats && sections.stats.stat_2_label) || 'Teachers' %></span>
                        <% } else { %>
                        <h3 class="display-1 text-success mb-0" data-toggle="counter-up"><%= (sections && sections.stats && sections.stats.stat_2_count) || '123' %></h3>
                        <span class="fs-5 text-success"><%= (sections && sections.stats && sections.stats.stat_2_label) || 'Teachers' %></span>
                        <% } %>
                    </div>
                    <div class="col-lg-3 col-md-6 text-center wow fadeIn" data-wow-delay="0.5s">
                        <i class="fa fa-book-reader fa-3x text-warning mb-3"></i>
                        <% if (user && user.role === 'admin') { %>
                        <h3 class="display-1 text-warning mb-0 editable-inline" data-section="stats" data-field="stat_3_count" contenteditable="false" onclick="enableInlineEdit(this)" data-toggle="counter-up"><%= (sections && sections.stats && sections.stats.stat_3_count) || '50' %></h3>
                        <span class="fs-5 text-warning editable-inline" data-section="stats" data-field="stat_3_label" contenteditable="false" onclick="enableInlineEdit(this)"><%= (sections && sections.stats && sections.stats.stat_3_label) || t('classes') %></span>
                        <% } else { %>
