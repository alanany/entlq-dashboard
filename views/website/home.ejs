    <!-- Website Builder Styles -->
    <style>
        /* Inline Editable Elements */
        .editable-inline {
            position: relative;
            cursor: text;
            transition: all 0.3s;
            border-radius: 8px;
        }
        
        .builder-active .editable-inline:hover {
            outline: 2px dashed #FE5D37;
            outline-offset: 8px;
            background: rgba(254, 93, 55, 0.08);
        }
        
        .editable-inline[contenteditable="true"] {
            outline: 3px solid #FE5D37 !important;
            outline-offset: 8px;
            background: rgba(254, 93, 55, 0.15) !important;
            animation: pulse-edit 1.5s infinite;
        }
        
        @keyframes pulse-edit {
            0%, 100% { box-shadow: 0 0 0 0 rgba(254, 93, 55, 0.4); }
            50% { box-shadow: 0 0 0 10px rgba(254, 93, 55, 0); }
        }
        
        /* Edit Indicator */
        .builder-active .editable-inline::before {
            content: '✏️ اضغط للتعديل';
            position: absolute;
            top: -30px;
            left: 0;
            background: rgba(30, 30, 30, 0.95);
            color: white;
            padding: 4px 12px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 700;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s;
            z-index: 100;
            white-space: nowrap;
        }
        
        .builder-active .editable-inline:hover::before {
            opacity: 1;
            top: -35px;
        }
        
        .editable-inline[contenteditable="true"]::before {
            content: '✅ جاري التحرير - اضغط خارج العنصر للحفظ';
            background: linear-gradient(135deg, #22c55e, #4ade80);
            opacity: 1 !important;
        }
        
        /* Editable Button */
        .editable-button {
            position: relative;
        }
        
        .builder-active .editable-button:hover {
            outline: 2px dashed #FE5D37;
            outline-offset: 4px;
        }
        
        .builder-active .editable-button::after {
            content: '⚙️';
            position: absolute;
            top: -10px;
            right: -10px;
            background: #FE5D37;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        
        .builder-active .editable-button:hover::after {
            display: flex;
        }
        
        /* Builder Toolbar */
        .website-builder-toolbar {
            position: fixed;
            bottom: 20px;
            left: 20px;
            z-index: 9999;
            display: flex;
            gap: 10px;
            align-items: center;
        }
        
        .builder-toggle-btn {
            background: linear-gradient(135deg, #FE5D37, #ff8a6c);
            color: white;
            border: none;
            padding: 14px 28px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(254, 93, 55, 0.4);
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .builder-toggle-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 25px rgba(254, 93, 55, 0.5);
        }
        
        .builder-toggle-btn.active {
            background: linear-gradient(135deg, #22c55e, #4ade80);
            box-shadow: 0 4px 20px rgba(34, 197, 94, 0.4);
        }
        
        .builder-toggle-btn.active:hover {
            box-shadow: 0 6px 25px rgba(34, 197, 94, 0.5);
        }
        
        /* Save Indicator */
        .save-indicator {
            position: fixed;
            top: 20px;
            right: 20px;
            background: linear-gradient(135deg, #22c55e, #4ade80);
            color: white;
            padding: 12px 24px;
            border-radius: 50px;
            font-weight: 700;
            box-shadow: 0 4px 20px rgba(34, 197, 94, 0.4);
            z-index: 10000;
            opacity: 0;
            transform: translateY(-20px);
            transition: all 0.3s;
            pointer-events: none;
        }
        
        .save-indicator.show {
            opacity: 1;
            transform: translateY(0);
        }
        
        /* Button Edit Modal */
        .button-edit-modal {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            background: white;
            border-radius: 1.5rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            z-index: 10000;
            width: 90%;
            max-width: 500px;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s;
        }
        
        .button-edit-modal.active {
            opacity: 1;
            pointer-events: all;
            transform: translate(-50%, -50%) scale(1);
        }
        
        .modal-backdrop-inline {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(5px);
            z-index: 9999;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s;
        }
        
        .modal-backdrop-inline.active {
            opacity: 1;
            pointer-events: all;
        }
    </style>

    <!-- Website Builder Modals & Script -->
    <!-- Save Indicator -->
    <div class="save-indicator" id="saveIndicator">
        <i class="fas fa-check-circle me-2"></i>
        <span>تم الحفظ!</span>
    </div>

    <!-- Website Builder Toolbar -->
    <div class="website-builder-toolbar">
        <button class="builder-toggle-btn" id="builderToggle" onclick="toggleBuilderMode()">
            <i class="fas fa-magic"></i>
            <span>وضع التحرير</span>
        </button>
    </div>

    <!-- Modal Backdrop -->
    <div class="modal-backdrop-inline" id="buttonEditBackdrop" onclick="closeButtonEdit()"></div>

    <!-- Button Edit Modal -->
    <div class="button-edit-modal" id="buttonEditModal">
        <div style="background: linear-gradient(135deg, #FE5D37, #ff8a6c); color: white; padding: 1.25rem 1.5rem; border-radius: 1.5rem 1.5rem 0 0; display: flex; justify-content: space-between; align-items: center;">
            <h5 class="fw-bold mb-0">
                <i class="fas fa-link me-2"></i>
                تعديل الزر
            </h5>
            <button class="btn btn-sm btn-link text-white" onclick="closeButtonEdit()">
                <i class="fas fa-times fa-lg"></i>
            </button>
        </div>
        <div style="padding: 1.5rem;">
            <div class="mb-3">
                <label class="form-label fw-bold">نص الزر</label>
                <input type="text" class="form-control" id="buttonTextInput" placeholder="مثال: اعرف المزيد">
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">رابط الزر</label>
                <input type="url" class="form-control" id="buttonLinkInput" placeholder="/about" dir="ltr">
            </div>
        </div>
        <div style="padding: 1rem 1.5rem; border-top: 1px solid #eee; display: flex; justify-content: flex-end; gap: 10px;">
            <button class="btn btn-light rounded-pill px-4" onclick="closeButtonEdit()">إلغاء</button>
            <button class="btn btn-primary rounded-pill px-4" onclick="saveButtonEdit()">
                <i class="fas fa-save me-2"></i>حفظ
            </button>
        </div>
    </div>
 
    <div class="modal fade edit-section-modal" id="editSectionModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="fas fa-edit me-2"></i>
                        <span id="editModalTitle">تعديل القسم</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="editSectionForm">
                        <input type="hidden" id="sectionKey" name="key">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">العنوان الرئيسي</label>
                                <input type="text" class="form-control" id="sectionTitle" name="title" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label">العنوان الفرعي</label>
                                <input type="text" class="form-control" id="sectionSubtitle" name="subtitle">
                            </div>
                            <div class="col-12">
                                <label class="form-label">المحتوى / الوصف</label>
                                <textarea class="form-control" id="sectionContent" name="content" rows="4"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">نص الزر (اختياري)</label>
                                <input type="text" class="form-control" id="sectionButtonText" name="buttonText">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">رابط الزر (اختياري)</label>
                                <input type="text" class="form-control" id="sectionButtonLink" name="buttonLink" dir="ltr">
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" onclick="saveSection()">
                        <i class="fas fa-save me-2"></i>حفظ التغييرات
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        let builderMode = false;
        const editModal = new bootstrap.Modal(document.getElementById('editSectionModal'));
        
        // Safely inject sections data from server
        // Using JSON.stringify avoids syntax errors from special characters
        const sectionsData = <%- JSON.stringify(sections || {}) %>;
        
        // Auto-enable builder mode if ?builder=1 in URL
        window.addEventListener('DOMContentLoaded', function() {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('builder') === '1') {
                builderMode = true;
                toggleBuilderMode();
            }
        });
        
        function toggleBuilderMode() {
            builderMode = !builderMode;
            const btn = document.getElementById('builderToggle');
            const body = document.body;
            
            if (builderMode) {
                btn.classList.add('active');
                btn.innerHTML = '<i class="fas fa-check"></i><span>وضع التحرير مفعل</span>';
                body.classList.add('builder-active');
            } else {
                btn.classList.remove('active');
                btn.innerHTML = '<i class="fas fa-magic"></i><span>وضع التحرير</span>';
                body.classList.remove('builder-active');
            }
        }
        
        // Inline Editing System
        let currentEditingElement = null;
        let currentButtonElement = null;
        let saveButtonContainer = null;

        function createSaveButton(element) {
            if (saveButtonContainer) saveButtonContainer.remove();

            saveButtonContainer = document.createElement('div');
            saveButtonContainer.className = 'inline-save-actions fade-in';
            saveButtonContainer.style.position = 'absolute';
            saveButtonContainer.style.zIndex = '10000';
            saveButtonContainer.style.display = 'flex';
            saveButtonContainer.style.gap = '8px';
            saveButtonContainer.style.marginTop = '10px';
            
            // Calculate position
            const rect = element.getBoundingClientRect();
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
            const scrollLeft = window.pageXOffset || document.documentElement.scrollLeft;
            
            saveButtonContainer.style.top = (rect.bottom + scrollTop) + 'px';
            saveButtonContainer.style.left = (rect.left + scrollLeft) + 'px';

            const saveBtn = document.createElement('button');
            saveBtn.className = 'btn btn-sm btn-success rounded-pill px-3 shadow-sm';
            saveBtn.innerHTML = '<i class="fas fa-check me-1"></i>حفظ';
            saveBtn.onclick = (e) => {
                e.stopPropagation();
                performSave(element);
            };
            
            const cancelBtn = document.createElement('button');
            cancelBtn.className = 'btn btn-sm btn-danger rounded-pill px-3 shadow-sm';
            cancelBtn.innerHTML = '<i class="fas fa-times me-1"></i>إلغاء';
            cancelBtn.onclick = (e) => {
                e.stopPropagation();
                cancelEdit(element);
            };

            saveButtonContainer.appendChild(saveBtn);
            saveButtonContainer.appendChild(cancelBtn);
            document.body.appendChild(saveButtonContainer);
        }

        function removeSaveButton() {
            if (saveButtonContainer) {
                saveButtonContainer.remove();
                saveButtonContainer = null;
            }
        }

       function enableInlineEdit(element) {
            if (!builderMode) {
                toggleBuilderMode();
                setTimeout(() => enableInlineEdit(element), 100);
                return;
            }
            
            if (currentEditingElement && currentEditingElement !== element) {
                // Determine what to do with previous element? 
                // For now, let's just close it (cancel)
                cancelEdit(currentEditingElement);
            }
            
            currentEditingElement = element;
            element.setAttribute('contenteditable', 'true');
            element.dataset.original = element.innerText; // Store original text
            element.focus();
            element.style.outline = "2px dashed #FE5D37";
            element.style.borderRadius = "5px";
            
            createSaveButton(element);
        }
        
        function cancelEdit(element) {
            element.setAttribute('contenteditable', 'false');
            element.style.outline = "none";
            // Restore original text
            if (element.dataset.original !== undefined) {
                element.innerText = element.dataset.original;
            }
            removeSaveButton();
            currentEditingElement = null;
        }

        function handleInlineKeydown(event, element) {
            if (event.key === 'Escape') {
                cancelEdit(element);
            }
            // Disable Enter saving
        }
        
        async function performSave(element) {
            element.setAttribute('contenteditable', 'false');
            element.style.outline = "none";
            removeSaveButton();
            
            const section = element.dataset.section;
            const field = element.dataset.field;
            const value = element.innerText.trim(); // use innerText to preserve formatting if any, or textContent
            
            const formData = new FormData();
            formData.append('key', section);
            formData.append(field, value);
            
            await fetch('/admin/website/sections/update', {
                method: 'POST',
                body: formData
            }).then(res => {
                if (res.ok) {
                    showSaveIndicator();
                    // Update local data variable
                    if (!sectionsData[section]) sectionsData[section] = {};
                    sectionsData[section][field] = value;
                    
                    currentEditingElement = null;
                } else {
                    alert('حدث خطأ أثناء الحفظ');
                    location.reload();
                }
            }).catch(err => {
                console.error(err);
                alert('حدث خطأ أثناء الحفظ');
                location.reload();
            });
        }
        
        // Old function kept for compatibility if needed, but unused
        function saveInlineEdit(element) {
           // Do nothing on blur
        }
        
       function editButton(event, buttonElement) {
            event.preventDefault();
            if (!builderMode) {
                toggleBuilderMode();
                setTimeout(() => editButton(event, buttonElement), 100);
                return;
            }
            
            if (currentEditingElement) {
                cancelEdit(currentEditingElement);
            }
            
            currentButtonElement = buttonElement;
            const section = buttonElement.dataset.section;
            const data = sectionsData[section] || {};
            
            document.getElementById('buttonTextInput').value = data.buttonText || buttonElement.querySelector('.button-text').textContent;
            document.getElementById('buttonLinkInput').value = buttonElement.href || '';
            
            document.getElementById('buttonEditModal').classList.add('active');
            document.getElementById('buttonEditBackdrop').classList.add('active');
        }
        
        function closeButtonEdit() {
            document.getElementById('buttonEditModal').classList.remove('active');
            document.getElementById('buttonEditBackdrop').classList.remove('active');
            currentButtonElement = null;
        }
        
        async function saveButtonEdit() {
            if (!currentButtonElement) return;
            
            const section = currentButtonElement.dataset.section;
            const buttonText = document.getElementById('buttonTextInput').value;
            const buttonLink = document.getElementById('buttonLinkInput').value;
            
            const formData = new FormData();
            formData.append('key', section);
            formData.append('buttonText', buttonText);
            formData.append('buttonLink', buttonLink);
            
            await fetch('/admin/website/sections/update', {
                method: 'POST',
                body: formData
            }).then(res => {
                if (res.ok) {
                    closeButtonEdit();
                    showSaveIndicator();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert('حدث خطأ أثناء الحفظ');
                }
            }).catch(err => {
                console.error(err);
                alert('حدث خطأ أثناء الحفظ');
            });
        }
        
        function showSaveIndicator() {
            const indicator = document.getElementById('saveIndicator');
            indicator.classList.add('show');
            setTimeout(() => {
                indicator.classList.remove('show');
            }, 2000);
        }
        
        function openEditModal(sectionKey, sectionName) {
            document.getElementById('editModalTitle').textContent = 'تعديل قسم: ' + sectionName;
            document.getElementById('sectionKey').value = sectionKey;
            
            const data = sectionsData[sectionKey] || {};
            document.getElementById('sectionTitle').value = data.title || '';
            document.getElementById('sectionSubtitle').value = data.subtitle || '';
            document.getElementById('sectionContent').value = data.content || '';
            document.getElementById('sectionButtonText').value = data.buttonText || '';
            document.getElementById('sectionButtonLink').value = data.buttonLink || '';
            
            editModal.show();
        }
        
        async function saveSection() {
            const formData = new FormData(document.getElementById('editSectionForm'));
            
            await fetch('/admin/website/sections/update', {
                method: 'POST',
                body: formData
            }).then(res => {
                if (res.ok) {
                    editModal.hide();
                    const toast = document.createElement('div');
                    toast.className = 'position-fixed top-0 start-50 translate-middle-x mt-4 alert alert-success shadow-lg';
                    toast.style.zIndex = '99999';
                    toast.innerHTML = '<i class="fas fa-check-circle me-2"></i>تم حفظ التغييرات بنجاح! جاري إعادة التحميل...';
                    document.body.appendChild(toast);
                    
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    alert('حدث خطأ أثناء الحفظ. حاول مرة أخرى.');
                }
            }).catch(err => {
                console.error(err);
                alert('حدث خطأ أثناء الحفظ. حاول مرة أخرى.');
            });
        }
    </script>

</body>

