<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - إدارة المشرفين</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.8rem;
        }

        .swal2-popup { border-radius: 1.5rem !important; }
        .archived-row { opacity: 0.6; filter: grayscale(0.2); }
    </style>
</head>
<body class="bg-light">
    
    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4 position-fixed top-0 start-0 m-3 z-3" id="sidebarCollapse">
        <i class="fas fa-bars fs-5"></i>
    </button>
    <%- include('./_admin_sidebar.ejs', { currentPage: 'supervisors', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">إدارة المشرفين</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Manage academy supervisors</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button onclick="showSupervisorModal('add')" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="fa fa-user-plus me-1"></i> إضافة مشرف
                    </button>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden animate__animated animate__fadeInUp">
            <div class="table-responsive">
                <table class="table table-custom mb-0 text-end">
                    <thead>
                        <tr>
                            <th class="px-4 py-3">المشرف</th>
                            <th class="px-4 py-3">رقم الجوال</th>
                            <th class="px-4 py-3 text-center">الحالة</th>
                            <th class="px-4 py-3 text-start">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        <% supervisors.forEach((sup) => { %>
                            <tr class="hover-bg-light transition-colors <%= sup.isActive === false ? 'archived-row' : '' %>">
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center fw-bold outfit-font" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                            <%= sup.name.charAt(0) %>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark"><%= sup.name %></div>
                                            <div class="text-muted small" style="font-size: 0.75rem;"><%= sup.email %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-muted outfit-font" style="font-size: 0.8rem;"><%= sup.phone_number %></td>
                                <td class="px-4 py-3 text-center">
                                    <% if (sup.isActive !== false) { %>
                                        <span class="badge bg-success bg-opacity-10 text-white rounded-pill px-3 py-2" style="font-size: 0.65rem;">نشط</span>
                                    <% } else { %>
                                        <span class="badge bg-warning bg-opacity-10 text-white rounded-pill px-3 py-2" style="font-size: 0.65rem;">مؤرشف</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="d-flex gap-2">
                                         <button onclick="editSupervisor(this)" data-supervisor='<%- JSON.stringify(sup) %>' class="btn btn-light btn-sm rounded-3 text-primary">
                                             <i class="fas fa-edit"></i>
                                         </button>
                                        <% if (sup.isActive !== false) { %>
                                            <button onclick="handleAccountStatus('<%= sup._id %>', 'archive')" class="btn btn-light btn-sm rounded-3 text-warning" title="أرشفة">
                                                 <i class="fas fa-user-slash"></i>
                                            </button>
                                        <% } else { %>
                                            <button onclick="handleAccountStatus('<%= sup._id %>', 'activate')" class="btn btn-light btn-sm rounded-3 text-success" title="تفعيل">
                                                 <i class="fas fa-user-check"></i>
                                            </button>
                                        <% } %>
                                        <button onclick="handleDeleteSupervisor('<%= sup._id %>', '<%= sup.name %>')" class="btn btn-light btn-sm rounded-3 text-danger">
                                             <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>

    <!-- Supervisor Modal -->
    <div class="modal fade" id="supervisorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-0 overflow-hidden">
                    <div class="bg-primary p-4 text-white d-flex justify-content-between align-items-center">
                        <div>
                            <h5 id="modalTitle" class="fw-bold mb-1">بيانات المشرف</h5>
                            <p class="small opacity-75 mb-0">إدارة الحساب وصلاحيات الإشراف</p>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="supervisorForm" class="p-4">
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="small text-muted mb-1 d-block">الاسم الكامل</label>
                                <input type="text" id="name" required class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                            </div>
                            <div class="col-6">
                                <label class="small text-muted mb-1 d-block">رقم الجوال</label>
                                <input type="tel" id="phone" required dir="ltr" class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold text-end" style="font-size: 0.85rem;">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted mb-1 d-block">الايميل</label>
                            <input type="email" id="email" dir="ltr" class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                        </div>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-light rounded-pill flex-grow-1" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-primary rounded-pill flex-[2] fw-bold">حفظ البيانات</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const supervisorModal = new bootstrap.Modal(document.getElementById('supervisorModal'));
        let currentSupervisorId = null;

        async function handleAccountStatus(id, action) {
             const isArchiving = action === 'archive';
            const { value: confirm } = await Swal.fire({
                title: isArchiving ? 'أرشفة الحساب؟' : 'إعادة تفعيل الحساب؟',
                text: 'سيتم تغيير حالة ظهور المشرف.',
                icon: isArchiving ? 'warning' : 'info',
                showCancelButton: true,
                confirmButtonColor: isArchiving ? '#f97316' : '#22c55e',
                confirmButtonText: isArchiving ? 'نعم، أرشِف' : 'نعم، تفعيل',
                cancelButtonText: 'إلغاء',
                customClass: { popup: 'rounded-[2rem]' }
            });
            if (confirm) {
                try {
                     const response = await fetch(`/admin/teacher/update-status`, { // Reusing user status endpoint if generic
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ teacherId: id, isActive: !isArchiving }) // Assuming backend uses teacherId generic for ID
                    });
                    if (response.ok) location.reload();
                    else Swal.fire('خطأ', 'فشل التحديث', 'error');
                } catch (e) { Swal.fire('خطأ', 'خطأ في الاتصال', 'error'); }
            }
        }

        async function handleDeleteSupervisor(id, name) {
            const { value: confirm } = await Swal.fire({
                title: 'حذف المشرف نهائياً؟',
                text: `هل أنت متأكد من حذف المشرف (${name})؟`,
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'نعم، احذف',
                cancelButtonText: 'تراجع',
                customClass: { popup: 'rounded-[2rem]' }
            });
            if (confirm) {
                try {
                    const response = await fetch(`/admin/supervisors/delete/${id}`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) location.reload();
                    else Swal.fire('خطأ', data.message, 'error');
                } catch (e) { Swal.fire('خطأ', 'خطأ في الاتصال', 'error'); }
            }
        }

        function editSupervisor(btn) {
            const sup = JSON.parse(btn.getAttribute('data-supervisor'));
            showSupervisorModal('edit', sup);
        }

        function showSupervisorModal(mode, sup = null) {
            if (mode === 'edit' && sup) {
                currentSupervisorId = sup._id;
                document.getElementById('modalTitle').innerText = "تعديل المشرف";
                document.getElementById('name').value = sup.name;
                document.getElementById('email').value = sup.email;
                document.getElementById('phone').value = sup.phone_number || '';
            } else {
                currentSupervisorId = null;
                document.getElementById('modalTitle').innerText = "إضافة مشرف جديد";
                document.getElementById('supervisorForm').reset();
            }
            supervisorModal.show();
        }

        document.getElementById('supervisorForm').onsubmit = async (e) => {
            e.preventDefault();
            const formData = {
                name: document.getElementById('name').value,
                phone_number: document.getElementById('phone').value,
                email: document.getElementById('email').value
            };
            const url = currentSupervisorId ? `/admin/supervisors/update/${currentSupervisorId}` : `/admin/supervisors/add`;
            
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const result = await response.json();
                if (result.success) location.reload();
                else Swal.fire('خطأ', result.message, 'error');
            } catch (err) { Swal.fire('خطأ', 'فشل الاتصال', 'error'); }
        };
    </script>
</body>
</html>
