<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - ملف الطالب التفصيلي</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .profile-card {
            background: #fff;
            border-radius: 2rem;
            padding: 2rem;
            border: 1px solid #f1f1f1;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.02);
        }

        .tab-btn {
            border: none;
            background: #fff;
            color: #6c757d;
            font-weight: 700;
            padding: 1rem 1.5rem;
            transition: all 0.3s;
            border-bottom: 3px solid transparent;
        }

        .tab-btn.active {
            color: var(--primary);
            border-bottom-color: var(--primary);
            background: var(--secondary);
        }

        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.5s; }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.8rem;
        }
    </style>
</head>
<body class="bg-light">
    <%- include('./_admin_sidebar.ejs', { currentPage: 'students', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fa fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">ملف الطالب</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Detailed student profile & history</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button onclick="history.back()" class="btn btn-light rounded-circle p-2 text-muted" title="رجوع">
                        <i class="fa fa-arrow-left"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-light rounded-circle p-2 text-danger" title="تسجيل الخروج">
                            <i class="fa fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="profile-card d-flex flex-column flex-md-row align-items-center gap-4 mb-4 animate__animated animate__fadeInUp">
            <div class="bg-primary bg-opacity-10 text-primary rounded-4 d-flex align-items-center justify-content-center fw-900 outfit-font text-white" style="width: 100px; height: 100px; font-size: 2.5rem;">
                <%= initials %>
            </div>
            <div class="flex-grow-1 text-center text-md-end">
                <h2 class="fw-900 text-dark mb-2 text-danger"><%= student.name %></h2>
                <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-4">
                    <a href="mailto: <%= student.email %>" class="text-muted text-decoration-none small fw-bold hover-text-primary">
                        <i class="fa fa-envelope text-primary me-1"></i> <%= student.email %>
                    </a>
                    <a href="tel: <%= student.phone_number %>" class="text-muted text-decoration-none small fw-bold hover-text-primary">
                        <i class="fa fa-phone text-primary me-1"></i> <%= student.phone_number || 'بدون هاتف' %>
                    </a>
                </div>
            </div>
            <div class="d-flex gap-3">
                <div class="bg-light p-3 rounded-4 text-center border border-light min-w-[120px]">
                    <p class="text-muted small fw-bold mb-1 uppercase">الحالة</p>
                    <span class=" text-white  <%= student.isActive ? 'bg-success' : 'bg-warning' %> bg-opacity-10 <%= student.isActive ? 'text-success' : 'text-warning' %> px-3 py-1 rounded-pill">
                        <%= student.isActive ? 'نشط' : 'مؤرشف' %>
                    </span>
                </div>
            </div>
            <div class="d-flex gap-3 align-items-center">



  <!-- زر الاشتراك -->
  <a href="/student/courses_list/<%= student.id %>"
     class="btn btn-primary px-2 py-2 rounded-pill d-flex align-items-center gap-2">
    <i class="fas fa-plus-circle"></i>
    إضافة اشتراك
  </a>
</div>

        </div>

        <div class="bg-white p-2 rounded-4 shadow-sm border border-light d-flex mb-4">
            <button onclick="openTab(event, 'courses')" class="tab-btn active flex-grow-1 rounded-3">الكورسات (<%= subscriptions.length %>)</button>
            <button onclick="openTab(event, 'sessions')" class="tab-btn flex-grow-1 rounded-3">الجلسات</button>
            <button onclick="openTab(event, 'billing')" class="tab-btn flex-grow-1 rounded-3">الفواتير</button>
            <button onclick="openTab(event, 'logs')" class="tab-btn flex-grow-1 rounded-3">النشاطات</button>
        </div>

        <div class="w-full">
            <div id="courses" class="tab-content active px-2">
                <div class="row g-4">
                    <% subscriptions.forEach(sub => { %>
                        <% 
                            const totalSessions = sub.numberOfSessionsPerMonth;
                            const completedSessions = sub.sessions.filter(s => s.status === 'completed').length;
                            const remainingSessions = totalSessions - completedSessions;
                            const progressPercent = (completedSessions / totalSessions) * 100;
                        %>
                        <div class="col-md-6 col-lg-4">
                       <% if(sub.status === 'pending'){ %>
<a href="#">
                                <div class="bg-white p-4 rounded-4 border border-light shadow-sm h-100 d-flex flex-column gap-3 hover-shadow transition-all">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class=" bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                            <i class="fa fa-book-open"></i>
                                        </div>
                                        <span class=" bg-opacity-10 text-primary rounded-pill px-3 py-2 small fw-bold">
                                            <%= sub.status === 'confirmed' ? 'نشط' : sub.status %>
                                        </span>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1"><%= sub.courseId ? sub.courseId.title : 'كورس غير مسمى' %></h6>
                                        <small class="text-muted fw-bold">المعلم: <%= sub.teacherId ? sub.teacherId.name : 'غير محدد' %></small>
                                    </div>
                                    <div class="row g-2 text-center py-2 border-top border-bottom border-light">
                                        <div class="col-4"><p class="small text-muted mb-0">الإجمالي</p><p class="fw-bold text-dark mb-0"><%= totalSessions %></p></div>
                                        <div class="col-4 border-start border-end border-light"><p class="small text-success mb-0">منتهية</p><p class="fw-bold text-success mb-0"><%= completedSessions %></p></div>
                                        <div class="col-4"><p class="small text-warning mb-0">متبقية</p><p class="fw-bold text-warning mb-0"><%= remainingSessions > 0 ? remainingSessions : 0 %></p></div>
                                    </div>
                                    <div class="space-y-1">
                                        <div class="d-flex justify-content-between small fw-bold text-muted mb-1">
                                            <span>نسبة الإنجاز</span>
                                            <span><%= Math.round(progressPercent) %>%</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-primary" style="width: <%= progressPercent %>%"></div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        <% }else{ %>
                              <a href="/student/student-sessions/<%= student._id %>" class="text-decoration-none">
                                <div class="bg-white p-4 rounded-4 border border-light shadow-sm h-100 d-flex flex-column gap-3 hover-shadow transition-all">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class=" bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                            <i class="fa fa-book-open"></i>
                                        </div>
                                        <span class=" bg-opacity-10 text-primary rounded-pill px-3 py-2 small fw-bold">
                                            <%= sub.status === 'confirmed' ? 'نشط' : sub.status %>
                                        </span>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1"><%= sub.courseId ? sub.courseId.title : 'كورس غير مسمى' %></h6>
                                        <small class="text-muted fw-bold">المعلم: <%= sub.teacherId ? sub.teacherId.name : 'غير محدد' %></small>
                                    </div>
                                    <div class="row g-2 text-center py-2 border-top border-bottom border-light">
                                        <div class="col-4"><p class="small text-muted mb-0">الإجمالي</p><p class="fw-bold text-dark mb-0"><%= totalSessions %></p></div>
                                        <div class="col-4 border-start border-end border-light"><p class="small text-success mb-0">منتهية</p><p class="fw-bold text-success mb-0"><%= completedSessions %></p></div>
                                        <div class="col-4"><p class="small text-warning mb-0">متبقية</p><p class="fw-bold text-warning mb-0"><%= remainingSessions > 0 ? remainingSessions : 0 %></p></div>
                                    </div>
                                    <div class="space-y-1">
                                        <div class="d-flex justify-content-between small fw-bold text-muted mb-1">
                                            <span>نسبة الإنجاز</span>
                                            <span><%= Math.round(progressPercent) %>%</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar bg-primary" style="width: <%= progressPercent %>%"></div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        
                        <% } %>
                        
                  
                        </div>
                    <% }) %>
                </div>
            </div>

            <div id="sessions" class="tab-content px-2">
                <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-custom mb-0 text-end">
                            <thead>
                                <tr>
                                    <th class="px-4 py-3">الحصة / الموضوع</th>
                                    <th class="px-4 py-3">الكورس</th>
                                    <th class="px-4 py-3 text-center">الوقت والتاريخ</th>
                                    <th class="px-4 py-3 text-center">الحالة</th>
                                    <th class="px-4 py-3 text-start">الإجراء</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white">
                                <% allSessions.forEach(session => { %>
                                <tr class="hover-bg-light transition-colors">
                                    <td class="px-4 py-3 fw-bold text-dark">حصة تدريبية</td>
                                    <td class="px-4 py-3">
                                        <span class=" bg-opacity-10 text-primary rounded-pill px-3 py-2 small fw-bold">
                                            <%= session.courseName %>
                                            مع المعلم
                                       <%= session.teacherName %>
                                        </span>
                                    </td>
                                    <td class="px-4 py-3 text-center text-muted">
                                        <div class="small fw-bold"><%= new Date(session.date).toLocaleDateString('ar-EG') %></div>
                                        <div class="text-primary outfit-font" style="font-size: 0.7rem;"><%= session.time %></div>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <% if(session.status === 'completed') { %>
                                            <span class="text-success small fw-bold"><i class="fa fa-check-circle me-1"></i> مكتملة</span>
                                        <% } else if(session.status === 'missed') { %>
                                            <span class="text-danger small fw-bold"><i class="fa fa-times-circle me-1"></i> غائب</span>
                                        <% } else { %>
                                            <span class="text-warning small fw-bold"><i class="fa fa-clock me-1"></i> قادمة</span>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3 text-start">
                                        <% if(session.status !== 'completed' && (!session.report || !session.report.content)) { %>
                                            <a href="<%= session.link  %>"  class="btn btn-primary btn-sm rounded-pill px-3 fw-bold shadow-sm">
                                                <i class="fa fa-video me-1"></i> انضمام
                                            </a>
                                        <% } else { %>
                                            <span class="text-muted small fw-bold"><%= session.status === 'completed' ? 'انتهت' : 'تم الرفع' %></span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div id="billing" class="tab-content px-2">
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="bg-white p-4 rounded-4 border border-light shadow-sm">
                            <p class="small text-muted fw-bold mb-1 uppercase">إجمالي المدفوعات</p>
                            <% 
                                let totalPaid = subscriptions.filter(s => s.status === 'confirmed' || s.status === 'completed')
                                                            .reduce((sum, s) => sum + s.totalAmount, 0);
                            %>
                            <p class="h4 fw-900 text-primary mb-0"><%= totalPaid %> $</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="bg-white p-4 rounded-4 border border-light shadow-sm">
                            <p class="small text-muted fw-bold mb-1 uppercase">اشتراكات بانتظار الدفع</p>
                            <p class="h4 fw-900 text-warning mb-0"><%= subscriptions.filter(s => s.status === 'pending').length %></p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-custom mb-0 text-end">
                            <thead>
                                <tr>
                                    <th class="px-4 py-3">رقم العملية</th>
                                    <th class="px-4 py-3">الكورس / الخطة</th>
                                    <th class="px-4 py-3">طريقة الدفع</th>
                                    <th class="px-4 py-3 text-center">المبلغ</th>
                                    <th class="px-4 py-3 text-start">الحالة</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white">
                                <% subscriptions.forEach(sub => { %>
                                <tr class="hover-bg-light transition-colors">
                                    <td class="px-4 py-3 outfit-font text-muted small">
                                        <%= sub.paymentDetails?.transactionId || sub._id.toString().slice(-8).toUpperCase() %>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="fw-bold text-dark"><%= sub.courseId ? sub.courseId.title : 'كورس عام' %></div>
                                        <div class="text-muted small" style="font-size: 0.7rem;"><%= sub.selectedPriceOption %> دقيقة | <%= sub.numberOfSessionsPerMonth %> حصص</div>
                                    </td>
                                    <td class="px-4 py-3 text-muted"><%= sub.paymentDetails?.method || 'تحويل مباشر' %></td>
                                    <td class="px-4 py-3 text-center fw-900 text-primary"><%= sub.totalAmount %> $</td>
                                    <td class="px-4 py-3">
                                        <% if(sub.status === 'confirmed' || sub.status === 'completed') { %>
                                            <span class="badge bg-success bg-opacity-10 text-white rounded-pill px-3 py-2 small fw-bold">مدفوع</span>
                                        <% } else if(sub.status === 'pending') { %>
                                            <span class="badge bg-warning bg-opacity-10 text-white rounded-pill px-3 py-2 small fw-bold">معلق</span>
                                        <% } else { %>
                                            <span class="badge bg-danger bg-opacity-10 text-white rounded-pill px-3 py-2 small fw-bold">ملغي</span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div id="logs" class="tab-content px-2">
                <div class="bg-white p-5 text-center rounded-4 border border-light text-muted fw-bold shadow-sm">
                    <i class="fa fa-activity fs-1 mb-3 opacity-25"></i>
                    <p class="mb-0">سجل نشاطات الطالب وتوقيت الدخول</p>
                </div>
            </div>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>

    <!-- Modals -->
    <!-- Logout Modal managed by _admin_sidebar -->

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function openTab(evt, tabName) {
            $(".tab-content").removeClass("active");
            $(".tab-btn").removeClass("active");
            $(`#${tabName}`).addClass("active");
            $(evt.currentTarget).addClass("active");
        }
    </script>
</body>
</html>