<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الطالب | <%= student.name %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .active-tab { 
            background-color: #4f46e5 !important; 
            color: white !important; 
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.2);
        }
    </style>
</head>
<body class="text-gray-900 antialiased">

    <header class="bg-white border-b border-gray-100 px-8 py-4 flex flex-col md:flex-row items-center justify-between sticky top-0 z-50 gap-4">
        <div class="flex items-center gap-4">
            <button onclick="history.back()" class="p-2 hover:bg-gray-100 rounded-xl transition-all group">
                <i data-feather="arrow-right" class="w-6 h-6 text-gray-500 group-hover:text-indigo-600"></i>
            </button>
            <div class="h-8 w-px bg-gray-100 mx-2"></div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-indigo-600 rounded-xl flex items-center justify-center text-white shadow-lg">
                    <i data-feather="user" class="w-5 h-5"></i>
                </div>
                <h2 class="text-xl font-black text-gray-800 tracking-tight">ملف الطالب التفصيلي</h2>
            </div>
        </div>

    </header>

    <main class="w-full p-8 space-y-8">
        
        <div class="bg-white rounded-[2.5rem] p-8 border border-gray-100 shadow-sm flex flex-col md:flex-row items-center gap-10">
            <div class="w-28 h-28 bg-indigo-50 rounded-[2rem] flex items-center justify-center text-indigo-600 text-4xl font-black border-2 border-indigo-100 uppercase">
                <%= initials %>
            </div>
            <div class="flex-1 text-center md:text-right">
                <h1 class="text-3xl font-black text-gray-900 mb-2"><%= student.name %></h1>
               <div class="flex flex-wrap justify-center md:justify-start gap-6">
    
    <a href="mailto: <%= student.email %>" 
       class="flex items-center gap-2 text-sm font-bold text-gray-400 hover:text-indigo-600 transition-colors group" title="إرسال بريد إلكتروني">
        <i data-feather="mail" class="w-4 h-4 text-indigo-400 group-hover:scale-110 transition-transform"></i> 
        <%= student.email %>
    </a>

    <div class="flex items-center gap-3">
        <a href="tel: < %= student.phone_number %>" 
           class="flex items-center gap-2 text-sm font-bold text-gray-400 hover:text-indigo-600 transition-colors group" title="اتصال هاتفي">
            <i data-feather="phone" class="w-4 h-4 text-indigo-400 group-hover:scale-110 transition-transform"></i> 
            <%= student.phone_number || 'بدون هاتف' %>
        </a>

        <% if (student.phone_number) { %>
            <a href="https://wa.me/<%= student.phone_number.replace(/\s+/g, '').replace('+', '') %>" 
               target="_blank"
               class="flex items-center justify-center w-8 h-8 bg-emerald-50 text-emerald-600 rounded-full hover:bg-emerald-500 hover:text-white transition-all shadow-sm border border-emerald-100"
               title="إرسال رسالة واتساب">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L0 24l6.335-1.662c1.72.94 3.659 1.437 5.63 1.438h.004c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
            </a>
        <% } %>
    </div>
</div>
            </div>
            <div class="flex gap-4">
                <div class="<%= student.status === 'active' ? 'bg-emerald-50 border-emerald-100 text-emerald-700' : 'bg-gray-50 border-gray-100 text-gray-700' %> px-6 py-4 rounded-3xl text-center border min-w-[120px]">
                    <p class="text-[10px] font-black uppercase mb-1">الحالة</p>
                    <p class="text-sm font-black"><%= student.isActive  ? 'حساب نشط' : 'مؤرشف' %></p>
                </div>
             
            </div>
        </div>

        <div class="bg-white p-2 rounded-2xl border border-gray-100 shadow-sm flex w-full">
            <button onclick="openTab(event, 'courses')" class="tab-btn active-tab flex-1 py-4 text-sm font-black rounded-xl transition-all">الكورسات (<%= subscriptions.length %>)</button>
           
            <button onclick="openTab(event, 'billing')" class="tab-btn flex-1 py-4 text-sm font-bold text-gray-400 hover:text-gray-600 rounded-xl transition-all">الفواتير</button>
            <button onclick="openTab(event, 'logs')" class="tab-btn flex-1 py-4 text-sm font-bold text-gray-400 hover:text-gray-600 rounded-xl transition-all">النشاطات</button>
        </div>

        <div class="w-full">
            <div id="courses" class="tab-content active animate-in fade-in duration-500">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% subscriptions.forEach(sub => { %>
            <% 
                // الحسابات البرمجية لكل كورس
                const totalSessions = sub.numberOfSessionsPerMonth; // إجمالي الحصص المحجوزة
                const completedSessions = sub.sessions.filter(s => s.status === 'completed').length; // المكتملة
                const remainingSessions = totalSessions - completedSessions; // المتبقية
                const progressPercent = (completedSessions / totalSessions) * 100; // نسبة الإنجاز
            %>
                 <a href="/student/student-sessions/<%= student._id %>">
  <div class="bg-white p-6 rounded-[2rem] border border-gray-100 shadow-sm flex flex-col gap-6 hover:shadow-md transition-all">
                <div class="flex justify-between items-center">
                    <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600">
                        <i data-feather="book-open"></i>
                    </div>
                    <span class="bg-indigo-50 text-indigo-600 px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest">
                        <%= sub.status === 'confirmed' ? 'نشط' : sub.status %>
                    </span>
                </div>

                <div>
                    <h4 class="font-black text-lg text-gray-800 leading-tight">
                        <%= sub.courseId ? sub.courseId.title : 'كورس غير مسمى' %>
                    </h4>
                    <p class="text-xs font-bold text-gray-400 mt-1 uppercase">
                        المعلم: <%= sub.teacherId ? sub.teacherId.name : 'غير محدد' %>
                    </p>
                </div>

                <div class="grid grid-cols-3 gap-2 py-2 border-y border-gray-50">
                    <div class="text-center">
                        <p class="text-[10px] font-bold text-gray-400 uppercase">الإجمالي</p>
                        <p class="text-sm font-black text-gray-700"><%= totalSessions %></p>
                    </div>
                    <div class="text-center border-x border-gray-50">
                        <p class="text-[10px] font-bold text-emerald-500 uppercase">منتهية</p>
                        <p class="text-sm font-black text-emerald-600"><%= completedSessions %></p>
                    </div>
                    <div class="text-center">
                        <p class="text-[10px] font-bold text-amber-500 uppercase">متبقية</p>
                        <p class="text-sm font-black text-amber-600"><%= remainingSessions > 0 ? remainingSessions : 0 %></p>
                    </div>
                </div>

                <div class="space-y-2">
                    <div class="flex justify-between text-[10px] font-black text-gray-400 uppercase">
                        <span>نسبة الإنجاز</span>
                        <span><%= Math.round(progressPercent) %>%</span>
                    </div>
                    <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden">
                        <div class="bg-indigo-600 h-full transition-all duration-700" style="width: <%= progressPercent %>%"></div>
                    </div>
                </div>
            </div>
                 </a>
          
        <% }) %>
    </div>
            </div>

          <div id="sessions" class="tab-content animate-in fade-in duration-500">
    <div class="bg-white rounded-[2.5rem] border border-gray-100 shadow-sm overflow-hidden">
        <table class="w-full text-right border-collapse">
            <thead class="bg-gray-50 text-[11px] font-black uppercase text-gray-400 border-b">
                <tr>
                    <th class="px-6 py-5">الحصة / الموضوع</th>
                    <th class="px-6 py-5">الكورس</th>
                    <th class="px-6 py-5">الوقت والتاريخ</th>
                    <th class="px-6 py-5 text-center">الحالة</th>
                    <th class="px-6 py-5 text-center">الإجراء</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50 text-sm font-bold">
                <% allSessions.forEach(session => { %>
                <tr class="hover:bg-gray-50/50 transition-colors">
                    <td class="px-6 py-6 text-gray-900">
                        <%=  'حصة تدريبية' %>
                    </td>

                    <td class="px-6 py-6">
                        <span class="bg-indigo-50 text-indigo-700 px-3 py-1 rounded-lg text-xs">
                            <%= session.courseTitle %>
                        </span>
                    </td>

                    <td class="px-6 py-6 text-gray-500 font-medium">
                        <div class="flex flex-col">
                            <span><%= new Date(session.date).toLocaleDateString('ar-EG') %></span>
                            <span class="text-[10px] text-indigo-400"><%= session.time %></span>
                        </div>
                    </td>

                    <td class="px-6 py-6 text-center">
                        <% if(session.status === 'completed') { %>
                            <span class="text-emerald-600 flex items-center justify-center gap-1 text-xs">
                                <i data-feather="check-circle" class="w-4 h-4"></i> مكتملة
                            </span>
                        <% } else if(session.status === 'missed') { %>
                            <span class="text-rose-500 flex items-center justify-center gap-1 text-xs">
                                <i data-feather="x-circle" class="w-4 h-4"></i> غائب
                            </span>
                        <% } else { %>
                            <span class="text-amber-500 flex items-center justify-center gap-1 text-xs">
                                <i data-feather="clock" class="w-4 h-4"></i> قادمة
                            </span>
                        <% } %>
                    </td>

                    <td class="px-6 py-6 text-center">
                        <% 
                           // شرط ظهور الزر: الحالة ليست مكتملة (pending) وتقرير الحصة غير موجود
                           const hasNoReport = !session.report || !session.report.content;
                           if(session.status !== 'completed' && hasNoReport) { 
                        %>
                            <a href="<%= session.link || '#' %>" target="_blank" 
                               class="inline-flex items-center gap-2 bg-indigo-600 text-white px-4 py-2 rounded-xl text-xs font-black shadow-md shadow-indigo-100 hover:bg-indigo-700 transition-all">
                                <i data-feather="video" class="w-3 h-3"></i>
                                انضمام الآن
                            </a>
                        <% } else if (session.status === 'completed') { %>
                            <span class="text-[10px] text-gray-300 font-black uppercase tracking-tighter">انتهت الجلسة</span>
                        <% } else { %>
                            <span class="text-[10px] text-emerald-500 font-black uppercase tracking-tighter">تم رفع التقرير</span>
                        <% } %>
                    </td>
                </tr>
                <% }) %>

                <% if (allSessions.length === 0) { %>
                    <tr>
                        <td colspan="5" class="px-8 py-20 text-center text-gray-400 font-bold">
                            لا توجد حصص مسجلة لهذا الطالب حتى الآن.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

          <div id="billing" class="tab-content animate-in fade-in duration-500">
    <div class="grid grid-cols-1 gap-6">
        
        <div class="flex flex-wrap gap-4 mb-2">
            <div class="bg-white p-4 rounded-3xl border border-gray-100 flex-1 min-w-[200px] shadow-sm">
                <p class="text-[10px] font-black text-gray-400 uppercase">إجمالي المدفوعات</p>
                <% 
                    let totalPaid = subscriptions.filter(s => s.status === 'confirmed' || s.status === 'completed')
                                                .reduce((sum, s) => sum + s.totalAmount, 0);
                %>
                <p class="text-xl font-black text-indigo-600"><%= totalPaid %> $</p>
            </div>
            <div class="bg-white p-4 rounded-3xl border border-gray-100 flex-1 min-w-[200px] shadow-sm">
                <p class="text-[10px] font-black text-gray-400 uppercase">اشتراكات بانتظار الدفع</p>
                <p class="text-xl font-black text-amber-500">
                    <%= subscriptions.filter(s => s.status === 'pending').length %>
                </p>
            </div>
        </div>

        <div class="bg-white rounded-[2.5rem] border border-gray-100 shadow-sm overflow-hidden">
            <table class="w-full text-right border-collapse">
                <thead class="bg-gray-50 text-[11px] font-black uppercase text-gray-400 border-b">
                    <tr>
                        <th class="px-8 py-5">رقم العملية / ID</th>
                        <th class="px-8 py-5">الكورس</th>
                        <th class="px-8 py-5">طريقة الدفع</th>
                        <th class="px-8 py-5">المبلغ</th>
                        <th class="px-8 py-5">التاريخ</th>
                        <th class="px-8 py-5 text-center">الحالة</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-sm font-bold">
                    <% subscriptions.forEach(sub => { %>
                    <tr class="hover:bg-gray-50/50 transition-colors">
                        <td class="px-8 py-6 font-mono text-xs text-indigo-400">
                            <%= sub.paymentDetails?.transactionId || sub._id.toString().slice(-8).toUpperCase() %>
                        </td>
                        
                        <td class="px-8 py-6">
                            <div class="flex flex-col">
                                <span class="text-gray-900"><%= sub.courseId ? sub.courseId.title : 'كورس عام' %></span>
                                <span class="text-[10px] text-gray-400 font-medium">خيار: <%= sub.selectedPriceOption %> دقيقة |  <%= sub.numberOfSessionsPerMonth %> حصة شهرياً</span>
                                <span class="text-[10px] text-gray-400 font-medium">تاريخ بداية اول جلسة: <%= new Date(sub.startDate).toLocaleDateString('ar-EG') %></span>
                            </div>
                        </td>

                        <td class="px-8 py-6 text-gray-500">
                            <%= sub.paymentDetails?.method || 'تحويل مباشر' %>
                        </td>

                        <td class="px-8 py-6 text-indigo-600 font-black">
                            <%= sub.totalAmount %> $
                        </td>

                        <td class="px-8 py-6 text-gray-400">
                            <%= new Date(sub.createdAt).toLocaleDateString('ar-EG') %>
                        </td>

                        <td class="px-8 py-6 text-center">
                            <% if(sub.status === 'confirmed' || sub.status === 'completed') { %>
                                <span class="bg-emerald-50 text-emerald-600 px-4 py-1.5 rounded-xl text-[10px] font-black border border-emerald-100">
                                    مدفوع
                                </span>
                            <% } else if(sub.status === 'pending') { %>
                                <span class="bg-amber-50 text-amber-600 px-4 py-1.5 rounded-xl text-[10px] font-black border border-amber-100">
                                    معلق
                                </span>
                            <% } else { %>
                                <span class="bg-rose-50 text-rose-600 px-4 py-1.5 rounded-xl text-[10px] font-black border border-rose-100">
                                    ملغي
                                </span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>

                    <% if (subscriptions.length === 0) { %>
                        <tr>
                            <td colspan="6" class="px-8 py-20 text-center text-gray-400 font-bold">
                                لا توجد فواتير أو سجلات دفع لهذا الطالب.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

            <div id="logs" class="tab-content animate-in fade-in duration-500">
                <div class="bg-white p-12 text-center rounded-[2.5rem] border border-gray-100 text-gray-400 font-bold">
                    <i data-feather="activity" class="w-12 h-12 mx-auto mb-4 opacity-20"></i>
                    سجل نشاطات الطالب وتوقيت الدخول
                </div>
            </div>

        </div>
    </main>

    <script>
        feather.replace();

        function openTab(evt, tabName) {
            var i, tabContent, tabLinks;
            tabContent = document.getElementsByClassName("tab-content");
            for (i = 0; i < tabContent.length; i++) {
                tabContent[i].style.display = "none";
                tabContent[i].classList.remove("active");
            }
            tabLinks = document.getElementsByClassName("tab-btn");
            for (i = 0; i < tabLinks.length; i++) {
                tabLinks[i].classList.remove("active-tab");
                tabLinks[i].classList.add("text-gray-400");
                tabLinks[i].classList.remove("font-black");
                tabLinks[i].classList.add("font-bold");
            }
            document.getElementById(tabName).style.display = "block";
            evt.currentTarget.classList.add("active-tab", "font-black");
            evt.currentTarget.classList.remove("text-gray-400", "font-bold");
        }
    </script>
</body>
</html>