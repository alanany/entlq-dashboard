<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - الجلسات القادمة</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root { --primary: #FE5D37; --secondary: #FFF0ED; --light: #F8F9FA; --dark: #000B1C; }
        body { font-family: 'Cairo', sans-serif; background-color: #f7f9fc; font-size: 0.9rem; }
        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }
        .main-content { margin-right: 260px; padding: 1.5rem; min-height: 100vh; transition: all 0.3s; }
        @media (max-width: 991.98px) { .main-content { margin-right: 0; } }
        .table-custom thead th {
            background-color: #f8f9fa; border-bottom: none; color: #6c757d;
            font-weight: 700; padding: 0.75rem 1rem; font-size: 0.75rem;
            text-transform: uppercase; letter-spacing: 0.5px;
        }
        .table-custom tbody td {
            padding: 0.75rem 1rem; vertical-align: middle;
            border-bottom: 1px solid #f1f1f1; font-size: 0.8rem;
        }
        .filter-card {
            background: #fff; border-radius: 1.5rem; padding: 1.25rem;
            border: 1px solid rgba(0,0,0,0.05); margin-bottom: 1.5rem;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.03);
        }
    </style>
</head>
<body class="bg-light">
    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none position-fixed top-0 start-0 m-3 z-3" id="sidebarCollapse">
        <i class="fas fa-bars fs-5"></i>
    </button>
    <%- include('./_supervisor_sidebar.ejs', { currentPage: 'sessions', user: user }) %>

    <div class="main-content">
        <div class="px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div>
                    <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">الجلسات القادمة</h4>
                    <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Upcoming Sessions & Notifications</small>
                </div>
                <div>
                    <span class="badge bg-primary rounded-pill px-3 py-2"><%= sessions.length %> جلسة</span>
                </div>
            </div>
        </div>

        <!-- Date Filter -->
        <div class="filter-card animate__animated animate__fadeInUp">
            <form method="GET" action="/supervisor/sessions" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="small text-muted fw-bold mb-1">من تاريخ</label>
                    <input type="date" name="from" value="<%= filters.from %>" class="form-control border-0 bg-light rounded-3">
                </div>
                <div class="col-md-4">
                    <label class="small text-muted fw-bold mb-1">إلى تاريخ</label>
                    <input type="date" name="to" value="<%= filters.to %>" class="form-control border-0 bg-light rounded-3">
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold">
                        <i class="fas fa-filter me-1"></i> تصفية
                    </button>
                </div>
            </form>
        </div>

        <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden animate__animated animate__fadeInUp">
            <div class="table-responsive">
                <table class="table table-custom mb-0 text-end">
                    <thead>
                        <tr>
                            <th class="px-4 py-3">الطالب</th>
                            <th class="px-4 py-3">المعلم</th>
                            <th class="px-4 py-3">الدورة</th>
                            <th class="px-4 py-3 text-center">التاريخ</th>
                            <th class="px-4 py-3 text-center">الوقت</th>
                            <th class="px-4 py-3 text-center">الرابط</th>
                            <th class="px-4 py-3 text-center">إشعار</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        <% if (sessions && sessions.length > 0) { %>
                            <% sessions.forEach(s => { %>
                                <tr>
                                    <td class="px-4 py-3 fw-bold"><%= s.studentName %></td>
                                    <td class="px-4 py-3 text-muted"><%= s.teacherName %></td>
                                    <td class="px-4 py-3"><%= s.courseTitle %></td>
                                    <td class="px-4 py-3 text-center outfit-font"><%= s.displayDate %></td>
                                    <td class="px-4 py-3 text-center outfit-font"><%= s.displayTime %></td>
                                    <td class="px-4 py-3 text-center">
                                        <% if (s.link) { %>
                                            <a href="<%= s.link %>" target="_blank" class="btn btn-outline-primary btn-sm rounded-3">
                                                <i class="fas fa-video"></i>
                                            </a>
                                        <% } else { %>
                                            <span class="text-muted">---</span>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <button onclick="sendNotification('<%= s.subscriptionId %>', '<%= s.sessionId %>', '<%= s.studentName %>')" 
                                                class="btn btn-sm btn-outline-warning rounded-3" title="إرسال إشعار تذكير">
                                            <i class="fas fa-bell"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="fas fa-calendar-times fs-1 text-muted opacity-25 d-block mb-3"></i>
                                    لا توجد جلسات في الفترة المحددة
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية <%= new Date().getFullYear() %> - جميع الحقوق محفوظة</small>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function sendNotification(subscriptionId, sessionId, studentName) {
            const { value: confirm } = await Swal.fire({
                title: 'إرسال إشعار تذكير؟',
                text: `سيتم إرسال إشعار تذكير للطالب (${studentName}) بموعد الجلسة.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#FE5D37',
                confirmButtonText: 'نعم، أرسل',
                cancelButtonText: 'إلغاء',
                customClass: { popup: 'rounded-4' }
            });

            if (confirm) {
                try {
                    const response = await fetch('/features/send-notification', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ subscriptionId, sessionId })
                    });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire({ title: 'تم!', text: 'تم إرسال الإشعار بنجاح', icon: 'success', customClass: { popup: 'rounded-4' } });
                    } else {
                        Swal.fire('خطأ', data.message || 'فشل إرسال الإشعار', 'error');
                    }
                } catch (err) {
                    Swal.fire('خطأ', 'فشل الاتصال بالسيرفر', 'error');
                }
            }
        }
    </script>
</body>
</html>
