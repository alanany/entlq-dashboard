<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - إعدادات المشرف</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root { --primary: #FE5D37; --secondary: #FFF0ED; --light: #F8F9FA; --dark: #000B1C; }
        body { font-family: 'Cairo', sans-serif; background-color: #f7f9fc; font-size: 0.9rem; }
        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }
        .main-content { margin-right: 260px; padding: 1.5rem; min-height: 100vh; transition: all 0.3s; }
        @media (max-width: 991.98px) { .main-content { margin-right: 0; } }
        .settings-card {
            background: #fff; border-radius: 1.5rem; padding: 2rem;
            border: 1px solid rgba(0,0,0,0.05); margin-bottom: 1.5rem;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.03);
        }
        .settings-card h5 { font-weight: 800; margin-bottom: 1.5rem; }
        .settings-card h5 i { color: var(--primary); margin-left: 0.5rem; }
    </style>
</head>
<body class="bg-light">
    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none position-fixed top-0 start-0 m-3 z-3" id="sidebarCollapse">
        <i class="fas fa-bars fs-5"></i>
    </button>
    <%- include('./_supervisor_sidebar.ejs', { currentPage: 'settings', user: user }) %>

    <div class="main-content">
        <div class="px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div>
                    <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">الإعدادات</h4>
                    <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Profile & Security Settings</small>
                </div>
            </div>
        </div>

        <div class="row g-4 animate__animated animate__fadeInUp">
            <!-- Profile Settings -->
            <div class="col-lg-6">
                <div class="settings-card">
                    <h5><i class="fas fa-user-edit"></i> البيانات الشخصية</h5>
                    <form id="profileForm">
                        <div class="mb-3">
                            <label class="small text-muted fw-bold mb-1">الاسم الكامل</label>
                            <input type="text" id="profileName" value="<%= user.name %>" required 
                                class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted fw-bold mb-1">البريد الإلكتروني</label>
                            <input type="email" value="<%= user.email %>" disabled 
                                class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold text-muted" style="font-size: 0.85rem;">
                            <small class="text-muted" style="font-size: 0.7rem;">لا يمكن تغيير البريد الإلكتروني</small>
                        </div>
                        <div class="mb-4">
                            <label class="small text-muted fw-bold mb-1">رقم الجوال</label>
                            <input type="tel" id="profilePhone" value="<%= user.phone_number || '' %>" dir="ltr" 
                                class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold text-end" style="font-size: 0.85rem;">
                        </div>
                        <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold py-2">
                            <i class="fas fa-save me-1"></i> حفظ التعديلات
                        </button>
                    </form>
                </div>
            </div>

            <!-- Password Change -->
            <div class="col-lg-6">
                <div class="settings-card">
                    <h5><i class="fas fa-shield-alt"></i> تغيير كلمة المرور</h5>
                    <form id="passwordForm">
                        <div class="mb-3">
                            <label class="small text-muted fw-bold mb-1">كلمة المرور الحالية</label>
                            <div class="position-relative">
                                <input type="password" id="currentPassword" required 
                                    class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted" 
                                    onclick="togglePassword('currentPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted fw-bold mb-1">كلمة المرور الجديدة</label>
                            <div class="position-relative">
                                <input type="password" id="newPassword" required minlength="6"
                                    class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted" 
                                    onclick="togglePassword('newPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <small class="text-muted" style="font-size: 0.7rem;">يجب أن تكون 6 أحرف على الأقل</small>
                        </div>
                        <div class="mb-4">
                            <label class="small text-muted fw-bold mb-1">تأكيد كلمة المرور الجديدة</label>
                            <div class="position-relative">
                                <input type="password" id="confirmPassword" required minlength="6"
                                    class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                                <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted" 
                                    onclick="togglePassword('confirmPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-danger rounded-pill w-100 fw-bold py-2">
                            <i class="fas fa-key me-1"></i> تغيير كلمة المرور
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Account Info Card -->
        <div class="settings-card animate__animated animate__fadeInUp">
            <h5><i class="fas fa-info-circle"></i> معلومات الحساب</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="bg-light rounded-3 p-3 text-center">
                        <small class="text-muted d-block mb-1">الدور</small>
                        <span class="badge bg-primary rounded-pill px-3 py-2">مشرف</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-light rounded-3 p-3 text-center">
                        <small class="text-muted d-block mb-1">البريد الإلكتروني</small>
                        <span class="fw-bold small outfit-font"><%= user.email %></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-light rounded-3 p-3 text-center">
                        <small class="text-muted d-block mb-1">تاريخ الإنضمام</small>
                        <span class="fw-bold small outfit-font"><%= new Date(user.createdAt).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                    </div>
                </div>
            </div>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية <%= new Date().getFullYear() %> - جميع الحقوق محفوظة</small>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        // Update Profile
        document.getElementById('profileForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            try {
                const response = await fetch('/supervisor/settings/update-profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: document.getElementById('profileName').value,
                        phone_number: document.getElementById('profilePhone').value
                    })
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire({ title: 'تم!', text: data.message, icon: 'success', customClass: { popup: 'rounded-4' } })
                    .then(() => location.reload());
                } else {
                    Swal.fire('خطأ', data.message, 'error');
                }
            } catch (err) {
                Swal.fire('خطأ', 'فشل الاتصال بالسيرفر', 'error');
            }
        });

        // Change Password
        document.getElementById('passwordForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (newPassword !== confirmPassword) {
                return Swal.fire('خطأ', 'كلمة المرور الجديدة وتأكيدها غير متطابقين', 'error');
            }

            try {
                const response = await fetch('/supervisor/settings/update-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        currentPassword: document.getElementById('currentPassword').value,
                        newPassword: newPassword,
                        confirmPassword: confirmPassword
                    })
                });
                const data = await response.json();
                if (data.success) {
                    Swal.fire({ title: 'تم!', text: data.message, icon: 'success', customClass: { popup: 'rounded-4' } });
                    document.getElementById('passwordForm').reset();
                } else {
                    Swal.fire('خطأ', data.message, 'error');
                }
            } catch (err) {
                Swal.fire('خطأ', 'فشل الاتصال بالسيرفر', 'error');
            }
        });
    </script>
</body>
</html>
