<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8">
    <title>كيدر - إدارة الدورات التدريبية</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .filter-section {
            background: #fff;
            padding: 1.25rem;
            border-radius: 1.25rem;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.03);
            margin-bottom: 2rem;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .course-admin-card {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: all 0.3s;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .course-admin-card:hover { 
            transform: translateY(-5px); 
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.1);
        }

        .course-img-wrapper {
            position: relative;
            height: 180px;
            overflow: hidden;
        }

        .course-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

        .course-admin-card:hover .course-img-wrapper img {
            transform: scale(1.1);
        }

        .status-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            z-index: 10;
        }

        .card-price {
            position: absolute;
            bottom: 1rem;
            left: 1rem;
            background: rgba(254, 93, 55, 0.95);
            color: #fff;
            padding: 0.3rem 0.8rem;
            border-radius: 0.75rem;
            font-weight: 800;
            font-size: 0.85rem;
            box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.3);
        }

        .btn-action {
            padding: 0.4rem 0.8rem;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            border: none;
            font-size: 0.75rem;
            font-weight: 700;
            gap: 0.5rem;
            text-decoration: none;
        }

        .btn-edit { background-color: var(--secondary); color: var(--primary); }
        .btn-edit:hover { background-color: var(--primary); color: #fff; }
        
        .btn-delete { background-color: #fff5f5; color: #ff4d4d; }
        .btn-delete:hover { background-color: #ff4d4d; color: #fff; }

        .search-input-group {
            background: #f8f9fa;
            border-radius: 0.75rem;
            padding: 0.25rem 0.5rem;
            display: flex;
            align-items: center;
            border: 1px solid #eee;
        }

        .search-input-group input {
            border: none;
            background: transparent;
            padding: 0.5rem;
            font-size: 0.85rem;
            outline: none;
            width: 100%;
        }

    </style>
</head>

<body>
    <%- include('./_admin_sidebar.ejs', { currentPage: 'courses', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;"><%= title %></h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Manage academy curriculum</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <a href="/addCourse" class="btn btn-primary rounded-pill px-2 fw-bold shadow-sm">
                        <i class="fas fa-plus-circle me-1"></i> إضافة دورة جديدة
                    </a>
                    
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-light rounded-circle p-2 text-danger" title="تسجيل الخروج">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filters Section -->
        <div class="filter-section animate__animated animate__fadeInUp">
            <div class="row g-3">
                <div class="col-md-5">
                    <div class="search-input-group">
                        <i class="fas fa-search text-muted ms-2 ps-2 border-start"></i>
                        <input type="text" placeholder="بحث عن دورة أو معلم...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select border-0 bg-light rounded-pill px-4 outfit-font fw-600" style="font-size: 0.8rem;">
                        <option>جميع التصنيفات</option>
                        <option>برمجة</option>
                        <option>تسويق</option>
                        <option>تصميم</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select border-0 bg-light rounded-pill px-4 outfit-font fw-600" style="font-size: 0.8rem;">
                        <option>الحالة: الكل</option>
                        <option>منشور</option>
                        <option>مسودة</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Courses Grid -->
        <div class="row g-4 animate__animated animate__fadeInUp">
            <% if (courses && courses.length > 0) { %>
                <% courses.forEach(course => { %>
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="course-admin-card">
                            <div class="course-img-wrapper">
                                <% if (course.isPublished) { %>
                                    <span class="badge rounded-pill bg-success status-badge fw-800 px-3 py-2" style="font-size: 0.65rem;">منشور</span>
                                <% } else { %>
                                    <span class="badge rounded-pill bg-secondary status-badge fw-800 px-3 py-2" style="font-size: 0.65rem;">مسودة</span>
                                <% } %>
                                
                                <img src="<%= course.coverImage %>" alt="Course Cover">
                                <div class="card-price outfit-font">$<%= course.price ? course.price.toFixed(2) : '0.00' %></div>
                            </div>

                            <div class="p-4 flex-grow-1 d-flex flex-column">
                                <div class="mb-2">
                                    <small class="text-primary fw-bold outfit-font text-uppercase" style="font-size: 0.65rem; letter-spacing: 1px;">
                                        <%= course.category ? course.category.name : 'Uncategorized' %>
                                    </small>
                                    <h5 class="fw-bold text-dark mt-1 line-clamp-1"><%= course.title %></h5>
                                </div>
                                
                                <p class="text-muted line-clamp-2 mb-4" style="min-height: 2.5rem; font-size: 0.75rem;">
                                    <%= course.description.slice(0, 250) %><%= course.description.length > 250 ? '...' : '' %>
                                </p>
                                
                                <div class="mt-auto pt-3 border-top">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="d-flex gap-3">
                                            <div class="d-flex align-items-center text-muted" style="font-size: 0.75rem;">
                                                <i class="fas fa-users text-primary me-2"></i>
                                                <span class="outfit-font fw-bold"><%= course.studentsCount || 0 %></span>
                                            </div>
                                            <div class="d-flex align-items-center text-muted" style="font-size: 0.75rem;">
                                                <i class="fas fa-star text-warning me-2"></i>
                                                <span class="outfit-font fw-bold"><%= course.averageRating || '-' %></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a href="/course/<%= course._id %>" class="btn-action btn-edit flex-grow-1">
                                            <i class="fas fa-pencil-alt"></i>
                                            <span>تعديل</span>
                                        </a>
                                        <button onclick="showDeleteModal('<%= course._id %>', '<%= course.title %>')" class="btn-action btn-delete" style="width: 40px;">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <div class="bg-white rounded-5 p-5 shadow-sm border border-light">
                        <i class="fa fa-inbox display-1 text-muted opacity-25 mb-4"></i>
                        <h4 class="fw-bold">لا توجد دورات تدريبية حالياً</h4>
                        <p class="text-muted">ابدأ بإثراء المحتوى التعليمي وإضافة دورتك الأولى اليوم.</p>
                        <a href="/addCourse" class="btn btn-primary rounded-pill px-4 mt-3 fw-bold">إضافة أول دورة</a>
                    </div>
                </div>
            <% } %>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة كيدر التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>

    <!-- Bootstrap Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-5 text-center">
                    <div class="bg-danger bg-opacity-10 text-danger mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; border-radius: 40px; font-size: 2rem;">
                        <i class="fa fa-exclamation-triangle"></i>
                    </div>
                    <h4 class="fw-bold mb-3">تأكيد الحذف</h4>
                    <p class="text-muted mb-4">هل أنت متأكد من حذف الدورة <strong id="courseTitleToDelete" class="text-danger">""</strong>؟ لا يمكن التراجع عن هذا الإجراء.</p>
                    <input type="hidden" id="courseIdToDelete">
                    <div class="d-flex gap-3">
                        <button class="btn btn-light rounded-pill flex-grow-1 fw-bold" data-bs-dismiss="modal">إلغاء</button>
                        <button onclick="confirmDeletion()" id="confirmDeleteBtn" class="btn btn-danger rounded-pill flex-grow-1 fw-bold d-flex align-items-center justify-content-center">
                            تأكيد الحذف
                            <span id="deleteSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-4" style="z-index: 1050"></div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>

        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const courseIdInput = document.getElementById('courseIdToDelete');
        const courseTitleDisplay = document.getElementById('courseTitleToDelete');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const deleteSpinner = document.getElementById('deleteSpinner');

        function showDeleteModal(id, title) {
            courseIdInput.value = id;
            courseTitleDisplay.textContent = title;
            deleteModal.show();
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            let bgClass = 'bg-primary';
            if (type === 'success') bgClass = 'bg-success';
            if (type === 'error') bgClass = 'bg-danger';

            const toastElem = document.createElement('div');
            toastElem.className = `toast align-items-center text-white ${bgClass} border-0 mb-3 animate__animated animate__slideInRight`;
            toastElem.setAttribute('role', 'alert');
            toastElem.setAttribute('aria-live', 'assertive');
            toastElem.setAttribute('aria-atomic', 'true');
            toastElem.innerHTML = `
                <div class="d-flex p-2">
                    <div class="toast-body fw-bold">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>`;
            container.appendChild(toastElem);
            const bsToast = new bootstrap.Toast(toastElem);
            bsToast.show();
            toastElem.addEventListener('hidden.bs.toast', () => toastElem.remove());
        }

        async function confirmDeletion() {
            const courseId = courseIdInput.value;
            confirmDeleteBtn.disabled = true;
            deleteSpinner.classList.remove('d-none');

            try {
                const response = await fetch(`/course/${courseId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message || 'فشل في حذف الدورة.');
                }

                deleteModal.hide();
                showToast(data.message || 'تم حذف الدورة بنجاح.', 'success');

                setTimeout(() => {
                    window.location.reload();
                }, 800);

            } catch (error) {
                showToast("خطأ: " + error.message, 'error');
                confirmDeleteBtn.disabled = false;
                deleteSpinner.classList.add('d-none');
            }
        }
    </script>
</body>

</html>