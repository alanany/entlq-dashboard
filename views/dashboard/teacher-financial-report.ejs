<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>التقرير المالي | <%= teacher.name %></title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        body { font-family: 'Tajawal', sans-serif; scroll-behavior: smooth; }
        .accordion-content { max-height: 0; overflow: hidden; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); opacity: 0; }
        .accordion-content.open { max-height: 2000px; opacity: 1; padding-bottom: 2rem; }
        .rotate-180 { transform: rotate(180deg); }
    </style>
</head>
<body class="bg-slate-50 text-right">

    <header class="bg-white/90 backdrop-blur-md border-b p-6 flex justify-between items-center sticky top-0 z-50 shadow-sm">
        <div class="flex items-center gap-4">
            <button onclick="history.back()" class="p-3 bg-gray-100 rounded-2xl hover:bg-indigo-600 hover:text-white transition-all">
                <i data-feather="arrow-right" class="w-5 h-5"></i>
            </button>
            <div>
                <h1 class="text-xl font-black text-gray-800 tracking-tight">التقرير المالي: <%= teacher.name %></h1>
                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">سعر الساعة: <%= teacher.hour_rate %> ر.س</p>
            </div>
        </div>
    </header>

    <main class="p-6 max-w-7xl mx-auto space-y-12">

        <div class="space-y-6">
            <div class="flex items-center gap-2 px-2">
                <div class="w-2 h-6 bg-indigo-600 rounded-full"></div>
                <h3 class="font-black text-gray-800 text-xl tracking-tight">المستحقات المعلقة (بانتظار الصرف)</h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-indigo-600 rounded-[2.5rem] p-8 text-white shadow-2xl shadow-indigo-100 relative overflow-hidden group">
                    <p class="text-indigo-100 text-xs font-bold uppercase mb-2 tracking-widest">إجمالي المبلغ المعلق</p>
                    <h2 class="text-4xl font-black tracking-tighter"><%= totalUnpaid %> <span class="text-lg opacity-70 font-medium">ر.س</span></h2>
                    <i data-feather="clock" class="absolute -bottom-2 -left-2 w-20 h-20 opacity-10"></i>
                </div>

                <% Object.keys(monthlyStats).forEach(key => { 
                    const stat = monthlyStats[key]; 
                %>
                <div class="bg-white rounded-[2.5rem] p-8 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300">
                    <div class="flex justify-between items-start mb-4">
                        <p class="text-gray-400 text-[10px] font-black uppercase tracking-widest">أرباح شهر <%= stat.monthName %></p>
                        <span class="bg-indigo-50 text-indigo-600 text-[10px] px-3 py-1 rounded-full font-black"><%= stat.count %> حصة</span>
                    </div>
                    <h2 class="text-3xl font-black text-gray-800 mb-6 tracking-tighter"><%= stat.total.toFixed(2) %> <span class="text-sm font-normal text-gray-400">ر.س</span></h2>
                    
                    <button onclick="paySalary('<%= teacher._id %>', '<%= stat.key %>', '<%= stat.total.toFixed(2) %>')" 
                            class="w-full bg-slate-900 text-white py-4 rounded-2xl text-[11px] font-black hover:bg-indigo-600 transition-all flex items-center justify-center gap-2 shadow-lg shadow-slate-100">
                        <i data-feather="credit-card" class="w-4 h-4"></i> تأكيد دفع المرتب
                    </button>
                </div>
                <% }) %>
            </div>
        </div>

        <div class="space-y-6">
            <div class="flex items-center gap-2 px-2">
                <div class="w-2 h-6 bg-green-500 rounded-full"></div>
                <h3 class="font-black text-gray-800 text-xl tracking-tight">سجل المدفوعات السابقة (الأرشيف)</h3>
            </div>

            <div class="space-y-4">
                <% Object.keys(paidSessionsGrouped).reverse().forEach((key, index) => { 
                    const monthData = paidSessionsGrouped[key];
                %>
                <div class="bg-white border border-gray-100 rounded-[2.5rem] shadow-sm overflow-hidden transition-all duration-300 hover:border-green-200">
                    <button onclick="toggleAccordion('content-<%= index %>', 'icon-<%= index %>')" 
                            class="w-full p-7 flex justify-between items-center hover:bg-gray-50/50 transition-colors group">
                        
                        <div class="flex items-center gap-5">
                            <div class="bg-green-100 text-green-600 p-4 rounded-2xl group-hover:bg-green-600 group-hover:text-white transition-all">
                                <i data-feather="shield" class="w-5 h-5"></i>
                            </div>
                            <div class="text-right">
                                <h4 class="font-black text-gray-800 text-lg tracking-tight flex items-center gap-3">
                                    شهر <%= monthData.name %>
                                    <span class="bg-green-600 text-white text-[10px] px-4 py-1.5 rounded-full font-bold shadow-sm">
                                         تم دفع: <%= monthData.totalPaidInMonth.toFixed(2) %> ر.س
                                    </span>
                                </h4>
                                <p class="text-[10px] text-gray-400 font-bold tracking-widest uppercase mt-1">إجمالي الحصص المسددة: <%= monthData.sessions.length %></p>
                            </div>
                        </div>
                        
                        <div class="flex items-center gap-4">
                            <span class="text-[10px] font-black text-gray-300 group-hover:text-green-600 transition-colors uppercase tracking-widest">التفاصيل</span>
                            <i data-feather="chevron-down" id="icon-<%= index %>" class="text-gray-300 transition-transform duration-500"></i>
                        </div>
                    </button>

                    <div id="content-<%= index %>" class="accordion-content">
                        <div class="px-7 pt-0">
                            <div class="overflow-x-auto border-t border-gray-50 pt-6">
                                <table class="w-full text-right">
                                    <thead>
                                        <tr class="text-[10px] font-black text-gray-300 uppercase tracking-widest">
                                            <th class="pb-4">تاريخ الحصة</th>
                                            <th class="pb-4">اسم الطالب</th>
                                            <th class="pb-4">الكورس</th>
                                            <th class="pb-4 text-center">المبلغ</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-50">
                                        <% monthData.sessions.forEach(s => { %>
                                        <tr class="group/row">
                                            <td class="py-4 text-gray-500 font-bold text-sm"><%= new Date(s.date).toLocaleDateString('ar-EG') %></td>
                                            <td class="py-4 font-black text-gray-700 text-sm"><%= s.studentName %></td>
                                            <td class="py-4 text-gray-400 text-xs italic"><%= s.courseTitle %></td>
                                            <td class="py-4 text-center font-black text-green-600 text-sm">
                                                <%= s.price %> <span class="text-[10px] opacity-50 font-normal">ر.س</span>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>

                <% if (Object.keys(paidSessionsGrouped).length === 0) { %>
                    <div class="p-20 text-center bg-white rounded-[3rem] border-2 border-dashed border-gray-100 flex flex-col items-center justify-center">
                        <i data-feather="inbox" class="w-12 h-12 text-gray-200 mb-4"></i>
                        <p class="text-gray-400 font-bold">لا يوجد سجل مدفوعات سابق للمعلم</p>
                    </div>
                <% } %>
            </div>
        </div>
    </main>

    <script>
        feather.replace();

        // منطق الأكورديون
        function toggleAccordion(contentId, iconId) {
            const content = document.getElementById(contentId);
            const icon = document.getElementById(iconId);
            content.classList.toggle('open');
            icon.classList.toggle('rotate-180');
        }

        // منطق الدفع
        async function paySalary(teacherId, monthKey, amount) {
            const { value: confirm } = await Swal.fire({
                title: 'تأكيد عملية الدفع',
                text: `هل تم تحويل مبلغ ${amount} ر.س للأستاذ/ة بنجاح؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#f43f5e',
                confirmButtonText: 'نعم، سجل الدفع الآن',
                cancelButtonText: 'إلغاء'
            });

            if (confirm) {
                try {
                    const response = await fetch(`/admin/teacher/pay-salary`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ teacherId, monthKey: monthKey, amount })
                    });

                    if (response.ok) {
                        Swal.fire({
                            title: 'تم بنجاح!',
                            text: 'تمت أرشفة الحصص وتحديث التقرير المالي',
                            icon: 'success',
                            showConfirmButton: false,
                            timer: 2000
                        });
                        setTimeout(() => location.reload(), 2000);
                    } else {
                        Swal.fire('خطأ', 'حدثت مشكلة أثناء تسجيل الدفع', 'error');
                    }
                } catch (error) {
                    console.error(error);
                    Swal.fire('خطأ اتصال', 'السيرفر لا يستجيب', 'error');
                }
            }
        }
    </script>
</body>
</html>