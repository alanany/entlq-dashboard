<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - التقرير المالي | <%= teacher.name %></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .card-stats {
            background: #fff;
            border-radius: 1.5rem;
            padding: 1.5rem;
            border: 1px solid #f1f1f1;
            transition: all 0.3s;
        }

        .card-stats:hover { 
            transform: translateY(-3px); 
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.08); 
        }

        .accordion-item {
            border: 1px solid #f1f1f1;
            border-radius: 1.5rem !important;
            margin-bottom: 1rem;
            overflow: hidden;
        }

        .accordion-button {
            background-color: #fff;
            font-weight: 700;
            padding: 1.25rem 1.5rem;
            border-radius: 1.5rem !important;
        }

        .accordion-button:not(.collapsed) {
            background-color: #f8f9fa;
            color: var(--primary);
            box-shadow: none;
        }

        .accordion-button:focus {
            box-shadow: none;
            border-color: transparent;
        }

        .accordion-button::after {
            background-size: 1rem;
        }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.7rem;
            text-transform: uppercase;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.85rem;
        }

        .pending-card {
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            border-radius: 2rem;
            padding: 2rem;
            color: white;
            position: relative;
            overflow: hidden;
        }

        .pending-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            border-radius: 50%;
        }

        .month-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 1.5rem;
            padding: 1.5rem;
            transition: all 0.3s;
        }

        .month-card:hover {
            border-color: var(--primary);
            box-shadow: 0 0.5rem 1.5rem rgba(254, 93, 55, 0.1);
        }
    </style>
</head>
<body class="bg-light">
    <%- include('./_admin_sidebar.ejs', { currentPage: 'teachers', user: user }) %>

    <div class="main-content">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-2" id="sidebarCollapse">
                    <i class="fas fa-bars"></i>
                </button>
                <a href="/admin/teacher/<%= teacher._id %>" class="btn btn-light rounded-circle p-2">
                    <i class="fas fa-arrow-right"></i>
                </a>
                <div>
                    <h4 class="mb-0 fw-bold text-dark">التقرير المالي: <%= teacher.name %></h4>
                    <p class="mb-0 small text-muted">
                        <i class="fas fa-money-bill-wave me-1"></i>
                        أسعار الساعة: 
                        <% if (teacher.hourly_rates && teacher.hourly_rates.length > 0) { %>
                            <% teacher.hourly_rates.forEach((r, idx) => { %>
                                <span class="fw-bold text-primary"><%= r.label %>: <%= formatCurrency(r.rate) %></span><%= idx < teacher.hourly_rates.length - 1 ? ' | ' : '' %>
                            <% }) %>
                        <% } else { %>
                            <span class="fw-bold text-primary"><%= formatCurrency(teacher.hour_rate || 0) %></span>
                        <% } %>
                    </p>
                </div>
            </div>
            <div>
                <a href="/admin/teacher/<%= teacher._id %>" class="btn btn-light rounded-3 px-3">
                    <i class="fas fa-user me-2"></i> صفحة المعلم
                </a>
            </div>
        </div>

        <!-- Pending Payments Section -->
        <div class="mb-5">
            <div class="d-flex align-items-center gap-2 mb-4">
                <div class="bg-primary rounded-pill" style="width: 5px; height: 25px;"></div>
                <h5 class="fw-bold text-dark mb-0">المستحقات المعلقة (بانتظار الصرف)</h5>
            </div>

            <div class="row g-4">
                <!-- Total Pending Card -->
                <div class="col-md-4">
                    <div class="pending-card h-100">
                        <div class="position-relative">
                            <p class="small opacity-75 mb-2 text-uppercase fw-bold" style="letter-spacing: 2px;">إجمالي المبلغ المعلق</p>
                            <h2 class="display-5 fw-bold mb-0 outfit-font"><%= formatCurrency(totalUnpaid) %></h2>
                            <div class="mt-3 d-flex align-items-center gap-2">
                                <i class="fas fa-clock opacity-50"></i>
                                <span class="small opacity-75">في انتظار المراجعة والدفع</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Monthly Pending Cards -->
                <% Object.keys(monthlyStats).forEach(key => { 
                    const stat = monthlyStats[key]; 
                %>
                <div class="col-md-4">
                    <div class="month-card h-100">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <p class="small text-muted text-uppercase fw-bold mb-1" style="letter-spacing: 1px;">أرباح شهر <%= stat.monthName %></p>
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">
                                    <i class="fas fa-book-open me-1"></i> <%= stat.count %> حصة
                                </span>
                            </div>
                            <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2">
                                <i class="fas fa-hourglass-half"></i>
                            </div>
                        </div>
                        
                        <h3 class="fw-bold text-dark mb-4 outfit-font"><%= formatCurrency(stat.total) %></h3>
                        
                        <button onclick="paySalary('<%= teacher._id %>', '<%= stat.key %>', '<%= stat.total.toFixed(2) %>')" 
                                class="btn btn-dark w-100 rounded-3 py-2 fw-bold">
                            <i class="fas fa-credit-card me-2"></i> تأكيد دفع المرتب
                        </button>
                    </div>
                </div>
                <% }) %>

                <% if (Object.keys(monthlyStats).length === 0) { %>
                <div class="col-md-8">
                    <div class="bg-light rounded-4 p-5 text-center border border-dashed">
                        <i class="fas fa-check-circle fa-3x text-success opacity-50 mb-3"></i>
                        <h5 class="text-muted">لا توجد مستحقات معلقة</h5>
                        <p class="small text-muted mb-0">جميع الحصص المكتملة تم تسويتها</p>
                    </div>
                </div>
                <% } %>
            </div>
        </div>

        <!-- Paid Sessions Archive -->
        <div class="mb-4">
            <div class="d-flex align-items-center gap-2 mb-4">
                <div class="bg-success rounded-pill" style="width: 5px; height: 25px;"></div>
                <h5 class="fw-bold text-dark mb-0">سجل المدفوعات السابقة (الأرشيف)</h5>
            </div>

            <% if (Object.keys(paidSessionsGrouped).length === 0) { %>
                <div class="bg-white rounded-4 p-5 text-center border">
                    <i class="fas fa-inbox fa-3x text-muted opacity-25 mb-3"></i>
                    <h5 class="text-muted">لا يوجد سجل مدفوعات سابق</h5>
                    <p class="small text-muted mb-0">سيظهر هنا سجل المدفوعات بعد تسجيل أول عملية دفع</p>
                </div>
            <% } else { %>
                <div class="accordion" id="paymentsAccordion">
                    <% Object.keys(paidSessionsGrouped).reverse().forEach((key, index) => { 
                        const monthData = paidSessionsGrouped[key];
                    %>
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button <%= index !== 0 ? 'collapsed' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>">
                                <div class="d-flex align-items-center gap-3 w-100">
                                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-2">
                                        <i class="fas fa-shield-alt"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <span class="fw-bold">شهر <%= monthData.name %></span>
                                        <span class="badge bg-success rounded-pill ms-2">
                                            تم الدفع: <%= formatCurrency(monthData.totalPaidInMonth) %>
                                        </span>
                                    </div>
                                    <span class="small text-muted me-3">
                                        <i class="fas fa-book-open me-1"></i> <%= monthData.sessions.length %> حصة
                                    </span>
                                </div>
                            </button>
                        </h2>
                        <div id="collapse<%= index %>" class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>" data-bs-parent="#paymentsAccordion">
                            <div class="accordion-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-custom mb-0 text-end">
                                        <thead>
                                            <tr>
                                                <th class="px-4">تاريخ الحصة</th>
                                                <th>اسم الطالب</th>
                                                <th>الكورس</th>
                                                <th class="text-center">المبلغ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% monthData.sessions.forEach(s => { %>
                                            <tr>
                                                <td class="px-4 text-muted"><%= new Date(s.date).toLocaleDateString('ar-EG') %></td>
                                                <td class="fw-bold text-dark"><%= s.studentName %></td>
                                                <td class="text-muted small"><%= s.courseTitle %></td>
                                                <td class="text-center fw-bold text-success">
                                                    <%= formatCurrency(s.price) %>
                                                </td>
                                            </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية 2024</small>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        async function paySalary(teacherId, monthKey, amount) {
            const result = await Swal.fire({
                title: 'تأكيد عملية الدفع',
                html: `<p class="mb-2">هل تم تحويل مبلغ <strong class="text-primary">${amount} <%= currencySymbol %></strong> للأستاذ/ة بنجاح؟</p>
                       <p class="small text-muted">سيتم تسجيل هذه العملية وأرشفة الحصص المرتبطة</p>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#4f46e5',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-check me-2"></i> نعم، سجل الدفع',
                cancelButtonText: 'إلغاء',
                reverseButtons: true
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch('/admin/teacher/pay-salary', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ teacherId, monthKey, amount })
                    });

                    if (response.ok) {
                        Swal.fire({
                            title: 'تم بنجاح!',
                            text: 'تم تسجيل الدفع وأرشفة الحصص',
                            icon: 'success',
                            showConfirmButton: false,
                            timer: 2000
                        });
                        setTimeout(() => location.reload(), 2000);
                    } else {
                        Swal.fire('خطأ', 'حدثت مشكلة أثناء تسجيل الدفع', 'error');
                    }
                } catch (error) {
                    console.error(error);
                    Swal.fire('خطأ في الاتصال', 'تعذر الاتصال بالسيرفر', 'error');
                }
            }
        }
    </script>
</body>
</html>