<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - إدارة الأقسام</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.8rem;
        }

        .spinner {
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top: 2px solid #fff;
            border-radius: 50%;
            width: 1rem;
            height: 1rem;
            animation: spin 1s linear infinite;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-light">
    <%- include('./_admin_sidebar.ejs', { currentPage: 'settings', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h2 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">إدارة الأقسام</h2>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Course categories management</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-light rounded-circle p-2 text-danger" title="تسجيل الخروج">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    
        <div class="row g-4 animate__animated animate__fadeInUp">
            <div class="col-lg-4">
                <div class="bg-white p-4 rounded-4 shadow-sm border border-light">
                    <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">إضافة قسم جديد</h5>
                    <form id="addCategoryForm" onsubmit="handleAddCategory(event)">
                        <div class="mb-3">
                            <label for="categoryName" class="small text-muted mb-1 d-block">اسم القسم</label>
                            <input type="text" id="categoryName" name="name" required class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;" placeholder="مثال: تطوير الويب">
                        </div>
                        <button id="addBtn" type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2 shadow-sm d-flex align-items-center justify-content-center">
                            إضافة
                            <div id="addSpinner" class="spinner ms-2 d-none"></div>
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden">
                    <div class="p-4 border-bottom">
                        <h5 class="fw-bold text-dark mb-0">الأقسام الحالية</h5>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-custom mb-0 text-end">
                            <thead>
                                <tr>
                                    <th class="px-4 py-3">الاسم</th>
                                    <th class="px-4 py-3 text-center">عدد الدورات</th>
                                    <th class="px-4 py-3 text-start">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody id="categoriesTableBody" class="bg-white">
                                <% if (categories && categories.length > 0) { %>
                                    <% categories.forEach(category => { %>
                                    <tr id="category-<%= category._id %>">
                                        <td class="px-4 py-3 fw-bold text-dark"><%= category.name %></td>
                                        <td class="px-4 py-3 text-center text-muted"><%= category.courseCount || 0 %></td>
                                        <td class="px-4 py-3">
                                            <button onclick="showDeleteModal('<%= category._id %>', '<%= category.name %>')" class="btn btn-light btn-sm rounded-3 text-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="3" class="px-4 py-5 text-center text-muted">لا توجد أقسام مضافة بعد.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        
        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>
    
    <!-- Delete Modal (Bootstrap Style) -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-4 text-center">
                    <div class="bg-danger bg-opacity-10 text-danger mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 30px; font-size: 1.5rem;">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <h5 class="fw-bold mb-3 text-dark">تأكيد الحذف</h5>
                    <p class="text-muted small mb-4">هل أنت متأكد من حذف القسم <strong id="categoryTitleToDelete" class="text-danger">""</strong>؟</p>
                    
                    <input type="hidden" id="categoryIdToDelete">

                    <div class="d-flex gap-2">
                        <button class="btn btn-light rounded-pill flex-grow-1" data-bs-dismiss="modal">إلغاء</button>
                        <button onclick="confirmDeletion()" id="confirmDeleteBtn" class="btn btn-danger rounded-pill flex-grow-1 fw-bold">حذف</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div id="toastContainer" class="fixed bottom-4 right-4 z-[70] space-y-3"></div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        const addBtn = document.getElementById('addBtn');
        const addSpinner = document.getElementById('addSpinner');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');
        const categoryIdInput = document.getElementById('categoryIdToDelete');
        const categoryTitleDisplay = document.getElementById('categoryTitleToDelete');

        const originalAddButtonText = 'إضافة';
        const originalDeleteButtonText = 'حذف';

        function showToast(message, type = 'info', duration = 4000) {
            Swal.fire({
                text: message,
                icon: type,
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: duration
            });
        }

        function startLoading(btn, spinner, text) {
            btn.disabled = true;
            spinner.classList.remove('d-none');
            btn.innerHTML = `جاري... ${spinner.outerHTML}`;
        }

        function stopLoading(btn, spinner, text) {
            btn.disabled = false;
            spinner.classList.add('d-none');
            btn.innerHTML = text;
        }

        function showDeleteModal(id, title) {
            categoryIdInput.value = id;
            categoryTitleDisplay.textContent = title;
            deleteModal.show();
        }

        function closeModal() {
            deleteModal.hide();
        }

        async function handleAddCategory(event) {
            event.preventDefault();
            const form = event.target;
            const categoryName = form.name.value.trim();
            if (!categoryName) return;

            startLoading(addBtn, addSpinner, originalAddButtonText);

            try {
                const response = await fetch('/create-category', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: categoryName })
                });

                const data = await response.json();

                if (!response.ok) throw new Error(data.message || 'فشل في إضافة القسم.');

                appendNewCategoryRow(data.category);
                showToast(`تم إضافة القسم "${data.category.name}" بنجاح.`, 'success');
                form.reset();

            } catch (error) {
                showToast(error.message || 'حدث خطأ أثناء إضافة القسم.', 'error');
            } finally {
                stopLoading(addBtn, addSpinner, originalAddButtonText);
            }
        }
        
        function appendNewCategoryRow(category) {
            const tbody = document.getElementById('categoriesTableBody');
            const emptyRow = tbody.querySelector('td[colspan="3"]');
            if (emptyRow) emptyRow.closest('tr').remove();
            
            const newRowHtml = `
                <tr id="category-${category._id}">
                    <td class="px-4 py-3 fw-bold text-dark">${category.name}</td>
                    <td class="px-4 py-3 text-center text-muted">0</td>
                    <td class="px-4 py-3">
                        <button onclick="showDeleteModal('${category._id}', '${category.name}')" class="btn btn-light btn-sm rounded-3 text-danger">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
            tbody.insertAdjacentHTML('beforeend', newRowHtml);
        }

        async function confirmDeletion() {
            const categoryId = categoryIdInput.value;
            const originalText = confirmDeleteBtn.innerHTML;
            confirmDeleteBtn.disabled = true;
            confirmDeleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري...';

            try {
                const response = await fetch(`/category/${categoryId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });

                const data = await response.json();

                if (!response.ok) throw new Error(data.message || 'فشل في حذف القسم.');

                closeModal();
                showToast(data.message || 'تم حذف القسم بنجاح.', 'success');
                
                const rowToRemove = document.getElementById(`category-${categoryId}`);
                if (rowToRemove) {
                    rowToRemove.remove();
                    if (document.getElementById('categoriesTableBody').children.length === 0) {
                        document.getElementById('categoriesTableBody').innerHTML = '<tr><td colspan="3" class="px-4 py-5 text-center text-muted">لا توجد أقسام مضافة بعد.</td></tr>';
                    }
                }
            } catch (error) {
                showToast(error.message || 'حدث خطأ غير متوقع أثناء الحذف.', 'error');
            } finally {
                confirmDeleteBtn.disabled = false;
                confirmDeleteBtn.innerHTML = originalText;
            }
        }
    </script>
</body>
</html>