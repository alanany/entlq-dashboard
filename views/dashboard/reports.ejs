<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - التقارير المالية</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-stats {
            background: #fff;
            border-radius: 1.5rem;
            padding: 1.5rem;
            border: 1px solid #f1f1f1;
            transition: all 0.3s;
        }

        .card-stats:hover { transform: translateY(-5px); box-shadow: 0 1rem 2rem rgba(0,0,0,0.05); }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.8rem;
        }
    </style>
</head>
<body class="bg-light">
    <%- include('./_admin_sidebar.ejs', { currentPage: 'reports', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">التحليلات المالية</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Financial Overview & Analytics</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-light rounded-circle p-2 text-danger" title="تسجيل الخروج">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-4 mb-4 animate__animated animate__fadeInUp">
            <div class="col-md-3">
                <div class="card-stats bg-primary text-white border-0 shadow-sm" style="background: linear-gradient(135deg, var(--primary), #ff8a6c) !important;">
                    <p class="small opacity-75 mb-1 fw-bold">إجمالي الإيرادات</p>
                    <h3 class="fw-900 outfit-font mb-3"><%= stats.totalIncome %> ر.س</h3>
                    <div class=" bg-opacity-20 rounded-pill px-3 py-2 small fw-bold">
                        <i class="fas fa-arrow-up me-1"></i> الاشتراكات المدفوعة
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card-stats shadow-sm border-0">
                    <p class="small text-muted mb-1 fw-bold">إجمالي المصروفات</p>
                    <h3 class="fw-900 outfit-font text-danger mb-3"><%= stats.totalExpenses %> ر.س</h3>
                    <p class="small text-muted mb-0">رواتب المعلمين المدفوعة</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-stats shadow-sm border-0">
                    <p class="small text-muted mb-1 fw-bold">صافي الأرباح</p>
                    <h3 class="fw-900 outfit-font text-success mb-3"><%= stats.netProfit %> ر.س</h3>
                    <p class="small text-muted mb-0">الإيرادات - المصروفات</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card-stats shadow-sm border-0">
                    <p class="small text-muted mb-1 fw-bold">مستحقات المعلمين (معلقة)</p>
                    <h3 class="fw-900 outfit-font text-warning mb-3"><%= stats.pendingExpenses %> ر.س</h3>
                    <a href="/admin/teachers" class="btn btn-light btn-sm rounded-pill px-4 fw-bold text-primary">إدارة المدفوعات</a>
                </div>
            </div>
        </div>


        <!-- Transactions Table -->
        <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden animate__animated animate__fadeInUp">
            <div class="p-4 border-bottom">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">سجل المعاملات</h5>
                    <span class="badge bg-primary rounded-pill"><%= transactions.length %> معاملة</span>
                </div>
                
                <!-- Filter Form -->
                <form action="/admin/reports" method="GET" class="d-flex gap-3 flex-wrap align-items-end">
                    <div>
                        <label class="form-label small text-muted mb-1">الشهر</label>
                        <input type="month" name="month" value="<%= filters.month %>" class="form-control rounded-3" style="min-width: 150px;">
                    </div>
                    <div>
                        <label class="form-label small text-muted mb-1">النوع</label>
                        <select name="type" class="form-select rounded-3" style="min-width: 130px;">
                            <option value="">الكل</option>
                            <option value="income" <%= filters.type === 'income' ? 'selected' : '' %>>إيرادات</option>
                            <option value="expense" <%= filters.type === 'expense' ? 'selected' : '' %>>مصروفات</option>
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-3 px-4">
                            <i class="fas fa-filter me-1"></i> تصفية
                        </button>
                        <a href="/admin/reports" class="btn btn-outline-secondary rounded-3">
                            <i class="fas fa-redo"></i>
                        </a>
                    </div>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-custom mb-0 text-end">
                    <thead>
                        <tr>
                            <th class="px-4 py-3">رقم العملية</th>
                            <th class="px-4 py-3">النوع</th>
                            <th class="px-4 py-3">الوصف</th>
                            <th class="px-4 py-3 text-center">التاريخ</th>
                            <th class="px-4 py-3">المبلغ</th>
                            <th class="px-4 py-3 text-start">الحالة</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        <% if (transactions.length === 0) { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">لا توجد معاملات بعد</td>
                            </tr>
                        <% } else { %>
                            <% transactions.forEach((txn, index) => { %>
                                <tr>
                                    <td class="px-4 py-3 outfit-font text-muted">#TXN-<%= txn._id.toString().slice(-6).toUpperCase() %></td>
                                    <td class="px-4 py-3">
                                        <% if (txn.type === 'income') { %>
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">إيراد</span>
                                        <% } else { %>
                                            <span class="badge bg-danger bg-opacity-10 text-white rounded-pill px-3 py-2">مصروف</span>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3 fw-bold text-dark">
                                        <%= txn.description || (txn.category === 'subscription' ? 'اشتراك جديد' : (txn.category === 'salary' ? 'راتب معلم' : 'معاملة')) %>
                                        <% if (txn.teacherId && txn.teacherId.name) { %>
                                            <small class="text-muted d-block"><%= txn.teacherId.name %></small>
                                        <% } %>
                                        <% if (txn.fromUser && txn.fromUser.name) { %>
                                            <small class="text-muted d-block">من: <%= txn.fromUser.name %></small>
                                        <% } %>
                                    </td>
                                    <td class="px-4 py-3 text-center text-muted"><%= new Date(txn.createdAt).toLocaleDateString('ar-EG') %></td>
                                    <td class="px-4 py-3 fw-bold <%= txn.type === 'income' ? 'text-success' : 'text-danger' %>">
                                        <%= txn.type === 'income' ? '+' : '-' %><%= txn.amount.toFixed(2) %> ر.س
                                    </td>
                                    <td class="px-4 py-3">
                                        <% if (txn.status === 'completed') { %>
                                            <span class="badge bg-success bg-opacity-10 text-white rounded-pill px-3 py-2" style="font-size: 0.65rem;">مكتملة</span>
                                        <% } else if (txn.status === 'pending') { %>
                                            <span class="badge bg-warning bg-opacity-10 text-white rounded-pill px-3 py-2" style="font-size: 0.65rem;">معلقة</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary bg-opacity-10 text-white rounded-pill px-3 py-2" style="font-size: 0.65rem;"><%= txn.status %></span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>