<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - التقارير المالية</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-stats {
            background: #fff;
            border-radius: 1.5rem;
            padding: 1.5rem;
            border: 1px solid #f1f1f1;
            transition: all 0.3s;
        }

        .card-stats:hover { transform: translateY(-5px); box-shadow: 0 1rem 2rem rgba(0,0,0,0.05); }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.8rem;
        }
    </style>
</head>
<body class="bg-light">
    <%- include('./_admin_sidebar.ejs', { currentPage: 'reports', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h2 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">التحليلات المالية</h2>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Financial Overview & Analytics</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <select class="form-select border-0 bg-light rounded-pill px-4" style="max-width: 200px; font-size: 0.8rem;">
                        <option>هذا الشهر</option>
                        <option>آخر 3 أشهر</option>
                        <option>هذا العام</option>
                    </select>
                    
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-light rounded-circle p-2 text-danger" title="تسجيل الخروج">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="row g-4 mb-4 animate__animated animate__fadeInUp">
            <div class="col-md-4">
                <div class="card-stats bg-primary text-white border-0 shadow-sm" style="background: linear-gradient(135deg, var(--primary), #ff8a6c) !important;">
                    <p class="small opacity-75 mb-1 fw-bold">إجمالي المبيعات</p>
                    <h3 class="fw-900 outfit-font mb-3">$124,500.00</h3>
                    <div class="badge bg-white bg-opacity-20 rounded-pill px-3 py-2 small fw-bold">
                        <i class="fas fa-arrow-up me-1"></i> +15% عن الشهر الماضي
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card-stats shadow-sm border-0">
                    <p class="small text-muted mb-1 fw-bold">أرباح المنصة (الصافي)</p>
                    <h3 class="fw-900 outfit-font text-dark mb-3">$32,150.00</h3>
                    <p class="small text-muted mb-0">بعد خصم نسبة المدربين</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card-stats shadow-sm border-0">
                    <p class="small text-muted mb-1 fw-bold">مستحقات المدربين (للدفع)</p>
                    <h3 class="fw-900 outfit-font text-dark mb-3">$8,400.00</h3>
                    <button class="btn btn-light btn-sm rounded-pill px-4 fw-bold text-primary">إدارة المدفوعات</button>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="bg-white p-4 rounded-4 shadow-sm border border-light">
                    <h5 class="fw-bold text-dark mb-4">نمو الإيرادات</h5>
                    <div class="d-flex align-items-end justify-content-between gap-2 px-2 border-bottom border-light pb-2" style="height: 200px;">
                        <div class="flex-grow-1 bg-light rounded-top hover-bg-primary transition-colors position-relative group" style="height: 40%; background-color: #f1f1f1;"></div>
                        <div class="flex-grow-1 bg-light rounded-top hover-bg-primary transition-colors" style="height: 60%; background-color: #f1f1f1;"></div>
                        <div class="flex-grow-1 bg-light rounded-top hover-bg-primary transition-colors" style="height: 55%; background-color: #f1f1f1;"></div>
                        <div class="flex-grow-1 bg-light rounded-top hover-bg-primary transition-colors" style="height: 70%; background-color: #f1f1f1;"></div>
                        <div class="flex-grow-1 bg-light rounded-top hover-bg-primary transition-colors" style="height: 45%; background-color: #f1f1f1;"></div>
                        <div class="flex-grow-1 bg-light rounded-top hover-bg-primary transition-colors" style="height: 80%; background-color: #f1f1f1;"></div>
                        <div class="flex-grow-1 bg-primary rounded-top shadow" style="height: 90%;"></div>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mt-2 px-1 fw-bold">
                        <span>السبت</span><span>الأحد</span><span>الاثنين</span><span>الثلاثاء</span><span>الأربعاء</span><span>الخميس</span><span>الجمعة</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden animate__animated animate__fadeInUp">
            <div class="p-4 border-bottom">
                <h5 class="fw-bold text-dark mb-0">أحدث المعاملات</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-custom mb-0 text-end">
                    <thead>
                        <tr>
                            <th class="px-4 py-3">رقم العملية</th>
                            <th class="px-4 py-3">الطالب</th>
                            <th class="px-4 py-3 text-center">التاريخ</th>
                            <th class="px-4 py-3">المبلغ</th>
                            <th class="px-4 py-3 text-start">الحالة</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        <tr>
                            <td class="px-4 py-3 outfit-font text-muted">#TRX-9812</td>
                            <td class="px-4 py-3 fw-bold text-dark">سارة أحمد</td>
                            <td class="px-4 py-3 text-center text-muted">05/12/2025</td>
                            <td class="px-4 py-3 fw-bold text-success">+$49.00</td>
                            <td class="px-4 py-3"><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2" style="font-size: 0.65rem;">ناجحة</span></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 outfit-font text-muted">#TRX-9811</td>
                            <td class="px-4 py-3 fw-bold text-dark">خالد عمر</td>
                            <td class="px-4 py-3 text-center text-muted">04/12/2025</td>
                            <td class="px-4 py-3 fw-bold text-success">+$120.00</td>
                            <td class="px-4 py-3"><span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2" style="font-size: 0.65rem;">ناجحة</span></td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 outfit-font text-muted">#TRX-9810</td>
                            <td class="px-4 py-3 fw-bold text-dark">مدرب: سامر علي</td>
                            <td class="px-4 py-3 text-center text-muted">03/12/2025</td>
                            <td class="px-4 py-3 fw-bold text-danger">-$500.00</td>
                            <td class="px-4 py-3"><span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2" style="font-size: 0.65rem;">سحب أرباح</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>