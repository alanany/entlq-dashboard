<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= settings.academyName %> - الإعدادات</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-settings {
            background: #fff;
            border-radius: 1.5rem;
            padding: 1.5rem;
            border: 1px solid #f1f1f1;
            transition: all 0.3s;
            text-decoration: none;
            display: block;
        }

        .card-settings:hover { transform: translateY(-5px); box-shadow: 0 1rem 2rem rgba(0,0,0,0.05); }
    </style>
</head>
<body class="bg-light">
    <%- include('./_admin_sidebar.ejs', { currentPage: 'settings', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fa fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;"><%= title %></h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">System configuration & settings</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-light rounded-circle p-2 text-danger" title="تسجيل الخروج">
                            <i class="fa fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 animate__animated animate__fadeInUp">
            <div class="col-md-6 col-lg-4">
                <a href="/dashboard/settings/system" class="card-settings shadow-sm">
                    <div class=" bg-opacity-10 text-warning rounded-3 d-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-sliders-h fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">إعدادات النظام</h5>
                    <p class="small text-muted mb-0">تكوين إعدادات المنصة والعملة والخيارات العامة.</p>
                </a>
            </div>
            
            <div class="col-md-6 col-lg-4">
                <a href="/admin/categories" class="card-settings shadow-sm">
                    <div class=" bg-opacity-10 text-success rounded-3 d-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-list fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">إدارة الأقسام</h5>
                    <p class="small text-muted mb-0">إدارة تصنيفات وفئات الدورات التدريبية المتاحة.</p>
                </a>
            </div>

            <div class="col-md-6 col-lg-4">
                <a href="/dashboard/settings/security" class="card-settings shadow-sm">
                    <div class=" bg-opacity-10 text-danger rounded-3 d-flex align-items-center justify-content-center mb-3" style="width: 50px; height: 50px;">
                        <i class="fas fa-shield-alt fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">الأمان وكلمة المرور</h5>
                    <p class="small text-muted mb-0">تأمين حسابك وتغيير كلمة المرور الخاصة بك.</p>
                </a>
            </div>
            
          
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; <%= settings.academyName %> <%= new Date().getFullYear() %> - <%= settings.footerText %></small>
        </footer>
    </div>
    
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>