<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إضافة دورة جديدة</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; }
        .spinner {
            border: 4px solid rgba(255, 255, 255, 0.3);
            border-top: 4px solid #fff;
            border-radius: 50%;
            width: 1.5rem;
            height: 1.5rem;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">
    <div class="flex flex-col min-h-screen">
        <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-4 md:px-8 sticky top-0 z-50">
            <div class="flex items-center gap-4">
                <a href="/courses" class="p-2 hover:bg-gray-100 rounded-full transition-colors text-gray-600" title="رجوع">
                    <i data-feather="arrow-right" class="w-6 h-6"></i>
                </a>
                <div class="flex items-center gap-2 text-sm md:text-base">
                    <h1 class="text-xl font-bold text-indigo-600 ml-4 hidden md:block">أكاديمية انطلق</h1>
                    <span class="text-gray-400 hidden md:inline">/</span>
                    <span class="text-gray-800 font-bold">إضافة دورة جديدة</span>
                </div>
            </div>
            
            <div class="flex gap-2 md:gap-3">
                <button type="button" class="px-3 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 text-xs md:text-sm">حفظ كمسودة</button>
                <button id="publishBtn" type="submit" form="courseForm" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 text-xs md:text-sm flex items-center transition-colors">
                    نشر الدورة
                    <div id="spinner" class="spinner mr-2 hidden"></div>
                </button>
            </div>
        </header>

        <main class="flex-1 overflow-y-auto p-4 md:p-8">
            <div class="max-w-5xl mx-auto">
                <form id="courseForm" onsubmit="handleSubmit(event)" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    
                    <div class="lg:col-span-2 space-y-6">
                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                            <h3 class="font-bold text-lg mb-4 text-gray-800">المعلومات الأساسية</h3>
                            <div class="space-y-4">
                                <div>
                                    <label for="title" class="block text-sm font-medium text-gray-700 mb-1">عنوان الدورة</label>
                                    <input type="text" id="title" name="title" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="مثال: تعلم التصميم الجرافيكي من الصفر">
                                </div>
                                <div>
                                    <label for="description" class="block text-sm font-medium text-gray-700 mb-1">وصف قصير</label>
                                    <textarea id="description" name="description" rows="4" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none" placeholder="اكتب نبذة مختصرة تجذب الطلاب..."></textarea>
                                </div>
                            </div>

                            <h3 class="font-bold text-xl mb-4 text-indigo-600 border-b pb-2 mt-8">تفاصيل التسعير</h3>
                            <div class="bg-gray-50 p-4 rounded-lg border border-gray-200 mb-6">
                                <p class="font-bold text-gray-800 mb-3 text-sm">حدد سعر الحصة لكل مدة زمنية:</p>
                                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">30 دقيقة (SAR)</label>
                                        <input type="number" id="price30min" name="price30min" required min="1" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">40 دقيقة (SAR)</label>
                                        <input type="number" id="price40min" name="price40min" required min="1" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-medium text-gray-700 mb-1">60 دقيقة (SAR)</label>
                                        <input type="number" id="price60min" name="price60min" required min="1" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-bold text-lg text-gray-800">المنهج الدراسي</h3>
                                <button type="button" onclick="addSection()" class="text-sm text-indigo-600 font-medium hover:underline">+ إضافة قسم جديد</button>
                            </div>
                            <div id="curriculumContainer" class="space-y-3"></div>
                        </div>
                    </div>
                    
                    <div class="space-y-6">
                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                            <h3 class="font-bold text-sm mb-3 text-gray-800">صورة الغلاف</h3>
                            <div id="imagePreviewContainer" class="relative border-2 border-dashed border-gray-300 rounded-lg p-6 flex flex-col items-center justify-center text-center hover:bg-gray-50 transition-colors cursor-pointer h-48 overflow-hidden">
                                <i data-feather="image" class="w-8 h-8 text-gray-400 mb-2"></i>
                                <span class="text-xs text-gray-500">اسحب الصورة هنا أو اضغط للرفع</span>
                                <input type="file" id="coverImage" name="coverImage" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                            </div>
                        </div>

                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                            <h3 class="font-bold text-sm mb-3 text-gray-800">التصنيف والمستوى</h3>
                            <div class="space-y-4">
                                <div>
                                    <label for="level" class="block text-xs font-medium text-gray-700 mb-1">المستوى</label>
                                    <select id="level" name="level" required class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white">
                                        <option value="beginner">مبتدئ</option>
                                        <option value="intermediate">متوسط</option>
                                        <option value="advanced">متقدم</option>
                                    </select>
                                </div>
                                <div>
                                    <label for="category" class="block text-sm font-medium text-gray-700 mb-1 text-xs">القسم الرئيسي</label>
                                    <select id="category" name="category" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none text-sm">
                                        <option value="" disabled selected>-- اختر قسماً --</option>
                                        <% if (locals.categories && categories.length > 0) { %>
                                            <% categories.forEach(category => { %>
                                                <option value="<%= category._id %>"><%= category.name %></option>
                                            <% }); %>
                                        <% } %>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </main>
    </div>
    
    <div id="toastContainer" class="fixed bottom-4 right-4 z-[70] space-y-3"></div>

    <script>
        feather.replace();

        // معاينة الصورة
        document.getElementById('coverImage').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const container = this.parentElement;
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    container.querySelectorAll('i, span').forEach(el => el.classList.add('hidden'));
                    const oldPreview = container.querySelector('.img-preview');
                    if(oldPreview) oldPreview.remove();
                    const img = document.createElement('img');
                    img.src = event.target.result;
                    img.className = 'img-preview absolute inset-0 w-full h-full object-cover rounded-lg';
                    container.appendChild(img);
                }
                reader.readAsDataURL(file);
            }
        });

        // بقية الدوال (addSection, addLesson, handleSubmit, إلخ...) كما هي في كودك السابق
        // [ملاحظة: تأكد من نسخ دوال JavaScript من كودك السابق هنا ليعمل الفورم]
        
        let sectionCounter = 0;
        const publishBtn = document.getElementById("publishBtn");

        function startLoading() {
            publishBtn.disabled = true;
            publishBtn.innerHTML = 'جاري النشر... <div class="spinner mr-2"></div>';
        }

        function stopLoading() {
            publishBtn.disabled = false;
            publishBtn.innerHTML = 'نشر الدورة';
            feather.replace();
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            const colors = { success: 'bg-green-600', error: 'bg-red-600', info: 'bg-blue-500' };
            toast.className = `p-4 rounded-lg shadow-xl text-white ${colors[type] || colors.info} flex items-center transition-all duration-300 transform translate-x-full opacity-0 max-w-sm w-full`;
            toast.innerHTML = `<span class="text-sm font-medium">${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => { toast.style.transform = 'translateX(0)'; toast.style.opacity = '1'; }, 50);
            setTimeout(() => { toast.style.opacity = '0'; toast.addEventListener('transitionend', () => toast.remove()); }, 4000);
        }

        function createSectionTemplate() {
            sectionCounter++;
            const idx = sectionCounter;
            return `
                <div class="section-item border border-gray-200 rounded-lg p-4 bg-gray-50" data-section-index="${idx}">
                    <div class="flex justify-between items-center mb-3">
                        <input type="text" placeholder="عنوان القسم ${idx}" class="font-bold text-gray-700 bg-transparent border-none focus:outline-none w-full" value="القسم ${idx}:">
                        <button type="button" onclick="removeElement(this)" class="text-gray-400 hover:text-red-500"><i data-feather="trash" class="w-4 h-4"></i></button>
                    </div>
                    <div class="lessons-container space-y-2 border-r-2 border-gray-200 pr-4">
                        <button type="button" onclick="addLesson(this)" class="w-full py-2 border border-dashed border-gray-300 rounded text-gray-500 text-sm hover:bg-gray-100">+ إضافة درس</button>
                    </div>
                </div>`;
        }

        function addSection() {
            document.getElementById('curriculumContainer').insertAdjacentHTML('beforeend', createSectionTemplate());
            feather.replace();
        }

        function addLesson(btn) {
            const sectionIdx = btn.closest('.section-item').dataset.sectionIndex;
            const template = `
                <div class="lesson-item flex items-center justify-between bg-white p-2 rounded border border-gray-100">
                    <input type="text" placeholder="عنوان الدرس" required class="text-sm border-none focus:outline-none w-full">
                    <button type="button" onclick="removeElement(this)" class="text-gray-400 hover:text-red-500"><i data-feather="trash" class="w-3 h-3"></i></button>
                </div>`;
            btn.insertAdjacentHTML('beforebegin', template);
            feather.replace();
        }

        function removeElement(btn) {
            (btn.closest('.section-item') || btn.closest('.lesson-item')).remove();
        }
async function handleSubmit(event) {
    event.preventDefault();
    startLoading();

    const form = event.target;
    const formData = new FormData();

    // 1. البيانات الأساسية
    formData.append('title', document.getElementById('title').value);
    formData.append('description', document.getElementById('description').value);
    formData.append('level', document.getElementById('level').value);
    formData.append('category', document.getElementById('category').value);

    // 2. الأسعار
    const pricing = [
        { duration: 30, price: parseFloat(document.getElementById('price30min').value) },
        { duration: 40, price: parseFloat(document.getElementById('price40min').value) },
        { duration: 60, price: parseFloat(document.getElementById('price60min').value) }
    ];
    formData.append('pricingOptions', JSON.stringify(pricing));

    // 3. المنهج (Curriculum)
    const curriculum = [];
    document.querySelectorAll('.section-item').forEach(sec => {
        const sectionTitle = sec.querySelector('input[type="text"]').value;
        const lessons = [];
        sec.querySelectorAll('.lesson-item input').forEach(inp => {
            if(inp.value.trim()) lessons.push({ title: inp.value.trim() });
        });
        curriculum.push({ title: sectionTitle, lessons: lessons });
    });
    formData.append('curriculum', JSON.stringify(curriculum));

    // 4. الصورة (تأكد من اختيار الملف)
    const imageInput = document.getElementById('coverImage');
    if (imageInput.files.length > 0) {
        formData.append('coverImage', imageInput.files[0]);
    }

    // 💡 للتأكد من المحتوى في القنصل قبل الإرسال:
    for (let pair of formData.entries()) {
        console.log(pair[0] + ': ' + pair[1]);
    }

    try {
        const res = await fetch('/addCourse-post', { 
            method: 'POST', 
            // ⚠️ ملاحظة: لا تضع 'Content-Type' يدوياً هنا، المتصفح سيقوم بذلك تلقائياً
            body: formData 
        });

        const result = await res.json();
        
        if (!res.ok) throw result;

        showToast("تم النشر بنجاح", "success");
        setTimeout(() => location.href = '/courses', 1500);

    } catch (e) {
        stopLoading();
        console.error("خطأ في الإرسال:", e);
        showToast(e.message || "حدث خطأ أثناء الاتصال بالسيرفر", "error");
    }
}
        document.addEventListener('DOMContentLoaded', () => {
            if (document.getElementById('curriculumContainer').children.length === 0) addSection();
        });
        // منع الخروج بالخطأ إذا وجد بيانات

    </script>
</body>
</html>