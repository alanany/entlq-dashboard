<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تعديل: <%= course.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; }
        .spinner { border: 3px solid rgba(255, 255, 255, 0.3); border-top: 3px solid #fff; border-radius: 50%; width: 1.2rem; height: 1.2rem; animation: spin 1s linear infinite; }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-gray-50 text-gray-800">
    <div class="flex h-screen overflow-hidden">
        <aside class="w-64 bg-white border-l border-gray-200 hidden md:flex flex-col">
            <div class="h-16 flex items-center justify-center border-b border-gray-200 font-bold text-indigo-600 text-xl">أكاديمية انطلق</div>
            <nav class="flex-1 px-4 py-6 space-y-2">
                <a href="/dashboard/courses" class="flex items-center px-4 py-3 bg-indigo-50 text-indigo-600 rounded-lg"><i data-feather="book-open" class="ml-3 w-5 h-5"></i> الدورات</a>
            </nav>
        </aside>

        <div class="flex-1 flex flex-col overflow-hidden">
            <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-8">
                <div class="text-gray-500 text-sm">تعديل الدورة / <span class="text-gray-800 font-bold"><%= course.title %></span></div>
                <button id="updateBtn" type="submit" form="courseForm" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 flex items-center transition-all">
                    <span>تحديث الدورة</span>
                    <div id="spinner" class="spinner mr-2 hidden"></div>
                </button>
            </header>

            <main class="flex-1 overflow-y-auto p-8">
                <form id="courseForm" onsubmit="handleSubmit(event)" class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6">
                    
                    <div class="lg:col-span-2 space-y-6">
                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                            <h3 class="font-bold mb-4">المعلومات الأساسية</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm mb-1">عنوان الدورة</label>
                                    <input type="text" id="title" required class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none" value="<%= course.title %>">
                                </div>
                                <div>
                                    <label class="block text-sm mb-1">الوصف</label>
                                    <textarea id="description" rows="4" required class="w-full border rounded-lg px-4 py-2 focus:ring-2 focus:ring-indigo-500 outline-none"><%= course.description %></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="font-bold">المنهج الدراسي</h3>
                                <button type="button" onclick="addSection()" class="text-sm text-indigo-600 font-bold">+ إضافة قسم</button>
                            </div>
                            <div id="curriculumContainer" class="space-y-4">
                                <% if (course.curriculum && course.curriculum.length > 0) { %>
                                    <% course.curriculum.forEach((section, sIdx) => { %>
                                        <div class="section-item border rounded-lg p-4 bg-gray-50">
                                            <div class="flex justify-between mb-3">
                                                <input type="text" placeholder="عنوان القسم" class="font-bold bg-transparent outline-none w-full" value="<%= section.title %>">
                                                <button type="button" onclick="this.closest('.section-item').remove()" class="text-red-400"><i data-feather="trash-2" class="w-4 h-4"></i></button>
                                            </div>
                                            <div class="lessons-container space-y-2 pr-4 border-r-2 border-indigo-200">
                                                <% section.lessons.forEach((lesson) => { %>
                                                    <div class="lesson-item flex items-center bg-white p-2 rounded shadow-sm">
                                                        <input type="text" class="text-sm w-full outline-none" value="<%= lesson.title %>">
                                                        <button type="button" onclick="this.parentElement.remove()" class="text-gray-300 hover:text-red-500"><i data-feather="x" class="w-3 h-3"></i></button>
                                                    </div>
                                                <% }) %>
                                                <button type="button" onclick="addLesson(this)" class="text-xs text-indigo-500 py-1">+ إضافة درس</button>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100 text-center">
                            <h3 class="font-bold text-sm mb-4">صورة الغلاف</h3>
                            <div class="relative border-2 border-dashed border-gray-200 rounded-lg p-4 transition-all hover:bg-indigo-50 group">
                                <% if (course.coverImage) { %>
                                    <img id="previewImg" src="<%= course.coverImage %>" class="w-full h-32 object-cover rounded mb-2">
                                <% } else { %>
                                    <div id="placeholder" class="py-8"><i data-feather="image" class="w-10 h-10 text-gray-300 mx-auto"></i></div>
                                <% } %>
                                <span class="text-xs text-gray-400">اضغط لتغيير الصورة</span>
                                <input type="file" id="coverImage" accept="image/*" onchange="previewFile()" class="absolute inset-0 opacity-0 cursor-pointer">
                            </div>
                        </div>

                        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
                            <h3 class="font-bold text-sm mb-4">خيارات التسعير (SAR)</h3>
                            <div class="space-y-3">
                                <div>
                                    <label class="text-xs text-gray-500">30 دقيقة</label>
                                    <input type="number" id="price30" class="w-full border rounded-lg px-3 py-2 text-sm" value="<%= course.pricingOptions[0]?.price %>">
                                </div>
                                <div>
                                    <label class="text-xs text-gray-500">40 دقيقة</label>
                                    <input type="number" id="price40" class="w-full border rounded-lg px-3 py-2 text-sm" value="<%= course.pricingOptions[1]?.price %>">
                                </div>
                                <div>
                                    <label class="text-xs text-gray-500">60 دقيقة</label>
                                    <input type="number" id="price60" class="w-full border rounded-lg px-3 py-2 text-sm" value="<%= course.pricingOptions[2]?.price %>">
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </main>
        </div>
    </div>

    <script>
        feather.replace();

        function previewFile() {
            const preview = document.getElementById('previewImg') || document.createElement('img');
            const file = document.getElementById('coverImage').files[0];
            const reader = new FileReader();
            reader.onloadend = () => {
                preview.src = reader.result;
                preview.className = "w-full h-32 object-cover rounded mb-2";
                if(!document.getElementById('previewImg')) {
                    document.getElementById('placeholder').replaceWith(preview);
                    preview.id = "previewImg";
                }
            }
            if (file) reader.readAsDataURL(file);
        }

        function addSection() {
            const html = `
                <div class="section-item border rounded-lg p-4 bg-gray-50">
                    <div class="flex justify-between mb-3"><input type="text" placeholder="عنوان القسم الجديد" class="font-bold bg-transparent outline-none w-full"><button type="button" onclick="this.closest('.section-item').remove()" class="text-red-400"><i data-feather="trash-2" class="w-4 h-4"></i></button></div>
                    <div class="lessons-container space-y-2 pr-4 border-r-2 border-indigo-200"><button type="button" onclick="addLesson(this)" class="text-xs text-indigo-500 py-1">+ إضافة درس</button></div>
                </div>`;
            document.getElementById('curriculumContainer').insertAdjacentHTML('beforeend', html);
            feather.replace();
        }

        function addLesson(btn) {
            const html = `
                <div class="lesson-item flex items-center bg-white p-2 rounded shadow-sm">
                    <input type="text" placeholder="عنوان الدرس" class="text-sm w-full outline-none">
                    <button type="button" onclick="this.parentElement.remove()" class="text-gray-300 hover:text-red-500"><i data-feather="x" class="w-3 h-3"></i></button>
                </div>`;
            btn.insertAdjacentHTML('beforebegin', html);
            feather.replace();
        }

        async function handleSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('updateBtn');
            const spinner = document.getElementById('spinner');
            btn.disabled = true; spinner.classList.remove('hidden');

            const formData = new FormData();
            formData.append('title', document.getElementById('title').value);
            formData.append('description', document.getElementById('description').value);
            formData.append('level', '<%= course.level %>');
            formData.append('category', '<%= course.category %>');

            const pricing = [
                { duration: 30, price: document.getElementById('price30').value },
                { duration: 40, price: document.getElementById('price40').value },
                { duration: 60, price: document.getElementById('price60').value }
            ];
            formData.append('pricingOptions', JSON.stringify(pricing));

            const curriculum = [];
            document.querySelectorAll('.section-item').forEach(sec => {
                const section = { title: sec.querySelector('input').value, lessons: [] };
                sec.querySelectorAll('.lesson-item input').forEach(inp => section.lessons.push({ title: inp.value }));
                curriculum.push(section);
            });
            formData.append('curriculum', JSON.stringify(curriculum));

            const imageFile = document.getElementById('coverImage').files[0];
            if (imageFile) formData.append('coverImage', imageFile);

            try {
                const res = await fetch(`/edit-course/<%= course._id %>`, { method: 'POST', body: formData });
                if (res.ok) {
                    alert('تم التحديث بنجاح!');
                    window.location.href = '/courses';
                } else {
                    alert('فشل التحديث');
                }
            } catch (err) {
                console.error(err);
            } finally {
                btn.disabled = false; spinner.classList.add('hidden');
            }
        }
    </script>
</body>
</html>