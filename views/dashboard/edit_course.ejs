<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - تعديل: <%= course.title %></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-custom {
            background: #fff;
            border-radius: 1.5rem;
            border: 1px solid #f1f1f1;
            padding: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.02);
            margin-bottom: 1.5rem;
        }

        .form-label-custom {
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 0.5rem;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
        }

        .form-label-custom i { color: var(--primary); margin-left: 0.5rem; }

        .form-control, .form-select {
            border: 1px solid #eef0f2;
            border-radius: 1rem;
            padding: 0.75rem 1.25rem;
            font-weight: 600;
            font-size: 0.9rem;
            background-color: #f8fafc;
            transition: all 0.3s !important;
        }

        .form-control:focus, .form-select:focus {
            background-color: #fff;
            border-color: var(--primary);
            box-shadow: 0 0 0 0.25rem rgba(254, 93, 55, 0.1);
        }

        .image-edit-wrapper {
            position: relative;
            border: 2px dashed #eef0f2;
            border-radius: 1.5rem;
            padding: 1rem;
            text-align: center;
            transition: all 0.3s;
            cursor: pointer;
            background: #f8fafc;
        }

        .image-edit-wrapper:hover {
            border-color: var(--primary);
            background: #fffcfb;
        }

        .img-preview {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 1rem;
            margin-bottom: 1rem;
        }

        .section-item {
            background: #fafbfc;
            border-radius: 1.25rem;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
            border: 1px solid #f1f1f1;
        }

        .lesson-item {
            background: #fff;
            border-radius: 0.85rem;
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            border: 1px solid #f1f1f1;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .spinner {
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-top: 3px solid #fff;
            border-radius: 50%;
            width: 1.25rem;
            height: 1.25rem;
            animation: spin 1s linear infinite;
        }

        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body class="bg-light">

    <%- include('./_admin_sidebar.ejs', { currentPage: 'courses', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">تعديل الدورة</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Editing: <%= course.title %></small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button onclick="history.back()" class="btn btn-light rounded-circle p-2 text-muted" title="رجوع">
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <button id="updateBtn" type="submit" form="courseForm" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow-sm d-flex align-items-center gap-2">
                        <span>تحديث البيانات</span>
                        <div id="spinner" class="spinner d-none"></div>
                    </button>
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-light rounded-circle p-2 text-danger" title="تسجيل الخروج">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid p-0">
            <form id="courseForm" onsubmit="handleSubmit(event)">
                <div class="row g-4">
                    <div class="col-lg-8 animate__animated animate__fadeInUp">
                        <!-- Basic Info -->
                        <div class="card-custom">
                            <h5 class="fw-900 text-dark mb-4 d-flex align-items-center">
                                <i class="fas fa-edit text-primary me-2 ms-1"></i> المعلومات الأساسية
                            </h5>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label-custom">عنوان الدورة</label>
                                    <input type="text" id="title" required class="form-control" value="<%= course.title %>">
                                </div>
                                <div class="col-12">
                                    <label class="form-label-custom">الوصف</label>
                                    <textarea id="description" rows="5" required class="form-control"><%= course.description %></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Curriculum -->
                        <div class="card-custom">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h5 class="fw-900 text-dark mb-0 d-flex align-items-center">
                                    <i class="fas fa-list-ul text-primary me-2 ms-1"></i> المنهج الدراسي
                                </h5>
                                <button type="button" onclick="addSection()" class="btn btn-outline-primary btn-sm rounded-pill fw-bold">
                                    <i class="fas fa-plus-circle me-1"></i> إضافة قسم
                                </button>
                            </div>
                            <div id="curriculumContainer">
                                <% if (course.curriculum && course.curriculum.length > 0) { %>
                                    <% course.curriculum.forEach((section, sIdx) => { %>
                                        <div class="section-item animate__animated animate__fadeIn">
                                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-light">
                                                <div class="d-flex align-items-center flex-grow-1">
                                                    <i class="fas fa-folder text-primary me-2 ms-1"></i>
                                                    <input type="text" placeholder="عنوان القسم" class="fw-bold text-dark bg-transparent border-0 outline-none flex-grow-1" value="<%= section.title %>">
                                                </div>
                                                <button type="button" onclick="this.closest('.section-item').remove()" class="btn btn-light btn-sm rounded-circle p-1 text-danger">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </div>
                                            <div class="lessons-container ps-4 border-start border-2 border-primary border-opacity-25">
                                                <% section.lessons.forEach((lesson) => { %>
                                                    <div class="lesson-item">
                                                        <div class="d-flex align-items-center flex-grow-1">
                                                            <i class="fas fa-file-alt text-muted me-2 ms-1 small"></i>
                                                            <input type="text" class="text-dark small bg-transparent border-0 outline-none flex-grow-1" value="<%= lesson.title %>">
                                                        </div>
                                                        <button type="button" onclick="this.parentElement.remove()" class="btn btn-link btn-sm text-danger p-0">
                                                            <i class="fas fa-trash-alt small"></i>
                                                        </button>
                                                    </div>
                                                <% }) %>
                                                <button type="button" onclick="addLesson(this)" class="btn btn-light btn-sm rounded-pill w-100 py-2 mt-2 fw-bold text-muted border-dashed border-2">
                                                    <i class="fas fa-plus-circle me-1 small"></i> إضافة درس
                                                </button>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                        <!-- Cover Image -->
                        <div class="card-custom text-center">
                            <h6 class="fw-bold text-dark mb-3">صورة الغلاف</h6>
                            <div class="image-edit-wrapper group">
                                <% if (course.coverImage) { %>
                                    <img id="previewImg" src="<%= course.coverImage %>" class="img-preview">
                                <% } else { %>
                                    <div id="placeholder" class="py-5"><i class="fas fa-image fs-1 text-light mb-2"></i></div>
                                <% } %>
                                <div class="p-2">
                                    <span class="btn btn-light btn-sm rounded-pill fw-bold text-primary w-100">
                                        <i class="fas fa-camera me-1"></i> تغيير الصورة
                                    </span>
                                </div>
                                <input type="file" id="coverImage" accept="image/*" onchange="previewFile()" class="position-absolute top-0 start-0 w-100 h-100 opacity-0 cursor-pointer">
                            </div>
                        </div>

                        <!-- Pricing -->
                        <div class="card-custom">
                            <h6 class="fw-bold text-dark mb-4">خيارات التسعير (SAR)</h6>
                            <div class="space-y-4">
                                <div class="mb-3">
                                    <label class="form-label-custom small">30 دقيقة</label>
                                    <input type="number" id="price30" class="form-control" value="<%= course.pricingOptions[0]?.price %>">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label-custom small">40 دقيقة</label>
                                    <input type="number" id="price40" class="form-control" value="<%= course.pricingOptions[1]?.price %>">
                                </div>
                                <div class="mb-0">
                                    <label class="form-label-custom small">60 دقيقة</label>
                                    <input type="number" id="price60" class="form-control" value="<%= course.pricingOptions[2]?.price %>">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top border-light">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function previewFile() {
            const preview = document.getElementById('previewImg') || document.createElement('img');
            const file = document.getElementById('coverImage').files[0];
            const reader = new FileReader();
            reader.onloadend = () => {
                preview.src = reader.result;
                preview.className = "img-preview";
                if(!document.getElementById('previewImg')) {
                    const placeholder = document.getElementById('placeholder');
                    if(placeholder) placeholder.replaceWith(preview);
                    preview.id = "previewImg";
                }
            }
            if (file) reader.readAsDataURL(file);
        }

        function addSection() {
            const html = `
                <div class="section-item animate__animated animate__fadeIn">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-light">
                        <div class="d-flex align-items-center flex-grow-1">
                            <i class="fas fa-folder text-primary me-2 ms-1"></i>
                            <input type="text" placeholder="عنوان القسم الجديد" class="fw-bold text-dark bg-transparent border-0 outline-none flex-grow-1">
                        </div>
                        <button type="button" onclick="this.closest('.section-item').remove()" class="btn btn-light btn-sm rounded-circle p-1 text-danger">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    <div class="lessons-container ps-4 border-start border-2 border-primary border-opacity-25">
                        <button type="button" onclick="addLesson(this)" class="btn btn-light btn-sm rounded-pill w-100 py-2 mt-2 fw-bold text-muted border-dashed border-2">
                            <i class="fas fa-plus-circle me-1 small"></i> إضافة درس
                        </button>
                    </div>
                </div>`;
            document.getElementById('curriculumContainer').insertAdjacentHTML('beforeend', html);
        }

        function addLesson(btn) {
            const html = `
                <div class="lesson-item animate__animated animate__slideInLeft">
                    <div class="d-flex align-items-center flex-grow-1">
                        <i class="fas fa-file-alt text-muted me-2 ms-1 small"></i>
                        <input type="text" placeholder="عنوان الدرس" class="text-dark small bg-transparent border-0 outline-none flex-grow-1">
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="btn btn-link btn-sm text-danger p-0">
                        <i class="fas fa-trash-alt small"></i>
                    </button>
                </div>`;
            btn.insertAdjacentHTML('beforebegin', html);
        }

        async function handleSubmit(e) {
            e.preventDefault();
            const btn = document.getElementById('updateBtn');
            const spinner = document.getElementById('spinner');
            btn.disabled = true; spinner.classList.remove('d-none');
            const btnSpan = btn.querySelector('span');
            btnSpan.innerText = 'جاري التحديث...';

            const formData = new FormData();
            formData.append('title', document.getElementById('title').value);
            formData.append('description', document.getElementById('description').value);
            formData.append('level', '<%= course.level %>');
            formData.append('category', '<%= course.category %>');

            const pricing = [
                { duration: 30, price: document.getElementById('price30').value },
                { duration: 40, price: document.getElementById('price40').value },
                { duration: 60, price: document.getElementById('price60').value }
            ];
            formData.append('pricingOptions', JSON.stringify(pricing));

            const curriculum = [];
            document.querySelectorAll('.section-item').forEach(sec => {
                const section = { title: sec.querySelector('input').value, lessons: [] };
                sec.querySelectorAll('.lesson-item input').forEach(inp => {
                    if(inp.value.trim()) section.lessons.push({ title: inp.value.trim() });
                });
                curriculum.push(section);
            });
            formData.append('curriculum', JSON.stringify(curriculum));

            const imageFile = document.getElementById('coverImage').files[0];
            if (imageFile) formData.append('coverImage', imageFile);

            try {
                const res = await fetch(`/edit-course/<%= course._id %>`, { method: 'POST', body: formData });
                if (res.ok) {
                    alert('تم تحديث بيانات الدورة بنجاح!');
                    window.location.href = '/courses';
                } else {
                    const err = await res.json();
                    alert(err.message || 'فشل التحديث');
                }
            } catch (err) {
                console.error(err);
                alert('حدث خطأ في الاتصال بالسيرفر');
            } finally {
                btn.disabled = false; spinner.classList.add('d-none');
                btnSpan.innerText = 'تحديث البيانات';
            }
        }
    </script>
</body>
</html>
