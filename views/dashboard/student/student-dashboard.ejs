<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= dir %>">

<head>
    <meta charset="utf-8">
    <title><%= t('dashboard') %> - <%= t('brand_name') %></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Lobster+Two:wght@700&family=Cairo:wght@400;600;700;900&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            right: 0;
            background: #fff;
            box-shadow: -5px 0 15px rgba(0,0,0,0.05);
            z-index: 1000;
            transition: all 0.3s;
        }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
        }

        @media (max-width: 991.98px) {
            .sidebar { margin-right: -260px; }
            .sidebar.active { margin-right: 0; }
            .main-content { margin-right: 0; }
        }

        .nav-link {
            color: #6c757d;
            padding: 0.8rem 1.25rem;
            border-radius: 0.75rem;
            margin: 0.2rem 1rem;
            font-weight: 500;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            font-size: 0.85rem;
        }

        .nav-link i {
            margin-left: 1rem;
            font-size: 1.2rem;
        }

        .nav-link:hover, .nav-link.active {
            color: var(--primary);
            background-color: var(--secondary);
        }

        .nav-link.active {
            font-weight: 700;
        }

        .stats-card {
            border: none;
            border-radius: 1.25rem;
            background: #fff;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.03);
            padding: 1.25rem;
            height: 100%;
            transition: all 0.3s;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .stats-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.08);
        }

        .stats-icon-kider {
            position: relative;
            width: 30px;
            height: 30px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
            z-index: 1;
        }

        .stats-icon-kider::before {
            position: absolute;
            content: "";
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background: rgba(255, 255, 255, .8);
            border-radius: 30px;
            z-index: -1;
            transition: .5s;
        }

        .stats-card:hover .stats-icon-kider::before {
            background: transparent;
        }

        .stats-card:hover .stats-icon-kider i {
            color: #fff !important;
        }

        .stats-card * {
            transition: .5s;
        }

        .session-banner {
            background: linear-gradient(rgba(254, 93, 55, .9), rgba(254, 93, 55, .9)), url('/img/carousel-1.jpg');
            background-size: cover;
            background-position: center;
            border-radius: 2rem;
            color: #fff;
            padding: 3rem;
            position: relative;
            overflow: hidden;
        }

        .countdown-box {
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            padding: 1rem 2rem;
            border-radius: 1rem;
            display: inline-block;
            font-family: monospace;
            font-size: 2rem;
            font-weight: 700;
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-kider {
            background-color: #fff;
            color: var(--primary);
            border: none;
            padding: 0.8rem 2rem;
            border-radius: 1rem;
            font-weight: 700;
            transition: all 0.3s;
        }

        .btn-kider:hover {
            transform: scale(1.05);
            background-color: var(--light);
        }
    </style>
</head>

<body>
    <div class="sidebar" id="sidebar">
        <div class="p-4 text-center border-bottom">
            <h3 class="m-0 text-primary lobster-font" style="font-size: 2rem;">
                <i class="fa fa-laptop-code me-2"></i><%= t('brand_name') %>
            </h3>
        </div>
        <div class="py-4">
            <a href="/" class="nav-link active">
                <i class="fa fa-home"></i> <%= t('home') %>
            </a>
            <a href="/student/my-sessions" class="nav-link text-dark">
                <i class="fa fa-calendar-alt"></i> <%= t('sessions') %>
            </a>
            <a href="/student/courses_list" class="nav-link text-dark">
                <i class="fa fa-book"></i> <%= t('courses') %>
            </a>
            <a href="/student/enrolled_subscription" class="nav-link text-dark">
                <i class="fa fa-file-invoice"></i> <%= t('subscriptions') %>
            </a>
            <a href="/student/billing" class="nav-link text-dark">
                <i class="fa fa-wallet"></i> <%= t('billing') %>
            </a>
            <div class="mt-4 pt-4 border-top mx-3">
                <a href="/student/profile" class="nav-link text-dark">
                    <i class="fa fa-user-cog"></i> <%= t('settings') %>
                </a>
                <a href="#" data-bs-toggle="modal" data-bs-target="#logoutModal" class="nav-link text-danger mt-2">
                    <i class="fa fa-sign-out-alt"></i> <%= t('logout') %>
                </a>
            </div>
        </div>
    </div>

    <div class="main-content">
        <!-- Top Navigation -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light">
            <div class="d-flex align-items-center">
                <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-3" id="sidebarCollapse">
                    <i class="fa fa-bars fs-5"></i>
                </button>
                <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;"><%= t('welcome_back') %>, <%= user.name %>! 👋</h4>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-success p-2 px-3 rounded-pill small fw-bold d-none d-md-block">
                    <i class="fa fa-ticket-alt me-1"></i>
                    الرصيد المتبقي: <%= studentStats.totalPlan - studentStats.completedSessions %> <%= t('sessions_short') %>
                </div>
                <div class="position-relative">
                    <i class="fa fa-bell text-muted fs-4"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge border border-light rounded-circle bg-danger p-1"><span class="visually-hidden">unread messages</span></span>
                </div>
            </div>
        </div>

        <!-- Session Status -->
        <% 
            let sessionState = 'none'; 
            let countdownMs = 0;
            let joinUrl = '#';

            if (nearestSession && nearestSession.sessionDetails) {
                const sd = nearestSession.sessionDetails;
                const sessionStart = nearestSession.startTime;
                const sessionEnd = nearestSession.sessionEnd;
                const now = new Date();

                joinUrl = `/student/session-details/${nearestSession.bookingId}/${nearestSession.sessionId}`;

                if(now >= sessionStart && now <= sessionEnd) {
                    sessionState = 'ongoing';
                    countdownMs = sessionEnd.getTime() - now.getTime();
                } else if(now < sessionStart) {
                    sessionState = 'upcoming';
                }
            }
        %>

        <% if(sessionState === 'ongoing' || sessionState === 'upcoming'){ %>
            <div class="session-banner mb-4 animate__animated animate__fadeIn">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-<%= sessionState === 'ongoing' ? 'danger' : 'success' %> rounded-pill px-3 py-2 me-2">
                                <%= sessionState === 'ongoing' ? 'مباشر الآن 🔥' : 'حصة قادمة 🎓' %>
                            </span>
                            <span class="text-white-50">| <%= nearestSession.courseTitle %></span>
                        </div>
                        <h3 class="display-5 fw-bold mb-3">
                            <%= sessionState === 'ongoing' ? 'حصتك بدأت بالفعل!' : 'استعد لحصتك القادمة' %>
                        </h3>
                        <p class="fs-5 opacity-75 mb-4">
                            <i class="fa fa-clock me-2"></i>
                            <%= nearestSession.sessionDetails.displayDay %>، <%= nearestSession.sessionDetails.displayDate %> - <%= nearestSession.sessionDetails.displayTime %>
                        </p>
                        <% if(sessionState === 'ongoing'){ %>
                            <div class="mb-4">
                                <small class="d-block mb-2 text-white-50">الوقت المتبقي لانتهاء الحصة:</small>
                                <div id="countdown" class="countdown-box">--:--</div>
                            </div>
                        <% } %>
                    </div>
                    <div class="col-lg-4 text-lg-start">
                        <a href="<%= joinUrl %>" class="btn btn-kider fs-5 shadow-lg px-5 py-3">
                            <i class="fa fa-play-circle me-2"></i> <%= sessionState === 'ongoing' ? 'انضم الآن' : 'التوجه للقاعة' %>
                        </a>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="stats-card p-5 text-center mb-4">
                <div class="stats-icon bg-light text-muted mx-auto mb-4" style="width: 80px; height: 80px;">
                    <i class="fa fa-calendar-times fs-2"></i>
                </div>
                <h5 class="fw-bold">لا توجد حصص مجدولة اليوم</h5>
                <p class="text-muted">يمكنك استعراض جدولك الكامل أو حجز دورات جديدة</p>
                <a href="/student/my-sessions" class="btn btn-primary rounded-pill px-4 py-2 mt-2">
                    عرض الجدول الكامل
                </a>
            </div>
        <% } %>

        <!-- Statistics Grid -->
        <% if (courseBookingDetails != null) { %>
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="stats-card">
                        <div class="d-flex align-items-center mb-3">
                            <div class="stats-icon-kider bg-success text-success me-3">
                                <i class="fa fa-check-circle"></i>
                            </div>
                            <div>
                                <h3 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= studentStats.completedSessions %></h3>
                                <small class="text-muted fw-bold" style="font-size: 0.7rem;">حصة مكتملة</small>
                            </div>
                        </div>
                        <div class="progress" style="height: 4px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: <%= Math.round((studentStats.completedSessions / studentStats.totalPlan * 100) || 0) %>%"></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stats-card">
                        <div class="d-flex align-items-center mb-2">
                            <div class="stats-icon-kider bg-warning text-warning me-3">
                                <i class="fa fa-star text-warning"></i>
                            </div>
                            <div>
                                <h3 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= studentStats.rating || '5.0' %></h3>
                                <small class="text-muted fw-bold" style="font-size: 0.7rem;">التقييم الأكاديمي</small>
                            </div>
                        </div>
                        <div class="text-warning small" style="font-size: 0.7rem;">
                            <% for(let i=1; i<=5; i++){ %>
                                <i class="fa fa-star <%= i <= Math.round(studentStats.rating || 5) ? '' : 'text-muted opacity-25' %>"></i>
                            <% } %>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stats-card">
                        <div class="d-flex align-items-center mb-2">
                            <div class="stats-icon-kider bg-danger text-danger me-3">
                                <i class="fa fa-award"></i>
                            </div>
                            <div>
                                <h3 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= courseBookingDetails.totalCalculatedPrice %></h3>
                                <small class="text-muted fw-bold" style="font-size: 0.7rem;">إجمالي الاستثمار</small>
                            </div>
                        </div>
                        <div class="mt-1">
                            <span class="badge rounded-pill bg-success text-white" style="font-size: 0.65rem; font-weight: 800;">تم الدفع</span>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stats-card">
                        <div class="d-flex align-items-center mb-2">
                            <div class="stats-icon-kider bg-primary text-primary me-3">
                                <i class="fa fa-laptop-code"></i>
                            </div>
                            <div class="overflow-hidden">
                                <h6 class="mb-0 fw-900 text-truncate text-primary" style="max-width: 100px; font-size: 0.85rem;"><%= courseBookingDetails.courseName %></h6>
                                <small class="text-muted fw-bold" style="font-size: 0.7rem;">باقة الكورس</small>
                            </div>
                        </div>
                        <div class="mt-1 text-end">
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill small" style="font-size: 0.65rem;"><%= studentStats.totalPlan %> حصة</span>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- Bottom Footer (Inside content) -->
        <footer class="mt-auto py-4 text-center text-muted">
            <small>&copy; <%= t('brand_name') %> 2024 - <%= t('all_rights_reserved') %></small>
        </footer>
    </div>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-5 text-center">
                    <div class="stats-icon bg-danger bg-opacity-10 text-danger mx-auto mb-4 animate__animated animate__pulse animate__infinite" style="width: 100px; height: 100px; border-radius: 50%;">
                        <i class="fa fa-sign-out-alt" style="font-size: 3rem;"></i>
                    </div>
                    <h3 class="fw-bold mb-3 text-dark">تسجيل الخروج؟</h3>
                    <p class="text-muted mb-4 fs-5">هل أنت متأكد أنك تريد مغادرة حسابك؟ سنفتقدك!</p>
                    <div class="d-flex gap-3 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill px-4 py-2 flex-grow-1" data-bs-dismiss="modal">إلغاء</button>
                        <a href="/student/logout" class="btn btn-danger rounded-pill px-4 py-2 flex-grow-1">تسجيل الخروج</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/wow/wow.min.js"></script>
    
    <script>
        // Sidebar Toggle
        $('#sidebarCollapse').on('click', function() {
            $('#sidebar').toggleClass('active');
        });

        // Countdown Script
        <% if(sessionState === 'ongoing'){ %>
            let countdownMs = Number("<%= countdownMs || 0 %>");
            function updateCountdown() {
                const el = document.getElementById('countdown');
                if(!el) return;
                if(countdownMs <= 0) { el.innerText = "00:00"; return; }
                const mins = Math.floor(countdownMs / 60000);
                const secs = Math.floor((countdownMs % 60000) / 1000);
                el.innerText = `${mins}:${secs < 10 ? '0'+secs : secs}`;
                countdownMs -= 1000;
            }
            setInterval(updateCountdown, 1000); 
            updateCountdown();
        <% } %>
    </script>
</body>

</html>