<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8">
    <title><%= settings.academyName %> - طلبات الانضمام</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            right: 0;
            background: #fff;
            box-shadow: -5px 0 15px rgba(0,0,0,0.05);
            z-index: 1000;
            transition: all 0.3s;
        }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
        }

        @media (max-width: 991.98px) {
            .sidebar { margin-right: -260px; }
            .sidebar.active { margin-right: 0; }
            .main-content { margin-right: 0; }
        }

        .nav-link {
            color: #6c757d;
            padding: 0.8rem 1.25rem;
            border-radius: 0.75rem;
            margin: 0.2rem 1rem;
            font-weight: 500;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            font-size: 0.85rem;
        }

        .nav-link i { margin-left: 1rem; font-size: 1.2rem; }
        .nav-link:hover, .nav-link.active { color: var(--primary); background-color: var(--secondary); }
        .nav-link.active { font-weight: 700; }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stats-card {
            border: none;
            border-radius: 1.25rem;
            background: #fff;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.03);
            padding: 1.25rem;
            height: 100%;
            transition: all 0.3s;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .stats-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.08);
        }

        .stats-icon-kider {
            position: relative;
            width: 30px;
            height: 30px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
            z-index: 1;
        }

        .stats-icon-kider::before {
            position: absolute;
            content: "";
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            background: rgba(255, 255, 255, .8);
            border-radius: 30px;
            z-index: -1;
            transition: .5s;
        }

        .stats-card:hover .stats-icon-kider::before {
            background: transparent;
        }

        .stats-card:hover .stats-icon-kider i {
            color: #fff !important;
        }

        .stats-card * {
            transition: .5s;
        }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.8rem;
        }

        .btn-kider {
            background-color: var(--primary);
            color: #fff;
            border-radius: 0.75rem;
            padding: 0.35rem 0.8rem;
            font-weight: 700;
            border: none;
            font-size: 0.75rem;
        }

        .btn-kider:hover { background-color: #e44d2d; color: #fff; }

        .tab-btn {
            border: none;
            background: #fff;
            padding: 0.6rem 1.5rem;
            border-radius: 1rem;
            font-weight: 700;
            color: #6c757d;
            transition: all 0.3s;
            font-size: 0.85rem;
            box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,0.03);
        }

        .tab-btn.active {
            background-color: var(--primary);
            color: #fff;
            box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.2);
        }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <%- include('./_student_sidebar', { activePage: 'subscriptions' }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fa fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">طلبات الانضمام</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Track your enrollment requests</small>
                    </div>
                </div>

              
            </div>
        </div>

        <%
            function getStatusBadge(status) {
                switch(status) {
                    case 'pending': return { text: 'قيد المراجعة', color: 'bg-warning text-dark' };
                    case 'confirmed': return { text: 'تمت الموافقة', color: 'bg-primary text-white' };
                    case 'paid': return { text: 'تم الدفع', color: 'bg-success text-white' };
                    case 'rejected': return { text: 'مرفوض', color: 'bg-danger text-white' };
                    case 'awaiting_payment': return { text: 'بانتظار الدفع', color: 'bg-info text-dark' };
                    default: return { text: 'غير معروف', color: 'bg-secondary text-white' };
                }
            }

            const stats = {
                total: allRequests.length,
                pending: allRequests.filter(r => r.status === 'pending').length,
                awaiting: allRequests.filter(r => r.status === 'awaiting_payment').length,
                accepted: allRequests.filter(r => r.status === 'confirmed' || r.status === 'paid').length
            };
        %>

        <!-- Stats Grid -->
        <div class="row g-3 mb-4 animate__animated animate__fadeInUp">
            <div class="col-6 col-md-3">
                <div class="stats-card">
                    <div class="d-flex align-items-center">
                        <div class="stats-icon-kider bg-primary text-primary me-3">
                            <i class="fa fa-folder-open"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= stats.total %></h3>
                            <small class="text-muted fw-bold" style="font-size: 0.7rem;">إجمالي الطلبات</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-card">
                    <div class="d-flex align-items-center">
                        <div class="stats-icon-kider bg-warning text-warning me-3">
                            <i class="fa fa-clock"></i>
                        </div>
                        <div>
                            <h2 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= stats.pending %></h2>
                            <small class="text-muted fw-bold" style="font-size: 0.7rem;">قيد المراجعة</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-card">
                    <div class="d-flex align-items-center">
                        <div class="stats-icon-kider bg-info text-info me-3">
                            <i class="fa fa-wallet"></i>
                        </div>
                        <div>
                            <h2 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= stats.awaiting %></h2>
                            <small class="text-muted fw-bold" style="font-size: 0.7rem;">بانتظار الدفع</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stats-card">
                    <div class="d-flex align-items-center">
                        <div class="stats-icon-kider bg-success text-success me-3">
                            <i class="fa fa-check-double"></i>
                        </div>
                        <div>
                            <h2 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= stats.accepted %></h2>
                            <small class="text-muted fw-bold" style="font-size: 0.75rem;">المقبولة</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Tabs -->
        <div class="d-flex flex-wrap gap-2 mb-4 justify-content-center animate__animated animate__fadeInUp">
            <button onclick="showTab('all')" id="tab-all" class="tab-btn active">الكل</button>
            <button onclick="showTab('pending')" id="tab-pending" class="tab-btn text-warning">قيد المراجعة</button>
            <button onclick="showTab('awaiting_payment')" id="tab-awaiting_payment" class="tab-btn text-info">بانتظار الدفع</button>
            <button onclick="showTab('confirmed,paid')" id="tab-confirmedpaid" class="tab-btn text-success">المقبولة / المدفوعة</button>
            <button onclick="showTab('rejected')" id="tab-rejected" class="tab-btn text-danger">المرفوضة</button>
        </div>

        <!-- Requests List -->
        <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden animate__animated animate__fadeInUp">
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">الكورس</th>
                            <th>التاريخ</th>
                            <th>المبلغ</th>
                            <th>الحالة</th>
                            <th class="text-center">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody id="requestsTableBody">
                        <% if (allRequests.length > 0) { %>
                            <% allRequests.forEach(request => {
                                const badge = getStatusBadge(request.status);
                                const tabClasses = request.status === 'paid' ? 'status-paid status-confirmed' : `status-${request.status}`;
                            %>
                                <tr class="request-row <%= tabClasses %>">
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark"><%= request.courseId.title %></div>
                                        <small class="text-muted"><%= request.courseId.category.name %></small>
                                    </td>
                                    <td class="text-muted small outfit-font">
                                        <%= new Date(request.createdAt).toLocaleDateString('ar-EG') %>
                                    </td>
                                    <td class="fw-bold outfit-font">
                                        <%= request.totalAmount.toFixed(2) %> <small class="text-muted">SAR</small>
                                    </td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-2 <%= badge.color %>" style="font-size: 0.7rem; font-weight: 800; min-width: 100px; display: inline-block;">
                                            <%= badge.text %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a href="/request-details/<%= request._id %>" class="btn btn-kider">
                                            <i class="fa fa-eye me-1"></i> عرض التفاصيل
                                        </a>
                                        <% if (request.isRenewable) { %>
                                            <br>
                                            <button class="btn btn-success btn-sm mt-2 btn-renew" 
                                                data-id="<%= request._id %>"
                                                data-course-id="<%= request.courseId._id %>"
                                                data-price-option="<%= request.selectedPriceOption %>" 
                                                data-sessions-count="<%= request.numberOfSessionsPerMonth %>"
                                                data-total-amount="<%= request.totalAmount %>"
                                            >
                                                <i class="fa fa-sync me-1"></i> إعادة الاشتراك
                                            </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="fa fa-inbox text-muted fs-1 mb-3"></i>
                                    <p class="text-muted fw-bold">لا يوجد طلبات انضمام حالياً</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة انطلق التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>

    <!-- Modals -->
    <div class="modal fade" id="logoutModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-5 text-center">
                    <div class="stats-icon bg-danger bg-opacity-10 text-danger mx-auto mb-4 animate__animated animate__pulse animate__infinite" style="width: 100px; height: 100px; border-radius: 50%;">
                        <i class="fa fa-sign-out-alt fs-1"></i>
                    </div>
                    <h3 class="fw-bold mb-3">تسجيل الخروج؟</h3>
                    <p class="text-muted mb-4 fs-5">هل أنت متأكد أنك تريد مغادرة حسابك؟</p>
                    <div class="d-flex gap-3">
                        <button class="btn btn-light rounded-pill flex-grow-1" data-bs-dismiss="modal">إلغاء</button>
                        <a href="/student/logout" class="btn btn-danger rounded-pill flex-grow-1">خروج</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Renew Modal -->
    <div class="modal fade" id="renewModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-4 text-center">
                    <div class="mb-4 text-success animate__animated animate__bounceIn">
                        <i class="fas fa-sync-alt fa-3x"></i>
                    </div>
                    <h3 class="fw-bold mb-3">تجديد الاشتراك</h3>
                    <p class="text-muted mb-4">هل ترغب بتجديد الاشتراك بنفس الإعدادات السابقة أم تريد تغييرها؟</p>
                    
                    <input type="hidden" id="renewCourseId">
                    <input type="hidden" id="renewPriceOption">
                    <input type="hidden" id="renewSessionsCount">
                    <input type="hidden" id="renewTotalAmount">
                    <input type="hidden" id="renewId">

                    <div class="d-grid gap-3">
                        <button onclick="renewSameSettings()" id="renewConfirmBtn" class="btn btn-success btn-lg rounded-pill fw-bold">
                            <i class="fas fa-check-circle me-2"></i>تجديد بنفس الإعدادات
                        </button>
                        <div class="text-muted small my-1">أو</div>
                        <a href="#" id="changeSettingsBtn" class="btn btn-outline-primary btn-lg rounded-pill fw-bold">
                            <i class="fas fa-cog me-2"></i>تغيير الإعدادات
                        </a>
                        <button class="btn btn-light rounded-pill mt-2" data-bs-dismiss="modal">إلغاء</button>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        $('#sidebarCollapse').on('click', () => $('#sidebar').toggleClass('active'));

        function showTab(status) {
            $('.tab-btn').removeClass('active');
            $(`#tab-${status.replace(',', '')}`).addClass('active');

            if (status === 'all') {
                $('.request-row').show();
            } else {
                $('.request-row').hide();
                const statuses = status.split(',');
                statuses.forEach(s => $(`.status-${s}`).show());
            }
        }
        
        // Renewal Modal Logic
        $('.btn-renew').on('click', function() {
            const btn = $(this);
            const data = {
                id: btn.data('id'),
                courseId: btn.data('course-id'),
                priceOption: btn.data('price-option'),
                sessionsCount: btn.data('sessions-count'),
                totalAmount: btn.data('total-amount')
            };

            $('#renewCourseId').val(data.courseId);
            $('#renewPriceOption').val(data.priceOption);
            $('#renewSessionsCount').val(data.sessionsCount);
            $('#renewTotalAmount').val(data.totalAmount);
            
            // Set Change Settings Link
            $('#changeSettingsBtn').attr('href', `/student/book_plan/${data.courseId}`);
            
            $('#renewModal').modal('show');
        });

        function renewSameSettings() {
             const btn = $('#renewConfirmBtn');
             btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i> جاري التنفيذ...');

             const startRenew = {
                studentId: '<%= user._id %>',
                courseId: $('#renewCourseId').val(),
                selectedPriceOption: $('#renewPriceOption').val(),
                numberOfSessionsPerMonth: $('#renewSessionsCount').val(),
                totalAmount: $('#renewTotalAmount').val(),
                renewFromId: $('#renewId').val() // 🔴
             };

             fetch('/student/checkout', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(startRenew)
            })
            .then(response => response.json())
            .then(data => {
                if(data.success || data.message) {
                     alert('تم تجديد الاشتراك بنجاح!');
                     window.location.reload();
                } else {
                     alert('حدث خطأ أثناء التجديد: ' + (data.error || 'Unknown error'));
                     btn.prop('disabled', false).html('تأكيد التجديد');
                }
            })
            .catch(err => {
                console.error(err);
                alert('فشل الاتصال بالخادم');
                btn.prop('disabled', false).html('تأكيد التجديد');
            });
        }
    </script>
</body>

</html>
