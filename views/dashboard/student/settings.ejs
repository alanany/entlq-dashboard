<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إعدادات الحساب</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>body { font-family: 'Tajawal', sans-serif; }</style>
</head>
<body class="bg-gray-50 text-gray-800">
    <div class="flex h-screen overflow-hidden">
        
        <div class="flex-1 flex flex-col overflow-hidden">
            <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-8">
                <h2 class="text-xl font-semibold text-gray-800">إعدادات الحساب</h2>
                <a href="" onclick="history.back(); return false;" class="text-sm text-indigo-600 hover:underline flex items-center font-medium">
                    </i> العودة للرئيسية
                </a>
            </header>

            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 p-8">
                <div class="max-w-3xl mx-auto space-y-8">
                    
                    <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100">
                        <h3 class="font-bold text-xl text-indigo-700 mb-4 flex items-center"><i data-feather="user" class="ml-2 w-5 h-5"></i> تحديث الملف الشخصي</h3>
                        
<form action="/settings/update-profile" method="POST" class="space-y-4"    onsubmit="handleSubmit(event)">                            <div>
                                <label for="name" class="block text-sm font-medium text-gray-700">الاسم الكامل </label>
                                <input type="text" name="name" value= "<%= newuser.name %>"   class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500">
                            </div>
                            <div>
                                <label for="email" class="block text-sm font-medium text-gray-700">البريد الإلكتروني</label>
                                <input type="email" name="email" value=<%= newuser.email %> disabled class="mt-1 w-full border border-gray-200 bg-gray-50 rounded-lg px-3 py-2">
                            </div>
                            <button  id="saveBtn"
            type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">حفظ التغييرات</button>
                        </form>
                    </div>

                    <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100">
                        <h3 class="font-bold text-xl text-indigo-700 mb-4 flex items-center"><i data-feather="lock" class="ml-2 w-5 h-5"></i> تحديث كلمة المرور</h3>
                        
                        <form class="space-y-4" method="POST" onsubmit=handlePasswordSubmit(event) action="/settings/update-password">
                            <div>
                                <label for="currentPassword" class="block text-sm font-medium text-gray-700">كلمة المرور الحالية</label>
                                <input type="password"  required name="currentPassword" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500">
                            </div>
                            <div>
                                <label for="newPassword"  class="block text-sm font-medium text-gray-700">كلمة المرور الجديدة</label>
                                <input type="password" required name="newPassword" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500">
                            </div>
                            <div>
                                <label for="confirmPassword"  class="block text-sm font-medium text-gray-700">تأكيد كلمة المرور الجديدة</label>
                                <input type="password" required name="confirmPassword" class="mt-1 w-full border border-gray-300 rounded-lg px-3 py-2 focus:ring-indigo-500 focus:border-indigo-500">
                            </div>
                            <button id="saveBtn1"
            type="submit"  class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">تغيير كلمة المرور</button>
                        </form>
                    </div>

                </div>
            </main>
        </div>
    </div>
   <div
      id="toastContainer"
      class="fixed bottom-4 right-4 z-[70] space-y-3"
    ></div>

    <script>
      feather.replace();

      const saveBtn = document.getElementById("saveBtn");
      const originalButtonText = saveBtn.textContent.trim();
   const saveBtn1 = document.getElementById("saveBtn1");
      const originalButtonText1 = saveBtn1.textContent.trim();
      function startLoading(isSend = true) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = !isSend
          ? `<span>${originalButtonText}</span>`
          : `<span>جاري الحفظ...</span>`;
      }
   function startLoading1(isSend = true) {
        saveBtn1.disabled = true;
        saveBtn1.innerHTML = !isSend
          ? `<span>${originalButtonText1}</span>`
          : `<span>جاري الحفظ...</span>`;
      }
      function stopLoading(isSend = true) {
        saveBtn.disabled = false;
        saveBtn.innerHTML = !isSend
          ? `<span>${originalButtonText}</span>`
          : `<span>جاري الحفظ ...</span>`;

        feather.replace();
      }
  function stopLoading1(isSend = true) {
        saveBtn1.disabled = false;
        saveBtn1.innerHTML = !isSend
          ? `<span>${originalButtonText1}</span>`
          : `<span>جاري الحفظ ...</span>`;

        feather.replace();
      }
      function showToast(message, type = "info") {
        const container = document.getElementById("toastContainer");
        const toast = document.createElement("div");
        let bgColor =
          type === "success"
            ? "bg-green-600"
            : type === "error"
            ? "bg-red-600"
            : "bg-blue-600";
        let icon =
          type === "success"
            ? "check-circle"
            : type === "error"
            ? "alert-triangle"
            : "info";

        toast.className = `p-4 min-w-[250px] text-white ${bgColor} rounded-xl shadow-xl flex items-center justify-between transform transition-all duration-300 translate-x-full opacity-0`;
        toast.innerHTML = `
                <div class="flex items-center gap-3">
                    <i data-feather="${icon}" class="w-5 h-5"></i>
                    <span class="text-sm font-bold">${message}</span>
                </div>
                <button onclick="this.parentElement.remove()" class="mr-4"><i data-feather="x" class="w-4 h-4"></i></button>
            `;

        container.appendChild(toast);
        feather.replace();

        setTimeout(() => {
          toast.classList.remove("translate-x-full", "opacity-0");
        }, 10);

        setTimeout(() => {
          toast.classList.add("translate-x-full", "opacity-0");
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }
async function handleSubmit(event) {
    event.preventDefault();

    const form = event.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
  

    startLoading(true);

    try {
        const response = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
        });

        const result = await response.json();

        if (!response.ok) {
            throw new Error(result.message || "فشل التحديث");
        }

     
        showToast("تم تعديل الحساب بنجاح!", "success");

        // 4. التوجيه مع كسر الكاش (Cache Busting)
        setTimeout(() => {
            stopLoading(false);
            // إضافة Query String تجعل المتصفح يظن أنها صفحة جديدة ويجلب بيانات فريش
            window.location.href = "/";
        }, 1000);

    } catch (error) {
        stopLoading(false);
        showToast(error.message || error, "error");
    }
} 

async function handlePasswordSubmit(event) {
    event.preventDefault();

    const form = event.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    
  console.log(data);

    startLoading1(true);

    try {
        const response = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
        });

        const result = await response.json();

        if (!response.ok) {
             stopLoading1(false);
showToast(result.message, "error");            
          
        }else{
              showToast("تم تعديل كلمة المرور بنجاح!", "success");

        // 4. التوجيه مع كسر الكاش (Cache Busting)
        setTimeout(() => {
            stopLoading1(false);
            // إضافة Query String تجعل المتصفح يظن أنها صفحة جديدة ويجلب بيانات فريش
            window.location.href = "/";
        }, 1000);

        }

     
      
    } catch (error) {
        stopLoading1(false);
        showToast(error || error, "error");
    }
}


</script>
</body>
</html>