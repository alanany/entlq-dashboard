<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8">
    <title>منصة انطلق - جدول حصصي</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&family=Lobster+Two:wght@700&family=Cairo:wght@400;600;700;900&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            right: 0;
            background: #fff;
            box-shadow: -5px 0 15px rgba(0,0,0,0.05);
            z-index: 1000;
            transition: all 0.3s;
        }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
        }

        @media (max-width: 991.98px) {
            .sidebar { margin-right: -260px; }
            .sidebar.active { margin-right: 0; }
            .main-content { margin-right: 0; }
        }

        .nav-link {
            color: #6c757d;
            padding: 0.8rem 1.25rem;
            border-radius: 0.75rem;
            margin: 0.2rem 1rem;
            font-weight: 500;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            font-size: 0.85rem;
        }

        .nav-link i { margin-left: 1rem; font-size: 1.2rem; }
        .nav-link:hover, .nav-link.active { color: var(--primary); background-color: var(--secondary); }
        .nav-link.active { font-weight: 700; }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .session-card {
            border: none;
            border-radius: 1.5rem;
            background: #fff;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            transition: transform 0.3s;
        }

        .session-card:hover { transform: translateY(-5px); }

        .btn-join {
            background-color: var(--primary);
            color: #fff;
            border-radius: 1rem;
            padding: 0.6rem 1.5rem;
            font-weight: 700;
            border: none;
        }

        .btn-join:hover { background-color: #e44d2d; color: #fff; }

        .btn-wait { background-color: #f0f2f5; color: #adb5bd; border-radius: 1rem; padding: 0.6rem 1.5rem; font-weight: 700; border: none; }

        .tab-btn {
            border: none;
            background: #fff;
            padding: 0.7rem 2rem;
            border-radius: 1rem;
            font-weight: 700;
            color: #6c757d;
            transition: all 0.3s;
            margin-left: 0.5rem;
        }

        .tab-btn.active {
            background-color: var(--primary);
            color: #fff;
            box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.2);
        }

        .accordion-button:not(.collapsed) { background-color: var(--secondary); color: var(--primary); }
        .accordion-button:focus { box-shadow: none; }
        .accordion-item { border: none; margin-bottom: 0.5rem; border-radius: 1.5rem !important; overflow: hidden; box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,0.03); }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="p-4 text-center border-bottom">
            <h1 class="m-0 text-primary lobster-font" style="font-size: 2rem;">
                <i class="fa fa-book-reader me-2"></i><%= t('brand_name') %>
            </h1>
        </div>
        <div class="py-4">
            <a href="/" class="nav-link">
                <i class="fa fa-home"></i> الرئيسية
            </a>
            <a href="/student/my-sessions" class="nav-link active">
                <i class="fa fa-calendar-alt"></i> جدول الحصص
            </a>
            <a href="/student/courses_list" class="nav-link text-dark">
                <i class="fa fa-book"></i> استعراض الكورسات
            </a>
            <a href="/student/enrolled_subscription" class="nav-link text-dark">
                <i class="fa fa-file-invoice"></i> طلبات الانضمام
            </a>
            <a href="/student/billing" class="nav-link text-dark">
                <i class="fa fa-wallet"></i> الرصيد والدفع
            </a>
            <div class="mt-4 pt-4 border-top mx-3">
                <a href="/student/profile" class="nav-link text-dark">
                    <i class="fa fa-user-cog"></i> الإعدادات
                </a>
                <a href="#" data-bs-toggle="modal" data-bs-target="#logoutModal" class="nav-link text-danger mt-2">
                    <i class="fa fa-sign-out-alt"></i> تسجيل الخروج
                </a>
            </div>
        </div>
    </div>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fa fa-bars fs-5"></i>
                    </button>
                    <h2 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.5rem;">جدول حصصي والتقارير</h2>
                </div>
            <div class="d-flex align-items-center gap-3">
                <small class="text-primary fw-bold d-none d-md-block">التوقيت: <%= user.timezone || 'UTC' %></small>
                <div class="position-relative">
                    <i class="fa fa-bell text-muted fs-4"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge border border-light rounded-circle bg-danger p-1"></span>
                </div>
            </div>
        </div>

        <!-- Logic Section -->
        <% 
            const now = new Date();
            let upcoming = [];
            let past = [];

            if (bookings && bookings.length > 0) {
                bookings.forEach(booking => {
                    const courseTitle = booking.courseId?.title || 'كورس غير معروف';
                    const studentTZ = booking.studentId?.timezone || 'Asia/Riyadh';

                    (booking.sessions || []).forEach(session => {
                        const sessionStart = new Date(session.utcDateAndTime);
                        const sessionEnd = new Date(sessionStart.getTime() + 60 * 60 * 1000);
                        
                        const item = { 
                            session, courseTitle, studentTZ,
                            displayDate: session.displayDate, 
                            displayTime: session.displayTime, 
                            displayDay: session.displayDay,
                            isCompleted: session.status === 'completed' || sessionEnd < now 
                        };

                        if (item.isCompleted) past.push(item);
                        else upcoming.push(item);
                    });
                });
                upcoming.sort((a, b) => new Date(a.session.utcDateAndTime) - new Date(b.session.utcDateAndTime));
                past.sort((a, b) => new Date(b.session.utcDateAndTime) - new Date(a.session.utcDateAndTime));
            }
        %>

        <!-- Page Content -->
        <div class="mb-4 d-flex justify-content-center">
            <button onclick="switchTab('upcoming')" id="btn-up" class="tab-btn active">الحصص القادمة</button>
            <button onclick="switchTab('past')" id="btn-past" class="tab-btn">السابقة والتقارير</button>
        </div>

        <div id="upcoming-content">
            <% if (upcoming.length === 0) { %>
                <div class="stats-card p-5 text-center">
                    <p class="text-muted mb-0">لا توجد حصص مجدولة حالياً.</p>
                </div>
            <% } else { %>
                <div class="row g-4">
                    <% upcoming.forEach(item => { %>
                        <div class="col-md-6 col-xl-4 animate__animated animate__fadeIn">
                            <div class="session-card">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">قريباً</span>
                                    <small class="text-muted fw-bold"><%= item.displayDay %></small>
                                </div>
                                <h5 class="fw-bold mb-3"><%= item.courseTitle %></h5>
                                <div class="d-flex align-items-center gap-3 mb-4">
                                    <div class="small text-muted"><i class="fa fa-calendar-alt text-primary me-1"></i> <%= item.displayDate %></div>
                                    <div class="small fw-bold text-primary px-2 py-1 bg-secondary rounded"><i class="fa fa-clock me-1"></i> <%= item.displayTime %></div>
                                </div>
                                <% if (item.session.link) { %>
                                    <a href="<%= item.session.link %>" target="_blank" class="btn btn-join w-100">دخول الحصة</a>
                                <% } else { %>
                                    <button class="btn btn-wait w-100 fs-7" disabled>رابط الحصة سيظهر قريباً</button>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <div id="past-content" class="d-none animate__animated animate__fadeIn">
            <% if (past.length === 0) { %>
                <div class="stats-card p-5 text-center">
                    <p class="text-muted mb-0">لا يوجد سجل حصص سابقة.</p>
                </div>
            <% } else { %>
                <div class="accordion" id="reportAccordion">
                    <% past.forEach((item, index) => { %>
                        <div class="accordion-item shadow-sm">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed py-4 px-4" type="button" data-bs-toggle="collapse" data-bs-target="#collapse<%= index %>">
                                    <div class="stats-icon bg-light text-primary me-3" style="width: 40px; height: 40px;">
                                        <i class="fa fa-check-circle"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <span class="fw-bold text-dark d-block mb-1"><%= item.courseTitle %></span>
                                        <small class="text-muted"><%= item.displayDate %> - <%= item.displayTime %></small>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapse<%= index %>" class="accordion-collapse collapse" data-bs-parent="#reportAccordion">
                                <div class="accordion-body bg-light p-4">
                                    <div class="row g-4">
                                        <div class="col-md-8">
                                            <div class="card border-0 rounded-3 p-3 mb-3 shadow-sm">
                                                <h6 class="text-primary fw-bold mb-2"><i class="fa fa-comment-dots me-1"></i> ملاحظات المعلم :</h6>
                                                <p class="mb-0 small"><%= item.session.report?.content || 'لا توجد ملاحظات مسجلة.' %></p>
                                            </div>
                                            <div class="card border-0 rounded-3 p-3 shadow-sm">
                                                <h6 class="text-success fw-bold mb-2"><i class="fa fa-tasks me-1"></i> الواجب المنزلي :</h6>
                                                <p class="mb-0 small"><%= item.session.report?.instructions || 'لا يوجد واجبات مطلوبة.' %></p>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="card border-0 rounded-3 p-4 h-100 text-center shadow-sm">
                                                <small class="text-muted d-block mb-2">تقييم المستوي</small>
                                                <div class="mb-2">
                                                    <% let r = item.session.report?.level==='A' ? 3 : item.session.report?.level === 'B' ? 2 : item.session.report?.level === 'C' ? 1 : 0; 
                                                       for(let i=1; i<=3; i++){ %>
                                                        <i class="fa fa-star <%= i <= r ? 'text-warning' : 'text-muted opacity-25' %>"></i>
                                                    <% } %>
                                                </div>
                                                <h3 class="fw-bold mb-0 text-primary"><%= r %>/3</h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة كيدر التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>

    <!-- Modals -->
    <div class="modal fade" id="logoutModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-5 text-center">
                    <div class="stats-icon bg-danger bg-opacity-10 text-danger mx-auto mb-4 animate__animated animate__pulse animate__infinite" style="width: 100px; height: 100px; border-radius: 50%;">
                        <i class="fa fa-sign-out-alt fs-1"></i>
                    </div>
                    <h3 class="fw-bold mb-3">تسجيل الخروج؟</h3>
                    <p class="text-muted mb-4 fs-5">هل أنت متأكد أنك تريد مغادرة حسابك؟</p>
                    <div class="d-flex gap-3">
                        <button class="btn btn-light rounded-pill flex-grow-1" data-bs-dismiss="modal">إلغاء</button>
                        <a href="/student/logout" class="btn btn-danger rounded-pill flex-grow-1">خروج</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        $('#sidebarCollapse').on('click', () => $('#sidebar').toggleClass('active'));

        function switchTab(type) {
            if(type === 'upcoming') {
                $('#upcoming-content').removeClass('d-none');
                $('#past-content').addClass('d-none');
                $('#btn-up').addClass('active');
                $('#btn-past').removeClass('active');
            } else {
                $('#upcoming-content').addClass('d-none');
                $('#past-content').removeClass('d-none');
                $('#btn-up').removeClass('active');
                $('#btn-past').addClass('active');
            }
        }
    </script>
</body>
</html>