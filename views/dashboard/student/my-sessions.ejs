<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>جدول حصصي المتكامل</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }
        .mobile-bottom-nav { @apply lg:hidden fixed bottom-0 left-0 right-0 h-20 bg-white/95 backdrop-blur-xl border-t border-gray-100 flex items-center justify-around px-2 pb-5 z-[9999] shadow-[0_-5px_20px_rgba(0,0,0,0.05)]; }
        .nav-tab { @apply flex flex-col items-center justify-center flex-1 h-full transition-all duration-300; color: #9ca3af; }
        .nav-tab.active { color: #5e35b1 !important; }
        .accordion-content { transition: max-height 0.3s ease-out; overflow: hidden; }
        @media (max-width: 1024px) { body { padding-bottom: 100px; } }
    </style>
</head>
<body class="pb-20">

<div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-xl font-bold text-gray-600 flex items-center">
                <i data-feather="calendar" class="ml-3 w-8 h-8 text-indigo-400"></i>
                جدول الحصص والتقارير
            </h1>
            <p class="text-[10px] text-indigo-500 font-bold mt-1 uppercase tracking-widest">
                التوقيت الحالي للمنطقة: <%= user.timezone || 'UTC' %>
            </p>
        </div>

        <div class="inline-flex p-1 bg-gray-200 rounded-2xl shadow-inner font-bold">
            <button onclick="switchTab('upcoming')" id="tab-upcoming" class="px-6 py-2 rounded-xl transition-all duration-200 bg-indigo-600 text-white shadow-md">الحصص القادمة</button>
            <button onclick="switchTab('past')" id="tab-past" class="px-6 py-2 rounded-xl transition-all duration-200 text-gray-600 hover:bg-gray-100">السابقة والتقارير</button>
        </div>
    </div>

    <% 
    const now = new Date();
    let upcoming = [];
    let past = [];

    if (bookings && bookings.length > 0) {
        bookings.forEach(booking => {
            const courseTitle = booking.courseId?.title || 'كورس غير معروف';
            const studentName = booking.studentId?.name || 'طالب غير معروف';
            const studentTZ = booking.studentId?.timezone || 'Asia/Riyadh';

            (booking.sessions || []).forEach(session => {
                // ملاحظة: نستخدم التاريخ الأصلي utcDateAndTime للمقارنة لأنه الأكثر دقة
                // ونستخدم displayDate و displayTime اللذين جهزناهما للعرض فقط
                
                const sessionStart = new Date(session.utcDateAndTime);
                // افتراض أن الجلسة مدتها ساعة واحدة (3600000 مللي ثانية)
                const sessionEnd = new Date(sessionStart.getTime() + 60 * 60 * 1000);
                
                const item = { 
                    session, 
                    courseTitle, 
                    studentName, 
                    displayDate: session.displayDate, 
                    displayTime: session.displayTime, 
                    displayDay: session.displayDay,
                    studentTZ,
                    // الحصة منتهية إذا كانت حالتها مكتملة أو مر وقتها الفعلي
                    isCompleted: session.status === 'completed' || sessionEnd < now 
                };

                if (item.isCompleted) {
                    past.push(item);
                } else {
                    upcoming.push(item);
                }
            });
        });

        // ترتيب الحصص القادمة من الأقرب للأبعد
        upcoming.sort((a, b) => new Date(a.session.utcDateAndTime) - new Date(b.session.utcDateAndTime));
        
        // ترتيب الحصص السابقة من الأحدث للأقدم
        past.sort((a, b) => new Date(b.session.utcDateAndTime) - new Date(a.session.utcDateAndTime));
    }
%>

    <div id="upcoming-content">
        <% if (upcoming.length === 0) { %>
            <div class="p-20 text-center bg-white rounded-[2.5rem] border-2 border-dashed border-gray-200 text-gray-400 font-bold">لا توجد حصص مجدولة حالياً.</div>
        <% } else { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% upcoming.forEach((item, i) => { %>
                    <div class="bg-white p-6 rounded-[2rem] border-2 border-white shadow-sm hover:shadow-indigo-100 transition-all duration-300">
                        <div class="flex justify-between mb-4">
                            <span class="bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full text-[10px] font-black italic">قادمة</span>
                        </div>
                        <h3 class="text-xl font-black text-gray-900 mb-1"><%= item.courseTitle %></h3>
                        
                        <div class="space-y-3 mt-4 mb-6">
                            <div class="flex items-center gap-2 text-sm font-bold text-gray-600">
                                <i data-feather="calendar" class="w-4 h-4 text-indigo-400"></i>
                                <span class="local-date"   data-tz="<%= item.displayDate %>"> <%= item.displayDate %></span>
                            </div>
                            <div class="flex items-center gap-2 text-sm font-bold text-indigo-600 bg-indigo-50/50 p-2 rounded-lg w-fit">
                                <i data-feather="clock" class="w-4 h-4 text-indigo-500"></i>
                                <span class="local-time font-black" data-utc="<%= item.rawDate %>" data-time="<%= item.rawTime %>" data-tz="<%= item.studentTZ %>"><%= item.displayTime %></span>
                            </div>
                        </div>

                        <% if (item.session.link) { %>
                            <a href="<%= item.session.link %>" target="_blank" class="w-full py-3 bg-indigo-600 text-white rounded-2xl font-black text-center block shadow-md hover:bg-indigo-700 transition">دخول الحصة</a>
                        <% } else { %>
                            <div class="w-full py-3 bg-gray-100 text-gray-400 rounded-2xl font-black text-center text-xs">رابط الحصة سيظهر قريباً</div>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <div id="past-content" class="hidden space-y-4">
        <% if (past.length === 0) { %>
            <div class="p-10 text-center text-gray-400 font-bold">لا يوجد سجل حصص سابقة.</div>
        <% } else { %>
            <% past.forEach((item, index) => { %>
                <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden transition-all hover:border-indigo-200">
                    <button onclick="toggleAccordion('<%= index %>')" class="w-full flex items-center justify-between px-8 py-6 outline-none">
                        <div class="flex items-center gap-5 text-right">
                            <div class="w-12 h-12 bg-gray-50 text-indigo-600 rounded-2xl flex items-center justify-center font-black"><i data-feather="check-circle" class="w-5 h-5"></i></div>
                            <div>
                                <h4 class="font-black text-gray-900"><%= item.courseTitle %></h4>
                                <div class="flex gap-3 mt-1">
                                    <span class="text-[10px] text-gray-400 font-bold local-date" data-utc="<%= item.rawDate %>" data-time="<%= item.rawTime %>" data-tz="<%= item.studentTZ %>"></span>
                                    <span class="text-[10px] text-indigo-400 font-black local-time" data-utc="<%= item.rawDate %>" data-time="<%= item.rawTime %>" data-tz="<%= item.studentTZ %>"></span>
                                </div>
                            </div>
                        </div>
                        <i data-feather="chevron-down" id="icon-<%= index %>" class="w-5 h-5 text-gray-300 transition-transform duration-300"></i>
                    </button>

                    <div id="report-<%= index %>" class="max-h-0 accordion-content bg-gray-50/50 border-t border-gray-100">
                        <div class="p-8 grid grid-cols-1 md:grid-cols-3 gap-8">
                            <div class="md:col-span-2 space-y-4 font-medium text-right">
                                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                                    <h5 class="text-[10px] font-black text-indigo-600 mb-2 uppercase italic">ملاحظات المعلم</h5>
                                    <p class="text-sm text-gray-700 leading-relaxed"><%= item.session.report?.content || 'لا توجد ملاحظات مسجلة لهذه الحصة.' %></p>
                                </div>
                                <div class="bg-white p-5 rounded-2xl shadow-sm border border-gray-100">
                                    <h5 class="text-[10px] font-black text-green-600 mb-2 uppercase italic">الواجب المنزلي</h5>
                                    <p class="text-sm text-gray-700 leading-relaxed"><%= item.session.report?.instructions || 'لا يوجد واجبات مطلوبة.' %></p>
                                </div>
                            </div>
                            <div class="bg-white p-6 rounded-3xl shadow-sm flex flex-col justify-center items-center text-center">
                                <p class="text-[10px] font-black text-gray-400 mb-4 uppercase">تقييم الأداء</p>
                                <div class="flex gap-1 mb-2">
                                    <% let r = item.session.report?.level==='A' ? 3 : item.session.report?.level === 'B' ? 2 : item.session.report?.level === 'C' ? 1 : 0; 
                                       for(let i=1; i<=3; i++){ %>
                                        <i data-feather="star" class="w-5 h-5 <%= i <= r ? 'text-yellow-400 fill-yellow-400' : 'text-gray-200' %>"></i>
                                    <% } %>
                                </div>
                                <p class="font-black text-gray-900 text-xl mt-2"><%= r %>/3</p>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<%- include('../../partials/bottom-nav.ejs', {currentPage: 'sessions'}) %>

<script>
    // تهيئة الأيقونات
    feather.replace();

    /**
     * محرك تحويل التوقيت
     * يقوم بتحويل التاريخ والوقت الخام إلى توقيت الطالب المحلي
     */

    // التنفيذ عند تحميل الصفحة
    document.addEventListener('DOMContentLoaded', () => {
    });

    // تبديل التابات
    function switchTab(type) {
        const upBtn = document.getElementById('tab-upcoming');
        const pastBtn = document.getElementById('tab-past');
        const upContent = document.getElementById('upcoming-content');
        const pastContent = document.getElementById('past-content');

        if (type === 'upcoming') {
            upBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-md');
            upBtn.classList.remove('text-gray-600');
            pastBtn.classList.remove('bg-indigo-600', 'text-white', 'shadow-md');
            pastBtn.classList.add('text-gray-600');
            upContent.classList.remove('hidden');
            pastContent.classList.add('hidden');
        } else {
            pastBtn.classList.add('bg-indigo-600', 'text-white', 'shadow-md');
            pastBtn.classList.remove('text-gray-600');
            upBtn.classList.remove('bg-indigo-600', 'text-white', 'shadow-md');
            upBtn.classList.add('text-gray-600');
            upContent.classList.add('hidden');
            pastContent.classList.remove('hidden');
        }
        feather.replace();
    }

    // فتح وإغلاق التقارير (الأكورديون)
    function toggleAccordion(index) {
        const content = document.getElementById('report-' + index);
        const icon = document.getElementById('icon-' + index);
        
        if (content.style.maxHeight && content.style.maxHeight !== '0px') {
            content.style.maxHeight = '0px';
            icon.style.transform = 'rotate(0deg)';
        } else {
            // إغلاق أي أكورديون مفتوح آخر اختيارياً
            document.querySelectorAll('.accordion-content').forEach(el => el.style.maxHeight = '0px');
            document.querySelectorAll('[id^="icon-"]').forEach(el => el.style.transform = 'rotate(0deg)');
            
            content.style.maxHeight = content.scrollHeight + 'px';
            icon.style.transform = 'rotate(180deg)';
        }
    }
</script>
</body>
</html>