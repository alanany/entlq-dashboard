<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8">
    <title><%= t('settings') %> - <%= t('brand_name') %></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            right: 0;
            background: #fff;
            box-shadow: -5px 0 15px rgba(0,0,0,0.05);
            z-index: 1000;
            transition: all 0.3s;
        }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        @media (max-width: 991.98px) {
            .sidebar { margin-right: -260px; }
            .sidebar.active { margin-right: 0; }
            .main-content { margin-right: 0; }
        }

        .nav-link {
            color: #6c757d;
            padding: 0.8rem 1.25rem;
            border-radius: 0.75rem;
            margin: 0.2rem 1rem;
            font-weight: 500;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            font-size: 0.85rem;
        }

        .nav-link i { margin-left: 1rem; font-size: 1.2rem; }
        .nav-link:hover, .nav-link.active { color: var(--primary); background-color: var(--secondary); }
        .nav-link.active { font-weight: 700; }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .profile-card {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            padding: 2.5rem;
            text-align: center;
            margin-bottom: 2rem;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .avatar-box {
            width: 100px;
            height: 100px;
            background-color: var(--primary);
            color: #fff;
            border-radius: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: 800;
            margin: 0 auto 1.5rem;
            box-shadow: 0 1rem 2rem rgba(254, 93, 55, 0.2);
            position: relative;
        }

        .avatar-edit-btn {
            position: absolute;
            bottom: -5px;
            right: -5px;
            width: 32px;
            height: 32px;
            background: #fff;
            border: 1px solid #eee;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6c757d;
            box-shadow: 0 0.25rem 0.5rem rgba(0,0,0,0.1);
            cursor: pointer;
            transition: all 0.3s;
        }

        .avatar-edit-btn:hover { color: var(--primary); transform: scale(1.1); }

        .settings-group {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            overflow: hidden;
            margin-bottom: 2rem;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .settings-item {
            padding: 1.25rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #444;
            text-decoration: none;
            transition: all 0.3s;
            border-bottom: 1px solid #f1f1f1;
        }

        .settings-item:last-child { border-bottom: none; }
        .settings-item:hover { background-color: #fafbfc; }

        .settings-icon-kider {
            position: relative;
            width: 30px;
            height: 30px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
            z-index: 1;
            margin-left: 1rem;
        }

        .settings-icon-kider::before {
            position: absolute;
            content: "";
            width: 100%;
            height: 100%;
            background: rgba(254, 93, 55, 0.1);
            border-radius: 30px;
            z-index: -1;
        }

        .group-label {
            font-size: 0.7rem;
            font-weight: 800;
            color: #adb5bd;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 0.75rem;
            padding-right: 0.5rem;
        }

        .form-switch .form-check-input {
            width: 2.5em;
            height: 1.25em;
            cursor: pointer;
        }

        .form-check-input:checked { background-color: var(--primary); border-color: var(--primary); }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <%- include('./_student_sidebar', { activePage: 'settings' }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fa fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;"><%= t('settings') %></h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Manage your professional profile</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold outfit-font" style="width: 40px; height: 40px;">
                        <%= user.name.charAt(0).toUpperCase() %>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid max-w-lg p-0 animate__animated animate__fadeInUp" style="max-width: 600px;">
            <!-- Profile Header -->
            <div class="profile-card">
                <div class="avatar-box">
                    <%= user.name.charAt(0).toUpperCase() %>
                    <div class="avatar-edit-btn">
                        <i class="fa fa-camera small"></i>
                    </div>
                </div>
                <h3 class="fw-black mb-1"><%= user.name %></h3>
                <p class="text-muted outfit-font small mb-0"><%= user.email %></p>
            </div>

            <!-- Settings Group 1 -->
            <div class="group-label">إعدادات الحساب</div>
            <div class="settings-group mb-4">
                <a href="/student/enrolled_subscription" class="settings-item">
                    <div class="d-flex align-items-center">
                        <div class="settings-icon-kider text-primary">
                            <i class="fa fa-file-invoice"></i>
                        </div>
                        <span class="fw-bold small">طلبات الانضمام</span>
                    </div>
                    <i class="fa fa-chevron-left text-muted opacity-25 small"></i>
                </a>
                <a href="/student/billing" class="settings-item">
                    <div class="d-flex align-items-center">
                        <div class="settings-icon-kider text-primary">
                            <i class="fa fa-wallet"></i>
                        </div>
                        <span class="fw-bold small">الرصيد والدفع</span>
                    </div>
                    <i class="fa fa-chevron-left text-muted opacity-25 small"></i>
                </a>
                <a href="/student/edit-profile" class="settings-item">
                    <div class="d-flex align-items-center">
                        <div class="settings-icon-kider text-primary">
                            <i class="fa fa-user-edit"></i>
                        </div>
                        <span class="fw-bold small">تعديل البيانات الشخصية</span>
                    </div>
                    <i class="fa fa-chevron-left text-muted opacity-25 small"></i>
                </a>
                <a href="/student/change-password" class="settings-item">
                    <div class="d-flex align-items-center">
                        <div class="settings-icon-kider text-primary">
                            <i class="fa fa-lock"></i>
                        </div>
                        <span class="fw-bold small">تغيير كلمة المرور</span>
                    </div>
                    <i class="fa fa-chevron-left text-muted opacity-25 small"></i>
                </a>
                <div class="settings-item">
                    <div class="d-flex align-items-center">
                        <div class="settings-icon-kider text-success">
                            <i class="fa fa-bell"></i>
                        </div>
                        <span class="fw-bold small">تنبيهات الحصص</span>
                    </div>
                    <div class="form-check form-switch p-0 m-0">
                        <input class="form-check-input ms-0" type="checkbox" checked>
                    </div>
                </div>
            </div>

            <!-- Settings Group 2 -->
            <div class="group-label">المساعدة والدعم</div>
            <div class="settings-group">
                <a href="https://wa.me/+966581734347" target="_blank" class="settings-item">
                    <div class="d-flex align-items-center">
                        <div class="settings-icon-kider text-success">
                            <i class="fab fa-whatsapp"></i>
                        </div>
                        <div>
                            <span class="fw-bold small d-block">تواصل معنا</span>
                            <small class="text-muted" style="font-size: 0.6rem;">متاحون دائماً لخدمتك عبر واتساب</small>
                        </div>
                    </div>
                    <i class="fa fa-external-link-alt text-muted opacity-25 small"></i>
                </a>
            </div>

            <!-- Exit Button -->
            <div class="text-center mt-5">
                <button data-bs-toggle="modal" data-bs-target="#logoutModal" class="btn btn-outline-danger border-0 rounded-pill px-4 py-2 small fw-bold">
                    <i class="fa fa-sign-out-alt me-2"></i> تسجيل الخروج
                </button>
                <p class="text-muted opacity-25 mt-4" style="font-size: 0.6rem;">إصدار التطبيق 2.0.1 &copy; 2024</p>
            </div>
        </div>

        <footer class="mt-auto py-4 text-center text-muted border-top">
            <small>&copy; <%= t('brand_name') %> 2024 - <%= t('all_rights_reserved') %></small>
        </footer>
    </div>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-4 text-center">
                    <div class="settings-icon-kider bg-danger bg-opacity-10 text-danger mx-auto mb-3" style="width: 60px; height: 60px; font-size: 1.5rem;">
                        <i class="fa fa-sign-out-alt"></i>
                    </div>
                    <h5 class="fw-bold mb-2">تأكيد الخروج</h5>
                    <p class="text-muted small mb-4">هل أنت متأكد أنك تريد مغادرة حسابك الآن؟</p>
                    <div class="d-flex gap-2">
                        <button class="btn btn-light rounded-pill flex-grow-1 small" data-bs-dismiss="modal">إلغاء</button>
                        <a href="/student/logout" class="btn btn-danger rounded-pill flex-grow-1 small">نعم، اخرج</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        $('#sidebarCollapse').on('click', () => $('#sidebar').toggleClass('active'));
    </script>
</body>

</html>