<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - Professional Login</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Inter:wght@600&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            background-color: var(--secondary);
            overflow-x: hidden;
        }

        .login-card {
            border: none;
            border-radius: 2rem;
            overflow: hidden;
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175);
        }

        .login-img {
            background: linear-gradient(rgba(254, 93, 55, .8), rgba(254, 93, 55, .8)), url('/img/carousel-1.jpg');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3rem;
            color: #fff;
            text-align: center;
        }

        .login-form-container {
            padding: 4rem;
            background: #fff;
        }

        .form-floating > .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.25rem rgba(254, 93, 55, .25);
        }

        .btn-login {
            background-color: var(--primary);
            border: none;
            color: #fff;
            padding: 1rem;
            font-weight: 600;
            border-radius: 1rem;
            transition: all .3s ease;
        }

        .btn-login:hover {
            background-color: #e44d2d;
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        }

        .social-login {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 2rem;
        }

        .social-btn {
            width: 3rem;
            height: 3rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #dee2e6;
            color: var(--dark);
            transition: all .3s ease;
        }

        .social-btn:hover {
            background-color: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }
    </style>
</head>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<body>
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->
     <nav class="navbar navbar-expand-lg bg-white navbar-light sticky-top px-4 px-lg-5 py-lg-0">
            <a href="/" class="navbar-brand">
                <h1 class="m-0 text-primary"><i class="fa fa-book-reader me-3"></i><%= t('brand_name') %></h1>
            </a>
            <div class="ms-auto d-flex align-items-center">
                <a href="/student/login" class="btn btn-outline-primary rounded-pill px-3 me-2">Login</a>
                <a href="/student/register" class="btn btn-primary rounded-pill px-3">Register</a>
            </div>
        </nav>
      
        <div class="container-fluid py-5" style="background-color: var(--secondary); min-height: 90vh; display: flex; align-items: center;">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="card login-card animate__animated animate__fadeIn">
                            <div class="row g-0">
                                <div class="col-md-5 login-img d-none d-md-flex">
                                    <h2 class="lobster-font display-4 mb-4">Welcome Back!</h2>
                                    <p class="fs-5 mb-5">"Education is the most powerful weapon which you can use to change the world."</p>
                                    <div class="mt-auto">
                                        <p class="small mb-0 opacity-75">&copy; 2024 <%= t('brand_name') %> Preschool</p>
                                    </div>
                                </div>
                                <div class="col-md-7 login-form-container">
                                    <div class="mb-5 text-center text-md-start">
                                        <h2 class="fw-bold mb-2">Student Login</h2>
                                        <p class="text-muted">Enter your credentials to access your dashboard</p>
                                    </div>
                                    <form onsubmit="handleSubmit(event)">
                                        <div class="form-floating mb-3">
                                            <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
                                            <label for="email">Email address</label>
                                        </div>
                                        <div class="form-floating mb-4">
                                            <input type="password" class="form-control" id="password" placeholder="Password" required>
                                            <label for="password">Password</label>
                                        </div>
                                        
                                        <input type="hidden" name="timezone" id="timezoneHiddenInput">

                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="remember-me">
                                                <label class="form-check-label" for="remember-me">Remember Me</label>
                                            </div>
                                            <a href="#" class="text-primary small">Forgot Password?</a>
                                        </div>

                                        <button id="saveBtn" type="submit" class="btn btn-login w-100 mb-4">
                                            SIGN IN
                                        </button>

                                        <div class="text-center">
                                            <p class="text-muted">Or login with</p>
                                            <div class="social-login">
                                                <a href="#" class="social-btn"><i class="fab fa-google"></i></a>
                                                <a href="#" class="social-btn"><i class="fab fa-facebook-f"></i></a>
                                                <a href="#" class="social-btn"><i class="fab fa-apple"></i></a>
                                            </div>
                                            <p class="mt-5 mb-0">Don't have an account? <a href="/student/register" class="text-primary fw-bold">Register here</a></p>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

   
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050"></div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/wow/wow.min.js"></script>
    <script src="/js/main.js"></script>

    <script>
        // Timezone Logic
        const hiddenInput = document.getElementById('timezoneHiddenInput');
        const userDefault = Intl.DateTimeFormat().resolvedOptions().timeZone;
        hiddenInput.value = userDefault;

        const saveBtn = document.getElementById("saveBtn");
        const originalButtonText = "SIGN IN"; 

        function startLoading() {
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> SIGNING IN...';
        }

        function stopLoading() {
            saveBtn.disabled = false;
            saveBtn.textContent = originalButtonText; 
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            let bgClass = 'bg-primary';
            if (type === 'success') bgClass = 'bg-success';
            if (type === 'error') bgClass = 'bg-danger';

            const toastElem = document.createElement('div');
            toastElem.className = `toast align-items-center text-white ${bgClass} border-0 mb-2`;
            toastElem.setAttribute('role', 'alert');
            toastElem.setAttribute('aria-live', 'assertive');
            toastElem.setAttribute('aria-atomic', 'true');
            toastElem.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>`;
            container.appendChild(toastElem);
            const bsToast = new bootstrap.Toast(toastElem);
            bsToast.show();
            toastElem.addEventListener('hidden.bs.toast', () => toastElem.remove());
        }

        async function handleSubmit(event) {
            event.preventDefault(); 
            const userData = {
                email: document.getElementById('email').value,
                password: document.getElementById('password').value,
                role: 'student',
                timezone: userDefault
            };

            startLoading();
    
                 const response = await axios.post('/student/login', userData)
                 .then((response)=>{

                    showToast("Login Successful!", 'success'); 
                    setTimeout(() => window.location.href = '/', 1000);
                })
                .catch((error)=>{
                    stopLoading();
                    const msg = error.response.data.error || "Login Failed";
                    showToast(msg, 'error');
                })  

        }
    </script>
</body>
</html>