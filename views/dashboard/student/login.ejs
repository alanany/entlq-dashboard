<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= dir %>">

<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - <%= t('login') %></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600&family=Cairo:wght@400;600;700&family=Inter:wght@600&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            background-color: var(--secondary);
            overflow-x: hidden;
            font-family: '<%= currentLang === "ar" ? "Cairo" : "Heebo" %>', sans-serif;
        }

        .login-card {
            border: none;
            border-radius: 2rem;
            overflow: hidden;
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175);
        }

        .login-img {
            background: linear-gradient(rgba(254, 93, 55, .8), rgba(254, 93, 55, .8)), url('/img/carousel-1.jpg');
            background-size: cover;
            background-position: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3rem;
            color: #fff;
            text-align: center;
        }

        .login-form-container {
            padding: 4rem;
            background: #fff;
        }

        .form-floating > .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 0.25rem rgba(254, 93, 55, .25);
        }

        .btn-login {
            background-color: var(--primary);
            border: none;
            color: #fff;
            padding: 1rem;
            font-weight: 600;
            border-radius: 1rem;
            transition: all .3s ease;
        }

        .btn-login:hover {
            background-color: #e44d2d;
            transform: translateY(-2px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15);
        }

        .social-login {
            display: flex;
            gap: 1rem;
            justify-content: center;
            margin-top: 2rem;
        }

        .social-btn {
            width: 3rem;
            height: 3rem;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #dee2e6;
            color: var(--dark);
            transition: all .3s ease;
        }

        .social-btn:hover {
            background-color: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }
    </style>
</head>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<body>
    <div class="container-xxl bg-white p-0">
        <!-- Spinner Start -->
        <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <!-- Spinner End -->
     <nav class="navbar navbar-expand-lg bg-white navbar-light sticky-top px-4 px-lg-5 py-lg-0">
            <a href="/" class="navbar-brand">
                <h1 class="m-0 text-primary"><i class="fa fa-book-reader me-3"></i><%= t('brand_name') %></h1>
            </a>
            <div class="ms-auto d-flex align-items-center">
                <a href="/lang/<%= currentLang === 'ar' ? 'en' : 'ar' %>" class="btn btn-outline-primary rounded-pill px-3 me-2">
                    <%= currentLang === 'ar' ? 'English' : 'العربية' %>
                </a>
                <a href="/student/login" class="btn btn-outline-primary rounded-pill px-3 me-2"><%= t('login') %></a>
                <!-- <a href="/student/register" class="btn btn-primary rounded-pill px-3"><%= t('register') %></a> -->
            </div>
        </nav>
      
        <div class="container-fluid py-5" style="background-color: var(--secondary); min-height: 90vh; display: flex; align-items: center;">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="card login-card animate__animated animate__fadeIn">
                            <div class="row g-0">
                                <div class="col-md-5 login-img d-none d-md-flex">
                                    <h2 class="lobster-font display-4 mb-4"><%= t('login_welcome') %></h2>
                                    <p class="fs-5 mb-5">"<%= t('login_quote') %>"</p>
                                    <div class="mt-auto">
                                        <p class="small mb-0 opacity-75">&copy; 2024 <%= t('brand_name') %></p>
                                    </div>
                                </div>
                                <div class="col-md-7 login-form-container">
                                    <div class="mb-5 text-center text-md-start">
                                        <h2 class="fw-bold mb-2"><%= t('login_student_title') %></h2>
                                        <p class="text-muted"><%= t('login_subtitle') %></p>
                                    </div>
                                    <form onsubmit="handleSubmit(event)">
                                        <div class="form-floating mb-3">
                                            <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
                                            <label for="email"><%= t('email_label') %></label>
                                        </div>
                                        <div class="form-floating mb-4">
                                            <input type="password" class="form-control" id="password" placeholder="Password" required>
                                            <label for="password"><%= t('password_label') %></label>
                                        </div>
                                        
                                        <input type="hidden" name="timezone" id="timezoneHiddenInput">

                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="remember-me">
                                                <label class="form-check-label" for="remember-me"><%= t('remember_me') %></label>
                                            </div>
                                            <a href="#" class="text-primary small"><%= t('forgot_password') %></a>
                                        </div>

                                        <button id="saveBtn" type="submit" class="btn btn-login w-100 mb-4">
                                            <%= t('sign_in_btn') %>
                                        </button>

                                        <div class="text-center">
                                            <p class="text-muted"><%= t('login_with_social') %></p>
                                            <div class="social-login">
                                                <a href="#" class="social-btn"><i class="fab fa-google"></i></a>
                                                <a href="#" class="social-btn"><i class="fab fa-facebook-f"></i></a>
                                                <a href="#" class="social-btn"><i class="fab fa-apple"></i></a>
                                            </div>
                                            <!-- <p class="mt-5 mb-0"><%= t('no_account') %> <a href="/student/register" class="text-primary fw-bold"><%= t('register_here') %></a></p> -->
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

   
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050"></div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/wow/wow.min.js"></script>
    <script src="/js/main.js"></script>

    <script>
        // Pass translations to the external JS file
        window.loginTranslations = {
            signing_in: "<%= t('signing_in') %>",
            sign_in_btn: "<%= t('sign_in_btn') %>",
            login_success: "<%= t('login_success') %>",
            login_failed: "<%= t('login_failed') %>"
        };
    </script>
    <script src="/js/student-login.js"></script>
</body>
</html>