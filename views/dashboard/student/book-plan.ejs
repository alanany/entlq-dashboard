<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title>حجز خطة الحصص - <%= t('brand_name') %></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        /* Header */
        .top-header {
            background: #fff;
            padding: 1.5rem 0;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
        }

        .btn-back {
            background: var(--light);
            border: 1px solid #dee2e6;
            padding: 0.5rem 1.5rem;
            border-radius: 2rem;
            font-weight: 700;
            transition: all 0.3s;
        }

        .btn-back:hover {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

        /* Step Indicator */
        .steps-container {
            background: #fff;
            padding: 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
        }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            flex: 1;
        }

        .step-number {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: #e9ecef;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 900;
            font-size: 1.25rem;
            margin-bottom: 0.75rem;
            transition: all 0.3s;
            z-index: 2;
        }

        .step-item.active .step-number {
            background: var(--primary);
            color: #fff;
            box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.3);
        }

        .step-item.completed .step-number {
            background: #22c55e;
            color: #fff;
        }

        .step-label {
            font-size: 0.9rem;
            font-weight: 700;
            color: #6c757d;
        }

        .step-item.active .step-label {
            color: var(--primary);
        }

        .step-line {
            position: absolute;
            top: 25px;
            left: 50%;
            right: -50%;
            height: 3px;
            background: #e9ecef;
            z-index: 1;
        }

        .step-item:last-child .step-line {
            display: none;
        }

        .step-item.completed .step-line {
            background: #22c55e;
        }

        /* Content Cards */
        .content-card {
            background: #fff;
            border-radius: 1.5rem;
            padding: 2rem;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.05);
            border: 1px solid #f1f1f1;
        }

        .card-title {
            font-size: 1.5rem;
            font-weight: 900;
            color: var(--dark);
            margin-bottom: 1.5rem;
        }

        /* Course Card */
        .course-card {
            border: 2px solid #f1f1f1;
            border-radius: 1.25rem;
            overflow: hidden;
            transition: all 0.3s;
            cursor: pointer;
        }

        .course-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.1);
            border-color: var(--primary);
        }

        .course-card.selected {
            border-color: var(--primary);
            background: var(--secondary);
        }

        .course-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .course-body {
            padding: 1.5rem;
        }

        .course-category {
            background: var(--secondary);
            color: var(--primary);
            padding: 0.35rem 1rem;
            border-radius: 2rem;
            font-size: 0.75rem;
            font-weight: 800;
            display: inline-block;
            margin-bottom: 0.75rem;
        }

        .course-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 0.75rem;
        }

        .course-description {
            font-size: 0.9rem;
            color: #6c757d;
            line-height: 1.6;
        }

        /* Form Controls */
        .form-select-custom,
        .form-control-custom {
            border: 2px solid #eef0f2;
            border-radius: 1rem;
            padding: 0.85rem 1.25rem;
            font-weight: 600;
            font-size: 0.95rem;
            background: #f8fafc;
            transition: all 0.3s;
        }

        .form-select-custom:focus,
        .form-control-custom:focus {
            background: #fff;
            border-color: var(--primary);
            box-shadow: 0 0 0 0.25rem rgba(254, 93, 55, 0.1);
        }

        .form-label-custom {
            font-weight: 700;
            color: var(--dark);
            margin-bottom: 0.75rem;
            font-size: 0.95rem;
        }

        /* Summary Box */
        .summary-box {
            background: linear-gradient(135deg, #f8fafc 0%, #fff 100%);
            border: 2px solid var(--primary);
            border-radius: 1.25rem;
            padding: 1.5rem;
        }

        .summary-title {
            font-size: 1.1rem;
            font-weight: 900;
            color: var(--dark);
            margin-bottom: 1rem;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px solid #f1f1f1;
        }

        .summary-row:last-child {
            border-bottom: none;
            padding-top: 1rem;
        }

        .summary-label {
            color: #6c757d;
            font-weight: 600;
        }

        .summary-value {
            font-weight: 800;
            color: var(--dark);
        }

        .price-value {
            color: #22c55e;
            font-size: 1.5rem;
        }

        /* Payment Methods */
        .payment-option {
            border: 2px solid #f1f1f1;
            border-radius: 1rem;
            padding: 1.25rem;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 1rem;
        }

        .payment-option:hover {
            border-color: var(--primary);
            background: var(--secondary);
        }

        .payment-option input[type="radio"]:checked ~ .payment-content {
            color: var(--primary);
        }

        .payment-option input[type="radio"]:checked ~ * {
            border-color: var(--primary);
        }

        /* Buttons */
        .btn-primary-custom {
            background: var(--primary);
            border: none;
            padding: 0.85rem 2.5rem;
            border-radius: 2rem;
            font-weight: 800;
            font-size: 1rem;
            transition: all 0.3s;
            box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.2);
        }

        .btn-primary-custom:hover {
            background: #ff4520;
            transform: translateY(-2px);
            box-shadow: 0 0.75rem 1.5rem rgba(254, 93, 55, 0.3);
        }

        .btn-secondary-custom {
            background: #e9ecef;
            border: none;
            padding: 0.85rem 2rem;
            border-radius: 2rem;
            font-weight: 700;
            color: #6c757d;
            transition: all 0.3s;
        }

        .btn-secondary-custom:hover {
            background: #dee2e6;
            color: var(--dark);
        }

        /* Alert Box */
        .alert-custom {
            background: #fff3cd;
            border: 2px solid #ffc107;
            border-radius: 1rem;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .alert-custom-title {
            font-weight: 800;
            color: #856404;
            margin-bottom: 0.5rem;
        }

        .alert-custom-text {
            color: #856404;
            font-size: 0.9rem;
        }

        /* Hidden class */
        .hidden {
            display: none !important;
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="top-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-primary fw-900 lobster-font">
                    <i class="fas fa-calendar-alt me-2"></i>
                    معالج حجز خطة الحصص
                </h5>
                <a href="/" class="btn btn-back">
                    <i class="fas fa-arrow-right me-2"></i>
                    إلغاء والعودة
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="container pb-5">
        <!-- Steps Indicator -->
        <div class="steps-container">
            <div class="d-flex justify-content-between position-relative">
                <div class="step-item active" id="step1Indicator">
                    <div class="step-number">1</div>
                    <div class="step-label">اختيار الكورس</div>
                    <div class="step-line"></div>
                </div>
                <div class="step-item" id="step2Indicator">
                    <div class="step-number">2</div>
                    <div class="step-label">تفاصيل الحزمة</div>
                    <div class="step-line"></div>
                </div>
                <div class="step-item" id="step3Indicator">
                    <div class="step-number">3</div>
                    <div class="step-label">الدفع والتأكيد</div>
                </div>
            </div>
        </div>

        <!-- Step 1: Course Selection -->
        <div id="step1" class="content-card animate__animated animate__fadeIn">
            <h3 class="card-title">
                <i class="fas fa-book-open text-primary me-2"></i>
                الخطوة 1: اختيار الكورس
            </h3>

            <div class="course-card" data-course-id="MATH" data-course-name="<%= course.title %>" data-course-description="<%= course.description %>">
                <img src="<%= getImageUrl(course.coverImage) %>" alt="<%= course.title %>" class="course-image">
                <div class="course-body">
                    <% if (course.category && course.category.name) { %>
                        <span class="course-category">
                            <i class="fas fa-tag me-1"></i>
                            <%= course.category.name %>
                        </span>
                    <% } %>
                    <h4 class="course-title"><%= course.title %></h4>
                    <p class="course-description"><%= course.description %></p>
                    <div class="mt-3">
                        <small class="text-primary fw-bold">
                            <i class="fas fa-mouse-pointer me-1"></i>
                            انقر للمتابعة
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Step 2: Package Details -->
        <div id="step2" class="content-card hidden animate__animated animate__fadeIn">
            <h3 class="card-title">
                <i class="fas fa-box-open text-primary me-2"></i>
                الخطوة 2: تحديد تفاصيل الحزمة
            </h3>

            <div class="alert alert-info rounded-4 mb-4">
                <strong>الكورس المختار:</strong>
                <span class="text-primary fw-bold" id="summaryCourse">--</span>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label for="sessionsPerMonth" class="form-label-custom">
                        <i class="fas fa-calendar-week text-primary me-2"></i>
                        عدد الحصص في الأسبوع:
                    </label>
                    <select id="sessionsPerMonth" required class="form-select form-select-custom">
                        <% for(let index = 1; index < 6; index++) { %>
                            <option value="<%= index %>"><%= index %> حصة أسبوعياً (<%= 4*index %> حصص شهرياً)</option>
                        <% } %>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="sessionDuration" class="form-label-custom">
                        <i class="fas fa-clock text-primary me-2"></i>
                        مدة كل حصة:
                    </label>
                    <select id="sessionDuration" required class="form-select form-select-custom">
                        <% for(let index = 0; index < course.pricingOptions.length; index++) { %>
                            <option 
                                session-price="<%= course.pricingOptions[index].price %>" 
                                data-id="<%= course.pricingOptions[index].duration %>" 
                                data-duration="<%= course.pricingOptions[index].duration %>" 
                                value="<%= course.pricingOptions[index].price %>">
                                <%= course.pricingOptions[index].duration %> دقيقة
                            </option>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="summary-box mt-4">
                <h5 class="summary-title">
                    <i class="fas fa-file-invoice-dollar text-primary me-2"></i>
                    ملخص الدفع الشهري
                </h5>
                <div class="summary-row">
                    <span class="summary-label">إجمالي الدقائق شهرياً:</span>
                    <span class="summary-value outfit-font" id="totalMinutes">--</span>
                </div>
                <div class="summary-row">
                    <span class="summary-label">السعر الإجمالي:</span>
                    <span class="summary-value price-value outfit-font" id="calculatedPrice">--</span>
                </div>
                <small class="text-muted d-block mt-2">
                    <i class="fas fa-info-circle me-1"></i>
                    السعر قد يختلف قليلاً حسب التخصص والمدة
                </small>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button id="backToStep1" class="btn btn-secondary-custom">
                    <i class="fas fa-arrow-right me-2"></i>
                    عودة
                </button>
                <button id="goToStep3" disabled class="btn btn-primary-custom">
                    المتابعة للدفع
                    <i class="fas fa-arrow-left ms-2"></i>
                </button>
            </div>
        </div>

        <!-- Step 3: Payment & Confirmation -->
        <div id="step3" class="content-card hidden animate__animated animate__fadeIn">
            <h3 class="card-title">
                <i class="fas fa-credit-card text-primary me-2"></i>
                الخطوة 3: الدفع والتأكيد
            </h3>

            <div class="alert-custom">
                <div class="alert-custom-title">
                    <i class="fas fa-clipboard-check me-2"></i>
                    تفاصيل الخطة:
                </div>
                <p id="finalSummary" class="alert-custom-text mb-2">--</p>
                <h4 class="text-success fw-900 mb-0 outfit-font">
                    المبلغ المطلوب: <span id="finalPriceDisplay">--</span>
                </h4>
            </div>

            <h5 class="fw-bold mb-3">
                <i class="fas fa-wallet text-primary me-2"></i>
                اختر طريقة الدفع:
            </h5>

            <label class="payment-option">
                <div class="d-flex align-items-center">
                    <input type="radio" name="paymentMethod" value="visa" class="form-check-input me-3" checked>
                    <div class="payment-content flex-grow-1">
                        <div class="fw-bold">بطاقة ائتمانية</div>
                        <small class="text-muted">Visa / Mastercard</small>
                    </div>
                    <i class="fas fa-credit-card text-primary fs-4"></i>
                </div>
            </label>

            <label class="payment-option">
                <div class="d-flex align-items-center">
                    <input type="radio" name="paymentMethod" value="mada" class="form-check-input me-3">
                    <div class="payment-content flex-grow-1">
                        <div class="fw-bold">مدى</div>
                        <small class="text-muted">Mada Card</small>
                    </div>
                    <i class="fas fa-shield-alt text-primary fs-4"></i>
                </div>
            </label>

            <div class="d-flex justify-content-between mt-4">
                <button id="backToStep2" class="btn btn-secondary-custom">
                    <i class="fas fa-arrow-right me-2"></i>
                    عودة
                </button>
                <button id="checkoutButton" type="button" class="btn btn-primary-custom">
                    إتمام عملية الدفع
                    <i class="fas fa-check ms-2"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-4" style="z-index: 1050"></div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
          const CURRENT = {
    id: "<%= user._id %>",
    role: "<%= user.role %>",
    studentId: "<%= locals.studentId || '' %>"
  };
          console.log(CURRENT.studentId,'studentId');
        // Toast notification function
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            let bgClass = 'bg-primary';
            if (type === 'success') bgClass = 'bg-success';
            if (type === 'error') bgClass = 'bg-danger';

            const toastElem = document.createElement('div');
            toastElem.className = `toast align-items-center text-white ${bgClass} border-0 mb-3`;
            toastElem.setAttribute('role', 'alert');
            toastElem.innerHTML = `
                <div class="d-flex p-3">
                    <div class="toast-body fw-bold">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>`;
            container.appendChild(toastElem);
            const bsToast = new bootstrap.Toast(toastElem);
            bsToast.show();
            toastElem.addEventListener('hidden.bs.toast', () => toastElem.remove());
        }

        // Checkout function
        function checkout() {
          
            const STUDENT_ID = CURRENT.role=='admin'?CURRENT.studentId:CURRENT.id;
            const COURSE_ID = '<%= course._id %>';
            const API_ENDPOINT = '/student/checkout';

            const sessionCount = document.getElementById('sessionsPerMonth').value;
            const select = document.getElementById('sessionDuration');
            const pricingOptionsSelectedId = select.options[select.selectedIndex].getAttribute('data-id');
            const sessionsPrice = select.options[select.selectedIndex].getAttribute('session-price');

            const button = document.getElementById('checkoutButton');
            button.disabled = true;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>جاري إعداد الطلب...';

            if (!pricingOptionsSelectedId || !sessionCount || !COURSE_ID || !STUDENT_ID) {
                showToast('خطأ: بيانات النموذج مفقودة', 'error');
                resetButtonState(button);
                return;
            }

            const bookingData = {
                studentId: STUDENT_ID,
                courseId: COURSE_ID,
                selectedPriceOption: pricingOptionsSelectedId,
                numberOfSessionsPerMonth: sessionCount * 4,
                totalAmount: sessionsPrice * (sessionCount * 4)
            };

            fetch(API_ENDPOINT, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(bookingData)
            })
            .then(response => {
                if (!response.ok) {
                    return response.json().then(err => { throw new Error(err.message || 'فشل الاتصال بالخادم'); });
                }
                return response.json();
            })
            .then(data => {
                showToast('تم إنشاء طلب الحجز بنجاح!', 'success');
                setTimeout(() => window.location.href = '/', 1500);
            })
            .catch(error => {
                console.error('خطأ في عملية الدفع:', error);
                showToast(`فشلت عملية الدفع: ${error.message}`, 'error');
                resetButtonState(button);
            });
        }

        function resetButtonState(button) {
            button.disabled = false;
            button.innerHTML = 'إتمام عملية الدفع <i class="fas fa-check ms-2"></i>';
        }

        // Page initialization
        let currentStep = 1;
        let selectedPlan = { courseId: null, courseName: null, sessions: null, duration: null, price: 0 };

        const elements = {
            step1: document.getElementById('step1'),
            step2: document.getElementById('step2'),
            step3: document.getElementById('step3'),
            step1Indicator: document.getElementById('step1Indicator'),
            step2Indicator: document.getElementById('step2Indicator'),
            step3Indicator: document.getElementById('step3Indicator'),
            courseCard: document.querySelector('.course-card'),
            summaryCourse: document.getElementById('summaryCourse'),
            sessionsPerMonth: document.getElementById('sessionsPerMonth'),
            sessionDuration: document.getElementById('sessionDuration'),
            totalMinutes: document.getElementById('totalMinutes'),
            calculatedPrice: document.getElementById('calculatedPrice'),
            goToStep3: document.getElementById('goToStep3'),
            finalSummary: document.getElementById('finalSummary'),
            finalPriceDisplay: document.getElementById('finalPriceDisplay'),
        };

        function updateStepIndicators() {
            const indicators = [elements.step1Indicator, elements.step2Indicator, elements.step3Indicator];
            indicators.forEach((ind, index) => {
                const stepNumber = index + 1;
                ind.classList.remove('active', 'completed');
                
                if (stepNumber < currentStep) {
                    ind.classList.add('completed');
                } else if (stepNumber === currentStep) {
                    ind.classList.add('active');
                }
            });
        }

        function navigateToStep(step) {
            currentStep = step;
            elements.step1.classList.add('hidden');
            elements.step2.classList.add('hidden');
            elements.step3.classList.add('hidden');

            if (step === 1) elements.step1.classList.remove('hidden');
            if (step === 2) elements.step2.classList.remove('hidden');
            if (step === 3) elements.step3.classList.remove('hidden');

            updateStepIndicators();
        }

        function calculatePrice() {
            const sessions = parseInt(elements.sessionsPerMonth.value);
            const sessionsPrice = parseInt(elements.sessionDuration.value);
            const select = document.getElementById('sessionDuration');
            const selectedDuration = select.options[select.selectedIndex].getAttribute('data-duration');

            const totalMin = sessions * selectedDuration * 4;
            const totalPrice = sessions * sessionsPrice * 4;

            selectedPlan.sessions = sessions;
            selectedPlan.duration = selectedDuration;
            selectedPlan.price = totalPrice;

            elements.totalMinutes.textContent = `${totalMin} دقيقة`;
            elements.calculatedPrice.textContent = `${totalPrice.toFixed(2)} ريال`;
            elements.goToStep3.disabled = (totalPrice === 0);
        }

        // Event listeners
        elements.courseCard.addEventListener('click', function() {
            this.classList.add('selected');
            selectedPlan.courseId = this.dataset.courseId;
            selectedPlan.courseName = this.dataset.courseName;
            elements.summaryCourse.textContent = selectedPlan.courseName;
            navigateToStep(2);
            calculatePrice();
        });

        elements.sessionsPerMonth.addEventListener('change', calculatePrice);
        elements.sessionDuration.addEventListener('change', calculatePrice);

        document.getElementById('backToStep1').addEventListener('click', () => navigateToStep(1));

        elements.goToStep3.addEventListener('click', function() {
            const select = document.getElementById('sessionDuration');
            const selectedDuration = select.options[select.selectedIndex].getAttribute('data-duration');
            const sessions = parseInt(elements.sessionsPerMonth.value);

            if (selectedPlan.price > 0) {
                elements.finalSummary.textContent = `${sessions * 4} حصص شهرياً | مدة الحصة ${selectedDuration} دقيقة | كورس ${selectedPlan.courseName}`;
                elements.finalPriceDisplay.textContent = `${selectedPlan.price.toFixed(2)} ريال`;
                navigateToStep(3);
            }
        });

        document.getElementById('backToStep2').addEventListener('click', () => navigateToStep(2));
        document.getElementById('checkoutButton').addEventListener('click', checkout);

        // Initialize
        updateStepIndicators();
    </script>
</body>
</html>