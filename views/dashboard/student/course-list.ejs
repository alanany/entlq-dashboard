<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8">
    <title>منصة انطلق - استعراض الكورسات</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .sidebar {
            width: 260px;
            height: 100vh;
            position: fixed;
            top: 0;
            right: 0;
            background: #fff;
            box-shadow: -5px 0 15px rgba(0,0,0,0.05);
            z-index: 1000;
            transition: all 0.3s;
        }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
        }

        @media (max-width: 991.98px) {
            .sidebar { margin-right: -260px; }
            .sidebar.active { margin-right: 0; }
            .main-content { margin-right: 0; }
        }

        .nav-link {
            color: #6c757d;
            padding: 0.8rem 1.25rem;
            border-radius: 0.75rem;
            margin: 0.2rem 1rem;
            font-weight: 500;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            font-size: 0.85rem;
        }

        .nav-link i { margin-left: 1rem; font-size: 1.2rem; }
        .nav-link:hover, .nav-link.active { color: var(--primary); background-color: var(--secondary); }
        .nav-link.active { font-weight: 700; }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .course-card {
            border: none;
            border-radius: 1.5rem;
            background: #fff;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            overflow: hidden;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: transform 0.3s;
        }

        .course-card:hover { transform: translateY(-5px); }

        .course-img {
            height: 180px;
            object-fit: cover;
            width: 100%;
        }

        .btn-kider {
            background-color: var(--primary);
            color: #fff;
            border-radius: 0.75rem;
            padding: 0.4rem 1.2rem;
            font-weight: 700;
            border: none;
            font-size: 0.8rem;
        }

        .btn-kider:hover { background-color: #e44d2d; color: #fff; }

        .filter-section {
            background: #fff;
            padding: 1.5rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
        }

        .search-input {
            border-radius: 1rem;
            padding-right: 3rem;
        }

        .search-icon {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
        }
    </style>
</head>

<body>
  
<%if(user.role!=="admin"){  %> 
      <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="p-4 text-center border-bottom">
            <h1 class="m-0 text-primary lobster-font" style="font-size: 2rem;">
                <i class="fa fa-book-reader me-2"></i>Kider
            </h1>
        </div>
        <div class="py-4">
            <a href="/" class="nav-link">
                <i class="fa fa-home"></i> الرئيسية
            </a>
            <a href="/student/my-sessions" class="nav-link">
                <i class="fa fa-calendar-alt"></i> جدول الحصص
            </a>
            <a href="/student/courses_list" class="nav-link active">
                <i class="fa fa-book"></i> استعراض الكورسات
            </a>
            <a href="/student/enrolled_subscription" class="nav-link text-dark">
                <i class="fa fa-file-invoice"></i> طلبات الانضمام
            </a>
            <a href="/student/billing" class="nav-link text-dark">
                <i class="fa fa-wallet"></i> الرصيد والدفع
            </a>
            <a href="/chat" class="nav-link text-dark">
                <i class="fa fa-comments"></i> الدردشة
            </a>
            <div class="mt-4 pt-4 border-top mx-3">
                <a href="/student/profile" class="nav-link text-dark">
                    <i class="fa fa-user-cog"></i> الإعدادات
                </a>
                <a href="#" data-bs-toggle="modal" data-bs-target="#logoutModal" class="nav-link text-danger mt-2">
                    <i class="fa fa-sign-out-alt"></i> تسجيل الخروج
                </a>
            </div>
        </div>
    </div>
    <% }else{ %> 
   <!-- Back Button -->
<div class="position-fixed top-0 end-0 p-4" style="z-index: 1000;">
            <a href="#" onclick="history.back(); return false;" class="btn btn-light rounded-circle shadow" style="width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    <% } %> 
    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-3" id="sidebarCollapse">
                        <i class="fa fa-bars fs-5"></i>
                    </button>
                    <div class="d-none d-sm-block">
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">استكشاف الكورسات</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Browse available learning paths</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-4">
                    <div class="d-none d-md-flex align-items-center bg-light rounded-pill px-3 py-2 border border-white shadow-sm">
                        <i class="fa-solid fa-graduation-cap text-primary me-2 fs-6"></i>
                        <span id="courseCount" class="outfit-font fw-900 text-dark me-1">0</span>
                        <span class="text-muted small fw-bold">كورس متاح</span>
                    </div>

                    <div class="vr d-none d-md-block mx-2 text-muted opacity-25" style="height: 30px;"></div>

                 
                </div>
            </div>
        </div>

        <!-- Filters Section -->
        <div class="filter-section animate__animated animate__fadeIn py-3">
            <div class="row g-2 align-items-center">
                <div class="col-lg-6">
                    <div class="position-relative">
                        <input type="text" id="globalSearch" placeholder="ابحث باسم الكورس..." onkeyup="filterCourses()" class="form-control search-input border-0 bg-light shadow-none" style="font-size: 0.85rem;">
                        <i class="fa fa-search search-icon" style="font-size: 0.8rem;"></i>
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="categoryFilter" onchange="filterCourses()" class="form-select border-0 bg-light rounded-3 shadow-none" style="font-size: 0.85rem;">
                        <option value="">جميع التصنيفات</option>
                        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                            <% categories.forEach(function(cat) { %>
                                <option value="<%= cat.slug %>"><%= cat.name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="levelFilter" onchange="filterCourses()" class="form-select border-0 bg-light rounded-3 shadow-none" style="font-size: 0.85rem;">
                        <option value="">جميع المستويات</option>
                        <option value="beginner">مبتدئ</option>
                        <option value="intermediate">متوسط</option>
                        <option value="advanced">متقدم</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Course List -->
        <div class="row g-4" id="course-list-container">
            <% if (courses?.length) { %>
                <% courses.forEach(course => { %>
                    <div class="col-md-6 col-xl-4 course-card-wrapper animate__animated animate__fadeIn" 
                         data-name="<%= course.title|| 'Test Course' %>"
                         data-category="<%= course.category_slug || '' %>"
                         data-level="<%= course.level || '' %>">
                        <div class="course-card">
                            <img src="<%= getImageUrl(course.coverImage) %>" class="course-img" alt="<%= course.name %>">
                            <div class="p-4 flex-grow-1 d-flex flex-column">
                                <div class="mb-2">
                                    <% if (course.category_name) { %>
                                        <span class="badge bg-secondary text-primary rounded-pill px-2 py-1 small">
                                            <%= course.category_name %>
                                        </span>
                                    <% } %>
                                    <span class="badge bg-light text-muted rounded-pill px-2 py-1 small ms-1">
                                        <%= course.level === 'beginner' ? 'مبتدئ' : (course.level === 'intermediate' ? 'متوسط' : 'متقدم') %>
                                    </span>
                                </div>
                                <h5 class="fw-bold mb-3"><%= course.title %></h5>
                                <p class="text-muted small line-clamp-3 mb-4"><%= course.description.slice(0, 250) %><%= course.description.length > 250 ? '...' : '' %></p>
                                
                                <div class="mt-auto">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="text-warning me-2">
                                            <% for(let i=1; i<=5; i++){ %>
                                                <i class="fa fa-star <%= i <= Math.round(course.rating || 5) ? '' : 'text-muted opacity-25' %> small"></i>
                                            <% } %>
                                        </div>
                                        <small class="text-muted">(<%= course.reviews_count || 0 %> تقييم)</small>
                                    </div>
<%if(user.role=="admin"){%>

      <a href="/student/book_plan/<%= course.id %>/<%= studentId%>" class="btn btn-kider w-100">
                                        الاشتراك فى الكورس
                                    </a>

<%}else{%>

      <a href="/website-course/<%= course.id %>" class="btn btn-kider w-100">
                                        عرض التفاصيل
                                    </a>

<%}%>

                                  
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center py-5">
                    <div class="stats-icon bg-light text-muted mx-auto mb-4" style="width: 80px; height: 80px;">
                        <i class="fa fa-book-open fs-2"></i>
                    </div>
                    <h3 class="fw-bold">لا توجد كورسات متاحة حالياً</h3>
                    <p class="text-muted">عد لاحقاً لاستكشاف الكورسات الجديدة</p>
                </div>
            <% } %>
        </div>

        <div id="noResults" class="col-12 text-center py-5 d-none animate__animated animate__fadeIn">
            <div class="stats-icon bg-light text-muted mx-auto mb-4" style="width: 80px; height: 80px;">
                <i class="fa fa-search fs-2"></i>
            </div>
            <h3 class="fw-bold">لا توجد نتائج مطابقة لبحثك</h3>
            <p class="text-muted">جرب البحث بكلمات أخرى أو تغيير الفلاتر</p>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة كيدر التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-5 text-center">
                    <div class="stats-icon bg-danger bg-opacity-10 text-danger mx-auto mb-4 animate__animated animate__pulse animate__infinite" style="width: 100px; height: 100px; border-radius: 50%;">
                        <i class="fa fa-sign-out-alt fs-1"></i>
                    </div>
                    <h3 class="fw-bold mb-3">تسجيل الخروج؟</h3>
                    <p class="text-muted mb-4 fs-5">هل أنت متأكد أنك تريد مغادرة حسابك؟</p>
                    <div class="d-flex gap-3">
                        <button class="btn btn-light rounded-pill flex-grow-1" data-bs-dismiss="modal">إلغاء</button>
                        <a href="/student/logout" class="btn btn-danger rounded-pill flex-grow-1">خروج</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Sidebar Toggle
        $('#sidebarCollapse').on('click', () => $('#sidebar').toggleClass('active'));

        // Filter Logic
        function updateCount() {
            const visible = $('.course-card-wrapper:not(.d-none)').length;
            $('#courseCount').text(visible);
            if(visible === 0) $('#noResults').removeClass('d-none');
            else $('#noResults').addClass('d-none');
        }

        function filterCourses() {
            const search = $('#globalSearch').val().toLowerCase();
            const category = $('#categoryFilter').val();
            const level = $('#levelFilter').val();

            $('.course-card-wrapper').each(function() {
                const name = $(this).data('name');
                const cat = $(this).data('category');
                const lvl = $(this).data('level');

                const matchesSearch = name.includes(search);
                const matchesCategory = !category || cat === category;
                const matchesLevel = !level || lvl === level;

                if (matchesSearch && matchesCategory && matchesLevel) {
                    $(this).removeClass('d-none');
                } else {
                    $(this).addClass('d-none');
                }
            });
            updateCount();
        }

        $(document).ready(() => {
            updateCount();
        });
    </script>
</body>

</html>
