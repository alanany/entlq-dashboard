<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الرصيد</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>body { font-family: 'Tajawal', sans-serif; }

             @media (max-width: 1024px) {
    body { padding-bottom: 80px; } /* نفس ارتفاع الشريط السفلي */
}
    </style>
</head>
<body class="bg-gray-50 text-gray-800">
    <div class="flex h-screen overflow-hidden">
        <div class="flex-1 flex flex-col overflow-hidden">
            <header class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-8">
                <h2 class="text-xl font-semibold text-gray-800">إدارة رصيد الحصص</h2>
                <a href="/" class="text-sm text-indigo-600 hover:underline flex items-center font-medium">
                    العودة للرئيسية
                </a>
            </header>

            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-50 p-8">
                <div class="max-w-4xl mx-auto space-y-8">
                    
                    <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100">
                        <h3 class="font-bold text-xl text-indigo-700 mb-4 flex items-center">
                            <i data-feather="zap" class="ml-2 w-5 h-5"></i> ملخص الرصيد والدفع
                        </h3>
                        
                        <% if (activePlan) { %>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
                            <div class="p-4 bg-indigo-50 rounded-lg">
                                <p class="text-sm font-medium text-indigo-700">الخطة النشطة</p>
                                <p class="text-xl font-bold text-indigo-900 mt-1"><%= activePlan.courseName %> (<%= activePlan.totalSessions %> حصص)</p>
                            </div>
                            <div class="p-4 bg-green-50 rounded-lg">
                                <p class="text-sm font-medium text-green-700">الحصص المتبقية</p>
                                <p class="text-xl font-bold text-green-900 mt-1"><%= activePlan.remainingSessionsCount %> حصص</p>
                            </div>
                            <div class="p-4 bg-gray-50 rounded-lg">
                                <p class="text-sm font-medium text-gray-700">تاريخ التجديد القادم</p>
                                <p class="text-xl font-bold text-gray-800 mt-1"><%= new Date(activePlan.renewalDate).toLocaleDateString('ar-EG') %></p>
                            </div>
                        </div>
                        <% } else { %>
                            <div class="text-center py-6 text-gray-500">لا يوجد اشتراك نشط حالياً.</div>
                        <% } %>
                    
                    </div>
                    
                    <div class="bg-white p-6 rounded-xl shadow-md border border-gray-100">
                        <h3 class="font-bold text-xl text-gray-800 mb-4 flex items-center">
                            <i data-feather="list" class="ml-2 w-5 h-5"></i> سجل الدفعات
                        </h3>
                        
                        <div class="overflow-x-auto">
                            <table class="min-w-full divide-y divide-gray-200">
                                <thead class="bg-gray-50">
                                    <tr>
                                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">الخطة</th>
                                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">التاريخ</th>
                                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">المبلغ (SAR)</th>
                                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">الحالة</th>
                                    </tr>
                                </thead>
                                <tbody class="bg-white divide-y divide-gray-200">
                                    <% billingData.forEach(payment => { %>
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= payment.courseName %> (<%= payment.totalSessions %> حصص)</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= new Date(payment.createdAt).toLocaleDateString('ar-EG') %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-green-600 font-bold"><%= payment.totalAmount.toFixed(2) %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= payment.status === 'confirmed' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                                <%= payment.status === 'confirmed' ? 'مكتملة' : 'قيد الانتظار' %>
                                            </span>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </div>
    <script>feather.replace();</script>
</body>
</html>