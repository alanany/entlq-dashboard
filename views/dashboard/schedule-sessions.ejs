<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>إدارة الجدولة | <%= booking.studentId?.name %></title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&family=Tajawal:wght@400;700;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/feather-icons"></script>

  <style>
    body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }

    .dashboard-card {
      background: white;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
    }

    .master-session {
      border-right: 4px solid #4f46e5 !important;
      background: linear-gradient(to left, #f5f7ff, #ffffff);
    }

    .input-field {
      transition: all 0.2s;
      border: 2px solid #e2e8f0;
      background: #ffffff;
      border-radius: 12px;
    }
    .input-field:focus {
      border-color: #4f46e5;
      box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
      outline: none;
    }

    .auto-filled-row { animation: highlight-green 1s ease-out; }
    @keyframes highlight-green {
      0% { background-color: #f0fdf4; border-color: #22c55e; }
      100% { background-color: white; }
    }

    .day-tag {
      font-size: 10px;
      font-weight: 800;
      padding: 2px 8px;
      border-radius: 6px;
      margin-top: 4px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* السايد بار ثابت في مكانه عند التمرير للشاشات الكبيرة فقط */
    @media (min-width: 1024px) {
      .sticky-sidebar {
        position: sticky;
        top: 2rem;
      }
    }
  </style>
</head>
<body class="text-slate-900 pb-24">

<%
  const totalSessions   = booking.numberOfSessionsPerMonth || 16;
  const sessionsPerWeek = booking.numberOfSessionsPerWeek || 4;
  const studentTZ       = booking.studentId?.timezone || 'UTC';
  const existingSessions = booking.sessions || [];

  const courseTitle = booking.courseId?.title || 'كورس غير محدد';
  const teacherName = booking.teacherId?.name || 'لم يتم تعيين معلم';
  const studentName = booking.studentId?.name || 'طالب مجهول';

  const totalWeeks = Math.ceil(totalSessions / sessionsPerWeek);
%>

<div class="max-w-7xl mx-auto px-4 pt-10">
  
  <div class="flex flex-col lg:flex-row gap-8 items-start">
    
    <aside class="w-full lg:w-1/3 sticky-sidebar order-1">
      <div class="dashboard-card overflow-hidden border-indigo-100 shadow-lg shadow-indigo-900/5">
        <div class="bg-slate-900 p-6 text-white relative">
          <span class="text-indigo-400 text-[10px] font-black uppercase tracking-widest block mb-2">بطاقة حجز الطالب</span>
          <h2 class="text-xl font-black flex items-center gap-3">
            <i data-feather="user" class="w-5 h-5 text-indigo-400"></i> <%= studentName %>
          </h2>
          <i data-feather="activity" class="absolute top-4 left-4 w-12 h-12 text-white/5 pointer-events-none"></i>
        </div>

        <div class="p-6 space-y-6 text-sm">
          <div>
            <label class="text-slate-400 font-bold block mb-2 uppercase text-[10px]">الكورس المسجل</label>
            <div class="font-black text-slate-800 flex items-center gap-3 p-3 bg-slate-50 rounded-xl">
              <i data-feather="book-open" class="w-4 h-4 text-emerald-500"></i> <%= courseTitle %>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="p-4 bg-indigo-50/50 rounded-2xl border border-indigo-100">
              <label class="text-slate-400 font-bold block mb-1 text-[10px]">حصص/أسبوع</label>
              <span class="font-black text-indigo-700 text-lg"><%= sessionsPerWeek %></span>
            </div>
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100">
              <label class="text-slate-400 font-bold block mb-1 text-[10px]">إجمالي الأسابيع</label>
              <span class="font-black text-slate-700 text-lg"><%= totalWeeks %></span>
            </div>
          </div>

          <div>
            <label class="text-slate-400 font-bold block mb-2 uppercase text-[10px]">المعلم</label>
            <div class="font-bold text-slate-700 flex items-center gap-3 p-3 border border-slate-100 rounded-xl">
              <i data-feather="shield" class="w-4 h-4 text-amber-500"></i> <%= teacherName %>
            </div>
          </div>

          <div class="bg-indigo-900 p-4 rounded-2xl text-white shadow-inner">
            <div class="flex items-center gap-2 mb-1">
              <i data-feather="globe" class="w-3 h-3 text-indigo-400"></i>
              <label class="text-[10px] font-bold text-indigo-300">المنطقة الزمنية للطالب</label>
            </div>
            <span class="font-bold text-xs"><%= studentTZ %></span>
          </div>
        </div>
      </div>
    </aside>

    <main class="w-full lg:w-2/3 order-2">
      <form action="/booking/<%= booking._id %>/update-sessions" method="POST">
        <div class="space-y-6">
          <% for (let i = 0; i < totalSessions; i++) {
            const isMaster     = i < sessionsPerWeek;
            const savedSession = existingSessions[i] || {};
            const savedDate    = savedSession.date ? new Date(savedSession.date).toISOString().split('T')[0] : '';
            const savedTime    = savedSession.time || '';
            const currentWeek  = Math.floor(i / sessionsPerWeek) + 1;
          %>

            <% if (i % sessionsPerWeek === 0) { %>
              <div class="flex items-center gap-4 mt-10 mb-6">
                <div class="bg-indigo-600 text-white px-5 py-2 rounded-xl font-black text-xs shadow-md shadow-indigo-200 flex items-center gap-2">
                  <i data-feather="calendar" class="w-3 h-3"></i>
                  الأسبوع <%= currentWeek %>
                </div>
                <div class="h-px bg-slate-200 flex-1"></div>
              </div>
            <% } %>

            <div
              id="row_<%= i %>"
              class="dashboard-card p-5 flex flex-col sm:flex-row items-center gap-6 transition-all hover:border-indigo-300 <%= isMaster ? 'master-session' : '' %>"
            >
              <div class="flex flex-col items-center justify-center bg-slate-100 w-14 h-14 rounded-2xl border border-slate-200 flex-shrink-0">
                <span class="text-[9px] font-black text-slate-400 uppercase leading-none mb-1">حصة</span>
                <span class="text-xl font-black text-slate-800 leading-none">
                  <%= (i + 1) %>
                </span>
              </div>

              <div class="flex-1 grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
                <div>
                  <label class="text-[10px] font-black text-slate-400 mb-1 block">التاريخ</label>
                  <input
                    type="date"
                    name="sessions[<%= i %>][date]"
                    id="date_<%= i %>"
                    value="<%= savedDate %>"
                    onchange="handleUpdate(<%= i %>)"
                    class="input-field w-full p-3 text-sm font-bold"
                  >
                  <div id="day_name_<%= i %>" class="day-tag bg-slate-100 text-slate-400 italic">بانتظار التاريخ...</div>
                </div>

                <div>
                  <label class="text-[10px] font-black text-slate-400 mb-1 block uppercase">توقيت المعلم</label>
                  <input
                    type="time"
                    name="sessions[<%= i %>][time]"
                    id="time_<%= i %>"
                    value="<%= savedTime %>"
                    onchange="handleUpdate(<%= i %>)"
                    class="input-field w-full p-3 text-sm font-bold"
                  >
                  <p id="preview_<%= i %>" class="text-[10px] text-indigo-500 font-bold mt-2 flex items-center gap-1 min-h-[14px]"></p>
                </div>
              </div>

              <input type="hidden" name="sessions[<%= i %>][status]" value="<%= savedSession.status || 'pending' %>">
              <input type="hidden" name="sessions[<%= i %>][_id]" value="<%= savedSession._id %>">
            </div>
          <% } %>
        </div>

        <div class="fixed inset-x-0 bottom-0 z-50 border-t border-slate-200 bg-white/90 backdrop-blur-md px-4 py-4">
          <div class="max-w-7xl mx-auto flex justify-center lg:justify-end">
            <button
              type="submit"
              class="w-full lg:w-1/3 bg-slate-900 text-white py-4 rounded-2xl font-black text-lg shadow-xl hover:bg-black transition-all flex items-center justify-center gap-3 active:scale-95"
            >
              <i data-feather="check-circle" class="w-5 h-5 text-emerald-400"></i>
              تأكيد وحفظ الجدول
            </button>
          </div>
        </div>
      </form>
    </main>
  </div>
</div>

<script>
  feather.replace();

  const sessionsPerWeek = <%= sessionsPerWeek %>;
  const totalSessions   = <%= totalSessions %>;
  const studentTZ       = '<%= studentTZ %>';

  function handleUpdate(index) {
    updateDayAndPreview(index);
    if (index < sessionsPerWeek) {
      fillAllFutureWeeks(index);
    }
  }

  function fillAllFutureWeeks(index) {
    const masterDate = document.getElementById(`date_${index}`).value;
    const masterTime = document.getElementById(`time_${index}`).value;
    if (!masterDate || !masterTime) return;

    for (let nextIdx = index + sessionsPerWeek; nextIdx < totalSessions; nextIdx += sessionsPerWeek) {
      const targetDateInput = document.getElementById(`date_${nextIdx}`);
      const targetTimeInput = document.getElementById(`time_${nextIdx}`);
      const targetRow       = document.getElementById(`row_${nextIdx}`);

      const weeksCount = (nextIdx - index) / sessionsPerWeek;
      const d = new Date(masterDate);
      d.setDate(d.getDate() + (weeksCount * 7));

      targetDateInput.value = d.toISOString().split('T')[0];
      targetTimeInput.value = masterTime;

      updateDayAndPreview(nextIdx);
      targetRow.classList.add('auto-filled-row');
      setTimeout(() => targetRow.classList.remove('auto-filled-row'), 1000);
    }
  }

  function updateDayAndPreview(index) {
    const dateVal  = document.getElementById(`date_${index}`).value;
    const timeVal  = document.getElementById(`time_${index}`).value;
    const dayLabel = document.getElementById(`day_name_${index}`);
    const preview  = document.getElementById(`preview_${index}`);

    if (!dateVal) return;

    const dateObj = new Date(dateVal);
    const dayName = new Intl.DateTimeFormat('ar-EG', { weekday: 'long' }).format(dateObj);
    dayLabel.innerText = dayName;
    dayLabel.className = 'day-tag bg-emerald-50 text-emerald-600 border border-emerald-100';

    if (timeVal) {
      const fullDateTime = new Date(`${dateVal}T${timeVal}`);
      const studentTimeStr = fullDateTime.toLocaleTimeString('ar-EG', {
        timeZone: studentTZ,
        hour: '2-digit',
        minute: '2-digit',
        hour12: true
      });
      preview.innerHTML = `<i data-feather="globe" class="w-3 h-3"></i> توقيت الطالب: ${studentTimeStr}`;
      feather.replace();
    } else {
      preview.innerHTML = '';
    }
  }

  window.addEventListener('DOMContentLoaded', () => {
    for (let i = 0; i < totalSessions; i++) updateDayAndPreview(i);
  });
</script>

</body>
</html>