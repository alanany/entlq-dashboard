<%
    const totalSessions   = booking.numberOfSessionsPerMonth || 16;
    const sessionsPerWeek = booking.numberOfSessionsPerWeek || 4;
    const studentTZ       = booking.studentId?.timezone || 'UTC';
    const existingSessions = booking.sessions || [];
    const courseTitle = booking.courseId?.title || 'كورس غير محدد';
    const teacherName = booking.teacherId?.name || 'لم يتم تعيين معلم';
    const studentName = booking.studentId?.name || 'طالب مجهول';
    const totalWeeks = Math.ceil(totalSessions / sessionsPerWeek);
%>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - جدولة الحصص | <%= studentName %></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .info-card {
            background: #fff;
            border-radius: 1.5rem;
            border: 1px solid #f1f1f1;
            padding: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.02);
            position: sticky;
            top: 2rem;
        }

        .week-divider {
            display: flex;
            align-items: center;
            margin: 2.5rem 0 1.5rem;
        }

        .week-badge {
            background: var(--dark);
            color: #fff;
            padding: 0.4rem 1.25rem;
            border-radius: 3rem;
            font-weight: 800;
            font-size: 0.75rem;
            white-space: nowrap;
        }

        .week-line {
            height: 1px;
            background: #eef0f2;
            flex-grow: 1;
            margin-right: 1.5rem;
        }

        .session-row {
            background: #fff;
            border-radius: 1.25rem;
            border: 1px solid #f1f1f1;
            padding: 1.25rem;
            margin-bottom: 1rem;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .session-row:hover {
            border-color: var(--primary);
            box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.05);
        }

        .session-row.master-row {
            border-right: 5px solid var(--primary);
            background-color: #fffcfb;
        }

        .session-number {
            width: 45px;
            height: 45px;
            background: #f8fafc;
            border: 1px solid #eef0f2;
            border-radius: 1rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .form-control-custom {
            border: 1px solid #eef0f2;
            border-radius: 0.85rem;
            padding: 0.6rem 1rem;
            font-weight: 600;
            font-size: 0.85rem;
            background-color: #f8fafc;
            transition: all 0.3s;
        }

        .form-control-custom:focus {
            background-color: #fff;
            border-color: var(--primary);
            box-shadow: 0 0 0 0.2rem rgba(254, 93, 55, 0.1);
        }

        .day-tag {
            font-size: 0.65rem;
            font-weight: 800;
            padding: 0.2rem 0.75rem;
            border-radius: 2rem;
            margin-top: 0.5rem;
            display: inline-block;
        }

        .sticky-footer {
            position: fixed;
            bottom: 0;
            right: 260px;
            left: 0;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            padding: 1rem 2rem;
            border-top: 1px solid #f1f1f1;
            z-index: 1000;
            display: flex;
            justify-content: flex-end;
        }

        @media (max-width: 991.98px) {
            .sticky-footer { right: 0; }
        }

        .auto-filled-row {
            animation: pulse-border 1s ease-in-out;
        }

        @keyframes pulse-border {
            0% { border-color: #22c55e; background-color: #f0fdf4; }
            100% { border-color: #f1f1f1; background-color: #fff; }
        }

        .main-content i, .top-nav i { color: #fff !important; }
    </style>
</head>
<body class="bg-light">



    <%- include('./_admin_sidebar.ejs', { currentPage: 'subscriptions', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">إدارة جدولة الحصص</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Scheduling Management | <%= studentName %></small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button onclick="history.back()" class="btn btn-primary rounded-circle p-2" title="رجوع">
                        <i class="fas fa-arrow-left"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-danger rounded-circle p-2" title="تسجيل الخروج">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid p-0">
            <div class="row g-4">
                <!-- Left Column (Order Stats) -->
                <div class="col-lg-4 order-lg-1">
                    <div class="info-card animate__animated animate__fadeInLeft">
                        <div class="text-center mb-4">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px; font-size: 1.8rem;">
                                <i class="fas fa-calendar-check text-white"></i>
                            </div>
                            <h5 class="fw-900 text-dark mb-0"><%= studentName %></h5>
                            <p class="small text-muted mb-0"><%= studentTZ %></p>
                        </div>

                        <div class="list-group list-group-flush border-0">
                            <div class="list-group-item px-0 py-3 bg-transparent border-bottom border-light">
                                <label class="small text-muted d-block fw-bold mb-1">الكورس المسجل</label>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-book-open text-white me-2 ms-2 small"></i>
                                    <span class="fw-bold text-dark"><%= courseTitle %></span>
                                </div>
                            </div>
                            <div class="list-group-item px-0 py-3 bg-transparent border-bottom border-light">
                                <div class="row">
                                    <div class="col-6">
                                        <label class="small text-muted d-block fw-bold mb-1">حصص/أسبوع</label>
                                        <span class="fw-bold text-dark outfit-font"><%= sessionsPerWeek %></span>
                                    </div>
                                    <div class="col-6">
                                        <label class="small text-muted d-block fw-bold mb-1">إجمالي الأسابيع</label>
                                        <span class="fw-bold text-dark outfit-font"><%= totalWeeks %></span>
                                    </div>
                                </div>
                            </div>
                            <div class="list-group-item px-0 py-3 bg-transparent border-0">
                                <label class="small text-muted d-block fw-bold mb-1">المعلم المسؤول</label>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-user-tie text-white me-2 ms-2 small"></i>
                                    <span class="fw-bold text-dark"><%= teacherName %></span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 p-3 bg-light rounded-4 text-center border border-light">
                            <i class="fas fa-info-circle text-white mb-2"></i>
                            <p class="small text-muted mb-0 lh-base">ملاحظة: تعديل مواعيد <strong>الأسبوع الأول</strong> سيقوم بتحديث الأسابيع التالية تلقائياً.</p>
                        </div>
                    </div>
                </div>

                <!-- Right Column (Sessions List) -->
                <div class="col-lg-8 order-lg-2">
                    <form action="/booking/<%= booking._id %>/update-sessions" method="POST" id="scheduleForm">
                        <div class="sessions-container animate__animated animate__fadeInUp">
                            <% for (let i = 0; i < totalSessions; i++) {
                                const isMaster     = i < sessionsPerWeek;
                                const savedSession = existingSessions[i] || {};
                                const savedDate    = savedSession.date ? new Date(savedSession.date).toISOString().split('T')[0] : '';
                                const savedTime    = savedSession.time || '';
                                const currentWeek  = Math.floor(i / sessionsPerWeek) + 1;
                            %>

                                <% if (i % sessionsPerWeek === 0) { %>
                                    <div class="week-divider">
                                        <div class="week-badge">الأسبوع <%= currentWeek %></div>
                                        <div class="week-line"></div>
                                    </div>
                                <% } %>

                                <div id="row_<%= i %>" class="session-row <%= isMaster ? 'master-row' : '' %>">
                                    <div class="session-number">
                                        <span class="text-muted outfit-font" style="font-size: 0.6rem;">#</span>
                                        <span class="fw-900 text-dark outfit-font"><%= i + 1 %></span>
                                    </div>

                                    <div class="row g-3 flex-grow-1">
                                        <div class="col-md-6">
                                            <label class="small text-muted fw-bold mb-1 d-block">التاريخ</label>
                                            <input type="date" name="sessions[<%= i %>][date]" id="date_<%= i %>" value="<%= savedDate %>" onchange="handleUpdate(<%= i %>)" class="form-control form-control-custom">
                                            <div id="day_name_<%= i %>" class="day-tag bg-light text-muted">بانتظار التاريخ...</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="small text-muted fw-bold mb-1 d-block">توقيت المعلم (KSA)</label>
                                            <input type="time" name="sessions[<%= i %>][time]" id="time_<%= i %>" value="<%= savedTime %>" onchange="handleUpdate(<%= i %>)" class="form-control form-control-custom">
                                            <div id="preview_<%= i %>" class="small text-primary fw-bold mt-2 d-flex align-items-center gap-1 min-h-[14px]"></div>
                                        </div>
                                    </div>

                                    <input type="hidden" name="sessions[<%= i %>][status]" value="<%= savedSession.status || 'pending' %>">
                                    <input type="hidden" name="sessions[<%= i %>][_id]" value="<%= savedSession._id %>">
                                </div>
                            <% } %>
                        </div>
                        
                        <div class="mb-5 pb-5"></div> <!-- Spacer for sticky footer -->
                    </form>
                </div>
            </div>
        </div>

        <div class="sticky-footer">
            <button type="submit" form="scheduleForm" class="btn btn-primary rounded-pill px-5 py-3 fw-900 shadow-lg border-0 d-flex align-items-center gap-2">
                <i class="fas fa-save text-white"></i>
                تأكيد وحفظ الجدول الدراسي
            </button>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sessionsPerWeek = <%= sessionsPerWeek %>;
        const totalSessions   = <%= totalSessions %>;
        const studentTZ       = '<%= studentTZ %>';

        function handleUpdate(index) {
            updateDayAndPreview(index);
            if (index < sessionsPerWeek) {
                fillAllFutureWeeks(index);
            }
        }

        function fillAllFutureWeeks(index) {
            const masterDate = document.getElementById(`date_${index}`).value;
            const masterTime = document.getElementById(`time_${index}`).value;
            if (!masterDate || !masterTime) return;

            for (let nextIdx = index + sessionsPerWeek; nextIdx < totalSessions; nextIdx += sessionsPerWeek) {
                const targetDateInput = document.getElementById(`date_${nextIdx}`);
                const targetTimeInput = document.getElementById(`time_${nextIdx}`);
                const targetRow       = document.getElementById(`row_${nextIdx}`);

                const weeksCount = (nextIdx - index) / sessionsPerWeek;
                const d = new Date(masterDate);
                d.setDate(d.getDate() + (weeksCount * 7));

                targetDateInput.value = d.toISOString().split('T')[0];
                targetTimeInput.value = masterTime;

                updateDayAndPreview(nextIdx);
                targetRow.classList.add('auto-filled-row');
                setTimeout(() => targetRow.classList.remove('auto-filled-row'), 1000);
            }
        }

        function updateDayAndPreview(index) {
            const dateVal  = document.getElementById(`date_${index}`).value;
            const timeVal  = document.getElementById(`time_${index}`).value;
            const dayLabel = document.getElementById(`day_name_${index}`);
            const preview  = document.getElementById(`preview_${index}`);

            if (!dateVal) return;

            const dateObj = new Date(dateVal);
            const dayName = new Intl.DateTimeFormat('ar-EG', { weekday: 'long' }).format(dateObj);
            dayLabel.innerText = dayName;
            dayLabel.className = 'day-tag bg-success bg-opacity-10 text-white';

            if (timeVal) {
                try {
                    const fullDateTime = new Date(`${dateVal}T${timeVal}`);
                    const studentTimeStr = fullDateTime.toLocaleTimeString('ar-EG', {
                        timeZone: studentTZ,
                        hour: '2-digit',
                        minute: '2-digit',
                        hour12: true
                    });
                    preview.innerHTML = `<i class="fas fa-globe-americas ms-1"></i> توقيت الطالب: ${studentTimeStr}`;
                } catch(e) {
                    preview.innerHTML = '';
                }
            } else {
                preview.innerHTML = '';
            }
        }

        window.addEventListener('DOMContentLoaded', () => {
            for (let i = 0; i < totalSessions; i++) updateDayAndPreview(i);
        });
    </script>
</body>
</html>