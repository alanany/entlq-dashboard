<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - إدارة المدربين</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.8rem;
        }

        .swal2-popup { border-radius: 1.5rem !important; }
        .archived-row { opacity: 0.6; filter: grayscale(0.2); }
    </style>
</head>
<body class="bg-light">
    <%- include('./_admin_sidebar.ejs', { currentPage: 'teachers', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2rem;">إدارة المعلمين</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Manage academy instructors</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button onclick="showInstructorModal('add')" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="fa fa-user-plus me-1"></i> إضافة معلم
                    </button>
                    
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-light rounded-circle p-2 text-danger" title="تسجيل الخروج">
                            <i class="fas fa-sign-out-alt"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden animate__animated animate__fadeInUp">
            <div class="table-responsive">
                <table class="table table-custom mb-0 text-end">
                    <thead>
                        <tr>
                            <th class="px-4 py-3">المدرب</th>
                            <th class="px-4 py-3">المشرف</th>
                            <th class="px-4 py-3">التواصل</th>
                            <th class="px-4 py-3 text-center">سعر الساعة</th>
                            <th class="px-4 py-3 text-center">زووم</th>
                            <th class="px-4 py-3 text-center">الحالة</th>
                            <th class="px-4 py-3 text-start">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        <% teachers.forEach((teacher) => { %>
                            <tr class="hover-bg-light transition-colors <%= teacher.isActive === false ? 'archived-row' : '' %>">
                                <td class="px-4 py-3 cursor-pointer" onclick="window.location.href='/admin/teacher/<%= teacher._id %>'">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center fw-bold outfit-font" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                            <%= teacher.name.charAt(0) %>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark"><%= teacher.name %></div>
                                            <div class="text-muted small" style="font-size: 0.75rem;"><%= teacher.email %></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-muted outfit-font" style="font-size: 0.8rem;">
                                    <% if (teacher.supervisorId) { %>
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fas fa-user-shield text-primary"></i>
                                            <span class="fw-bold text-dark"><%= teacher.supervisorId.name %></span>
                                        </div>
                                    <% } else { %>
                                        <span class="text-muted">---</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3 text-muted outfit-font" style="font-size: 0.8rem;"><%= teacher.phone_number %></td>
                                <td class="px-4 py-3 text-center fw-bold text-dark">
                                    <% if (teacher.hourly_rates && teacher.hourly_rates.length > 0) { %>
                                        <% teacher.hourly_rates.forEach(r => { %>
                                            <div class="small"><%= r.label %>: <%= r.rate %>  <%= currencySymbol %></div>
                                        <% }) %>
                                    <% } else { %>
                                        ---
                                    <% } %>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <a href="<%= teacher.zoom_link %>" target="_blank" class="btn btn-outline-primary btn-sm rounded-3">
                                        <i class="fas fa-video"></i>
                                    </a>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <% if (teacher.isActive !== false) { %>
                                        <span class="badge bg-success bg-opacity-10 text-white rounded-pill px-3 py-2" style="font-size: 0.65rem;">نشط</span>
                                    <% } else { %>
                                        <span class="badge bg-warning bg-opacity-10 text-white rounded-pill px-3 py-2" style="font-size: 0.65rem;">مؤرشف</span>
                                    <% } %>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="d-flex gap-2">
                                         <button onclick="editTeacher(this)" data-teacher='<%- JSON.stringify(teacher) %>' class="btn btn-light btn-sm rounded-3 text-primary">
                                             <i class="fas fa-edit"></i>
                                         </button>
                                        <% if (teacher.isActive !== false) { %>
                                            <button onclick="handleAccountStatus('<%= teacher._id %>', 'archive')" class="btn btn-light btn-sm rounded-3 text-warning" title="أرشفة">
                                                 <i class="fas fa-user-slash"></i>
                                            </button>
                                        <% } else { %>
                                            <button onclick="handleAccountStatus('<%= teacher._id %>', 'activate')" class="btn btn-light btn-sm rounded-3 text-success" title="تفعيل">
                                                 <i class="fas fa-user-check"></i>
                                            </button>
                                        <% } %>
                                        <button onclick="handleDeleteTeacher('<%= teacher._id %>', '<%= teacher.name %>')" class="btn btn-light btn-sm rounded-3 text-danger">
                                             <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>
</div>

    <!-- Instructor Modal (Bootstrap Style) -->
    <div class="modal fade" id="instructorModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
                <div class="modal-body p-0 overflow-hidden">
                    <div class="bg-primary p-4 text-white d-flex justify-content-between align-items-center">
                        <div>
                            <h5 id="modalTitle" class="fw-bold mb-1">بيانات المدرب</h5>
                            <p class="small opacity-75 mb-0">إدارة الحساب والاتصال</p>
                        </div>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form id="instructorForm" class="p-4">
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label class="small text-muted mb-1 d-block">الاسم الكامل</label>
                                <input type="text" id="name" required class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                            </div>
                            <div class="col-6">
                                <label class="small text-muted mb-1 d-block">رقم الجوال</label>
                                <input type="tel" id="phone" required dir="ltr" class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold text-end" style="font-size: 0.85rem;">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted mb-1 d-block">الايميل</label>
                            <input type="email" id="email" dir="ltr" class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted mb-1 d-block">المشرف المسؤول</label>
                            <select id="supervisorId" class="form-select border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                                <option value="">بدون مشرف</option>
                                <% if (locals.supervisors) { %>
                                    <% supervisors.forEach(sup => { %>
                                        <option value="<%= sup._id %>"><%= sup.name %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="small text-muted mb-1 d-block">سعر ساعة المعلم (خيارات متعددة)</label>
                            <div id="ratesContainer">
                                <!-- Dynamic Rates -->
                            </div>
                            <button type="button" onclick="addRateRow()" class="btn btn-sm btn-outline-primary mt-2">
                                <i class="fas fa-plus me-1"></i> إضافة سعر جديد
                            </button>
                        </div>
                        <div class="mb-4">
                            <label class="small text-muted mb-1 d-block">رابط زووم</label>
                            <input type="url" id="zoom" dir="ltr" class="form-control border-0 bg-light rounded-3 py-2 px-3 fw-bold" style="font-size: 0.85rem;">
                        </div>
                        <div class="d-flex gap-3">
                            <button type="button" class="btn btn-light rounded-pill flex-grow-1" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-primary rounded-pill flex-[2] fw-bold">حفظ البيانات</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const instructorModal = new bootstrap.Modal(document.getElementById('instructorModal'));
        let currentTeacherId = null;

        // --- 1. نظام الأرشفة والتفعيل (SweetAlert2) ---
        async function handleAccountStatus(teacherId, action) {
            const isArchiving = action === 'archive';
            const { value: confirm } = await Swal.fire({
                title: isArchiving ? 'أرشفة حساب المعلم؟' : 'إعادة تفعيل الحساب؟',
                text: isArchiving ? 'لن يظهر المعلم في القوائم النشطة، ولكن بياناته محفوظة.' : 'سيعود المعلم للعمل والظهور في القوائم مرة أخرى.',
                icon: isArchiving ? 'warning' : 'info',
                showCancelButton: true,
                confirmButtonColor: isArchiving ? '#f97316' : '#22c55e',
                confirmButtonText: isArchiving ? 'نعم، أرشِف' : 'نعم، تفعيل',
                cancelButtonText: 'إلغاء',
                customClass: { popup: 'rounded-[2rem]' }
            });

            if (confirm) {
                try {
                    const response = await fetch(`/admin/teacher/update-status`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ teacherId, isActive: !isArchiving })
                    });
                    const data = await response.json();
                    if (response.ok) location.reload();
                    else Swal.fire({ title: 'تنبيه', text: data.error, icon: 'error', customClass: { popup: 'rounded-[2rem]' } });
                } catch (err) { Swal.fire('خطأ', 'تعذر الاتصال بالسيرفر', 'error'); }
            }
        }

        // --- 2. نظام الحذف النهائي (SweetAlert2 - نفس التصميم) ---
        async function handleDeleteTeacher(teacherId, teacherName) {
            const { value: confirm } = await Swal.fire({
                title: 'حذف المعلم نهائياً؟',
                text: `هل أنت متأكد من حذف المدرب (${teacherName})؟ لا يمكن التراجع عن هذا الإجراء وسيتم مسح كافة البيانات.`,
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'نعم، احذف نهائياً',
                cancelButtonText: 'تراجع',
                customClass: { popup: 'rounded-[2rem]' }
            });

            if (confirm) {
                try {
                    const response = await fetch(`/admin/teachers/delete/${teacherId}`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) location.reload();
                    else Swal.fire({ title: 'فشل الحذف', text: data.message, icon: 'error', customClass: { popup: 'rounded-[2rem]' } });
                } catch (err) { Swal.fire('خطأ', 'فشل الاتصال بالسيرفر', 'error'); }
            }
        }

        // --- إدارة المودال ---
        function editTeacher(btn) {
            const teacher = JSON.parse(btn.getAttribute('data-teacher'));
            showInstructorModal('edit', teacher);
        }

        function showInstructorModal(mode, teacher = null) {
            const ratesContainer = document.getElementById('ratesContainer');
            ratesContainer.innerHTML = '';

            if(mode === 'edit' && teacher) {
                currentTeacherId = teacher._id;
                document.getElementById('modalTitle').innerText = "تعديل المدرب";
                document.getElementById('name').value = teacher.name;
                document.getElementById('email').value = teacher.email;
                document.getElementById('zoom').value = teacher.zoom_link || '';
                document.getElementById('phone').value = teacher.phone_number || '';
                document.getElementById('supervisorId').value = teacher.supervisorId ? (teacher.supervisorId._id || teacher.supervisorId) : '';
                
                
                if (teacher.hourly_rates && teacher.hourly_rates.length > 0) {
                    teacher.hourly_rates.forEach(r => addRateRow(r.label, r.rate));
                } else {
                    addRateRow();
                }
            } else {
                currentTeacherId = null;
                document.getElementById('modalTitle').innerText = "إضافة مدرب جديد";
                document.getElementById('instructorForm').reset();
                addRateRow();
            }
            instructorModal.show();
        }

        function addRateRow(label = '', rate = '') {
            const container = document.getElementById('ratesContainer');
            const div = document.createElement('div');
            div.className = 'row g-2 mb-2 rate-row';
            div.innerHTML = `
                <div class="col-6">
                    <input type="text" placeholder="مثلاً: لغة عربية" value="${label}" class="form-control bg-light border-0 rate-label" required>
                </div>
                <div class="col-5">
                    <input type="number" placeholder="السعر" value="${rate}" class="form-control bg-light border-0 rate-value" required>
                </div>
                <div class="col-1 d-flex align-items-center">
                    <button type="button" onclick="this.parentElement.parentElement.remove()" class="text-danger border-0 bg-transparent">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            `;
            container.appendChild(div);
        }

        function closeModal() {
            instructorModal.hide();
        }

        document.getElementById('instructorForm').onsubmit = async (e) => {
            e.preventDefault();
            const rates = [];
            document.querySelectorAll('.rate-row').forEach(row => {
                const label = row.querySelector('.rate-label').value;
                const rate = row.querySelector('.rate-value').value;
                if (label && rate) rates.push({ label, rate: Number(rate) });
            });

            const formData = {
                name: document.getElementById('name').value,
                zoom_link: document.getElementById('zoom').value,
                phone_number: document.getElementById('phone').value,
                hourly_rates: rates,
                email: document.getElementById('email').value,
                supervisorId: document.getElementById('supervisorId').value
            };
            const url = currentTeacherId ? `/admin/teachers/update/${currentTeacherId}` : `/admin/teachers/add`;
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const result = await response.json();
                if (result.success) location.reload();
                else Swal.fire('خطأ', result.message, 'error');
            } catch (err) { Swal.fire('خطأ', 'فشل الاتصال', 'error'); }
        };
    </script>
</body>
</html>
