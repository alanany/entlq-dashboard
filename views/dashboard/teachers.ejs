<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المدربين | أكاديمية انطلق</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; overflow: hidden; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .status-pill { transition: all 0.3s ease; }
        .status-active { background-color: #dcfce7; color: #15803d; }
        .status-archived { background-color: #ffedd5; color: #9a3412; }
        
        .modal-scale { transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
        .overlay-blur { backdrop-filter: blur(4px); transition: all 0.3s ease; }
        .archived-row { opacity: 0.6; filter: grayscale(0.5); }
    </style>
</head>
<body class="flex h-screen">

    <%- include('./_admin_sidebar.ejs', { currentPage: 'teachers', user: user }) %>

    <main class="flex-1 flex flex-col min-w-0">
        <header class="h-24 bg-white/80 backdrop-blur-md border-b border-slate-100 flex items-center justify-between px-10 sticky top-0 z-10">
            <div>
                <h2 class="text-xl font-black text-slate-800">المعلمون</h2>
            </div>
            <button onclick="showInstructorModal('add')" class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-4 rounded-[1.5rem] font-black text-sm transition-all shadow-xl shadow-indigo-100 flex items-center gap-2 active:scale-95">
                <i data-feather="user-plus" class="w-4 h-4"></i>
                إضافة معلم جديد
            </button>
        </header>

        <div class="flex-1 overflow-y-auto p-10 no-scrollbar">
            <div class="bg-white rounded-[3rem] shadow-[0_8px_30px_rgb(0,0,0,0.02)] border border-slate-50 overflow-hidden">
                <table class="w-full text-right">
                    <thead class="bg-slate-50/50 text-slate-400 text-[10px] font-black uppercase tracking-widest border-b border-slate-50">
                        <tr>
                            <th class="px-8 py-6">المدرب</th>
                            <th class="px-8 py-6">التواصل</th>
                            <th class="px-8 py-6 text-center">سعر الساعة</th>
                            <th class="px-8 py-6 text-center">زووم</th>
                            <th class="px-8 py-6 text-center">الحالة</th>
                            <th class="px-8 py-6 text-left">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        <% teachers.forEach((teacher) => { %>
                        <tr class="hover:bg-slate-50/50 transition-all group <%= teacher.isActive === false ? 'archived-row' : '' %>">
                            <td class="px-8 py-6 cursor-pointer" onclick="window.location.href='/admin/teacher/<%= teacher._id %>'">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600 font-black text-lg">
                                        <%= teacher.name.charAt(0) %>
                                    </div>
                                    <div>
                                        <p class="font-black text-slate-800 text-sm"><%= teacher.name %></p>
                                        <p class="text-[10px] font-bold text-slate-400"><%= teacher.email %></p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <span dir="ltr" class="text-sm font-bold text-slate-500"><%= teacher.phone_number %></span>
                            </td>
                            <td class="px-8 py-6 text-center">
                                <p class="font-black text-slate-800 text-sm"><%= teacher.hour_rate %> ر.س</p>
                            </td>
                            <td class="px-8 py-6 text-center">
                                <a href="<%= teacher.zoom_link %>" target="_blank" class="w-10 h-10 bg-indigo-50 text-indigo-500 rounded-xl inline-flex items-center justify-center hover:bg-indigo-600 hover:text-white transition-all">
                                    <i data-feather="video" class="w-4 h-4"></i>
                                </a>
                            </td>
                            <td class="px-8 py-6 text-center">
                                <% if (teacher.isActive !== false) { %>
                                    <span class="status-pill px-4 py-2 rounded-xl text-[10px] font-black status-active uppercase tracking-widest">نشط</span>
                                <% } else { %>
                                    <span class="status-pill px-4 py-2 rounded-xl text-[10px] font-black status-archived uppercase tracking-widest">مؤرشف</span>
                                <% } %>
                            </td>
                            <td class="px-8 py-6">
                                <div class="flex items-center justify-end gap-2">
                                    <button onclick="showInstructorModal('edit', <%= JSON.stringify(teacher) %>)" class="p-3 text-slate-400 hover:text-blue-500 hover:bg-blue-50 rounded-xl transition-all">
                                        <i data-feather="edit-3" class="w-4 h-4"></i>
                                    </button>
                                    
                                    <% if (teacher.isActive !== false) { %>
                                        <button onclick="handleAccountStatus('<%= teacher._id %>', 'archive')" class="p-3 text-slate-400 hover:text-orange-500 hover:bg-orange-50 rounded-xl transition-all" title="أرشفة">
                                            <i data-feather="user-x" class="w-4 h-4"></i>
                                        </button>
                                    <% } else { %>
                                        <button onclick="handleAccountStatus('<%= teacher._id %>', 'activate')" class="p-3 text-slate-400 hover:text-green-500 hover:bg-green-50 rounded-xl transition-all" title="تفعيل">
                                            <i data-feather="user-check" class="w-4 h-4"></i>
                                        </button>
                                    <% } %>

                                    <button onclick="handleDeleteTeacher('<%= teacher._id %>', '<%= teacher.name %>')" class="p-3 text-slate-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition-all">
                                        <i data-feather="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <div id="instructorModal" class="fixed inset-0 bg-slate-900/40 z-[100] hidden items-center justify-center p-4 overlay-blur">
        <div id="modalContent" class="bg-white rounded-[3rem] w-full max-w-lg shadow-2xl overflow-hidden transform modal-scale opacity-0 scale-95">
            <div class="bg-indigo-600 p-8 text-white flex justify-between items-center relative overflow-hidden">
                <div class="relative z-10">
                    <h3 id="modalTitle" class="text-xl font-black leading-none">بيانات المدرب</h3>
                    <p class="text-indigo-200 text-[10px] font-bold uppercase tracking-widest mt-2">إدارة الحساب والاتصال</p>
                </div>
                <button onclick="closeModal()" class="w-10 h-10 bg-black/10 hover:bg-black/20 rounded-full flex items-center justify-center relative z-10 transition-all"><i data-feather="x" class="w-5 h-5"></i></button>
            </div>
            <form id="instructorForm" class="p-8 space-y-5">
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black text-slate-400 mr-2 uppercase">الاسم الكامل</label>
                        <input type="text" id="name" required class="w-full bg-slate-50 border-none p-4 rounded-2xl text-sm font-bold outline-none focus:ring-2 focus:ring-indigo-500/20">
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black text-slate-400 mr-2 uppercase">رقم الجوال</label>
                        <input type="tel" id="phone" required dir="ltr" class="w-full bg-slate-50 border-none p-4 rounded-2xl text-sm font-bold text-right outline-none">
                    </div>
                </div>
                <div class="space-y-1">
                    <label class="text-[10px] font-black text-indigo-500 mr-2 uppercase">الايميل</label>
                    <input type="email" id="email" dir="ltr" class="w-full bg-indigo-50 border-none p-4 rounded-2xl text-sm font-bold text-left outline-none">
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-[10px] font-black text-indigo-500 mr-2 uppercase">سعر الساعة</label>
                        <input type="number" id="hourlyRate" dir="ltr" class="w-full bg-indigo-50 border-none p-4 rounded-2xl text-sm font-bold text-left outline-none">
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-black text-indigo-500 mr-2 uppercase">رابط زووم</label>
                        <input type="url" id="zoom" dir="ltr" class="w-full bg-indigo-50 border-none p-4 rounded-2xl text-sm font-bold text-left outline-none">
                    </div>
                </div>
                <div class="flex gap-3 pt-4">
                    <button type="button" onclick="closeModal()" class="flex-1 py-4 text-slate-400 font-black text-sm hover:bg-slate-50 rounded-2xl transition-all">إلغاء</button>
                    <button type="submit" class="flex-[2] bg-indigo-600 text-white py-4 rounded-2xl font-black text-sm shadow-xl hover:bg-indigo-700 transition-all">حفظ البيانات</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        feather.replace();
        let currentTeacherId = null;

        // --- 1. نظام الأرشفة والتفعيل (SweetAlert2) ---
        async function handleAccountStatus(teacherId, action) {
            const isArchiving = action === 'archive';
            const { value: confirm } = await Swal.fire({
                title: isArchiving ? 'أرشفة حساب المعلم؟' : 'إعادة تفعيل الحساب؟',
                text: isArchiving ? 'لن يظهر المعلم في القوائم النشطة، ولكن بياناته محفوظة.' : 'سيعود المعلم للعمل والظهور في القوائم مرة أخرى.',
                icon: isArchiving ? 'warning' : 'info',
                showCancelButton: true,
                confirmButtonColor: isArchiving ? '#f97316' : '#22c55e',
                confirmButtonText: isArchiving ? 'نعم، أرشِف' : 'نعم، تفعيل',
                cancelButtonText: 'إلغاء',
                customClass: { popup: 'rounded-[2rem]' }
            });

            if (confirm) {
                try {
                    const response = await fetch(`/admin/teacher/update-status`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ teacherId, isActive: !isArchiving })
                    });
                    const data = await response.json();
                    if (response.ok) location.reload();
                    else Swal.fire({ title: 'تنبيه', text: data.error, icon: 'error', customClass: { popup: 'rounded-[2rem]' } });
                } catch (err) { Swal.fire('خطأ', 'تعذر الاتصال بالسيرفر', 'error'); }
            }
        }

        // --- 2. نظام الحذف النهائي (SweetAlert2 - نفس التصميم) ---
        async function handleDeleteTeacher(teacherId, teacherName) {
            const { value: confirm } = await Swal.fire({
                title: 'حذف المعلم نهائياً؟',
                text: `هل أنت متأكد من حذف المدرب (${teacherName})؟ لا يمكن التراجع عن هذا الإجراء وسيتم مسح كافة البيانات.`,
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'نعم، احذف نهائياً',
                cancelButtonText: 'تراجع',
                customClass: { popup: 'rounded-[2rem]' }
            });

            if (confirm) {
                try {
                    const response = await fetch(`/admin/teachers/delete/${teacherId}`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) location.reload();
                    else Swal.fire({ title: 'فشل الحذف', text: data.message, icon: 'error', customClass: { popup: 'rounded-[2rem]' } });
                } catch (err) { Swal.fire('خطأ', 'فشل الاتصال بالسيرفر', 'error'); }
            }
        }

        // --- إدارة المودال ---
        function showInstructorModal(type, teacher) {
            const modal = document.getElementById('instructorModal');
            const content = document.getElementById('modalContent');
            modal.classList.replace('hidden', 'flex');
            setTimeout(() => { content.classList.remove('opacity-0', 'scale-95'); content.classList.add('opacity-100', 'scale-100'); }, 10);
            
            if(type === 'edit' && teacher) {
                currentTeacherId = teacher._id;
                document.getElementById('modalTitle').innerText = "تعديل المدرب";
                document.getElementById('name').value = teacher.name;
                document.getElementById('email').value = teacher.email;
                document.getElementById('zoom').value = teacher.zoom_link || '';
                document.getElementById('phone').value = teacher.phone_number || '';
                document.getElementById('hourlyRate').value = teacher.hour_rate || '';
            } else {
                currentTeacherId = null;
                document.getElementById('modalTitle').innerText = "إضافة مدرب جديد";
                document.getElementById('instructorForm').reset();
            }
        }

        function closeModal() {
            const content = document.getElementById('modalContent');
            content.classList.replace('opacity-100', 'opacity-0');
            content.classList.add('scale-95');
            setTimeout(() => { document.getElementById('instructorModal').classList.replace('flex', 'hidden'); }, 300);
        }

        document.getElementById('instructorForm').onsubmit = async (e) => {
            e.preventDefault();
            const formData = {
                name: document.getElementById('name').value,
                zoom_link: document.getElementById('zoom').value,
                phone_number: document.getElementById('phone').value,
                hour_rate: document.getElementById('hourlyRate').value,
                email: document.getElementById('email').value
            };
            const url = currentTeacherId ? `/admin/teachers/update/${currentTeacherId}` : `/admin/teachers/add`;
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const result = await response.json();
                if (result.success) location.reload();
                else Swal.fire('خطأ', result.message, 'error');
            } catch (err) { Swal.fire('خطأ', 'فشل الاتصال', 'error'); }
        };
    </script>
</body>
</html>