<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>جدول المعلم الاحترافي | أكاديمية انطلق</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .tab-btn.active { background-color: #4f46e5; color: white; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3); }
        .animate-in { animation: slideUp 0.4s ease-out forwards; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
        
        .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; background-color: #f1f5f9; border-radius: 2rem; overflow: hidden; border: 2px solid #f1f5f9; }
        .calendar-day { min-height: 140px; background-color: white; padding: 10px; transition: all 0.2s; position: relative; }
        .calendar-day.today { background-color: #f5f3ff; }
        
        .event-bar { 
            font-size: 10px; padding: 5px 8px; border-radius: 8px; margin-top: 4px; 
            cursor: pointer; font-weight: 800; border-right-width: 3px; transition: all 0.2s;
            display: flex; flex-direction: column; gap: 1px;
        }
        .event-bar.completed { cursor: default; opacity: 0.6; filter: grayscale(0.5); }
        .event-bar:not(.completed):hover { transform: scale(1.02); z-index: 10; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        
        .session-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); border: 1px solid #f1f5f9; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="overflow-hidden">

    <div class="flex h-screen overflow-hidden">
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
            
            <header class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100 px-6 h-16 flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-4">
                    <button onclick="window.history.back()" class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                        <i data-feather="arrow-right" class="w-5 h-5 text-gray-600"></i>
                    </button>
                    <h1 class="text-xl font-black text-gray-900">جدول الحصص</h1>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[10px] font-bold text-indigo-500 bg-indigo-50 px-3 py-1 rounded-full local-tz-label">جاري مزامنة التوقيت...</span>
                    <div class="bg-indigo-600 text-white p-2 rounded-xl">
                        <i data-feather="calendar" class="w-5 h-5"></i>
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto p-4 md:p-8 no-scrollbar">
                <div class="max-w-7xl mx-auto">
                    
                    <div class="flex flex-col md:flex-row items-center justify-between mb-8 gap-6">
                        <div class="flex bg-gray-100 p-1.5 rounded-2xl w-full md:w-auto">
                            <button onclick="switchView('weekly')" id="btn-weekly" class="tab-btn active px-10 py-2.5 rounded-xl text-sm font-bold transition-all">أسبوعي</button>
                            <button onclick="switchView('monthly')" id="btn-monthly" class="tab-btn px-10 py-2.5 rounded-xl text-sm font-bold transition-all text-gray-500">شهري</button>
                        </div>
                        
                        <div id="nav-controls" class="flex items-center gap-6 bg-white px-6 py-2.5 rounded-2xl border border-gray-100 shadow-sm invisible">
                            <button onclick="changeMonth(-1)" class="text-gray-400 hover:text-indigo-600"><i data-feather="chevron-right"></i></button>
                            <h3 id="currentMonthLabel" class="text-lg font-black text-gray-800 min-w-[150px] text-center uppercase">---</h3>
                            <button onclick="changeMonth(1)" class="text-gray-400 hover:text-indigo-600"><i data-feather="chevron-left"></i></button>
                        </div>
                    </div>

                    <div id="weeklyView" class="space-y-6 animate-in">
                        <% const now = new Date(); const sortedDates = Object.keys(schedule).sort(); %>
                        <% sortedDates.forEach(dateStr => { const dayData = schedule[dateStr]; %>
                            <div class="bg-white rounded-[2.5rem] border border-gray-50 p-6 flex flex-col md:flex-row gap-6 items-stretch shadow-sm">
                                <div class="md:w-32 flex md:flex-col items-center justify-center bg-gray-50 rounded-3xl p-4 text-center border border-gray-100">
                                    <p class="text-[10px] text-gray-400 font-black uppercase"><%= dayData.dayName %></p>
                                    <p class="text-4xl font-black text-gray-900 mt-1"><%= dayData.dayNumber %></p>
                                </div>
                                <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                                    <% dayData.sessions.forEach(session => { 
                                        // ندمج التاريخ والوقت في صيغة UTC Z لضمان التحويل الصحيح في المتصفح
                                        const utcString = `${dateStr}T${session.time}:00Z`;
                                        const isCompleted = session.status === 'completed' || session.isSendReport === true;
                                    %>
                                        <div class="session-card p-5 rounded-3xl bg-white flex flex-col justify-between relative overflow-hidden <%= isCompleted ? 'opacity-60' : '' %>"
                                             data-utc-start="<%= utcString %>"
                                             data-booking-id="<%= session.bookingId %>"
                                             data-index="<%= session.sessionIndex %>"
                                             data-completed="<%= isCompleted %>"
                                             onclick="handleWeeklyClick(this)">
                                            
                                            <div class="status-indicator absolute top-0 right-0 w-1.5 h-full bg-gray-200"></div>
                                            
                                            <div>
                                                <h4 class="font-black text-lg mb-1 text-gray-900"><%= session.studentName %></h4>
                                                <p class="text-xs text-gray-400"><%= session.courseTitle %></p>
                                            </div>
                                            
                                            <div class="flex items-center justify-between mt-4">
                                                <span class="text-xs font-bold text-indigo-600 local-time-text"><%= session.time %></span>
                                                <span class="status-text text-[10px] font-black italic">...</span>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div id="monthlyView" class="hidden animate-in">
                        <div class="bg-white rounded-[3rem] border border-gray-100 p-6 shadow-sm overflow-hidden">
                            <div class="grid grid-cols-7 mb-4 bg-gray-50/50 rounded-2xl py-3">
                                <% ['الأحد', 'الاثنين', 'الثلاثاء', 'الأربعاء', 'الخميس', 'الجمعة', 'السبت'].forEach(day => { %>
                                    <div class="text-center text-xs font-black text-gray-400"><%= day %></div>
                                <% }) %>
                            </div>
                            <div id="calendarGrid" class="calendar-grid"></div>
                        </div>
                    </div>

                </div>
            </main>
        </div>
    </div>

    <script>
        feather.replace();
        let currentNavDate = new Date();
        let allEvents = [];

        // تحديث المنطقة الزمنية في الهيدر
        const userTZ = Intl.DateTimeFormat().resolvedOptions().timeZone;
        document.querySelector('.local-tz-label').innerText = `توقيتك المحلي: ${userTZ}`;

        // تحويل توقيت العرض الأسبوعي محلياً فور التحميل
        function localizeWeeklyView() {
            document.querySelectorAll('.session-card').forEach(card => {
                const utcStart = card.getAttribute('data-utc-start');
                const isCompleted = card.getAttribute('data-completed') === 'true';
                
                // تحويل النص "2023-10-01T07:30:00Z" إلى كائن تاريخ محلي
                const dateObj = new Date(utcStart);
                const now = new Date();

                // عرض الوقت بالتنسيق المحلي (مثلاً 10:30 م)
                card.querySelector('.local-time-text').innerText = dateObj.toLocaleTimeString('ar-EG', { 
                    hour: '2-digit', 
                    minute: '2-digit', 
                    hour12: true 
                });

                const indicator = card.querySelector('.status-indicator');
                const statusText = card.querySelector('.status-text');

                if (isCompleted) {
                    indicator.className = "status-indicator absolute top-0 right-0 w-1.5 h-full bg-emerald-500";
                    statusText.innerText = "✓ مكتمل";
                    statusText.className = "status-text text-[10px] font-black text-emerald-600";
                } else if (now > dateObj) {
                    indicator.className = "status-indicator absolute top-0 right-0 w-1.5 h-full bg-amber-400 animate-pulse";
                    statusText.innerText = "إرسال التقرير";
                    statusText.className = "status-text text-[10px] font-black text-amber-600";
                } else {
                    indicator.className = "status-indicator absolute top-0 right-0 w-1.5 h-full bg-indigo-500";
                    statusText.innerText = "قادمة";
                    statusText.className = "status-text text-[10px] font-black text-indigo-600";
                }
            });
        }

        function handleWeeklyClick(el) {
            const isCompleted = el.getAttribute('data-completed') === 'true';
            const startTimeStr = el.getAttribute('data-utc-start');
            if (isCompleted) return;
            
            if (new Date() > new Date(startTimeStr)) {
                window.location.href = `/teacher/session/${el.dataset.bookingId}/${el.dataset.index}`;
            } else {
                alert('هذه الحصة لم تنتهِ بعد');
            }
        }

        async function fetchEvents() {
            try {
                const res = await fetch('/teacher/events/<%= user._id %>');
                allEvents = await res.json();
                renderCustomCalendar();
            } catch (err) { console.error("Error fetching events:", err); }
        }

        function switchView(view) {
            const weekly = document.getElementById('weeklyView');
            const monthly = document.getElementById('monthlyView');
            const ctrl = document.getElementById('nav-controls');
            if (view === 'weekly') {
                weekly.classList.remove('hidden'); monthly.classList.add('hidden'); ctrl.classList.add('invisible');
                document.getElementById('btn-weekly').classList.add('active'); document.getElementById('btn-monthly').classList.remove('active');
            } else {
                weekly.classList.add('hidden'); monthly.classList.remove('hidden'); ctrl.classList.remove('invisible');
                document.getElementById('btn-monthly').classList.add('active'); document.getElementById('btn-weekly').classList.remove('active');
                fetchEvents();
            }
        }

        function renderCustomCalendar() {
            const grid = document.getElementById('calendarGrid'); grid.innerHTML = '';
            const year = currentNavDate.getFullYear(); const month = currentNavDate.getMonth();
            const monthNames = ["يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر"];
            document.getElementById('currentMonthLabel').innerText = `${monthNames[month]} ${year}`;
            
            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            for (let i = 0; i < firstDay; i++) grid.innerHTML += `<div class="calendar-day opacity-20 bg-gray-50/50"></div>`;

            for (let day = 1; day <= daysInMonth; day++) {
                const isToday = new Date().toDateString() === new Date(year, month, day).toDateString();
                
                // تصفية الحصص لهذا اليوم مع تحويلها للتوقيت المحلي أولاً
                const dayEvents = allEvents.filter(e => {
                    const localDate = new Date(e.start);
                    return localDate.getFullYear() === year && localDate.getMonth() === month && localDate.getDate() === day;
                });

                let eventsHtml = dayEvents.map(e => {
                    const localTime = new Date(e.start);
                    const isCompleted = e.isSendReport === true;
                    const isPast = new Date() > localTime;
                    
                    let styleClass = 'bg-indigo-50 text-indigo-700 border-indigo-500';
                    if (isCompleted) styleClass = 'bg-emerald-50 text-emerald-600 border-emerald-500 completed';
                    else if (isPast) styleClass = 'bg-amber-50 text-amber-700 border-amber-500 animate-pulse';

                    const timeStr = localTime.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit', hour12: true });

                    return `
                        <div onclick="${isCompleted ? '' : `handleEventClick('${e.bookingId}', '${e.sessionIndex}', '${e.start}')`}" 
                             class="event-bar border-r-4 ${styleClass}">
                             <div class="flex justify-between items-center w-full">
                                <span class="truncate font-black">${e.title}</span>
                                <span class="text-[8px] opacity-70">${timeStr}</span>
                             </div>
                             ${isCompleted ? '<span class="text-[8px] font-bold text-emerald-600">تم الإرسال ✓</span>' : ''}
                        </div>`;
                }).join('');

                grid.innerHTML += `
                    <div class="calendar-day ${isToday ? 'today shadow-inner' : ''} border-b border-l border-gray-50">
                        <span class="text-sm font-black ${isToday ? 'text-indigo-600' : 'text-gray-300'}">${day}</span>
                        <div class="mt-1 flex flex-col gap-1">${eventsHtml}</div>
                    </div>`;
            }
        }

        function handleEventClick(bId, sIndex, startTimeStr) {
            if (new Date() > new Date(startTimeStr)) {
                window.location.href = `/teacher/session/${bId}/${sIndex}`;
            } else {
                alert("هذه الحصة لم تنتهِ بعد");
            }
        }

        function changeMonth(step) { currentNavDate.setMonth(currentNavDate.getMonth() + step); renderCustomCalendar(); }

        // تشغيل التحويل المحلي فور التحميل
        window.onload = localizeWeeklyView;
    </script>
</body>
</html>