<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الطلاب | أكاديمية إتقان</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .main-card { border-radius: 2rem; background: white; border: 1px solid #f1f5f9; box-shadow: 0 4px 20px -5px rgba(0,0,0,0.05); }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    </style>
</head>
<body class="bg-[#fcfcfd] p-4 md:p-8">

    <div class="max-w-7xl mx-auto">
        
        <div class="flex items-center justify-between mb-10">
            <div class="flex items-center gap-4">
                <button onclick="history.back()" class="flex items-center justify-center w-12 h-12 bg-white border border-gray-100 rounded-2xl text-gray-600 hover:bg-gray-50 hover:text-indigo-600 transition-all shadow-sm group">
                    <i data-feather="arrow-right" class="w-6 h-6 group-hover:translate-x-1 transition-transform"></i>
                </button>
                <div>
                    <h2 class="text-2xl font-black text-gray-900 tracking-tight">إدارة الطلاب المشتركين</h2>
                    <p class="text-[11px] font-bold text-gray-400 uppercase tracking-widest mt-1">العدد الإجمالي: <%= students.length %> طالب</p>
                </div>
            </div>
            
            <div class="flex items-center gap-3 bg-white p-2 pr-4 rounded-2xl border border-gray-100 shadow-sm">
                <span class="text-xs font-black text-gray-700"><%= user.name %></span>
                <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white">
                    <i data-feather="user" class="w-5 h-5"></i>
                </div>
            </div>
        </div>

        <div class="main-card p-3 mb-6 flex items-center">
            <div class="relative flex-1">
                <i data-feather="search" class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-300"></i>
                <input type="text" id="studentSearch" onkeyup="searchStudent()" 
                       class="w-full bg-transparent border-none p-4 pr-12 rounded-xl outline-none text-sm font-bold"
                       placeholder="ابحث عن اسم الطالب أو البريد الإلكتروني...">
            </div>
            <button class="bg-gray-50 text-gray-400 p-4 rounded-xl hover:bg-indigo-50 hover:text-indigo-600 transition-all">
                <i data-feather="sliders" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="main-card overflow-hidden">
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-right text-sm">
                    <thead>
                        <tr class="bg-gray-50/50 border-b border-gray-100">
                            <th class="px-8 py-5 font-black text-gray-400 text-[10px] uppercase tracking-widest">بيانات الطالب</th>
                            <th class="px-6 py-5 font-black text-gray-400 text-[10px] uppercase tracking-widest text-center">الكورس</th>
                            <th class="px-6 py-5 font-black text-gray-400 text-[10px] uppercase tracking-widest text-center">عدد الحصص الشهرية </th>
                            <th class="px-6 py-5 font-black text-gray-400 text-[10px] uppercase tracking-widest text-center">الحصص المكتملة</th>
                            <th class="px-8 py-5 font-black text-gray-400 text-[10px] uppercase tracking-widest text-center">الجدول </th>
                        </tr>
                    </thead>
                    <tbody id="studentTableBody" class="divide-y divide-gray-50">
                        <% if (students && students.length > 0) { %>
                            <% students.forEach(student => { %>
                                <tr class="hover:bg-gray-50/50 transition-all group">
                                    <td class="px-8 py-5">
                                        <div class="flex items-center gap-4">
                                            <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-black text-xs border border-indigo-100">
                                                <%= student.name.charAt(0) %>
                                            </div>
                                            <div>
                                                <p class="font-black text-gray-900 leading-none mb-1"><%= student.name %></p>
                                                <p class="text-[10px] text-gray-400 font-medium"><%= student.email %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 text-center">
                                        <span class="text-[11px] font-bold text-gray-600 px-3 py-1 bg-white border border-gray-100 rounded-lg"><%= student.courseTitle %></span>
                                    </td>
                                    <td class="px-6 py-5 text-center" >
                                         <span class="text-[10px] font-bold   'text-emerald-600' %>">
                                               <%= student.numberOfSessionsPerMonth.toString()  %>
                                            </span>
                                    </td>
                                    <td class="px-6 py-5 text-center">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <span class="w-1.5 h-1.5 rounded-full <%= student.isActive ? 'bg-emerald-500 animate-pulse' : 'bg-gray-300' %>"></span>
                                            <span class="text-[10px] font-bold <%= student.isActive ? 'text-emerald-600' : 'text-gray-400' %>">
                                                <%= student.completedSessions   %>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="px-8 py-5">
                                        <div class="flex items-center justify-center gap-2">
                                            <button onclick="window.location.href='/student/my-sessions/<%= student._id %>'" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all">
                                                <i data-feather="table" class="w-4 h-4"></i>
                                            </button>
                                           
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="px-8 py-20 text-center text-gray-400 font-bold">لا يوجد طلاب مسجلين حالياً</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        feather.replace();

        function searchStudent() {
            const input = document.getElementById('studentSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#studentTableBody tr');
            rows.forEach(row => {
                if(row.querySelector('td[colspan]')) return;
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }
    </script>
</body>
</html>