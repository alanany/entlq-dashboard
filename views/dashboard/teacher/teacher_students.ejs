<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= dir %>">

<head>
    <meta charset="utf-8">
    <title><%= settings.academyName %> - طلابي</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root { --primary: #FE5D37; --secondary: #FFF0ED; --light: #F8F9FA; --dark: #000B1C; }
        body { font-family: 'Cairo', sans-serif; background-color: #f7f9fc; font-size: 0.9rem; }
        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }
        .main-content { margin-right: 260px; padding: 1.5rem; min-height: 100vh; transition: all 0.3s; }
        @media (max-width: 991.98px) { .main-content { margin-right: 0; } }

        .section-card {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            border: 1px solid rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .search-input {
            background: #fdfdfd;
            border: 1.5px solid #F3F4F6;
            padding: 0.75rem 1.25rem 0.75rem 2.5rem;
            border-radius: 1rem;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s;
        }
        .search-input:focus {
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(254, 93, 55, 0.1);
        }

        .search-wrapper { position: relative; }
        .search-wrapper i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #adb5bd;
            font-size: 0.85rem;
        }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.85rem 1rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .table-custom tbody td {
            padding: 0.85rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f5f5f5;
            font-size: 0.82rem;
        }
        .table-custom tbody tr {
            cursor: pointer;
            transition: all 0.2s;
        }
        .table-custom tbody tr:hover {
            background-color: var(--secondary);
        }

        .student-avatar {
            width: 38px;
            height: 38px;
            border-radius: 0.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 0.8rem;
        }
    </style>
</head>

<body>
    <%- include('./_teacher_sidebar.ejs', { currentPage: 'students', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2em;">طلابي</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">My Students Overview</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-bold" style="font-size: 0.7rem;">
                        <i class="fas fa-users me-1"></i> <%= students.length %> طالب
                    </span>
                </div>
            </div>
        </div>

        <!-- Stats Row -->
        <div class="row g-3 mb-4">
            <div class="col-md-4 animate__animated animate__fadeInUp">
                <div class="section-card p-3 d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                        <i class="fas fa-users"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 fw-bold" style="font-size: 0.65rem;">إجمالي الطلاب</p>
                        <h5 class="fw-bold mb-0"><%= students.length %></h5>
                    </div>
                </div>
            </div>
            <div class="col-md-4 animate__animated animate__fadeInUp" style="animation-delay: 0.05s;">
                <div class="section-card p-3 d-flex align-items-center gap-3">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                        <i class="fas fa-user-check"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 fw-bold" style="font-size: 0.65rem;">طلاب نشطين</p>
                        <h5 class="fw-bold mb-0"><%= students.filter(s => s.isActive).length %></h5>
                    </div>
                </div>
            </div>
            <div class="col-md-4 animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                <div class="section-card p-3 d-flex align-items-center gap-3">
                    <div class=" bg-opacity-10 text-info rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                        <i class="fas fa-check-double"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-0 fw-bold" style="font-size: 0.65rem;">إجمالي الحصص المكتملة</p>
                        <h5 class="fw-bold mb-0"><%= students.reduce((sum, s) => sum + s.completedSessions, 0) %></h5>
                    </div>
                </div>
            </div>
        </div>

        <!-- Search -->
        <div class="mb-4 animate__animated animate__fadeInUp" style="animation-delay: 0.15s;">
            <div class="search-wrapper">
                <i class="fas fa-search"></i>
                <input type="text" id="searchInput" class="form-control search-input w-100" placeholder="ابحث عن طالب بالاسم أو البريد..." oninput="filterStudents()">
            </div>
        </div>

        <!-- Students Table -->
        <div class="section-card animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
            <div class="table-responsive">
                <table class="table table-custom mb-0" id="studentsTable">
                    <thead>
                        <tr>
                            <th class="ps-4">الطالب</th>
                            <th>الكورس</th>
                            <th class="text-center">الحصص/الشهر</th>
                            <th class="text-center">المكتمل</th>
                            <th class="text-center">الحالة</th>
                            <th class="text-center">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach(student => { %>
                            <tr onclick="window.location.href='/teacher/student/profile/<%= student._id %>'" data-name="<%= student.name %>" data-email="<%= student.email %>">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="student-avatar bg-primary bg-opacity-10 text-primary">
                                            <%= student.name ? student.name.charAt(0) : 'S' %>
                                        </div>
                                        <div>
                                            <p class="fw-bold text-dark mb-0 small"><%= student.name %></p>
                                            <p class="text-muted mb-0 outfit-font" style="font-size: 0.65rem;"><%= student.email %></p>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark rounded-pill px-2 py-1 fw-bold" style="font-size: 0.65rem;">
                                        <%= student.courseTitle %>
                                    </span>
                                </td>
                                <td class="text-center fw-bold"><%= student.numberOfSessionsPerMonth %></td>
                                <td class="text-center">
                                    <span class="text-success fw-bold"><%= student.completedSessions %></span>
                                </td>
                                <td class="text-center">
                                    <% if(student.isActive) { %>
                                        <span class="badge bg-success bg-opacity-10 text-white rounded-pill px-2 py-1" style="font-size: 0.6rem;">نشط</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary bg-opacity-10 text-white rounded-pill px-2 py-1" style="font-size: 0.6rem;">غير نشط</span>
                                    <% } %>
                                </td>
                                <td class="text-center">
                                    <a href="/teacher/student/profile/<%= student._id %>" class="btn btn-sm btn-light rounded-pill px-3 fw-bold" style="font-size: 0.65rem;" onclick="event.stopPropagation();">
                                        <i class="fas fa-eye me-1"></i> عرض
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                        <% if (students.length === 0) { %>
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="fas fa-user-graduate mb-3 opacity-25" style="font-size: 2rem; display: block;"></i>
                                    <p class="fw-bold mb-0">لا يوجد طلاب حتى الآن</p>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="mt-auto py-4 text-center text-muted border-top">
            <small>&copy; <%= settings.academyName %> <%= new Date().getFullYear() %></small>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function filterStudents() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#studentsTable tbody tr');
            rows.forEach(row => {
                const name = (row.getAttribute('data-name') || '').toLowerCase();
                const email = (row.getAttribute('data-email') || '').toLowerCase();
                row.style.display = (name.includes(query) || email.includes(query)) ? '' : 'none';
            });
        }
    </script>
</body>
</html>