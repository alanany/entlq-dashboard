<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>متابعة الطالب - لوحة المعلم</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }
        .timer-gradient { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); }
        .level-radio:checked + label {
            transform: scale(1.05);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
        /* إخفاء شريط التمرير */
        ::-webkit-scrollbar { width: 0px; background: transparent; }
    </style>
</head>
<body class="text-gray-900 pb-10">

    <header class="sticky top-0 z-50 bg-white border-b border-gray-100 shadow-sm">
        <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-4">
             
                <h1 class="text-lg font-bold">حصة فردية: <span class="text-indigo-600"><%= student.name %></span></h1>
            </div>
           
        </div>
    </header>

    <main class="max-w-3xl mx-auto px-4 py-8">
    
        <div class="bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-xl shadow-gray-200/50">
            <div class="flex items-center gap-3 mb-8">
                <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center">
                    <i data-feather="file-text"></i>
                </div>
                <div>
                    <h3 class="font-black text-xl text-gray-900">تقرير أداء </h3>
                    <p class="text-xs text-gray-400">سيتم إرسال هذا التقرير تلقائياً لولي الأمر بعد الحفظ</p>
                </div>
            </div>

            <form action="/teacher/save-session-report" method="POST"  class="space-y-8" onsubmit="handleSubmit(event)">
                <input type="hidden" name="bookingId" value="<%= booking._id %>">
                <input type="hidden" name="sessionIndex" value="<%= sessionIndex %>">
                
                <div>
                    <label class="block text-xs font-black text-gray-400 uppercase tracking-widest mb-4 text-center">تحديد مستوى  في هذه الحصة</label>
                    <div class="grid grid-cols-3 gap-4">
                        <div class="relative">
                            <input type="radio" name="level" id="lvl_A" value="A" class="hidden level-radio peer" checked>
                            <label for="lvl_A" class="flex flex-col items-center justify-center p-4 bg-gray-50 border-2 border-transparent rounded-2xl cursor-pointer hover:bg-gray-100 peer-checked:border-green-500 peer-checked:bg-green-50 transition-all">
                                <span class="text-2xl mb-1">⭐</span>
                                <span class="text-xs font-black text-gray-700">ممتاز</span>
                            </label>
                        </div>
                        <div class="relative">
                            <input type="radio" name="level" id="lvl_B" value="B" class="hidden level-radio peer">
                            <label for="lvl_B" class="flex flex-col items-center justify-center p-4 bg-gray-50 border-2 border-transparent rounded-2xl cursor-pointer hover:bg-gray-100 peer-checked:border-orange-400 peer-checked:bg-orange-50 transition-all">
                                <span class="text-2xl mb-1">👍</span>
                                <span class="text-xs font-black text-gray-700">متوسط</span>
                            </label>
                        </div>
                        <div class="relative">
                            <input type="radio" name="level" id="lvl_C" value="C" class="hidden level-radio peer">
                            <label for="lvl_C" class="flex flex-col items-center justify-center p-4 bg-gray-50 border-2 border-transparent rounded-2xl cursor-pointer hover:bg-gray-100 peer-checked:border-red-500 peer-checked:bg-red-50 transition-all">
                                <span class="text-2xl mb-1">⚠️</span>
                                <span class="text-xs font-black text-gray-700">ضعيف</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase mb-2 mr-1">ما تم إنجازه في الحصة</label>
                        <textarea name="content" required rows="3" class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all placeholder:text-gray-300 shadow-inner" 
                                  placeholder="مثلاً: تم شرح قاعدة كان وأخواتها وحل تمارين الكتاب..."></textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-black text-gray-400 uppercase mb-2 mr-1">ملاحظات </label>
                        <textarea name="instructions" rows="3" class="w-full bg-gray-50 border border-gray-100 p-4 rounded-2xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all placeholder:text-gray-300 shadow-inner" 
                                  placeholder="مثلاً: يرجى مراجعة الكلمات الجديدة وحل صفحة 10..."></textarea>
                    </div>
                </div>

          

                <button button id="saveBtn" type="submit" class="w-full bg-gray-900 hover:bg-indigo-700 text-white py-5 rounded-2xl font-black text-lg shadow-xl shadow-gray-200 transition-all active:scale-95 flex items-center justify-center gap-3">
                    إنهاء الحصة وحفظ التقرير
                    <i data-feather="check-circle" class="w-5 h-5"></i>
                </button>
            </form>
        </div>

    </main>
  <div id="toastContainer" class="fixed bottom-4 right-4 z-[70] space-y-3">
    </div>
   <script>
      feather.replace();
       const saveBtn = document.getElementById("saveBtn");
               const originalButtonText = saveBtn.textContent.trim(); 

     async function handleSubmit(event) {
    event.preventDefault(); // منع إعادة تحميل الصفحة
    
    const form = event.target;
    const formData = new FormData(form);
    const data = Object.fromEntries(formData.entries());
    console.log(data);
   startLoading(true);
    try {
        const response = await fetch(form.action, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });

         if (!response.ok) {
                    stopLoading(true);
                    const errorData = await response.json();
                    // طرح كائن الخطأ كاملاً
                    throw errorData; 
                }
                // حالة النجاح:
                const successData = await response.json();
                stopLoading(true);
                
                // عرض رسالة النجاح في Toast
                showToast("تم الارسال  بنجاح!", 'success'); 
                
                // التحويل إلى لوحة التحكم
                 setTimeout(() => {
                    
                  window.location.href = '/teacher/schedule';
                
                }, 800);

    } catch (error) {
            stopLoading(true);
       console.error(error);
           showToast("خطأ في الإرسال: " + error, 'error');
    }
}
      function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            
            let bgColor = 'bg-blue-600';
            let icon = 'info';

            switch (type) {
                case 'success':
                    bgColor = 'bg-green-600';
                    icon = 'check-circle';
                    break;
                case 'error':
                    bgColor = 'bg-red-600';
                    icon = 'alert-triangle';
                    break;
                case 'info':
                default:
                    bgColor = 'bg-blue-600';
                    icon = 'info';
                    break;
            }

            toast.className = `p-4 max-w-xs text-white ${bgColor} rounded-lg shadow-xl flex items-center transform transition-transform duration-300 translate-x-full`;
            toast.innerHTML = `
                <i data-feather="${icon}" class="w-5 h-5 ml-3"></i>
                <span class="text-sm font-medium">${message}</span>
                <button onclick="this.closest('div').remove()" class="mr-2 text-white/80 hover:text-white transition-colors">
                    <i data-feather="x" class="w-4 h-4"></i>
                </button>
            `;
            container.appendChild(toast);
            feather.replace(); 
            
            
            setTimeout(() => {
                toast.classList.remove('translate-x-full');
            }, 10);

            setTimeout(() => {
                toast.classList.add('translate-x-full');
                toast.addEventListener('transitionend', () => toast.remove(), {once: true});
            }, 5000); 
        }
   function startLoading(isSend = true) {
            saveBtn.disabled = true;
            saveBtn.textContent = !isSend ? originalButtonText: 'جاري الارسال...';
        }
     function stopLoading(isSend = true) {
            saveBtn.disabled = false;
            saveBtn.textContent = !isSend ? originalButtonText : 'جاري الارسال...';
        }
   
    </script>
</body>
</html>