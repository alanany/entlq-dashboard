<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= settings.academyName %> - تقرير الحصة</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Alexandria:wght@300;400;500;700;800;900&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            color: var(--dark);
        }

        .main-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .report-card {
            background: #fff;
            border-radius: 2rem;
            border: 1px solid #f1f1f1;
            box-shadow: 0 1rem 3rem rgba(0,0,0,0.05);
            overflow: hidden;
            animation: slideUp 0.5s ease-out;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .report-header {
            background: linear-gradient(135deg, var(--primary), #ff8a6c);
            padding: 2.5rem 2rem;
            color: white;
            text-align: center;
        }

        .student-initial {
            width: 70px;
            height: 70px;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            border-radius: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 900;
            margin: 0 auto 1rem;
            border: 2px solid rgba(255,255,255,0.3);
            font-family: 'Alexandria', sans-serif;
        }

        .report-body {
            padding: 2.5rem;
        }

        .level-selector {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
            margin-bottom: 2.5rem;
        }

        .level-option {
            position: relative;
        }

        .level-option input {
            position: absolute;
            opacity: 0;
            cursor: pointer;
        }

        .level-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 1.5rem 1rem;
            background: #f8fafc;
            border: 2px solid transparent;
            border-radius: 1.5rem;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .level-option input:checked + .level-card {
            background: #fff;
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.05);
        }

        /* Level Specific Colors */
        .level-option[data-level="A"] input:checked + .level-card { border-color: var(--success); background: #ecfdf5; }
        .level-option[data-level="B"] input:checked + .level-card { border-color: var(--warning); background: #fffbeb; }
        .level-option[data-level="C"] input:checked + .level-card { border-color: var(--danger); background: #fef2f2; }

        .level-emoji { font-size: 1.75rem; margin-bottom: 0.5rem; }
        .level-label { font-weight: 800; font-size: 0.85rem; color: #64748b; }
        .level-option input:checked + .level-card .level-label { color: var(--dark); }

        .form-label-custom {
            font-weight: 700;
            color: #64748b;
            font-size: 0.8rem;
            margin-bottom: 0.75rem;
            display: block;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-control-custom {
            background: #f8fafc;
            border: 1px solid #eef0f2;
            border-radius: 1.25rem;
            padding: 1rem 1.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            transition: all 0.3s;
            width: 100%;
        }

        .form-control-custom:focus {
            background: #fff;
            border-color: var(--primary);
            box-shadow: 0 0 0 0.25rem rgba(254, 93, 55, 0.1);
            outline: none;
        }

        .btn-submit {
            background: var(--dark);
            color: white;
            border: none;
            border-radius: 1.25rem;
            padding: 1.25rem;
            font-weight: 800;
            font-size: 1.1rem;
            width: 100%;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            margin-top: 1rem;
        }

        .btn-submit:hover:not(:disabled) {
            background: var(--primary);
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(254, 93, 55, 0.2);
        }

        .btn-submit:active { transform: translateY(0); }

        .btn-submit:disabled { opacity: 0.7; cursor: not-allowed; }

        .spinner-custom {
            width: 1.25rem;
            height: 1.25rem;
            border: 3px solid rgba(255,255,255,0.3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin { to { transform: rotate(360deg); } }

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: #64748b;
            text-decoration: none;
            font-weight: 700;
            margin-bottom: 1.5rem;
            transition: all 0.2s;
        }

        .back-link:hover { color: var(--primary); transform: translateX(5px); }
    </style>
</head>
<body>

    <div class="main-container">
        <a href="javascript:history.back()" class="back-link">
            <i class="fas fa-arrow-right"></i>
            العودة للجدول
        </a>

        <div class="report-card">
            <header class="report-header">
                <div class="student-initial">
                    <%= student.name.charAt(0).toUpperCase() %>
                </div>
                <h3 class="fw-900 mb-1">تقرير أداء الطالب</h3>
                <p class="mb-0 opacity-75">حصة فردية: <%= student.name %></p>
            </header>

            <div class="report-body">
                <form action="/teacher/save-session-report" method="POST" id="sessionReportForm" onsubmit="handleSubmit(event)">
                    <input type="hidden" name="bookingId" value="<%= booking._id %>">
                    <input type="hidden" name="sessionIndex" value="<%= sessionIndex %>">
                    
                    <!-- Level Selector -->
                    <div class="mb-5">
                        <label class="form-label-custom text-center mb-4">تقييم مستوى الطالب في هذه الحصة</label>
                        <div class="level-selector">
                            <div class="level-option" data-level="A">
                                <input type="radio" name="level" id="lvl_A" value="A" checked>
                                <label for="lvl_A" class="level-card">
                                    <span class="level-emoji">⭐</span>
                                    <span class="level-label">ممتاز</span>
                                </label>
                            </div>
                            <div class="level-option" data-level="B">
                                <input type="radio" name="level" id="lvl_B" value="B">
                                <label for="lvl_B" class="level-card">
                                    <span class="level-emoji">👍</span>
                                    <span class="level-label">متوسط</span>
                                </label>
                            </div>
                            <div class="level-option" data-level="C">
                                <input type="radio" name="level" id="lvl_C" value="C">
                                <label for="lvl_C" class="level-card">
                                    <span class="level-emoji">⚠️</span>
                                    <span class="level-label">ضعيف</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Text Areas -->
                    <div class="mb-4">
                        <label class="form-label-custom">ما تم إنجازه في الحصة</label>
                        <textarea name="content" required rows="4" class="form-control-custom" 
                                  placeholder="مثلاً: تم شرح قاعدة كان وأخواتها وحل تمارين الكتاب..."></textarea>
                    </div>

                    <div class="mb-5">
                        <label class="form-label-custom">ملاحظات وتعليمات للمراجعة</label>
                        <textarea name="instructions" rows="4" class="form-control-custom" 
                                  placeholder="مثلاً: يرجى مراجعة الكلمات الجديدة وحل صفحة 10..."></textarea>
                    </div>

                    <!-- Submit Button -->
                    <button id="saveBtn" type="submit" class="btn-submit">
                        <span class="btn-text">إنهاء الحصة وحفظ التقرير</span>
                        <i class="fas fa-paper-plane"></i>
                    </button>
                    
                    <p class="text-center text-muted small mt-4">
                        <i class="fas fa-info-circle me-1"></i>
                        سيتم إرسال هذا التقرير تلقائياً لولي الأمر فور الحفظ
                    </p>
                </form>
            </div>
        </div>
    </div>

    <script>
        const saveBtn = document.getElementById("saveBtn");
        const btnText = saveBtn.querySelector(".btn-text");

        async function handleSubmit(event) {
            event.preventDefault();
            
            const form = event.target;
            const formData = new FormData(form);
            const data = Object.fromEntries(formData.entries());
            
            setLoading(true);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok) throw result;

                Swal.fire({
                    icon: 'success',
                    title: 'تم الحفظ بنجاح!',
                    text: 'تم إرسال التقرير لولي الأمر بنجاح.',
                    showConfirmButton: false,
                    timer: 2000,
                    customClass: { popup: 'rounded-4' }
                });

                setTimeout(() => {
                    window.location.href = '/teacher/schedule';
                }, 1500);

            } catch (error) {
                setLoading(false);
                console.error(error);
                Swal.fire({
                    icon: 'error',
                    title: 'حدث خطأ في الإرسال',
                    text: error.message || "يرجى المحاولة مرة أخرى لاحقاً",
                    confirmButtonColor: '#FE5D37',
                    customClass: { popup: 'rounded-4' }
                });
            }
        }

        function setLoading(isLoading) {
            saveBtn.disabled = isLoading;
            if (isLoading) {
                btnText.innerText = "جاري الحفظ والارسال...";
                const spinner = document.createElement('div');
                spinner.className = 'spinner-custom';
                saveBtn.appendChild(spinner);
                saveBtn.querySelector('i').classList.add('d-none');
            } else {
                btnText.innerText = "إنهاء الحصة وحفظ التقرير";
                const spinner = saveBtn.querySelector('.spinner-custom');
                if (spinner) spinner.remove();
                saveBtn.querySelector('i').classList.remove('d-none');
            }
        }
    </script>
    <footer class="mt-5 py-4 text-center text-muted border-top">
        <small>&copy; <%= settings.academyName %> <%= new Date().getFullYear() %> - <%= settings.footerText %></small>
    </footer>
</body>
</html>