<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title>تقرير الحصة | <%= settings.academyName %></title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --primary: #FE5D37;
            --primary-light: #FFF0ED;
            --accent: #000B1C;
        }

        body { 
            font-family: 'Cairo', sans-serif; 
            background: #f7f9fc;
            color: #1F2937;
            min-height: 100vh;
        }

        .outfit-font { font-family: 'Outfit', sans-serif; }

        .glass-card {
            background: white;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
        }

        .input-field { 
            width: 100%; 
            background: #fdfdfd; 
            border: 1.5px solid #F3F4F6; 
            padding: 1rem 1.25rem; 
            border-radius: 1rem; 
            outline: none; 
            transition: all 0.3s;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .input-field:focus { 
            border-color: #FE5D37; 
            background: white;
            box-shadow: 0 0 0 4px rgba(254, 93, 55, 0.1);
        }

        .level-radio:checked + .level-label {
            background: #FFF0ED;
            border-color: #FE5D37;
            color: #FE5D37;
            transform: translateY(-2px);
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .slide-up { animation: slideUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
    </style>
</head>
<body class="p-4 md:p-10 pb-20">

    <div class="max-w-3xl mx-auto space-y-8">
        
        <!-- Header -->
        <header class="flex items-center justify-between gap-6 slide-up">
            <div class="flex items-center gap-5">
                <button onclick="history.back()" class="flex items-center justify-center w-12 h-12 bg-white rounded-xl text-gray-500 shadow-sm border border-gray-100 hover:bg-[#FE5D37] hover:text-white transition-all transform active:scale-90 group">
                    <i data-feather="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
                </button>
                <div>
                    <h1 class="text-2xl font-black text-gray-900 tracking-tight">تقرير الحصة</h1>
                    <p class="text-[10px] text-gray-400 font-bold outfit-font uppercase tracking-widest mt-1">Session Performance Report</p>
                </div>
            </div>
            <div class="w-12 h-12 bg-white rounded-xl flex items-center justify-center border border-gray-100 shadow-sm text-[#FE5D37]">
                <i data-feather="file-text" class="w-6 h-6"></i>
            </div>
        </header>

        <!-- Main Card -->
        <div class="glass-card rounded-[2.5rem] overflow-hidden slide-up" style="animation-delay: 0.1s;">
            <div class="bg-[#000B1C] p-8 text-white text-center relative overflow-hidden">
                <div class="relative z-10">
                    <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-white/10 text-2xl font-black outfit-font">
                        <%= (student.name || 'U').charAt(0).toUpperCase() %>
                    </div>
                    <h2 class="text-lg font-black"><%= student.name %></h2>
                    <p class="text-[10px] text-gray-400 font-bold outfit-font uppercase tracking-widest mt-1">Direct Educational Session</p>
                </div>
            </div>

            <div class="p-8 md:p-12">
                <form action="/teacher/save-session-report" method="POST" id="sessionReportForm" onsubmit="handleSubmit(event)" class="space-y-10">
                    <input type="hidden" name="bookingId" value="<%= booking._id %>">
                    <input type="hidden" name="sessionIndex" value="<%= sessionIndex %>">

                    <!-- Level Selector -->
                    <div class="space-y-5">
                        <label class="block text-center text-[10px] font-black text-gray-400 uppercase tracking-widest outfit-font">Performance Rating</label>
                        <div class="grid grid-cols-3 gap-4">
                            <div class="relative">
                                <input type="radio" name="level" id="lvl_A" value="A" checked class="hidden level-radio">
                                <label for="lvl_A" class="level-label flex flex-col items-center justify-center p-5 bg-gray-50 border-2 border-transparent rounded-2xl cursor-pointer transition-all hover:bg-white text-center">
                                    <span class="text-2xl mb-2">🌟</span>
                                    <span class="text-[10px] font-black">ممتاز</span>
                                </label>
                            </div>
                            <div class="relative">
                                <input type="radio" name="level" id="lvl_B" value="B" class="hidden level-radio">
                                <label for="lvl_B" class="level-label flex flex-col items-center justify-center p-5 bg-gray-50 border-2 border-transparent rounded-2xl cursor-pointer transition-all hover:bg-white text-center">
                                    <span class="text-2xl mb-2">✨</span>
                                    <span class="text-[10px] font-black">جيد</span>
                                </label>
                            </div>
                            <div class="relative">
                                <input type="radio" name="level" id="lvl_C" value="C" class="hidden level-radio">
                                <label for="lvl_C" class="level-label flex flex-col items-center justify-center p-5 bg-gray-50 border-2 border-transparent rounded-2xl cursor-pointer transition-all hover:bg-white text-center">
                                    <span class="text-2xl mb-2">💪</span>
                                    <span class="text-[10px] font-black">تحسن</span>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Achievements -->
                    <div class="space-y-2.5">
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Session Achievements</label>
                        <textarea name="content" required rows="4" class="input-field resize-none leading-relaxed" 
                                  placeholder="ما الذي تم إنجازه في الحصة اليوم؟"></textarea>
                    </div>

                    <!-- Instructions -->
                    <div class="space-y-2.5">
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Instructions & Homework</label>
                        <textarea name="instructions" rows="3" class="input-field resize-none leading-relaxed" 
                                  placeholder="أي ملاحظات أو واجبات للطالب؟"></textarea>
                    </div>

                    <!-- Submit -->
                    <div class="pt-4">
                        <button id="saveBtn" type="submit" class="w-full py-4 bg-[#FE5D37] text-white rounded-2xl font-black text-sm shadow-lg shadow-[#FE5D37]/10 hover:bg-black transition-all transform active:scale-95 flex items-center justify-center gap-3 group">
                            <span class="btn-text">إرسال التقرير النهائي</span>
                            <i data-feather="send" class="w-4 h-4"></i>
                        </button>
                        <div class="mt-6 flex items-center justify-center gap-2 text-emerald-600 bg-emerald-50 py-2.5 px-4 rounded-xl border border-emerald-100">
                            <i data-feather="check-circle" class="w-3.5 h-3.5"></i>
                            <p class="text-[9px] font-black outfit-font">This report will be sent to the parent immediately.</p>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Footer -->
        <footer class="py-10 text-center text-gray-400">
            <p class="text-[10px] font-bold uppercase tracking-widest outfit-font opacity-60">
                &copy; <%= new Date().getFullYear() %> <%= settings.academyName %> &bull; Student Progress Monitoring
            </p>
        </footer>
    </div>

    <script>
        feather.replace();

        const saveBtn = document.getElementById("saveBtn");
        const btnText = saveBtn.querySelector(".btn-text");

        async function handleSubmit(event) {
            event.preventDefault();
            const form = event.target;
            const data = Object.fromEntries(new FormData(form).entries());
            
            setLoading(true);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (!response.ok) throw await response.json();

                Swal.fire({
                    icon: 'success',
                    title: 'تم الإرسال!',
                    text: 'تم توثيق الحصة بنجاح.',
                    showConfirmButton: false,
                    timer: 2000,
                    customClass: { popup: 'rounded-2xl' }
                });

                setTimeout(() => window.location.href = '/teacher/home', 1500);

            } catch (error) {
                setLoading(false);
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ في العملية',
                    text: error.message || "يرجى المحاولة مرة أخرى",
                    confirmButtonColor: '#FE5D37',
                    customClass: { popup: 'rounded-2xl' }
                });
            }
        }

        function setLoading(isLoading) {
            saveBtn.disabled = isLoading;
            btnText.innerText = isLoading ? "جاري الإرسال..." : "إرسال التقرير النهائي";
            saveBtn.classList.toggle('opacity-70', isLoading);
        }
    </script>
</body>
</html>