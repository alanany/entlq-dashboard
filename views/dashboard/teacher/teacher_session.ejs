<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= dir %>">

<head>
    <meta charset="utf-8">
    <title><%= settings.academyName %> - تقرير الحصة</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root { --primary: #FE5D37; --secondary: #FFF0ED; --light: #F8F9FA; --dark: #000B1C; }
        body { font-family: 'Cairo', sans-serif; background-color: #f7f9fc; font-size: 0.9rem; }
        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }
        .main-content { margin-right: 260px; padding: 1.5rem; min-height: 100vh; transition: all 0.3s; }
        @media (max-width: 991.98px) { .main-content { margin-right: 0; } }

        .section-card {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            border: 1px solid rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
            overflow: hidden;
        }

        .btn-kider {
            background-color: var(--primary);
            color: #fff;
            border-radius: 0.75rem;
            padding: 0.75rem 1.5rem;
            font-weight: 700;
            border: none;
            font-size: 0.85rem;
            transition: all 0.3s;
        }
        .btn-kider:hover { background-color: #e44d2d; transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.2); color: #fff; }

        .form-control-custom {
            background: #fdfdfd;
            border: 1.5px solid #F3F4F6;
            padding: 0.85rem 1.25rem;
            border-radius: 1rem;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s;
        }
        .form-control-custom:focus {
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(254, 93, 55, 0.1);
        }

        .level-option { cursor: pointer; transition: all 0.3s; }
        .level-option:hover { transform: translateY(-2px); }
        .level-radio:checked + .level-option {
            background: var(--secondary) !important;
            border-color: var(--primary) !important;
            color: var(--primary);
        }
    </style>
</head>

<body>
    <%- include('./_teacher_sidebar.ejs', { currentPage: 'schedule', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2em;">تقرير الحصة</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Session Performance Report</small>
                    </div>
                </div>
                <div>
                    <i class="fas fa-file-alt text-primary"></i>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-7">
                <!-- Student Info Header -->
                <div class="section-card animate__animated animate__fadeInUp">
                    <div class="text-white text-center p-4" style="background: var(--dark);">
                        <div class="bg-white bg-opacity-10 rounded-4 d-flex align-items-center justify-content-center mx-auto mb-3 fw-bold outfit-font" style="width: 60px; height: 60px; font-size: 1.5rem; border: 1px solid rgba(255,255,255,0.1);">
                            <%= (student.name || 'U').charAt(0).toUpperCase() %>
                        </div>
                        <h5 class="fw-bold mb-0"><%= student.name %></h5>
                        <small class="text-muted outfit-font" style="font-size: 0.6rem; letter-spacing: 2px;">DIRECT EDUCATIONAL SESSION</small>
                    </div>

                    <div class="p-4">
                        <form action="/teacher/save-session-report" method="POST" id="sessionReportForm" onsubmit="handleSubmit(event)">
                            <input type="hidden" name="bookingId" value="<%= booking._id %>">
                            <input type="hidden" name="sessionIndex" value="<%= sessionIndex %>">

                            <!-- Level Selector -->
                            <div class="mb-4">
                                <label class="form-label text-muted fw-bold outfit-font text-center d-block" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">تقييم الأداء</label>
                                <div class="row g-3">
                                    <div class="col-4">
                                        <input type="radio" name="level" id="lvl_A" value="A" checked class="d-none level-radio">
                                        <label for="lvl_A" class="level-option d-flex flex-column align-items-center justify-content-center p-3 bg-light border rounded-4 text-center w-100">
                                            <span style="font-size: 1.5rem;" class="mb-1">🌟</span>
                                            <span class="fw-bold" style="font-size: 0.7rem;">ممتاز</span>
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <input type="radio" name="level" id="lvl_B" value="B" class="d-none level-radio">
                                        <label for="lvl_B" class="level-option d-flex flex-column align-items-center justify-content-center p-3 bg-light border rounded-4 text-center w-100">
                                            <span style="font-size: 1.5rem;" class="mb-1">✨</span>
                                            <span class="fw-bold" style="font-size: 0.7rem;">جيد</span>
                                        </label>
                                    </div>
                                    <div class="col-4">
                                        <input type="radio" name="level" id="lvl_C" value="C" class="d-none level-radio">
                                        <label for="lvl_C" class="level-option d-flex flex-column align-items-center justify-content-center p-3 bg-light border rounded-4 text-center w-100">
                                            <span style="font-size: 1.5rem;" class="mb-1">💪</span>
                                            <span class="fw-bold" style="font-size: 0.7rem;">يحتاج تحسن</span>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Achievements -->
                            <div class="mb-4">
                                <label class="form-label text-muted fw-bold outfit-font" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">ما تم إنجازه في الحصة</label>
                                <textarea name="content" required rows="4" class="form-control form-control-custom" style="resize: none;"
                                          placeholder="ما الذي تم إنجازه في الحصة اليوم؟"></textarea>
                            </div>

                            <!-- Instructions -->
                            <div class="mb-4">
                                <label class="form-label text-muted fw-bold outfit-font" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">ملاحظات وواجبات</label>
                                <textarea name="instructions" rows="3" class="form-control form-control-custom" style="resize: none;"
                                          placeholder="أي ملاحظات أو واجبات للطالب؟"></textarea>
                            </div>

                            <!-- Submit -->
                            <button id="saveBtn" type="submit" class="btn btn-kider w-100 py-3">
                                <span class="btn-text">إرسال التقرير النهائي</span>
                                <i class="fas fa-paper-plane ms-2"></i>
                            </button>

                            <div class="d-flex align-items-center justify-content-center gap-2 mt-3 p-2 rounded-3" style="background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.1);">
                                <i class="fas fa-check-circle text-success" style="font-size: 0.7rem;"></i>
                                <small class="text-success fw-bold outfit-font" style="font-size: 0.65rem;">This report will be sent to the parent immediately.</small>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <footer class="mt-auto py-4 text-center text-muted border-top">
            <small>&copy; <%= settings.academyName %> <%= new Date().getFullYear() %></small>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const saveBtn = document.getElementById("saveBtn");
        const btnText = saveBtn.querySelector(".btn-text");

        async function handleSubmit(event) {
            event.preventDefault();
            const form = event.target;
            const data = Object.fromEntries(new FormData(form).entries());
            
            setLoading(true);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (!response.ok) throw await response.json();

                Swal.fire({
                    icon: 'success',
                    title: 'تم الإرسال!',
                    text: 'تم توثيق الحصة بنجاح.',
                    showConfirmButton: false,
                    timer: 2000,
                    customClass: { popup: 'rounded-4' }
                });

                setTimeout(() => window.location.href = '/teacher/home', 1500);

            } catch (error) {
                setLoading(false);
                Swal.fire({
                    icon: 'error',
                    title: 'خطأ في العملية',
                    text: error.message || "يرجى المحاولة مرة أخرى",
                    confirmButtonColor: '#FE5D37',
                    customClass: { popup: 'rounded-4' }
                });
            }
        }

        function setLoading(isLoading) {
            saveBtn.disabled = isLoading;
            btnText.innerText = isLoading ? "جاري الإرسال..." : "إرسال التقرير النهائي";
            saveBtn.style.opacity = isLoading ? '0.7' : '1';
        }
    </script>
</body>
</html>