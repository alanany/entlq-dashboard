<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المحفظة المالية | <%= teacherName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .glass-header { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(12px); }
        .gradient-card { background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%); }
        .status-pill { transition: all 0.3s ease; }
        /* تحسين مظهر التمرير */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    </style>
</head>
<body class="pb-20">

    <header class="sticky top-0 z-50 glass-header border-b border-gray-100">
        <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <button onclick="history.back()" class="p-2 text-gray-400 hover:bg-gray-50 rounded-xl transition-all">
                    <i data-feather="arrow-right"></i>
                </button>
                <div>
                    <h1 class="text-xl font-bold text-gray-900">المحفظة المالية</h1>
                    <p class="text-[11px] text-indigo-500 font-bold tracking-tight">إدارة الأرباح والمستحقات</p>
                </div>
            </div>
            <div class="flex items-center gap-3 bg-indigo-50 px-4 py-2 rounded-2xl">
                <span class="text-[10px] font-black text-indigo-600 uppercase">سعر الساعة:</span>
                <span class="text-sm font-black text-indigo-700"><%= hourlyRate %> ر.س</span>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-10">
        
        <div class="gradient-card p-10 rounded-[3rem] text-white shadow-2xl shadow-indigo-100 mb-12 relative overflow-hidden">
            <div class="relative z-10 flex flex-col md:flex-row justify-between items-center gap-8">
                <div>
                    <div class="flex items-center gap-2 mb-3 opacity-80">
                        <i data-feather="clock" class="w-4 h-4"></i>
                        <span class="text-xs font-bold uppercase tracking-widest">المستحقات غير المدفوعة</span>
                    </div>
                    <div class="flex items-baseline gap-3">
                        <h2 class="text-6xl font-black tracking-tighter italic"><%= totalEarnings %></h2>
                        <span class="text-xl font-medium opacity-70">ر.س</span>
                    </div>
                </div>
                <div class="flex flex-col items-center gap-3">
                    <button class="bg-white text-indigo-900 px-12 py-4 rounded-2xl font-black text-sm shadow-xl hover:bg-indigo-50 transition-all active:scale-95 flex items-center gap-2">
                        <i data-feather="external-link" class="w-4 h-4"></i>
                        طلب سحب المستحقات
                    </button>
                    <p class="text-[10px] opacity-60 font-medium">تتم مراجعة الطلبات خلال ساعات العمل الرسمية</p>
                </div>
            </div>
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-white/10 rounded-full"></div>
            <div class="absolute -bottom-20 -left-10 w-60 h-60 bg-black/10 rounded-full"></div>
        </div>

        <section class="mb-16">
            <h3 class="text-lg font-black text-gray-800 mb-6 flex items-center gap-2">
                <i data-feather="bar-chart-2" class="text-indigo-500 w-5 h-5"></i>
                ملخص الشهور
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <% Object.keys(monthlyStats).forEach(key => { %>
                    <div class="bg-white p-7 rounded-[2.5rem] border border-gray-100 shadow-sm hover:shadow-md transition-all cursor-pointer group" onclick="filterByMonth('<%= key %>')">
                        <div class="flex justify-between items-start mb-6">
                            <span class="text-[10px] font-black text-gray-400 bg-gray-50 px-3 py-1.5 rounded-full uppercase tracking-widest"><%= key %></span>
                            <% if (monthlyStats[key].isPaid) { %>
                                <span class="flex items-center gap-1 text-green-500 text-[10px] font-black"><i data-feather="check-circle" class="w-3 h-3"></i> مدفوع</span>
                            <% } else { %>
                                <span class="flex items-center gap-1 text-orange-400 text-[10px] font-black animate-pulse"><i data-feather="alert-circle" class="w-3 h-3"></i> قيد الانتظار</span>
                            <% } %>
                        </div>
                        <h4 class="text-xl font-black text-gray-900 mb-1"><%= monthlyStats[key].name %></h4>
                        <p class="text-3xl font-black text-indigo-600 tracking-tighter"><%= monthlyStats[key].total.toFixed(2) %> <span class="text-xs font-bold text-gray-300">ر.س</span></p>
                        <div class="mt-4 pt-4 border-t border-gray-50 flex justify-between items-center">
                            <span class="text-[10px] font-bold text-gray-400"><%= monthlyStats[key].count %> حصة منجزة</span>
                            <i data-feather="chevron-left" class="w-4 h-4 text-gray-300 group-hover:text-indigo-500 group-hover:translate-x-[-4px] transition-all"></i>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <section class="mb-16">
            <h3 class="text-lg font-black text-gray-800 mb-6 flex items-center gap-2">
                <i data-feather="shield" class="text-green-500 w-5 h-5"></i>
                الحوالات الصادرة من الإدارة
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% if (paymentHistory && paymentHistory.length > 0) { %>
                    <% paymentHistory.forEach(payment => { %>
                        <div class="bg-white p-5 rounded-[2rem] border-r-4 border-r-green-500 shadow-sm flex justify-between items-center">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 bg-green-50 text-green-600 rounded-xl flex items-center justify-center">
                                    <i data-feather="arrow-down-left" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-black text-gray-800">تحويل شهر <%= payment.month %></p>
                                    <p class="text-[10px] text-gray-400 font-bold"><%= new Date(payment.paymentDate).toLocaleDateString('ar-EG') %></p>
                                </div>
                            </div>
                            <div class="text-left">
                                <p class="text-lg font-black text-green-600"><%= payment.amount %> ر.س</p>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="col-span-2 py-10 bg-gray-50 rounded-[2.5rem] border border-dashed border-gray-200 text-center text-gray-400 text-sm font-bold">
                        لا توجد حوالات مسجلة حالياً
                    </div>
                <% } %>
            </div>
        </section>

        <section class="bg-white rounded-[3rem] shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-8 border-b border-gray-50 flex flex-col md:flex-row justify-between items-center gap-4">
                <h3 class="text-lg font-black text-gray-900">سجل تفاصيل الحصص</h3>
                <select id="monthSelect" class="bg-gray-50 border-none rounded-xl px-5 py-3 text-xs font-black text-gray-600 outline-none ring-1 ring-gray-100 focus:ring-indigo-500 transition-all">
                    <option value="all">عرض جميع الشهور</option>
                    <% Object.keys(monthlyStats).forEach(key => { %>
                        <option value="<%= key %>"><%= monthlyStats[key].name %></option>
                    <% }) %>
                </select>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-right">
                    <thead>
                        <tr class="bg-gray-50/50 text-[10px] font-black text-gray-400 tracking-[0.2em] uppercase">
                            <th class="px-8 py-5">المادة والطالب</th>
                            <th class="px-8 py-5 text-center">المدة</th>
                            <th class="px-8 py-5">التاريخ</th>
                            <th class="px-8 py-5 text-left">الربح / الحالة</th>
                        </tr>
                    </thead>
                    <tbody id="sessionsTable">
                        <% completedSessions.forEach(session => { %>
                            <tr class="session-row hover:bg-indigo-50/30 transition-all border-b border-gray-50 last:border-0" data-month="<%= session.monthKey %>">
                                <td class="px-8 py-6">
                                    <p class="text-sm font-black text-gray-800"><%= session.courseTitle %></p>
                                    <p class="text-[10px] text-gray-400 font-bold mt-1">الطالب: <%= session.studentName %></p>
                                </td>
                                <td class="px-8 py-6 text-center">
                                    <span class="bg-gray-100 text-gray-500 text-[10px] font-black px-3 py-1.5 rounded-lg"><%= session.duration %> د</span>
                                </td>
                                <td class="px-8 py-6">
                                    <p class="text-xs font-bold text-gray-600"><%= new Date(session.date).toLocaleDateString('ar-EG', {day: 'numeric', month: 'long'}) %></p>
                                    <p class="text-[9px] text-gray-400 font-medium mt-1 uppercase tracking-widest"><%= session.time %></p>
                                </td>
                                <td class="px-8 py-6 text-left">
                                    <p class="text-sm font-black text-indigo-600">+<%= session.price.toFixed(2) %></p>
                                    <% if (session.isPaid) { %>
                                        <span class="text-[8px] font-black text-green-500 bg-green-50 px-2 py-0.5 rounded uppercase">تم الصرف</span>
                                    <% } else { %>
                                        <span class="text-[8px] font-black text-gray-300 bg-gray-50 px-2 py-0.5 rounded uppercase">معلق</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <script>
        feather.replace();

        function filterByMonth(month) {
            document.getElementById('monthSelect').value = month;
            updateTable(month);
            document.getElementById('monthSelect').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        document.getElementById('monthSelect').addEventListener('change', (e) => updateTable(e.target.value));

        function updateTable(val) {
            const rows = document.querySelectorAll('.session-row');
            rows.forEach(row => {
                row.style.display = (val === 'all' || row.dataset.month === val) ? 'table-row' : 'none';
            });
        }
    </script>
</body>
</html>