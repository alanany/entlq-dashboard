<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المحفظة المالية | <%= teacherName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        :root {
            --primary: #FE5D37;
            --primary-light: #FFF0ED;
            --accent: #000B1C;
        }

        body { 
            font-family: 'Cairo', sans-serif; 
            background: #f7f9fc;
            color: #1F2937;
            min-height: 100vh;
        }

        .outfit-font { font-family: 'Outfit', sans-serif; }

        .glass-card {
            background: white;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
        }

        .gradient-card {
            background: linear-gradient(135deg, #FE5D37 0%, #FF8a6c 100%);
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .slide-up { animation: slideUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; }
    </style>
</head>
<body class="p-6 md:p-10 pb-20">

    <div class="max-w-6xl mx-auto space-y-10">
        
        <!-- Header Section -->
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-6 slide-up">
            <div class="flex items-center gap-5">
                <button onclick="history.back()" class="flex items-center justify-center w-12 h-12 bg-white rounded-xl text-gray-500 shadow-sm border border-gray-100 hover:bg-[#FE5D37] hover:text-white transition-all transform active:scale-90 group">
                    <i data-feather="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
                </button>
                <div>
                    <h1 class="text-2xl font-black text-gray-900 tracking-tight">إحصائيات المحفظة</h1>
                    <p class="text-[10px] text-gray-400 font-bold outfit-font uppercase tracking-widest mt-1">Total Earnings & Financial Overview</p>
                </div>
            </div>
            
            <div class="flex items-center gap-4 bg-white px-5 py-3 rounded-2xl border border-gray-100 shadow-sm">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-[#FE5D37]"></span>
                    <span class="text-[10px] font-black text-gray-400 uppercase outfit-font">Rate:</span>
                </div>
                <span class="text-md font-black text-[#FE5D37] outfit-font tracking-tighter"><%= hourlyRate %> <span class="text-[10px] font-bold text-gray-300">SAR</span></span>
            </div>
        </header>

        <!-- Balance Card -->
        <div class="gradient-card p-10 rounded-[2.5rem] text-white shadow-xl shadow-[#FE5D37]/20 slide-up relative overflow-hidden group" style="animation-delay: 0.1s;">
            <div class="relative z-10 flex flex-col md:flex-row justify-between items-center gap-10">
                <div class="text-center md:text-right">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/10 rounded-full border border-white/10 mb-4">
                        <i data-feather="clock" class="w-3.5 h-3.5 text-white/80"></i>
                        <span class="text-[9px] font-black uppercase tracking-widest">المستحقات المعلقة</span>
                    </div>
                    <div class="flex items-baseline justify-center md:justify-start gap-3">
                        <h2 class="text-6xl font-black outfit-font"><%= totalEarnings %></h2>
                        <span class="text-xl font-bold opacity-60 outfit-font">SAR</span>
                    </div>
                </div>
                
                <div class="flex flex-col items-center gap-4">
                    <button class="bg-white text-[#FE5D37] px-12 py-4 rounded-2xl font-black text-sm shadow-lg hover:bg-[#000B1C] hover:text-white transition-all transform active:scale-95 flex items-center gap-3 group/btn">
                        <i data-feather="file-text" class="w-5 h-5"></i>
                        طلب كشف حساب
                    </button>
                </div>
            </div>
            <i data-feather="dollar-sign" class="absolute -bottom-10 -left-10 w-48 h-48 text-white/5 pointer-events-none rotate-12"></i>
        </div>

        <!-- Monthly Cards Grid -->
        <section class="slide-up" style="animation-delay: 0.2s;">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <% Object.keys(monthlyStats).forEach((key, index) => { %>
                    <div class="glass-card p-6 rounded-2xl group hover:border-[#FE5D37]/30 transition-all cursor-pointer overflow-hidden relative" onclick="filterByMonth('<%= key %>')">
                        <div class="flex justify-between items-start mb-6">
                            <span class="text-[10px] font-black text-gray-400 bg-gray-50 border border-gray-100 px-3 py-1 rounded-full outfit-font tracking-widest"><%= key %></span>
                            <% if (monthlyStats[key].isPaid) { %>
                                <span class="text-emerald-500 text-[9px] font-black bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100 italic">مدفوع</span>
                            <% } else { %>
                                <span class="text-amber-500 text-[9px] font-black bg-amber-50 px-2 py-0.5 rounded-full border border-amber-100 italic">معلق</span>
                            <% } %>
                        </div>
                        
                        <div class="relative z-10">
                            <h4 class="text-sm font-bold text-gray-500 mb-1"><%= monthlyStats[key].name %></h4>
                            <p class="text-3xl font-black text-gray-900 outfit-font">
                                <%= monthlyStats[key].total.toFixed(2) %> 
                                <span class="text-xs font-bold text-gray-300 mr-1 italic">SAR</span>
                            </p>
                        </div>

                        <div class="mt-6 pt-5 border-t border-gray-50 flex justify-between items-center relative z-10">
                            <span class="text-[10px] font-bold text-gray-400"><%= monthlyStats[key].count %> حصص منجزة</span>
                            <div class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center text-gray-300 group-hover:bg-[#FE5D37] group-hover:text-white transition-all">
                                <i data-feather="chevron-left" class="w-4 h-4"></i>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        </section>

        <!-- Detailed List Table -->
        <section class="glass-card rounded-2xl overflow-hidden slide-up" style="animation-delay: 0.3s;">
            <div class="p-6 border-b border-gray-50 flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-black text-gray-900">سجل الحصص المنفذة</h3>
                    <p class="text-[10px] text-gray-400 font-bold outfit-font uppercase tracking-widest">Detailed Transaction History</p>
                </div>
                <select id="monthSelect" class="bg-gray-50 border-none rounded-xl px-4 py-2 text-xs font-black text-gray-600 outline-none ring-1 ring-gray-100 appearance-none cursor-pointer">
                    <option value="all">كل الشهور</option>
                    <% Object.keys(monthlyStats).forEach(key => { %>
                        <option value="<%= key %>"><%= monthlyStats[key].name %></option>
                    <% }) %>
                </select>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-right">
                    <thead class="bg-gray-50 text-[10px] font-black text-gray-400 tracking-widest uppercase outfit-font">
                        <tr>
                            <th class="px-8 py-5">Course / Student</th>
                            <th class="px-8 py-5 text-center">Duration</th>
                            <th class="px-8 py-5">Date</th>
                            <th class="px-8 py-5 text-left">Amount</th>
                        </tr>
                    </thead>
                    <tbody id="sessionsTable" class="divide-y divide-gray-50">
                        <% completedSessions.forEach(session => { %>
                            <tr class="session-row hover:bg-gray-50/50 transition-colors" data-month="<%= session.monthKey %>">
                                <td class="px-8 py-5">
                                    <p class="text-sm font-black text-gray-900 mb-0.5"><%= session.courseTitle %></p>
                                    <p class="text-[10px] text-[#FE5D37] font-bold">طالب: <%= session.studentName %></p>
                                </td>
                                <td class="px-8 py-5 text-center">
                                    <span class="text-[10px] font-black text-gray-500 bg-gray-100 px-2 py-1 rounded-md outfit-font"><%= session.duration %>m</span>
                                </td>
                                <td class="px-8 py-5">
                                    <p class="text-xs font-bold text-gray-700 outfit-font"><%= new Date(session.date).toLocaleDateString('en-GB') %></p>
                                </td>
                                <td class="px-8 py-5 text-left">
                                    <p class="text-sm font-black text-gray-900 outfit-font">+<%= session.price.toFixed(2) %></p>
                                    <% if (session.isPaid) { %>
                                        <span class="text-[8px] font-black text-emerald-500 uppercase italic">Paid</span>
                                    <% } else { %>
                                        <span class="text-[8px] font-black text-gray-300 uppercase italic">Pending</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- Footer -->
        <footer class="py-10 text-center text-gray-400">
            <p class="text-[10px] font-bold uppercase tracking-widest outfit-font opacity-60">
                &copy; <%= new Date().getFullYear() %> <%= settings.academyName %> &bull; Financial Portal
            </p>
        </footer>
    </div>

    <script>
        feather.replace();

        function filterByMonth(month) {
            document.getElementById('monthSelect').value = month;
            updateTable(month);
            window.scrollTo({ top: document.getElementById('monthSelect').offsetTop - 100, behavior: 'smooth' });
        }

        document.getElementById('monthSelect').addEventListener('change', (e) => updateTable(e.target.value));

        function updateTable(val) {
            const rows = document.querySelectorAll('.session-row');
            rows.forEach(row => {
                row.style.display = (val === 'all' || row.dataset.month === val) ? 'table-row' : 'none';
            });
        }
    </script>
</body>
</html>