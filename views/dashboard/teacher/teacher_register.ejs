<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل معلم جديد | منصة انطلق</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
      body {
        font-family: "Tajawal", sans-serif;
        background-color: #f8fafc;
      }
      .input-group:focus-within label {
        color: #4f46e5;
      }
      .input-group:focus-within .icon-box {
        background-color: #4f46e5;
        color: white;
      }
      select {
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
      }

      .gender-radio:checked + .gender-card {
        border-color: #4f46e5;
        background-color: #f5f3ff;
        color: #4f46e5;
      }
    </style>
  </head>
  <body class="min-h-screen flex items-center justify-center p-4">
    <div
      class="max-w-5xl w-full bg-white rounded-[3rem] shadow-2xl shadow-indigo-100 overflow-hidden flex flex-col md:flex-row border border-slate-50"
    >
      <div
        class="md:w-4/12 bg-indigo-600 p-10 text-white flex flex-col justify-between relative overflow-hidden"
      >
        <div class="relative z-10">
          <div class="flex items-center gap-2 mb-8">
            <div
              class="w-8 h-8 bg-white/20 rounded-lg flex items-center justify-center"
            >
              <i data-feather="zap" class="w-5 h-5"></i>
            </div>
            <span class="text-xl font-black">انطلق.</span>
          </div>
          <h2 class="text-3xl font-black mb-4 leading-tight">
            انضم كمعلم متميز
          </h2>
          <p class="text-indigo-100 text-sm opacity-80 font-medium">
            ابدأ الآن في إدارة حصصك وطلابك بكل سهولة.
          </p>
        </div>

        <div class="relative z-10 space-y-6">
          <div class="flex items-center gap-4">
            <div
              class="w-10 h-10 rounded-2xl bg-white/10 flex items-center justify-center backdrop-blur-sm"
            >
              <i data-feather="video" class="w-5 h-5"></i>
            </div>
            <span class="text-xs font-bold">حصص مباشرة ذكية</span>
          </div>
          <div class="flex items-center gap-4">
            <div
              class="w-10 h-10 rounded-2xl bg-white/10 flex items-center justify-center backdrop-blur-sm"
            >
              <i data-feather="bar-chart-2" class="w-5 h-5"></i>
            </div>
            <span class="text-xs font-bold">تقارير أداء دقيقة</span>
          </div>
        </div>
        <div
          class="absolute -bottom-10 -left-10 w-40 h-40 bg-white/10 rounded-full blur-3xl"
        ></div>
      </div>

      <div class="md:w-8/12 p-8 md:p-12 overflow-y-auto max-h-[90vh]">
        <div class="mb-8 text-center md:text-right">
          <h1 class="text-2xl font-black text-gray-900 tracking-tight">
            إنشاء حساب جديد
          </h1>
          <p
            class="text-xs text-gray-400 mt-2 font-bold uppercase tracking-widest"
          >
            لديك حساب؟
            <a href="/teacher/login" class="text-indigo-600 hover:underline"
              >تسجيل الدخول</a
            >
          </p>
        </div>

        <form
          id="teacherForm"
          action="/teacher/register"
          method="POST"
          class="space-y-6"
          onsubmit="handleSubmit(event)"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="input-group">
              <label
                class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2 mr-1"
                >الاسم الكامل</label
              >
              <div class="relative">
                <div
                  class="icon-box absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-gray-50 text-gray-400 rounded-xl flex items-center justify-center transition-all pointer-events-none"
                >
                  <i data-feather="user" class="w-4 h-4"></i>
                </div>
                <input
                  type="text"
                  name="name"
                  required
                  class="w-full bg-gray-50 border-2 border-transparent pr-14 pl-4 py-4 rounded-2xl text-sm font-bold focus:bg-white focus:border-indigo-500/10 outline-none transition-all"
                  placeholder="الاسم الثلاثي"
                />
              </div>
            </div>

            <div class="input-group">
              <label
                class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2 mr-1"
                >البريد الإلكتروني</label
              >
              <div class="relative">
                <div
                  class="icon-box absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-gray-50 text-gray-400 rounded-xl flex items-center justify-center transition-all pointer-events-none"
                >
                  <i data-feather="mail" class="w-4 h-4"></i>
                </div>
                <input
                  type="email"
                  name="email"
                  required
                  class="w-full bg-gray-50 border-2 border-transparent pr-14 pl-4 py-4 rounded-2xl text-sm font-bold focus:bg-white focus:border-indigo-500/10 outline-none transition-all"
                  placeholder="mail@example.com"
                />
              </div>
            </div>
          </div>

          <div class="input-group">
            <label
              class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2 mr-1"
              >رقم الجوال</label
            >
            <div class="flex gap-2">
              <div class="relative w-32">
                <select
                  name="country_code"
                  class="w-full bg-gray-50 border-2 border-transparent pr-4 pl-2 py-4 rounded-2xl text-xs font-black focus:bg-white focus:border-indigo-500/10 outline-none cursor-pointer"
                >
                  <option value="+966">🇸🇦 +966</option>
                  <option value="+20">🇪🇬 +20</option>
                  <option value="+971">🇦🇪 +971</option>
                </select>
                <div
                  class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none text-gray-400"
                >
                  <i data-feather="chevron-down" class="w-4 h-4"></i>
                </div>
              </div>
              <div class="relative flex-1">
                <div
                  class="icon-box absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-gray-50 text-gray-400 rounded-xl flex items-center justify-center pointer-events-none"
                >
                  <i data-feather="phone" class="w-4 h-4"></i>
                </div>
                <input
                  type="tel"
                  name="phone_number"
                  dir="ltr"
                  class="w-full bg-gray-50 border-2 border-transparent pr-14 pl-4 py-4 rounded-2xl text-sm font-bold focus:bg-white focus:border-indigo-500/10 outline-none transition-all text-left placeholder:text-right"
                  placeholder="5XXXXXXXX"
                />
              </div>
            </div>
          </div>

          <div class="input-group">
            <label
              class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-3 mr-1"
              >النوع</label
            >
            <div class="grid grid-cols-2 gap-4">
              <label class="relative cursor-pointer">
                <input
                  type="radio"
                  name="gender"
                  value="male"
                  class="gender-radio hidden"
                  required
                  checked
                />
                <div
                  class="gender-card border-2 border-gray-50 bg-gray-50 p-4 rounded-2xl flex items-center justify-center gap-3 transition-all"
                >
                  <i data-feather="user" class="w-4 h-4"></i>
                  <span class="text-sm font-bold">ذكر</span>
                </div>
              </label>
              <label class="relative cursor-pointer">
                <input
                  type="radio"
                  name="gender"
                  value="female"
                  class="gender-radio hidden"
                />
                <div
                  class="gender-card border-2 border-gray-50 bg-gray-50 p-4 rounded-2xl flex items-center justify-center gap-3 transition-all"
                >
                  <i data-feather="user-plus" class="w-4 h-4"></i>
                  <span class="text-sm font-bold">أنثى</span>
                </div>
              </label>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="input-group">
              <label
                class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2 mr-1"
                >كلمة المرور</label
              >
              <div class="relative">
                <div
                  class="icon-box absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-gray-50 text-gray-400 rounded-xl flex items-center justify-center pointer-events-none"
                >
                  <i data-feather="lock" class="w-4 h-4"></i>
                </div>
                <input
                  type="password"
                  name="password"
                  required
                  class="w-full bg-gray-50 border-2 border-transparent pr-14 pl-4 py-4 rounded-2xl text-sm font-bold focus:bg-white focus:border-indigo-500/10 outline-none transition-all"
                  placeholder="••••••••"
                />
              </div>
            </div>

            <div class="input-group">
              <label
                class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2 mr-1"
                >تأكيد كلمة المرور</label
              >
              <div class="relative">
                <div
                  class="icon-box absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-gray-50 text-gray-400 rounded-xl flex items-center justify-center pointer-events-none"
                >
                  <i data-feather="shield" class="w-4 h-4"></i>
                </div>
                <input
                  type="password"
                  name="confirm_password"
                  required
                  class="w-full bg-gray-50 border-2 border-transparent pr-14 pl-4 py-4 rounded-2xl text-sm font-bold focus:bg-white focus:border-indigo-500/10 outline-none transition-all"
                  placeholder="••••••••"
                />
              </div>
            </div>
          </div>

          <div class="input-group">
            <label
              class="block text-[10px] font-black text-indigo-500 uppercase tracking-widest mb-2 mr-1"
              >رابط زووم الشخصي (اختياري)</label
            >
            <div class="relative">
              <div
                class="icon-box absolute right-2 top-1/2 -translate-y-1/2 w-10 h-10 bg-indigo-50 text-indigo-400 rounded-xl flex items-center justify-center pointer-events-none"
              >
                <i data-feather="video" class="w-4 h-4"></i>
              </div>
              <input
                type="text"
                name="zoom_link"
                dir="ltr"
                class="w-full bg-indigo-50/20 border-2 border-transparent pr-14 pl-4 py-4 rounded-2xl text-sm font-bold focus:bg-white focus:border-indigo-500/10 outline-none transition-all text-left placeholder:text-indigo-200"
                placeholder="https://zoom.us/j/..."
              />
            </div>
          </div>

          <button
            id="saveBtn"
            type="submit"
            class="w-full bg-indigo-500 hover:bg-indigo-500 text-white py-4 rounded-2xl font-black text-lg shadow-xl shadow-indigo-100 transition-all flex items-center justify-center gap-3"
          >
            <i data-feather="log-in" class="w-5 h-5"></i>
            <span>إنشاء حسابي الآن</span>
          </button>
        </form>
      </div>
    </div>

    <div
      id="toastContainer"
      class="fixed bottom-4 right-4 z-[70] space-y-3"
    ></div>

    <script>
      feather.replace();

      const saveBtn = document.getElementById("saveBtn");
      const originalButtonText = saveBtn.textContent.trim();

      function startLoading(isSend = true) {
        saveBtn.disabled = true;
        saveBtn.innerHTML = !isSend
          ? `<i data-feather="log-in" class="w-5 h-5"></i><span>${originalButtonText}</span>`
          : `<span>جاري الإنشاء...</span>`;
      }

      function stopLoading(isSend = true) {
        saveBtn.disabled = false;
        saveBtn.innerHTML = !isSend
          ? `<i data-feather="log-in" class="w-5 h-5"></i><span>${originalButtonText}</span>`
          : `<span>جاري الإنشاء...</span>`;

        feather.replace();
      }

      function showToast(message, type = "info") {
        const container = document.getElementById("toastContainer");
        const toast = document.createElement("div");
        let bgColor =
          type === "success"
            ? "bg-green-600"
            : type === "error"
            ? "bg-red-600"
            : "bg-blue-600";
        let icon =
          type === "success"
            ? "check-circle"
            : type === "error"
            ? "alert-triangle"
            : "info";

        toast.className = `p-4 min-w-[250px] text-white ${bgColor} rounded-xl shadow-xl flex items-center justify-between transform transition-all duration-300 translate-x-full opacity-0`;
        toast.innerHTML = `
                <div class="flex items-center gap-3">
                    <i data-feather="${icon}" class="w-5 h-5"></i>
                    <span class="text-sm font-bold">${message}</span>
                </div>
                <button onclick="this.parentElement.remove()" class="mr-4"><i data-feather="x" class="w-4 h-4"></i></button>
            `;

        container.appendChild(toast);
        feather.replace();

        setTimeout(() => {
          toast.classList.remove("translate-x-full", "opacity-0");
        }, 10);

        setTimeout(() => {
          toast.classList.add("translate-x-full", "opacity-0");
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }

      async function handleSubmit(event) {
        event.preventDefault();

        const form = event.target;
        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        console.log(data, "data");
        const gender = formData.get("gender"); // 'male' أو 'female'

        console.log("النوع المختار هو:", gender);

        startLoading(true);

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });

          const result = await response.json();

          if (!response.ok) {
            if (result.errors) {
              throw new Error(
                result.errors[0]["message"] || "حدث خطأ غير متوقع"
              );
            } else {
              console.log(result, "result");
              throw new Error(result.error || "حدث خطأ  ");
            }
          }
          showToast("تم إنشاء الحساب بنجاح!", "success");
          setTimeout(() => {
            window.location.href = "/teacher/login";
          }, 1500);
        } catch (error) {
          stopLoading(false);
          showToast(error, "error");
        }
      }
    </script>
  </body>
</html>
