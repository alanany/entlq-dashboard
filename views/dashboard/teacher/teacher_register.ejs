<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل معلم جديد | <%= settings.academyName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        :root {
            --primary: #FE5D37;
            --primary-light: #FFF0ED;
            --accent: #000B1C;
        }

        body { 
            font-family: 'Cairo', sans-serif; 
            background: #f7f9fc;
            color: #1F2937;
        }

        .outfit-font { font-family: 'Outfit', sans-serif; }

        .gender-radio:checked + .gender-card {
            border-color: var(--primary);
            background-color: var(--primary-light);
            color: var(--primary);
        }

        .input-box:focus-within {
            border-color: var(--primary);
            background: white;
            box-shadow: 0 0 0 4px rgba(254, 93, 55, 0.1);
        }

        .input-box:focus-within .icon-box {
            color: var(--primary);
        }
    </style>
  </head>
  <body class="min-h-screen flex items-center justify-center p-4">
    <div class="max-w-5xl w-full bg-white rounded-[2.5rem] shadow-xl overflow-hidden flex flex-col md:flex-row border border-gray-100">
      
      <!-- Left sidebar -->
      <div class="md:w-5/12 bg-[#FE5D37] p-10 text-white flex flex-col justify-between relative overflow-hidden text-right">
        <div class="relative z-10">
          <div class="flex items-center gap-3 mb-10">
            <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center">
              <i data-feather="award" class="w-6 h-6"></i>
            </div>
            <span class="text-2xl font-black outfit-font"><%= settings.academyName %></span>
          </div>
          <h2 class="text-3xl font-black mb-4 leading-tight">انضم لنخبة المعلمين المبدعين</h2>
          <p class="text-white/80 text-sm font-medium leading-relaxed">كن جزءاً من منصتنا التعليمية الرائدة وساعد في بناء مستقبل الجيل القادم من خلال أدوات تعليمية متطورة.</p>
        </div>

        <div class="relative z-10 space-y-6">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center">
              <i data-feather="calendar" class="w-5 h-5"></i>
            </div>
            <span class="text-xs font-bold">إدارة ذكية للجداول</span>
          </div>
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center">
              <i data-feather="pocket" class="w-5 h-5"></i>
            </div>
            <span class="text-xs font-bold">نظام دفع وسحوبات سريع</span>
          </div>
        </div>
        <i data-feather="zap" class="absolute -bottom-10 -left-10 w-64 h-64 text-white/10 pointer-events-none -rotate-12"></i>
      </div>

      <!-- Main form -->
      <div class="md:w-7/12 p-8 md:p-12 overflow-y-auto max-h-[90vh]">
        <div class="mb-10 text-center md:text-right">
          <h1 class="text-2xl font-black text-gray-900 tracking-tight">طلب انضمام جديد</h1>
          <p class="text-xs text-gray-400 mt-2 font-bold uppercase tracking-widest outfit-font">
            Already have an account? 
            <a href="/teacher/login" class="text-[#FE5D37] hover:underline font-black ms-1">Sign In</a>
          </p>
        </div>

        <form id="teacherForm" action="/teacher/register" method="POST" class="space-y-6" onsubmit="handleSubmit(event)">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Full Name</label>
              <div class="input-box relative flex items-center bg-gray-50 border-2 border-transparent rounded-2xl transition-all">
                <div class="icon-box px-4 text-gray-400 transition-colors">
                  <i data-feather="user" class="w-4 h-4"></i>
                </div>
                <input type="text" name="name" required class="w-full bg-transparent py-4 text-sm font-bold outline-none" placeholder="الاسم بالكامل">
              </div>
            </div>

            <div class="space-y-2">
              <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Email Address</label>
              <div class="input-box relative flex items-center bg-gray-50 border-2 border-transparent rounded-2xl transition-all">
                <div class="icon-box px-4 text-gray-400 transition-colors">
                  <i data-feather="mail" class="w-4 h-4"></i>
                </div>
                <input type="email" name="email" required class="w-full bg-transparent py-4 text-sm font-bold outline-none" placeholder="mail@example.com">
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Phone Number</label>
            <div class="flex gap-3">
              <select name="country_code" class="w-32 bg-gray-50 border-2 border-transparent px-4 py-4 rounded-2xl text-xs font-black outline-none focus:border-[#FE5D37]/50 appearance-none text-center">
                <option value="+966">🇸🇦 +966</option>
                <option value="+20">🇪🇬 +20</option>
                <option value="+971">🇦🇪 +971</option>
              </select>
              <div class="input-box relative flex flex-1 items-center bg-gray-50 border-2 border-transparent rounded-2xl transition-all">
                <div class="icon-box px-4 text-gray-400 transition-colors">
                  <i data-feather="phone" class="w-4 h-4"></i>
                </div>
                <input type="tel" name="phone_number" dir="ltr" class="w-full bg-transparent py-4 text-sm font-bold outline-none" placeholder="5XXXXXXXX">
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Gender</label>
            <div class="grid grid-cols-2 gap-4">
              <label class="cursor-pointer">
                <input type="radio" name="gender" value="male" class="gender-radio hidden" required checked />
                <div class="gender-card border-2 border-gray-50 bg-gray-50 p-4 rounded-2xl flex items-center justify-center gap-3 transition-all text-sm font-bold">
                  ذكر
                </div>
              </label>
              <label class="cursor-pointer">
                <input type="radio" name="gender" value="female" class="gender-radio hidden" />
                <div class="gender-card border-2 border-gray-50 bg-gray-50 p-4 rounded-2xl flex items-center justify-center gap-3 transition-all text-sm font-bold">
                  أنثى
                </div>
              </label>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Password</label>
              <div class="input-box relative flex items-center bg-gray-50 border-2 border-transparent rounded-2xl transition-all">
                <div class="icon-box px-4 text-gray-400 transition-colors">
                  <i data-feather="lock" class="w-4 h-4"></i>
                </div>
                <input type="password" name="password" required class="w-full bg-transparent py-4 text-sm font-bold outline-none" placeholder="••••••••">
              </div>
            </div>
            <div class="space-y-2">
              <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Confirm Password</label>
              <div class="input-box relative flex items-center bg-gray-50 border-2 border-transparent rounded-2xl transition-all">
                <div class="icon-box px-4 text-gray-400 transition-colors">
                  <i data-feather="shield" class="w-4 h-4"></i>
                </div>
                <input type="password" name="confirm_password" required class="w-full bg-transparent py-4 text-sm font-bold outline-none" placeholder="••••••••">
              </div>
            </div>
          </div>

          <div class="space-y-2">
            <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Timezone</label>
            <select name="timezone" id="timezoneSelect" class="w-full bg-gray-50 border-2 border-transparent px-5 py-4 rounded-2xl text-xs font-black outline-none focus:border-[#FE5D37]/50 appearance-none">
            </select>
          </div>

          <button id="saveBtn" type="submit" class="w-full bg-[#FE5D37] text-white py-4 rounded-2xl font-black text-sm shadow-lg shadow-[#FE5D37]/10 hover:bg-black transition-all flex items-center justify-center gap-3">
            <i data-feather="user-plus" class="w-4 h-4"></i>
            إنشاء حسابي الآن
          </button>
        </form>
      </div>
    </div>

    <div id="toastContainer" class="fixed bottom-4 right-4 z-[70] space-y-3"></div>

    <script>
      feather.replace();

      // Timezone
      const timeZones = Intl.supportedValuesOf('timeZone');
      const select = document.getElementById('timezoneSelect');
      const userDefault = Intl.DateTimeFormat().resolvedOptions().timeZone;
      timeZones.forEach(tz => {
          const option = document.createElement('option');
          option.value = tz;
          option.text = tz.replace('_', ' ');
          if (tz === userDefault) option.selected = true;
          select.appendChild(option);
      });

      const saveBtn = document.getElementById("saveBtn");

      function showToast(message, type = "info") {
        const container = document.getElementById("toastContainer");
        const toast = document.createElement("div");
        const bgColor = type === "success" ? "bg-emerald-600" : type === "error" ? "bg-red-600" : "bg-blue-600";
        toast.className = `p-4 min-w-[280px] text-white ${bgColor} rounded-xl shadow-xl flex items-center justify-between transform transition-all duration-300 translate-x-full opacity-0`;
        toast.innerHTML = `<span class="text-xs font-black">${message}</span><button onclick="this.parentElement.remove()"><i data-feather="x" class="wh-3"></i></button>`;
        container.appendChild(toast);
        feather.replace();
        setTimeout(() => toast.classList.remove("translate-x-full", "opacity-0"), 10);
        setTimeout(() => {
          toast.classList.add("translate-x-full", "opacity-0");
          setTimeout(() => toast.remove(), 300);
        }, 4000);
      }

      async function handleSubmit(event) {
        event.preventDefault();
        const form = event.target;
        const data = Object.fromEntries(new FormData(form).entries());
        
        saveBtn.disabled = true;
        saveBtn.innerHTML = `<span>جاري المعالجة...</span>`;

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await response.json();
          if (!response.ok) throw result.error || result.errors?.[0]?.message || "فشل التسجيل";
          
          showToast("تم إنشاء الحساب بنجاح!", "success");
          setTimeout(() => window.location.href = "/teacher/login", 1500);
        } catch (error) {
          saveBtn.disabled = false;
          saveBtn.innerHTML = `<i data-feather="user-plus" class="w-4 h-4"></i><span>إنشاء حسابي الآن</span>`;
          feather.replace();
          showToast(error, "error");
        }
      }
    </script>
  </body>
</html>
