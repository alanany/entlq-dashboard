<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= dir %>">

<head>
    <meta charset="utf-8">
    <title><%= settings.academyName %> - الجدول الأسبوعي</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>

    <style>
        :root { --primary: #FE5D37; --secondary: #FFF0ED; --light: #F8F9FA; --dark: #000B1C; }
        body { font-family: 'Cairo', sans-serif; background-color: #f7f9fc; font-size: 0.9rem; }
        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }
        .main-content { margin-right: 260px; padding: 1.5rem; min-height: 100vh; transition: all 0.3s; }
        @media (max-width: 991.98px) { .main-content { margin-right: 0; } }

        .section-card {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            padding: 1.5rem;
            border: 1px solid rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
        }

        /* FullCalendar Overrides */
        .fc { 
            --fc-border-color: #f1f5f9;
            --fc-button-bg-color: #ffffff;
            --fc-button-border-color: #f1f5f9;
            --fc-button-hover-bg-color: #f8fafc;
            --fc-button-hover-border-color: #e2e8f0;
            --fc-button-active-bg-color: #FFF0ED;
            --fc-button-active-border-color: #FE5D37;
            --fc-button-text-color: #64748b;
            --fc-event-bg-color: #FE5D37;
            --fc-event-border-color: #FE5D37;
            --fc-today-bg-color: rgba(254, 93, 55, 0.03);
        }
        .fc .fc-toolbar-title { font-size: 1.1rem; font-weight: 900; color: #1e293b; }
        .fc .fc-button { border-radius: 0.75rem; text-transform: capitalize; font-weight: 700; font-size: 0.8rem; padding: 0.5rem 1rem; transition: all 0.2s; }
        .fc .fc-button-primary:not(:disabled).fc-button-active, 
        .fc .fc-button-primary:not(:disabled):active { color: #FE5D37; background-color: #FFF0ED; border-color: #FE5D37; }
        .fc-col-header-cell { padding: 0.75rem 0 !important; background: #f8fafc; }
        .fc-col-header-cell-cushion { font-size: 0.8rem; font-weight: 800; color: #64748b; text-decoration: none !important; }
        .fc-event { padding: 4px 8px !important; border-radius: 0.75rem !important; font-weight: 700; font-size: 0.7rem; border: none !important; transition: all 0.3s; }
        .fc-event:hover { transform: scale(1.02); z-index: 10; }
        .fc-timegrid-slot { height: 3.5rem !important; }
    </style>
</head>

<body>
    <%- include('./_teacher_sidebar.ejs', { currentPage: 'schedule', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2em;">الجدول الأسبوعي</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Academic Timetable & Sessions</small>
                    </div>
                </div>

                <div class="d-none d-md-flex align-items-center gap-2">
                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2" style="font-size: 0.6rem;">
                        <i class="fas fa-circle me-1" style="font-size: 0.35rem;"></i> Completed
                    </span>
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2" style="font-size: 0.6rem;">
                        <i class="fas fa-circle me-1" style="font-size: 0.35rem;"></i> Upcoming
                    </span>
                    <span class="badge bg-secondary bg-opacity-10 text-muted rounded-pill px-3 py-2" style="font-size: 0.6rem;">
                        <i class="fas fa-circle me-1" style="font-size: 0.35rem;"></i> Cancelled
                    </span>
                </div>
            </div>
        </div>

        <!-- Calendar -->
        <div class="section-card animate__animated animate__fadeInUp">
            <div id="calendar" style="min-height: 600px;"></div>
        </div>

        <!-- Tip Box -->
        <div class="rounded-4 p-4 text-white d-flex flex-column flex-md-row align-items-center justify-content-between gap-3 mb-4 shadow animate__animated animate__fadeInUp" style="background: var(--dark);">
            <div class="d-flex align-items-center gap-3 text-center text-md-end">
                <div class="bg-white bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px; border: 1px solid rgba(255,255,255,0.1);">
                    <i class="fas fa-question-circle text-primary"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0">إدارة الجدول ⚡</h6>
                    <small class="text-muted">تتبع مواعيد الحصص المباشرة مع الطلاب بدقة عالية.</small>
                </div>
            </div>
            <button class="btn btn-primary rounded-3 px-4 py-2 fw-bold" style="font-size: 0.8rem; white-space: nowrap;">طلب مساعدة</button>
        </div>

        <footer class="mt-auto py-4 text-center text-muted border-top">
            <small>&copy; <%= settings.academyName %> <%= new Date().getFullYear() %></small>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const calendarEl = document.getElementById('calendar');
            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                locale: 'ar',
                direction: 'rtl',
                slotMinTime: '06:00:00',
                slotMaxTime: '24:00:00',
                allDaySlot: false,
                slotEventOverlap: false,
                expandRows: true,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'timeGridWeek,timeGridDay'
                },
                buttonText: { today: 'اليوم', week: 'أسبوع', day: 'يوم' },
                
                eventSources: [{
                    url: '/teacher/events/<%= teacher._id %>',
                    method: 'GET',
                    success: function(content) {
                        return content.map(event => {
                            if (event.status === 'completed') {
                                event.backgroundColor = '#ecfdf5'; 
                                event.textColor = '#059669';      
                            } else if (event.status === 'pending' || event.status === 'upcoming') {
                                event.backgroundColor = '#FFF0ED'; 
                                event.textColor = '#FE5D37';      
                            } else {
                                event.backgroundColor = '#fef2f2'; 
                                event.textColor = '#ef4444';      
                            }
                            return event;
                        });
                    }
                }],

                eventDidMount: function(info) {
                    info.el.title = `الكورس: ${info.event.extendedProps.courseTitle || '---'}\nالطالب: ${info.event.extendedProps.studentName || '---'}`;
                    const titleEl = info.el.querySelector('.fc-event-title');
                    if(titleEl) {
                        let dot = document.createElement('span');
                        dot.style.cssText = 'display:inline-block; width:6px; height:6px; border-radius:50%; margin-left:6px; background:currentColor; opacity:0.6;';
                        titleEl.prepend(dot);
                        titleEl.style.display = 'flex';
                        titleEl.style.alignItems = 'center';
                    }
                }
            });
            calendar.render();
        });
    </script>
</body>
</html>