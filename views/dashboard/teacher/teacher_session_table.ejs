<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>جدول الحصص | <%= teacher.name %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        :root {
            --primary: #FE5D37;
            --primary-light: #FFF0ED;
            --accent: #000B1C;
        }

        body { 
            font-family: 'Cairo', sans-serif; 
            background: #f7f9fc;
            color: #1F2937;
            min-height: 100vh;
        }

        .outfit-font { font-family: 'Outfit', sans-serif; }

        .glass-card {
            background: white;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
        }

        /* FullCalendar Customization */
        .fc { 
            --fc-border-color: #f1f5f9;
            --fc-button-bg-color: #ffffff;
            --fc-button-border-color: #f1f5f9;
            --fc-button-hover-bg-color: #f8fafc;
            --fc-button-hover-border-color: #e2e8f0;
            --fc-button-active-bg-color: #FFF0ED;
            --fc-button-active-border-color: #FE5D37;
            --fc-button-text-color: #64748b;
            --fc-event-bg-color: #FE5D37;
            --fc-event-border-color: #FE5D37;
            --fc-today-bg-color: rgba(254, 93, 55, 0.03);
        }

        .fc .fc-toolbar-title {
            font-size: 1.1rem;
            font-weight: 900;
            color: #1e293b;
        }

        .fc .fc-button {
            border-radius: 0.75rem;
            text-transform: capitalize;
            font-weight: 700;
            font-size: 0.8rem;
            padding: 0.5rem 1rem;
            transition: all 0.2s;
        }

        .fc .fc-button-primary:not(:disabled).fc-button-active, 
        .fc .fc-button-primary:not(:disabled):active {
            color: #FE5D37;
            background-color: #FFF0ED;
            border-color: #FE5D37;
        }

        .fc-col-header-cell {
            padding: 0.75rem 0 !important;
            background: #f8fafc;
        }

        .fc-col-header-cell-cushion {
            font-size: 0.8rem;
            font-weight: 800;
            color: #64748b;
            text-decoration: none !important;
        }

        .fc-event {
            padding: 4px 8px !important;
            border-radius: 0.75rem !important;
            font-weight: 700;
            font-size: 0.7rem;
            border: none !important;
            transition: all 0.3s;
        }

        .fc-event:hover {
            transform: scale(1.02);
            z-index: 10;
        }

        .fc-timegrid-slot { height: 3.5rem !important; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fade-in { animation: fadeIn 0.6s ease-out forwards; }
    </style>
</head>
<body class="p-4 md:p-10">

    <div class="max-w-7xl mx-auto space-y-8">
        
        <!-- Header -->
        <header class="flex flex-col md:flex-row md:items-center justify-between gap-6 fade-in">
            <div class="flex items-center gap-5">
                <button onclick="history.back()" class="flex items-center justify-center w-12 h-12 bg-white rounded-xl text-gray-500 shadow-sm border border-gray-100 hover:bg-[#FE5D37] hover:text-white transition-all transform active:scale-90 group">
                    <i data-feather="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
                </button>
                <div>
                    <h1 class="text-2xl font-black text-gray-900 tracking-tight">الجدول الأسبوعي</h1>
                    <p class="text-[10px] text-gray-400 font-bold outfit-font uppercase tracking-widest mt-1">Academic Timetable & Sessions</p>
                </div>
            </div>
            
            <div class="hidden md:flex items-center gap-2">
                <div class="flex items-center gap-2 px-3 py-1.5 bg-emerald-50 text-emerald-600 rounded-lg border border-emerald-100 text-[9px] font-black uppercase outfit-font">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    Completed
                </div>
                <div class="flex items-center gap-2 px-3 py-1.5 bg-orange-50 text-[#FE5D37] rounded-lg border border-[#FFF0ED] text-[9px] font-black uppercase outfit-font">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#FE5D37]"></span>
                    Upcoming
                </div>
                <div class="flex items-center gap-2 px-3 py-1.5 bg-gray-50 text-gray-400 rounded-lg border border-gray-100 text-[9px] font-black uppercase outfit-font">
                    <span class="w-1.5 h-1.5 rounded-full bg-gray-300"></span>
                    Cancelled
                </div>
            </div>
        </header>

        <!-- Calendar Container -->
        <div class="glass-card rounded-[2rem] p-4 md:p-8 fade-in shadow-sm" style="animation-delay: 0.1s;">
            <div id="calendar" class="min-h-[600px]"></div>
        </div>

        <!-- Tip Box -->
        <div class="bg-[#000B1C] rounded-3xl p-6 text-white flex flex-col md:flex-row items-center justify-between gap-4 fade-in shadow-lg" style="animation-delay: 0.2s;">
            <div class="flex items-center gap-4 text-center md:text-right">
                <div class="w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center border border-white/10">
                    <i data-feather="help-circle" class="w-6 h-6 text-[#FE5D37]"></i>
                </div>
                <div>
                    <h4 class="text-md font-black leading-tight">إدارة الجدول ⚡</h4>
                    <p class="text-gray-400 text-xs font-bold mt-1">تتبع مواعيد الحصص المباشرة مع الطلاب بدقة عالية.</p>
                </div>
            </div>
            <button class="px-6 py-3 bg-[#FE5D37] text-white rounded-xl font-black text-xs hover:bg-white hover:text-black transition-all active:scale-95 whitespace-nowrap">طلب مساعدة</button>
        </div>

        <!-- Footer -->
        <footer class="py-8 text-center text-gray-400">
            <p class="text-[10px] font-bold uppercase tracking-widest outfit-font opacity-60">
                &copy; <%= new Date().getFullYear() %> <%= settings.academyName %> &bull; Smart Scheduling System
            </p>
        </footer>
    </div>

    <script>
        feather.replace();

        document.addEventListener('DOMContentLoaded', function() {
            const calendarEl = document.getElementById('calendar');
            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                locale: 'ar',
                direction: 'rtl',
                slotMinTime: '06:00:00',
                slotMaxTime: '24:00:00',
                allDaySlot: false,
                slotEventOverlap: false,
                expandRows: true,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'timeGridWeek,timeGridDay'
                },
                buttonText: {
                    today: 'اليوم',
                    week: 'أسبوع',
                    day: 'يوم'
                },
                
                eventSources: [{
                    url: '/teacher/events/<%= teacher._id %>',
                    method: 'GET',
                    success: function(content) {
                        return content.map(event => {
                            if (event.status === 'completed') {
                                event.backgroundColor = '#ecfdf5'; 
                                event.textColor = '#059669';      
                            } else if (event.status === 'pending' || event.status === 'upcoming') {
                                event.backgroundColor = '#FFF0ED'; 
                                event.textColor = '#FE5D37';      
                            } else {
                                event.backgroundColor = '#fef2f2'; 
                                event.textColor = '#ef4444';      
                            }
                            return event;
                        });
                    }
                }],

                eventDidMount: function(info) {
                    info.el.title = `الكورس: ${info.event.extendedProps.courseTitle || '---'}\nالطالب: ${info.event.extendedProps.studentName || '---'}`;
                    const titleEl = info.el.querySelector('.fc-event-title');
                    if(titleEl) {
                        let dot = document.createElement('span');
                        dot.className = "inline-block w-1.5 h-1.5 rounded-full ml-1.5 shrink-0 bg-current opacity-60";
                        titleEl.prepend(dot);
                        titleEl.style.display = 'flex';
                        titleEl.style.alignItems = 'center';
                    }
                }
            });
            calendar.render();
        });
    </script>
</body>
</html>