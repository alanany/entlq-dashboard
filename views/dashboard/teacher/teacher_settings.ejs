<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= dir %>">

<head>
    <meta charset="utf-8">
    <title><%= settings.academyName %> - إعدادات الحساب</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root { --primary: #FE5D37; --secondary: #FFF0ED; --light: #F8F9FA; --dark: #000B1C; }
        body { font-family: 'Cairo', sans-serif; background-color: #f7f9fc; font-size: 0.9rem; }
        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }
        .main-content { margin-right: 260px; padding: 1.5rem; min-height: 100vh; transition: all 0.3s; }
        @media (max-width: 991.98px) { .main-content { margin-right: 0; } }

        .section-card {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            padding: 1.5rem;
            border: 1px solid rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
        }

        .btn-kider {
            background-color: var(--primary);
            color: #fff;
            border-radius: 0.75rem;
            padding: 0.6rem 1.5rem;
            font-weight: 700;
            border: none;
            font-size: 0.85rem;
            transition: all 0.3s;
        }
        .btn-kider:hover { background-color: #e44d2d; transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.2); color: #fff; }

        .form-control-custom {
            background: #fdfdfd;
            border: 1.5px solid #F3F4F6;
            padding: 0.85rem 1.25rem;
            border-radius: 1rem;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s;
        }
        .form-control-custom:focus {
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(254, 93, 55, 0.1);
        }
    </style>
</head>

<body>
    <%- include('./_teacher_sidebar.ejs', { currentPage: 'settings', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2em;">إعدادات الملف الشخصي</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Personal Account Settings</small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="fas fa-cog text-muted"></i>
                </div>
            </div>
        </div>

        <!-- Profile Form -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="section-card animate__animated animate__fadeInUp">
                    <!-- Avatar Section -->
                    <div class="text-center mb-5">
                        <div class="position-relative d-inline-block">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-4 d-flex align-items-center justify-content-center fw-bold mx-auto position-relative overflow-hidden" style="width: 100px; height: 100px; font-size: 2rem; border: 4px solid #fff; box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);">
                                <% if(teacher.image) { %>
                                    <img src="<%= teacher.image %>" class="w-100 h-100" style="object-fit: cover;">
                                <% } else { %>
                                    <%= (teacher.name || 'U').charAt(0).toUpperCase() %>
                                <% } %>
                            </div>
                            <label for="avatar-input" class="position-absolute bg-primary text-white rounded-3 d-flex align-items-center justify-content-center shadow" style="width: 32px; height: 32px; bottom: -4px; right: -4px; cursor: pointer; border: 2px solid #fff;">
                                <i class="fas fa-camera" style="font-size: 0.7rem;"></i>
                            </label>
                            <input id="avatar-input" type="file" class="d-none" accept="image/*">
                        </div>
                        <h5 class="fw-bold text-dark mt-3 mb-0"><%= teacher.name %></h5>
                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 mt-2" style="font-size: 0.6rem;">Verified Educator</span>
                    </div>

                    <form action="/teacher/update" method="POST">
                        <div class="row g-4">
                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label class="form-label text-muted fw-bold outfit-font" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">الاسم الكامل</label>
                                <input type="text" name="name" value="<%= teacher.name %>" class="form-control form-control-custom" placeholder="اسم المعلم بالكامل">
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                <label class="form-label text-muted fw-bold outfit-font" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">رقم الهاتف</label>
                                <input type="tel" name="phone" value="<%= teacher.phone_number %>" class="form-control form-control-custom text-start" dir="ltr" placeholder="05XXXXXXXX">
                            </div>

                            <!-- Email -->
                            <div class="col-12">
                                <label class="form-label text-muted fw-bold outfit-font" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">البريد الإلكتروني (مقفل)</label>
                                <input type="email" value="<%= teacher.email %>" disabled class="form-control form-control-custom bg-light text-muted" dir="ltr">
                            </div>

                            <!-- Zoom Link -->
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label text-primary fw-bold outfit-font mb-0" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">رابط Zoom الدائم</label>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-2" style="font-size: 0.55rem;">مطلوب</span>
                                </div>
                                <input type="url" name="zoom_link" value="<%= teacher.zoom_link %>" 
                                       class="form-control form-control-custom text-start" 
                                       dir="ltr" placeholder="https://zoom.us/j/your-meeting-id">
                                <small class="text-muted d-block mt-1" style="font-size: 0.65rem;">هذا الرابط سيستخدم تلقائياً لجميع حصصك القادمة.</small>
                            </div>

                            <!-- Bio -->
                            <div class="col-12">
                                <label class="form-label text-muted fw-bold outfit-font" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">نبذة شخصية</label>
                                <textarea name="bio" rows="4" class="form-control form-control-custom" style="resize: none;"
                                          placeholder="اكتب نبذة عنك وعن خبراتك التعليمية..."><%= teacher.notes %></textarea>
                            </div>

                            <!-- Submit -->
                            <div class="col-12 pt-2">
                                <button type="submit" class="btn btn-kider w-100 py-3">
                                    <i class="fas fa-check-circle me-2"></i> حفظ كافة المعلومات
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Secondary Actions -->
                <div class="d-flex flex-wrap justify-content-center gap-3 mb-4 animate__animated animate__fadeInUp">
                    <a href="/teacher/change-password" class="btn btn-light rounded-pill px-4 py-2 fw-bold small text-decoration-none">
                        <i class="fas fa-lock me-2 text-muted"></i> تغيير كلمة المرور
                    </a>
                    <button class="btn btn-light rounded-pill px-4 py-2 fw-bold small text-danger">
                        <i class="fas fa-user-times me-2"></i> تعطيل الحساب
                    </button>
                </div>
            </div>
        </div>

        <footer class="mt-auto py-4 text-center text-muted border-top">
            <small>&copy; <%= settings.academyName %> <%= new Date().getFullYear() %></small>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>