<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إعدادات الحساب | <%= settings.academyName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        :root {
            --primary: #FE5D37;
            --primary-light: #FFF0ED;
            --accent: #000B1C;
        }

        body { 
            font-family: 'Cairo', sans-serif; 
            background: #f7f9fc;
            color: #1F2937;
            min-height: 100vh;
        }

        .outfit-font { font-family: 'Outfit', sans-serif; }

        .glass-card {
            background: white;
            border: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
        }

        .input-field { 
            width: 100%; 
            background: #fdfdfd; 
            border: 1.5px solid #F3F4F6; 
            padding: 1rem 1.25rem; 
            border-radius: 1rem; 
            outline: none; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 0.85rem;
            font-weight: 600;
        }

        .input-field:focus { 
            border-color: #FE5D37; 
            background: white;
            box-shadow: 0 0 0 4px rgba(254, 93, 55, 0.1);
        }

        @keyframes scaleIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        .scale-in { animation: scaleIn 0.5s ease-out forwards; }
    </style>
</head>
<body class="p-4 md:p-10 pb-20">

    <div class="max-w-4xl mx-auto space-y-10">
        
        <!-- Header Section -->
        <header class="flex items-center justify-between gap-6 scale-in">
            <div class="flex items-center gap-5">
                <button onclick="history.back()" class="flex items-center justify-center w-12 h-12 bg-white rounded-xl text-gray-500 shadow-sm border border-gray-100 hover:bg-[#FE5D37] hover:text-white transition-all transform active:scale-90 group">
                    <i data-feather="arrow-right" class="w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
                </button>
                <div>
                    <h1 class="text-2xl font-black text-gray-900 tracking-tight">إعدادات الملف الشخصي</h1>
                    <p class="text-[10px] text-gray-400 font-bold outfit-font uppercase tracking-widest mt-1">Personal Account Settings</p>
                </div>
            </div>
            <div class="w-12 h-12 flex items-center justify-center bg-white rounded-xl text-gray-300 border border-gray-100 shadow-sm">
                <i data-feather="settings" class="w-6 h-6"></i>
            </div>
        </header>

        <!-- Profile Form Card -->
        <div class="glass-card rounded-[2.5rem] overflow-hidden scale-in shadow-sm" style="animation-delay: 0.1s;">
            <div class="p-8 md:p-12">
                
                <!-- Avatar Upload -->
                <div class="flex flex-col items-center mb-12">
                    <div class="relative group">
                        <div class="w-28 h-28 bg-[#FFF0ED] rounded-[2rem] flex items-center justify-center text-[#FE5D37] font-black text-3xl border-4 border-white shadow-lg relative overflow-hidden transition-transform group-hover:scale-105 duration-500">
                            <% if(teacher.image) { %>
                                <img src="<%= teacher.image %>" class="w-full h-full object-cover">
                            <% } else { %>
                                <%= (teacher.name || 'U').charAt(0).toUpperCase() %>
                            <% } %>
                        </div>
                        <label for="avatar-input" class="absolute -bottom-1 -right-1 bg-[#FE5D37] p-2.5 rounded-xl shadow-lg border-2 border-white text-white cursor-pointer hover:bg-black transition-all active:scale-95">
                            <i data-feather="camera" class="w-4 h-4"></i>
                        </label>
                        <input id="avatar-input" type="file" class="hidden" accept="image/*">
                    </div>
                    <h2 class="mt-4 text-lg font-black text-gray-900"><%= teacher.name %></h2>
                    <p class="text-[9px] font-black text-[#FE5D37] uppercase tracking-[0.2em] mt-1 outfit-font">Verified Educator</p>
                </div>

                <form action="/teacher/update" method="POST" class="space-y-8">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Full Name -->
                        <div class="space-y-2.5">
                            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Full Name</label>
                            <input type="text" name="name" value="<%= teacher.name %>" class="input-field" placeholder="اسم المعلم بالكامل">
                        </div>

                        <!-- Phone Number -->
                        <div class="space-y-2.5">
                            <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Phone Number</label>
                            <input type="tel" name="phone" value="<%= teacher.phone_number %>" class="input-field text-left" dir="ltr" placeholder="05XXXXXXXX">
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="space-y-2.5">
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Email Address (Locked)</label>
                        <input type="email" value="<%= teacher.email %>" disabled class="input-field bg-gray-50 text-gray-400 border-gray-100 cursor-not-allowed" dir="ltr">
                    </div>

                    <!-- Zoom Link -->
                    <div class="space-y-2.5">
                        <div class="flex items-center justify-between mr-2">
                            <label class="block text-[10px] font-black text-[#FE5D37] uppercase tracking-widest outfit-font">Persistent Zoom Link</label>
                            <span class="px-2 py-0.5 bg-[#FFF0ED] text-[#FE5D37] text-[8px] font-black rounded-md outfit-font">Required</span>
                        </div>
                        <input type="url" name="zoom_link" value="<%= teacher.zoom_link %>" 
                               class="input-field text-left border-[#FFF0ED] focus:border-[#FE5D37]" 
                               dir="ltr" placeholder="https://zoom.us/j/your-meeting-id">
                        <p class="text-[9px] text-gray-400 mr-2 italic font-bold">هذا الرابط سيستخدم تلقائياً لجميع حصصك القادمة.</p>
                    </div>

                    <!-- Bio -->
                    <div class="space-y-2.5">
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mr-2 outfit-font">Biography / Profile Notes</label>
                        <textarea name="bio" rows="4" class="input-field resize-none leading-relaxed" 
                                  placeholder="اكتب نبذة عنك وعن خبراتك التعليمية..."><%= teacher.notes %></textarea>
                    </div>

                    <!-- Submit -->
                    <div class="pt-6">
                        <button type="submit" class="w-full py-4 bg-[#FE5D37] text-white rounded-2xl font-black text-sm shadow-lg shadow-[#FE5D37]/10 hover:bg-black transition-all transform active:scale-95 flex items-center justify-center gap-3 group">
                            حفظ كافة المعلومات
                            <i data-feather="check-circle" class="w-5 h-5"></i>
                        </button>
                    </div>

                </form>
            </div>
        </div>

        <!-- Secondary Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 scale-in" style="animation-delay: 0.2s;">
            <button class="flex items-center gap-2 px-6 py-3 bg-white text-gray-400 rounded-xl text-[10px] font-black hover:text-[#FE5D37] transition-all shadow-sm border border-gray-50 outfit-font">
                <i data-feather="lock" class="w-3.5 h-3.5"></i>
                Change Password
            </button>
            <button class="flex items-center gap-2 px-6 py-3 bg-white text-gray-400 rounded-xl text-[10px] font-black hover:text-red-500 transition-all shadow-sm border border-gray-50 outfit-font">
                <i data-feather="user-x" class="w-3.5 h-3.5"></i>
                Deactivate Account
            </button>
        </div>

        <!-- Footer -->
        <footer class="py-10 text-center text-gray-400">
            <p class="text-[10px] font-bold uppercase tracking-widest outfit-font opacity-60">
                &copy; <%= new Date().getFullYear() %> <%= settings.academyName %> &bull; Security & Privacy Panel
            </p>
        </footer>
    </div>

    <script>
        feather.replace();
    </script>
</body>
</html>