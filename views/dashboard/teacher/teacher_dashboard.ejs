<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= dir %>">

<head>
    <meta charset="utf-8">
    <title><%= settings.academyName %> - لوحة تحكم المعلم</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stats-card {
            border: none;
            border-radius: 1.25rem;
            background: #fff;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.03);
            padding: 1.25rem;
            height: 100%;
            transition: all 0.3s;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .stats-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.08);
        }

        .stats-icon-kider {
            position: relative;
            width: 30px;
            height: 30px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
            z-index: 1;
        }

        .stats-icon-kider::before {
            position: absolute;
            content: "";
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, .8);
            border-radius: 30px;
            z-index: -1;
            transition: .5s;
        }

        .stats-card:hover .stats-icon-kider::before {
            background: transparent;
        }

        .stats-card:hover .stats-icon-kider i {
            color: #fff !important;
        }

        .section-card {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            padding: 1.5rem;
            border: 1px solid rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
        }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.8rem;
        }

        .btn-brand {
            background-color: var(--primary);
            color: #fff;
            border-radius: 0.75rem;
            padding: 0.4rem 1.25rem;
            font-weight: 700;
            border: none;
            font-size: 0.8rem;
            transition: all 0.3s;
        }

        .btn-brand:hover { background-color: #e44d2d; transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.2); color: #fff; }

        .session-item {
            border: 1px solid rgba(0,0,0,0.05);
            border-radius: 1rem;
            padding: 1rem;
            transition: all 0.3s;
            background: #fff;
        }

        .session-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.08);
        }

        .session-live-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #dc3545;
            display: inline-block;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
            100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
        }

        /* WhatsApp Support */
        .support-float {
            position: fixed;
            width: 55px;
            height: 55px;
            bottom: 30px;
            left: 30px;
            background-color: #25d366;
            color: #FFF;
            border-radius: 50px;
            text-align: center;
            font-size: 28px;
            box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            transition: all 0.3s;
        }
        .support-float:hover {
            transform: scale(1.1);
            background-color: #128c7e;
            color: #fff;
        }

    </style>
</head>

<body>
    <%- include('./_teacher_sidebar.ejs', { currentPage: 'home', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2em;">أهلاً بك، أ. <%= user.name %>! 👋</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Teacher Dashboard Overview</small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-none d-md-flex flex-column align-items-end px-3 border-start border-light">
                        <span class="text-primary outfit-font fw-bold" style="font-size: 0.75rem;"><%= currentDate %></span>
                        <span class="text-muted local-timezone-name outfit-font" style="font-size: 0.65rem;">Detecting...</span>
                    </div>

                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px; font-size: 0.85rem;">
                        <% if(user.image) { %>
                            <img src="<%= user.image %>" class="w-100 h-100 rounded-circle" style="object-fit: cover;">
                        <% } else { %>
                            <%= user.name.charAt(0).toUpperCase() %>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Welcome Message -->
        <div class="mb-4 animate__animated animate__fadeIn">
            <h3 class="fw-black text-dark mb-1">إليك ملخص أداء دوراتك التعليمية! 🚀</h3>
            <p class="text-muted small">متابعة دقيقة لكل تفاصيل الطلاب، الحصص المجدولة، والأرباح المتحققة.</p>
        </div>

        <!-- Stats Grid -->
        <div class="row g-3 mb-4 animate__animated animate__fadeInUp">
            <div class="col-6 col-lg-3">
                <div class="stats-card">
                    <div class="d-flex align-items-center">
                        <div class="stats-icon-brand bg-primary text-primary me-3">
                            <i class="fas fa-user-graduate"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= teacherStatic.students %></h3>
                            <small class="text-muted fw-bold" style="font-size: 0.7rem;">إجمالي الطلاب</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stats-card">
                    <div class="d-flex align-items-center">
                        <div class="stats-icon-brand bg-success text-success me-3">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= Math.round(teacherStatic.revenue) %></h3>
                            <small class="text-muted fw-bold" style="font-size: 0.7rem;">إجمالي الأرباح</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stats-card">
                    <div class="d-flex align-items-center">
                        <div class="stats-icon-brand bg-warning text-warning me-3">
                            <i class="fas fa-star"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;">4.9<span class="text-muted" style="font-size: 0.65rem;">/5</span></h3>
                            <small class="text-muted fw-bold" style="font-size: 0.7rem;">التقييم</small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stats-card">
                    <div class="d-flex align-items-center">
                        <div class="stats-icon-brand bg-info text-info me-3">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div>
                            <h3 class="mb-0 fw-900 outfit-font lh-1" style="font-size: 1.3rem;"><%= todaysSessionsNumbers %></h3>
                            <small class="text-muted fw-bold" style="font-size: 0.7rem;">حصص اليوم</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Today's Sessions -->
        <div class="section-card mb-4 animate__animated animate__fadeInUp">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-0">حصص اليوم</h5>
                    <small class="text-muted outfit-font" style="font-size: 0.7rem;"><%= currentDate %></small>
                </div>
                <a href="/teacher/schedule" class="btn btn-brand btn-sm">
                    <i class="fas fa-calendar me-1"></i> الجدول الكامل
                </a>
            </div>

            <% if (todaysSessions && todaysSessions.length > 0) { %>
                <div class="row g-3">
                    <% todaysSessions.forEach(session => { %>
                        <div class="col-md-6 col-lg-3">
                            <div class="session-item position-relative">
                                <% if (session.status === 'live') { %>
                                    <span class="session-live-dot position-absolute" style="top: 12px; left: 12px;"></span>
                                <% } %>
                                
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <% if (session.status === 'live') { %>
                                        <span class="badge bg-danger text-white rounded-pill px-3 py-1" style="font-size: 0.65rem;">مباشر</span>
                                    <% } else if (session.status === 'upcoming') { %>
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1" style="font-size: 0.65rem;">قادمة</span>
                                    <% } else { %>
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1" style="font-size: 0.65rem;">انتهت</span>
                                    <% } %>
                                    <span class="fw-bold outfit-font local-time-display" style="font-size: 0.8rem;"
                                          data-utc-date="<%= session.date %>" 
                                          data-utc-time="<%= session.time %>">
                                        <%= session.time %>
                                    </span>
                                </div>
                                
                                <h6 class="fw-bold mb-1" style="font-size: 0.85rem;"><%= session.title %></h6>
                                <p class="text-muted small mb-3">الطالب: <%= session.studentName %></p>

                                <% if(session.status === 'live' || session.status === 'upcoming') { %>
                                    <a href="<%= session.link %>" class="btn btn-brand btn-sm w-100 rounded-3">
                                        <i class="fas fa-video me-1"></i> دخول الحصة
                                    </a>
                                <% } else { %>
                                    <% if(!session.isSendReport) { %>
                                        <a href="/teacher/session/<%= session.bookingId %>/<%= session.sessionIndex %>" class="btn btn-outline-primary btn-sm w-100 rounded-3 border-dashed">
                                            <i class="fas fa-file-alt me-1"></i> إضافة التقرير
                                        </a>
                                    <% } else { %>
                                        <div class="btn btn-sm w-100 rounded-3 bg-success bg-opacity-10 text-success border-0">
                                            <i class="fas fa-check-circle me-1"></i> تم التقرير
                                        </div>
                                    <% } %>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="fas fa-calendar-day fs-1 text-muted opacity-25 mb-3 d-block"></i>
                    <p class="text-muted fw-bold">لا توجد حصص مجدولة لليوم</p>
                </div>
            <% } %>
        </div>

        <!-- Latest Students Table -->
        <div class="section-card p-0 overflow-hidden animate__animated animate__fadeInUp">
            <div class="px-4 py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">آخر الطلاب المنضمين</h5>
                <a href="/teacher/students" class="btn btn-link text-primary text-decoration-none fw-bold small">عرض الكل</a>
            </div>
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">الطالب</th>
                            <th>الدورة التدريبية</th>
                            <th class="text-center">الحصص</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (teacherStatic.latestStudents && teacherStatic.latestStudents.length > 0) { %>
                            <% teacherStatic.latestStudents.forEach(booking => { %>
                                <tr style="cursor: pointer;" onclick="window.location.href='/teacher/students'">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-3 d-flex align-items-center justify-content-center fw-bold" style="width: 35px; height: 35px; font-size: 0.8rem;">
                                                <%= booking.studentId.name.substring(0, 1) %>
                                            </div>
                                            <div>
                                                <p class="fw-bold text-dark mb-0 small"><%= booking.studentId.name %></p>
                                                <p class="text-muted mb-0" style="font-size: 0.65rem;"><%= booking.studentId.email %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="fw-bold small text-muted"><%= booking.courseId?.title || 'عام' %></span>
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-bold outfit-font"><%= booking.numberOfSessionsPerMonth %></span>
                                    </td>
                                    <td class="text-start">
                                        <i class="fas fa-chevron-left text-muted small"></i>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5 fw-bold">لا يوجد طلاب مسجلون حالياً</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <footer class="mt-auto py-4 text-center text-muted border-top">
            <small>&copy; <%= settings.academyName %> <%= new Date().getFullYear() %> - <%= settings.footerText %></small>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        // Timezone Logic
        document.addEventListener('DOMContentLoaded', () => {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            document.querySelectorAll('.local-timezone-name').forEach(el => el.innerText = tz);

            document.querySelectorAll('.local-time-display').forEach(el => {
                const utcDate = el.getAttribute('data-utc-date');
                const utcTime = el.getAttribute('data-utc-time');
                if (utcDate && utcTime) {
                    const dateObj = new Date(`${utcDate}T${utcTime}:00Z`);
                    if (!isNaN(dateObj)) {
                        el.innerText = dateObj.toLocaleTimeString('en-US', {
                            hour: '2-digit', minute: '2-digit', hour12: true
                        });
                    }
                }
            });
        });
    </script>

    <!-- Support WhatsApp -->
    <% if (settings.supportContact && settings.supportContact.teacher) { %>
        <a href="https://wa.me/<%= settings.supportContact.teacher.replace(/\D/g, '') %>" class="support-float" target="_blank">
            <i class="fas fa-comment-dots"></i>
        </a>
    <% } %>
</body>
</html>