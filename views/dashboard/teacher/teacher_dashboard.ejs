<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم المعلم | <%= settings.academyName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --primary: #FE5D37;
            --primary-light: #FFF0ED;
            --accent: #000B1C;
            --success: #10B981;
            --light: #F8F9FA;
            --glass-bg: rgba(255, 255, 255, 0.9);
            --glass-border: rgba(0, 0, 0, 0.05);
        }

        body { 
            font-family: 'Cairo', sans-serif; 
            background: #f7f9fc;
            color: #1F2937;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .glass-card {
            background: white;
            border: 1px solid var(--glass-border);
            box-shadow: 0 4px 20px -5px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.1);
        }

        .sidebar-item {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .active-link {
            background-color: var(--primary);
            color: white !important;
            box-shadow: 0 10px 20px -5px rgba(254, 93, 55, 0.3);
        }

        .sidebar-item:not(.active-link):hover {
            background-color: var(--primary-light);
            color: var(--primary) !important;
            transform: translateX(-5px);
        }

        .session-card {
            transition: all 0.4s ease;
            border-bottom: 4px solid transparent;
        }

        .session-card:hover {
            transform: translateY(-8px);
            border-bottom-color: var(--primary);
        }

        .bg-primary-kider { background-color: var(--primary); }
        .text-primary-kider { color: var(--primary); }
        .bg-secondary-kider { background-color: var(--primary-light); }

        /* Custom Scrollbar */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .fade-in { animation: fadeIn 0.5s ease forwards; }
    </style>
</head>
<body class="h-screen overflow-hidden">

    <!-- Overlay for mobile sidebar -->
    <div id="overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/20 backdrop-blur-sm z-40 hidden lg:hidden transition-all duration-300"></div>

    <div class="flex h-full overflow-hidden">
        
        <!-- Sidebar -->
        <aside id="sidebar" class="fixed inset-y-0 right-0 z-50 w-72 bg-white border-l border-gray-100 transition-all duration-500 lg:translate-x-0 lg:static lg:block shadow-sm translate-x-full">
            <div class="h-20 flex items-center px-8">
                <div class="flex items-center gap-3">
                    <img src="/img/logo.png" alt="Logo" class="w-8 h-8" onerror="this.src='/img/favicon.ico'">
                    <span class="text-xl font-black text-primary-kider lobster-font tracking-tight"><%= settings.academyName %></span>
                </div>
            </div>
            
            <nav class="p-4 space-y-2 overflow-y-auto h-[calc(100vh-80px)] no-scrollbar">
                <div class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-4 px-4 outfit-font">Main Menu</div>
                
                <a href="/teacher/home" class="sidebar-item active-link flex items-center px-5 py-3.5 rounded-xl font-bold">
                    <i data-feather="grid" class="ml-3 w-5 h-5"></i>
                    <span>الرئيسية</span>
                </a>
                
                <a href="/teacher/students" class="sidebar-item group flex items-center px-5 py-3.5 text-gray-500 rounded-xl font-semibold">
                    <i data-feather="users" class="ml-3 w-5 h-5 group-hover:scale-110 transition-transform"></i>
                    <span>طلابي</span>
                </a>
                
                <a href="/teacher/schedule" class="sidebar-item group flex items-center px-5 py-3.5 text-gray-500 rounded-xl font-semibold">
                    <i data-feather="calendar" class="ml-3 w-5 h-5 group-hover:scale-110 transition-transform"></i>
                    <span>الجدول الدراسي</span>
                </a>
                
                <a href="/teacher/finanical_page" class="sidebar-item group flex items-center px-5 py-3.5 text-gray-500 rounded-xl font-semibold">
                    <i data-feather="pocket" class="ml-3 w-5 h-5 group-hover:scale-110 transition-transform"></i>
                    <span>المحفظة المالية</span>
                </a>
                
                <a href="/chat" class="sidebar-item group flex items-center px-5 py-3.5 text-gray-500 rounded-xl font-semibold">
                    <i data-feather="message-square" class="ml-3 w-5 h-5 group-hover:scale-110 transition-transform"></i>
                    <span>الرسائل</span>
                </a>

                <div class="pt-6">
                    <div class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-4 px-4 outfit-font">Account</div>
                </div>

                <a href="/teacher/settings" class="sidebar-item group flex items-center px-5 py-3.5 text-gray-500 rounded-xl font-semibold">
                    <i data-feather="sliders" class="ml-3 w-5 h-5 group-hover:scale-110 transition-transform"></i>
                    <span>الإعدادات</span>
                </a>

                <div class="pt-10">
                    <a href="#" onclick="openLogoutModal(event)" class="sidebar-item flex items-center px-5 py-3.5 text-red-500 hover:bg-red-50 rounded-xl font-bold group">
                        <i data-feather="log-out" class="ml-3 w-5 h-5 group-hover:rotate-12 transition-transform"></i>
                        <span>تسجيل الخروج</span>
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content -->
        <div class="flex-1 flex flex-col min-w-0 h-full overflow-hidden relative bg-[#f7f9fc]">
            
            <!-- Top Header -->
            <header class="h-20 bg-white border-b border-gray-100 flex items-center justify-between px-6 lg:px-10 shrink-0 z-30">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" class="lg:hidden p-2 text-gray-500 hover:bg-gray-50 rounded-lg transition">
                        <i data-feather="menu" class="w-6 h-6"></i>
                    </button>
                    <div>
                        <h2 class="text-xl font-black text-gray-900 tracking-tight">أهلاً بك، أ. <%= user.name %>! 👋</h2>
                        <small class="text-xs text-gray-400 outfit-font fw-600">Educational Dashboard Overview</small>
                    </div>
                </div>
                
                <div class="flex items-center gap-3">
                    <div class="hidden md:flex flex-col items-end px-3 border-r border-gray-100">
                        <span class="text-xs font-black text-primary-kider outfit-font"><%= currentDate %></span>
                        <span class="text-[10px] text-gray-400 font-bold local-timezone-name outfit-font">Detecting...</span>
                    </div>

                    <button class="w-10 h-10 flex items-center justify-center text-gray-400 hover:bg-gray-50 rounded-full transition relative group">
                        <i data-feather="bell" class="w-5 h-5"></i>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    
                    <div class="w-10 h-10 bg-primary-kider rounded-full flex items-center justify-center text-white font-black text-sm shadow-sm overflow-hidden">
                        <% if(user.image) { %>
                            <img src="<%= user.image %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <%= user.name.charAt(0).toUpperCase() %>
                        <% } %>
                    </div>
                </div>
            </header>

            <!-- Dashboard Content -->
            <main class="flex-1 overflow-y-auto p-6 lg:p-10 no-scrollbar">
                <div class="max-w-7xl mx-auto space-y-10">
                    
                    <!-- Welcome Box -->
                    <div class="bg-primary-kider p-8 rounded-3xl text-white shadow-lg relative overflow-hidden fade-in">
                        <div class="relative z-10">
                            <h3 class="text-2xl font-black mb-2">إليك ملخص أداء دوراتك التعليمية! 🚀</h3>
                            <p class="text-white/80 text-sm font-medium">متابعة دقيقة لكل تفاصيل الطلاب، الحصص المجدولة، والأرباح المتحققة.</p>
                        </div>
                        <i data-feather="pie-chart" class="absolute -bottom-10 -left-10 w-64 h-64 text-white/10 pointer-events-none rotate-12"></i>
                    </div>

                    <!-- Stats Grid -->
                    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                        <!-- Stat Item 1 -->
                        <div class="glass-card p-6 rounded-2xl group fade-in" style="animation-delay: 0.1s;">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="w-12 h-12 bg-secondary-kider text-primary-kider rounded-xl flex items-center justify-center group-hover:bg-primary-kider group-hover:text-white transition-colors">
                                    <i data-feather="users" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h3 class="text-[11px] font-bold text-gray-400 uppercase tracking-wider outfit-font">Students</h3>
                                    <p class="text-2xl font-black text-gray-900 outfit-font"><%= teacherStatic.students %></p>
                                </div>
                            </div>
                            <div class="w-full h-1 bg-gray-50 rounded-full">
                                <div class="h-full bg-primary-kider rounded-full" style="width: 70%"></div>
                            </div>
                        </div>

                        <!-- Stat Item 2 -->
                        <div class="glass-card p-6 rounded-2xl group fade-in" style="animation-delay: 0.2s;">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="w-12 h-12 bg-emerald-50 text-emerald-500 rounded-xl flex items-center justify-center group-hover:bg-emerald-500 group-hover:text-white transition-colors">
                                    <i data-feather="trending-up" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h3 class="text-[11px] font-bold text-gray-400 uppercase tracking-wider outfit-font">Revenue</h3>
                                    <p class="text-2xl font-black text-gray-900 outfit-font"><%= Math.round(teacherStatic.revenue) %><span class="text-xs ml-1">SAR</span></p>
                                </div>
                            </div>
                            <div class="w-full h-1 bg-gray-50 rounded-full">
                                <div class="h-full bg-emerald-500 rounded-full" style="width: 85%"></div>
                            </div>
                        </div>

                        <!-- Stat Item 3 -->
                        <div class="glass-card p-6 rounded-2xl group fade-in" style="animation-delay: 0.3s;">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="w-12 h-12 bg-amber-50 text-amber-500 rounded-xl flex items-center justify-center group-hover:bg-amber-500 group-hover:text-white transition-colors">
                                    <i data-feather="star" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h3 class="text-[11px] font-bold text-gray-400 uppercase tracking-wider outfit-font">Rating</h3>
                                    <p class="text-2xl font-black text-gray-900 outfit-font">4.9<span class="text-xs text-gray-300 ml-1">/5</span></p>
                                </div>
                            </div>
                            <div class="flex gap-1">
                                <i data-feather="star" class="w-3 h-3 fill-amber-400 text-amber-400"></i>
                                <i data-feather="star" class="w-3 h-3 fill-amber-400 text-amber-400"></i>
                                <i data-feather="star" class="w-3 h-3 fill-amber-400 text-amber-400"></i>
                                <i data-feather="star" class="w-3 h-3 fill-amber-400 text-amber-400"></i>
                                <i data-feather="star" class="w-3 h-3 fill-amber-400 text-amber-400"></i>
                            </div>
                        </div>

                        <!-- Stat Item 4 -->
                        <div class="glass-card p-6 rounded-2xl group fade-in" style="animation-delay: 0.4s;">
                            <div class="flex items-center gap-4 mb-4">
                                <div class="w-12 h-12 bg-gray-50 text-gray-500 rounded-xl flex items-center justify-center group-hover:bg-gray-900 group-hover:text-white transition-colors">
                                    <i data-feather="award" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h3 class="text-[11px] font-bold text-gray-400 uppercase tracking-wider outfit-font">Status</h3>
                                    <p class="text-lg font-black text-gray-900">معلم معتمد</p>
                                </div>
                            </div>
                            <span class="text-[10px] bg-indigo-50 text-indigo-600 px-3 py-1 rounded-full font-bold">Verified Expert</span>
                        </div>
                    </section>

                    <!-- Row 2: Today's Sessions -->
                    <section class="fade-in" style="animation-delay: 0.5s;">
                        <div class="flex items-center justify-between mb-6 px-2">
                            <div>
                                <h3 class="text-xl font-black text-gray-900">حصص اليوم</h3>
                                <p class="text-[10px] text-gray-400 font-bold outfit-font">Scheduled Sessions List</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-bold text-gray-400">اليوم: <%= currentDate %></span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                            <% if (todaysSessions && todaysSessions.length > 0) { %>
                                <% todaysSessions.forEach(session => { %>
                                    <div class="session-card glass-card p-6 rounded-2xl flex flex-col justify-between h-full bg-white relative">
                                        <% if (session.status === 'live') { %>
                                            <span class="absolute top-4 left-4 flex h-3 w-3">
                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                                <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
                                            </span>
                                        <% } %>

                                        <div class="mb-6">
                                            <div class="flex items-center justify-between mb-4">
                                                <span class="text-[10px] font-black text-primary-kider bg-secondary-kider px-3 py-1 rounded-full outfit-font">
                                                    <%= session.status %>
                                                </span>
                                                <span class="text-xs font-black text-gray-900 outfit-font local-time-display" 
                                                      data-utc-date="<%= session.date %>" 
                                                      data-utc-time="<%= session.time %>">
                                                    <%= session.time %>
                                                </span>
                                            </div>
                                            <h4 class="text-md font-black text-gray-900 mb-1 leading-tight"><%= session.title %></h4>
                                            <p class="text-xs text-gray-500 font-bold">الطالب: <%= session.studentName %></p>
                                        </div>

                                        <div class="space-y-3">
                                            <% if(session.status === 'live' || session.status === 'upcoming') { %>
                                                <a href="<%= session.link %>" class="w-full py-3 bg-primary-kider hover:bg-black text-white text-xs font-black rounded-xl transition-all flex items-center justify-center gap-2">
                                                    <i data-feather="video" class="w-4 h-4"></i>
                                                    دخول الحصة
                                                </a>
                                            <% } else { %>
                                                <% if(!session.isSendReport) { %>
                                                    <a href="/teacher/session/<%= session.bookingId %>/<%= session.sessionIndex %>" class="w-full py-3 border-2 border-dashed border-primary-kider text-primary-kider hover:bg-primary-kider hover:text-white text-xs font-black rounded-xl transition-all flex items-center justify-center gap-2">
                                                        <i data-feather="file-text" class="w-4 h-4"></i>
                                                        إضافة التقرير
                                                    </a>
                                                <% } else { %>
                                                    <div class="w-full py-3 bg-emerald-50 text-emerald-600 text-xs font-black rounded-xl border border-emerald-100 flex items-center justify-center gap-2">
                                                        <i data-feather="check" class="w-4 h-4"></i>
                                                        تم التقرير
                                                    </div>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } else { %>
                                <div class="col-span-full py-16 text-center glass-card rounded-2xl border-dashed border-2">
                                    <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-300">
                                        <i data-feather="calendar" class="w-8 h-8"></i>
                                    </div>
                                    <p class="text-gray-400 font-bold">لا توجد حصص مجدولة لليوم</p>
                                </div>
                            <% } %>
                        </div>
                    </section>

                    <!-- Latest Students Table -->
                    <section class="fade-in" style="animation-delay: 0.6s;">
                        <div class="glass-card rounded-2xl overflow-hidden">
                            <div class="p-6 border-b border-gray-50 flex items-center justify-between">
                                <h3 class="text-lg font-black text-gray-900">آخر الطلاب المنضمين</h3>
                                <a href="/teacher/students" class="text-xs font-black text-primary-kider hover:underline outfit-font">View All</a>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-right">
                                    <thead class="bg-gray-50 text-[10px] text-gray-400 font-black tracking-widest uppercase outfit-font">
                                        <tr>
                                            <th class="px-8 py-4">Student</th>
                                            <th class="px-8 py-4">Course</th>
                                            <th class="px-8 py-4 text-center">Sessions</th>
                                            <th class="px-8 py-4"></th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-50">
                                        <% if (teacherStatic.latestStudents && teacherStatic.latestStudents.length > 0) { %>
                                            <% teacherStatic.latestStudents.forEach(booking => { %>
                                                <tr class="hover:bg-gray-50/50 transition-colors cursor-pointer" onclick="window.location.href='/teacher/students'">
                                                    <td class="px-8 py-4">
                                                        <div class="flex items-center gap-3">
                                                            <div class="w-8 h-8 rounded-lg bg-primary-light text-primary-kider flex items-center justify-center font-black text-xs">
                                                                <%= booking.studentId.name.substring(0, 1) %>
                                                            </div>
                                                            <div>
                                                                <p class="font-bold text-gray-900 text-sm"><%= booking.studentId.name %></p>
                                                                <p class="text-[9px] text-gray-400 font-bold"><%= booking.studentId.email %></p>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="px-8 py-4">
                                                        <span class="text-xs font-bold text-gray-600"><%= booking.courseId?.title || 'عام' %></span>
                                                    </td>
                                                    <td class="px-8 py-4 text-center">
                                                        <span class="text-xs font-black text-gray-900 outfit-font"><%= booking.numberOfSessionsPerMonth %></span>
                                                    </td>
                                                    <td class="px-8 py-4 text-left">
                                                        <i data-feather="chevron-left" class="w-4 h-4 text-gray-300"></i>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="px-8 py-8 text-center text-gray-400 font-bold">لا يوجد طلاب مسجلون حالياً</td>
                                            </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                </div>
                
                <!-- Footer -->
                <footer class="mt-16 py-10 border-t border-gray-100/50 text-center">
                    <p class="text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] outfit-font">
                        &copy; <%= new Date().getFullYear() %> <%= settings.academyName %> &bull; All Rights Reserved
                    </p>
                </footer>
            </main>
        </div>
    </div>

    <!-- Modals -->
    <div id="logoutModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
        <div class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden max-w-sm w-full relative z-10 transform transition-all duration-300 scale-95 opacity-0" id="modalContainer">
            <div class="p-8 text-center">
                <div class="w-16 h-16 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center mx-auto mb-6">
                    <i data-feather="log-out" class="w-8 h-8"></i>
                </div>
                <h3 class="text-xl font-black text-gray-900 mb-2">تسجيل الخروج</h3>
                <p class="text-gray-500 text-sm mb-8">هل أنت متأكد من رغبتك في المغادرة؟ ستنتهي جلستك الحالية.</p>
                <div class="grid grid-cols-2 gap-4">
                    <button onclick="closeLogoutModal()" class="py-3 bg-gray-100 text-gray-600 rounded-xl font-black text-xs hover:bg-gray-200 transition-colors">إلغاء</button>
                    <a href="/logout" class="py-3 bg-red-600 text-white rounded-xl font-black text-xs hover:bg-black transition-all">خروج</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        feather.replace();

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            sidebar.classList.toggle('translate-x-full');
            overlay.classList.toggle('hidden');
        }

        function openLogoutModal() {
            const modal = document.getElementById('logoutModal');
            const container = document.getElementById('modalContainer');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeLogoutModal() {
            const modal = document.getElementById('logoutModal');
            const container = document.getElementById('modalContainer');
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }, 300);
        }

        // Timezone Logic
        document.addEventListener('DOMContentLoaded', () => {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            document.querySelectorAll('.local-timezone-name').forEach(el => el.innerText = tz);

            document.querySelectorAll('.local-time-display').forEach(el => {
                const utcDate = el.getAttribute('data-utc-date');
                const utcTime = el.getAttribute('data-utc-time');
                if (utcDate && utcTime) {
                    const dateObj = new Date(`${utcDate}T${utcTime}:00Z`);
                    if (!isNaN(dateObj)) {
                        el.innerText = dateObj.toLocaleTimeString('en-US', {
                            hour: '2-digit', minute: '2-digit', hour12: true
                        });
                    }
                }
            });
        });
    </script>
</body>
</html>