<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم المعلم - متجاوبة</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }
        
        /* تحسينات القائمة الجانبية للجوال */
        @media (max-width: 1024px) {
            .sidebar-closed { transform: translateX(100%); }
            .sidebar-open { transform: translateX(0); }
            .overlay { display: none; }
            .sidebar-open + .overlay { display: block; }
        }
.no-scrollbar::-webkit-scrollbar { display: none; }
.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .active-link { background-color: #4f46e5; color: white; box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.4); }
    </style>
</head>
<body class="overflow-hidden">

    <div id="overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden transition-opacity"></div>

    <div class="flex h-screen overflow-hidden">
        
        <aside id="sidebar" class="fixed inset-y-0 right-0 z-50 w-72 bg-white border-l border-gray-100 transition-transform duration-300 sidebar-closed lg:translate-x-0 lg:static lg:block shadow-2xl lg:shadow-none">
            <div class="h-20 flex items-center justify-between px-6 border-b border-gray-50">
                <span class="text-2xl font-black text-indigo-600">لوحة المعلم</span>
                <button onclick="toggleSidebar()" class="lg:hidden p-2 text-gray-400">
                    <i data-feather="x"></i>
                </button>
            </div>
            
            <nav class="p-4 space-y-2 overflow-y-auto h-[calc(100vh-80px)]">
                <a href="/teacher/home" class="active-link flex items-center px-4 py-3.5 rounded-2xl transition-all font-bold">
                    <i data-feather="grid" class="ml-3 w-5 h-5"></i> الرئيسية
                </a>
                <a href="/teacher/students" class="flex items-center px-4 py-3.5 text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 rounded-2xl transition-all font-medium">
                    <i data-feather="users" class="ml-3 w-5 h-5"></i> الطلاب المشتركين
                </a>
                <a href="/teacher/schedule" class="flex items-center px-4 py-3.5 text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 rounded-2xl transition-all font-medium">
                    <i data-feather="calendar" class="ml-3 w-5 h-5"></i> جدول المواعيد
                </a>
                  </a>
                <a href="/teacher/finanical_page" class="flex items-center px-4 py-3.5 text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 rounded-2xl transition-all font-medium">
                    <i data-feather="credit-card" class="ml-3 w-5 h-5"></i> المحفظة 
                </a>
                <a href="/teacher/settings" class="flex items-center px-4 py-3.5 text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 rounded-2xl transition-all font-medium">
                    <i data-feather="settings" class="ml-3 w-5 h-5"></i> الإعدادات
                </a>
                <div class="pt-4 mt-4 border-t border-gray-100">
                     <a href="#" onclick="openLogoutModal(event)" class="flex items-center justify-center p-2 text-red-600 bg-red-50 rounded-lg hover:bg-red-100 transition-colors font-medium">
            <i data-feather="log-out" class="ml-2 w-5 h-5"></i>
            تسجيل الخروج
        </a>
                </div>
            </nav>
        </aside>

        <div class="flex-1 flex flex-col min-w-0">
            
            <header class="h-20 bg-white/80 backdrop-blur-md border-b border-gray-100 flex items-center justify-between px-4 lg:px-10 shrink-0 z-30">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" class="lg:hidden p-3 bg-gray-50 text-gray-600 rounded-2xl hover:bg-indigo-50 transition">
                        <i data-feather="menu" class="w-6 h-6"></i>
                    </button>
                    <div>
                        <h2 class="text-lg lg:text-xl font-black text-gray-900">أهلاً بك، أ. <%=user.name  %> 👋</h2>
                    <% if (todaysSessions.length > 0) { %>
                     
                        <p class="text-[10px] lg:text-xs text-gray-400 font-bold hidden sm:block">لديك <%=todaysSessions.length  %> حصص اليوم، تمنياتنا لك بالتوفيق!</p>
                  
                    <% }else{ %> 
                        
                        <p class="text-[10px] lg:text-xs text-gray-400 font-bold hidden sm:block">  لا يوجد حصص اليوم، تمنياتنا لك بالتوفيق!</p>
                  
                        <% } %>     </div>
                </div>
                
                <div class="flex items-center gap-3">
                    <button class="p-3 text-gray-400 hover:bg-gray-50 rounded-2xl relative">
                        <i data-feather="bell" class="w-5 h-5"></i>
                        <span class="absolute top-3 left-3 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    <div class="w-10 h-10 lg:w-12 lg:h-12 bg-indigo-100 rounded-2xl border-2 border-white shadow-sm flex items-center justify-center text-indigo-600 font-black">أ</div>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto p-4 lg:p-10 no-scrollbar">
                <div class="max-w-7xl mx-auto space-y-8">
                    
<section>
    <div class="flex items-center justify-between mb-5">
        <h3 class="text-md font-black text-gray-900">جدول حصص اليوم</h3>
        <span class="text-[10px] font-bold text-indigo-500 bg-indigo-50 px-3 py-1 rounded-full italic local-timezone-name">
            توقيتك المحلي
        </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (todaysSessions && todaysSessions.length > 0) { %>
            <% todaysSessions.forEach(session => { %>
                <% 
            let rawDate = '';
    if (session.date && !isNaN(new Date(session.date).getTime())) {
        rawDate = new Date(session.date).toISOString().split('T')[0];
    } else {
        // إذا كان التاريخ مفقوداً، نستخدم تاريخ اليوم كقيمة احتياطية أو نتركه فارغاً
        rawDate = new Date().toISOString().split('T')[0]; 
    }

    // 2. التأكد من وجود الوقت
    const rawTime = session.time || '00:00';
                %>
              
                <% if (session.status === 'live' || session.status === 'upcoming') { %>
                    <div class="bg-white border <%= session.status === 'live' ? 'border-indigo-600 ring-2 ring-indigo-50' : 'border-gray-100' %> p-6 rounded-[2rem] shadow-sm relative transition-all hover:shadow-md">
                        <% if (session.status === 'live') { %>
                            <span class="absolute top-4 left-4 flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                            </span>
                        <% } %>
                        
                        <div class="flex items-center gap-2 mb-2">
                            <i data-feather="clock" class="w-3.5 h-3.5 text-indigo-500"></i>
                            <p class="text-[10px] font-black text-indigo-600 tracking-widest uppercase local-time-display" 
                               data-utc-date="<%= rawDate %>" 
                               data-utc-time="<%= rawTime %>">
                                <%= session.time %>
                            </p>
                        </div>
                        
                        <h4 class="font-bold text-gray-900 text-md mb-1"><%= session.title %></h4>
                        <p class="text-[10px] text-gray-500 mb-5">الطالب: <span class="font-bold text-gray-700"><%= session.studentName %></span></p>
                        
                        <a href="<%= session.link %>" 
                           class="w-full flex items-center justify-center gap-2 bg-indigo-600 text-white text-xs font-bold py-3 rounded-2xl hover:bg-indigo-700 transition shadow-lg shadow-indigo-100">
                            <i data-feather="video" class="w-4 h-4"></i>
                            انضمام للحصة الآن
                        </a>
                    </div>

                <% } else if (session.status === 'completed'|| session.status === 'finished') { %>
                    <div class="bg-gray-50 border border-gray-200 p-6 rounded-[2rem] relative opacity-90">
                        <div class="flex items-center gap-2 mb-2">
                            <i data-feather="check-circle" class="w-3.5 h-3.5 text-green-500"></i>
                            <p class="text-[10px] font-black text-gray-400 tracking-widest uppercase">انتهت الحصة</p>
                        </div>
                        
                        <h4 class="font-bold text-gray-400 text-md mb-1 line-through"><%= session.title %></h4>
                        <p class="text-[10px] text-gray-400 mb-2 italic local-time-display text-[8px]" 
                           data-utc-date="<%= rawDate %>" 
                           data-utc-time="<%= rawTime %>">
                           <%= session.time %>
                        </p>
                        <p class="text-[10px] text-gray-400 mb-5 italic">الطالب: <%= session.studentName %></p>
                        
                        <% if(session.isSendReport == false) {%>   
                            <a href="/teacher/session/<%= session.bookingId %>/<%= session.sessionIndex %>" 
                               class="w-full flex items-center justify-center gap-2 bg-white border border-gray-300 text-gray-700 text-xs font-bold py-3 rounded-2xl hover:bg-gray-100 transition">
                                <i data-feather="file-text" class="w-4 h-4"></i>
                                إضافة تقرير الحصة
                            </a>
                        <% } %>
                    </div>
                <% } %>

            <% }) %>
        <% } else { %>
            <div class="col-span-full bg-white border-2 border-dashed border-gray-100 p-12 rounded-[2.5rem] text-center">
                <div class="bg-gray-50 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-feather="coffee" class="text-gray-300"></i>
                </div>
                <p class="text-gray-400 font-bold text-sm">استراحة محارب! لا توجد حصص مجدولة لليوم.</p>
            </div>
        <% } %>
    </div>
</section>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // تحديث اسم المنطقة الزمنية في العنوان
        const tzNameDisplay = document.querySelector('.local-timezone-name');
        if (tzNameDisplay) {
            const tzName = Intl.DateTimeFormat().resolvedOptions().timeZone;
            tzNameDisplay.innerText = `توقيتك: ${tzName}`;
        }

        // تحويل كل الحصص للتوقيت المحلي
        document.querySelectorAll('.local-time-display').forEach(el => {
            const utcDate = el.getAttribute('data-utc-date');
            const utcTime = el.getAttribute('data-utc-time');
            
            if (utcDate && utcTime) {
                // دمج التاريخ والوقت في كائن Date (يفترض أن السيرفر يرسلهم بصيغة UTC)
                const dateObj = new Date(`${utcDate}T${utcTime}:00Z`);
                
                // تحويل للوقت المحلي بصيغة 12 ساعة (ص/م)
                const localTime = dateObj.toLocaleTimeString('ar-EG', {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: true
                });
                
                el.innerText = localTime;
            }
        });
    });
</script>
                    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <div class="bg-white p-6 rounded-[2rem] border border-gray-100 shadow-sm flex items-center gap-4">
                            <div class="p-4 bg-blue-50 text-blue-600 rounded-2xl"><i data-feather="users"></i></div>
                            <div>
                                <p class="text-[10px] font-bold text-gray-400">إجمالي الطلاب</p>
                                <p class="text-xl font-black text-gray-900"><%= teacherStatic. students %></p>
                            </div>
                        </div>
                        <div class="bg-white p-6 rounded-[2rem] border border-gray-100 shadow-sm flex items-center gap-4">
                            <div class="p-4 bg-green-50 text-green-600 rounded-2xl"><i data-feather="dollar-sign"></i></div>
                            <div>
                                <p class="text-[10px] font-bold text-gray-400">أرباحك (ر.س)</p>
                                <p class="text-xl font-black text-gray-900"><%=   Math.round(teacherStatic.revenue)  %></p>
                            </div>
                        </div>
                        <div class="bg-white p-6 rounded-[2rem] border border-gray-100 shadow-sm flex items-center gap-4">
                            <div class="p-4 bg-purple-50 text-purple-600 rounded-2xl"><i data-feather="book"></i></div>
                            <div>
                                <p class="text-[10px] font-bold text-gray-400">عدد الكورسات</p>
                                <p class="text-xl font-black text-gray-900">1</p>
                            </div>
                        </div>
                        <div class="bg-white p-6 rounded-[2rem] border border-gray-100 shadow-sm flex items-center gap-4">
                            <div class="p-4 bg-orange-50 text-orange-600 rounded-2xl"><i data-feather="star"></i></div>
                            <div>
                                <p class="text-[10px] font-bold text-gray-400">متوسط التقييم</p>
                                <p class="text-xl font-black text-gray-900">4.9/5</p>
                            </div>
                        </div>
                    </section>

                    <section class="grid grid-cols-1 lg:grid-cols-3 gap-8 pb-10">
                        <div class="lg:col-span-2 bg-white rounded-[2.5rem] border border-gray-100 shadow-sm overflow-hidden">
                            <div class="p-8 border-b border-gray-50 flex justify-between items-center">
                                <h3 class="font-black text-gray-900">آخر الطلاب المنضمين</h3>
                                <button class="text-xs font-bold text-indigo-600">عرض الكل</button>
                            </div>
                            <div class="overflow-x-auto">
                                <table class="w-full text-right text-sm">
                                    <thead class="bg-gray-50 text-gray-400">
                                        <tr>
                                            <th class="px-8 py-4 font-bold">اسم الطالب</th>
                                            <th class="px-8 py-4 font-bold">الكورس</th>
                                            <th class="px-8 py-4 font-bold text-center">عدد الحصص</th>
                                        </tr>
                                    </thead>
                                   <tbody class="divide-y divide-gray-50">
    <% teacherStatic.latestStudents.forEach(booking => { %>
        <tr class="hover:bg-gray-50/50 transition-all group">
            <td class="px-6 py-4">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-8 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 font-black text-xs">
                        <%= booking.studentId.name.substring(0, 2) %>
                    </div>
                    <p class="font-bold text-gray-900"><%= booking.studentId.name %></p>
                </div>
            </td>
            <td class="px-6 py-3 text-center">
                <span class="px-2 py-1.5 bg-gray-100 text-gray-600 rounded-full text-[11px] font-black">
                    <%= booking.courseId.title %>
                </span>
            </td>
            <td class="px-6 py-3 text-center">
                <span class="text-xs font-bold text-gray-400 italic">
                    <%= booking.numberOfSessionsPerMonth %> </span>
            </td>
        </tr>
    <% }) %>
</tbody>
                                </table>
                            </div>
                        </div>

                        <div class="bg-indigo-900 text-white rounded-[2.5rem] p-8 relative overflow-hidden shadow-2xl shadow-indigo-200">
                            <h3 class="font-black text-lg mb-4 relative z-10">تحتاج مساعدة؟ 💡</h3>
                            <p class="text-indigo-200 text-xs leading-relaxed mb-6 relative z-10">يمكنك التواصل مع الدعم الفني الخاص بالمنصة في أي وقت لمساعدتك في إدارة حصصك المباشرة.</p>
                            <button class="w-full bg-white text-indigo-900 py-4 rounded-2xl font-black text-xs relative z-10 hover:bg-indigo-50 transition">تواصل مع الدعم</button>
                            <i data-feather="help-circle" class="absolute -bottom-10 -left-10 w-40 h-40 text-white/5"></i>
                        </div>
                    </section>

                </div>
            </main>
        </div>
    </div>

    <script>
        feather.replace();

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            
            if (sidebar.classList.contains('sidebar-closed')) {
                sidebar.classList.remove('sidebar-closed');
                sidebar.classList.add('sidebar-open');
                overlay.classList.remove('hidden');
            } else {
                sidebar.classList.remove('sidebar-open');
                sidebar.classList.add('sidebar-closed');
                overlay.classList.add('hidden');
            }
        }
    </script>
    <div id="logoutModal" class="fixed inset-0 bg-gray-600 bg-opacity-75 hidden items-center justify-center z-50 transition-opacity duration-300">
    <div class="bg-white rounded-lg shadow-xl overflow-hidden max-w-sm w-full mx-4" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="px-6 pt-5 pb-4">
            <div class="flex items-center">
                <div class="flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100">
                    <i data-feather="alert-triangle" class="h-6 w-6 text-red-600"></i>
                </div>
                <div class="mr-4 text-right">
                    <h3 class="text-lg leading-6 font-bold text-gray-900" id="modal-title">تأكيد تسجيل الخروج</h3>
                    <div class="mt-2">
                        <p class="text-sm text-gray-500">
                            هل أنت متأكد أنك تريد تسجيل الخروج؟ سيتم إنهاء جلستك الحالية.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="bg-gray-50 px-4 py-3 sm:px-6 flex justify-between gap-3">
            <button type="button" onclick="closeLogoutModal()" class="w-full justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-100 sm:mt-0 sm:w-auto sm:text-sm transition-colors">
                إلغاء
            </button>
            
            <a id="confirmLogoutButton" href="/logout" class="w-full justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 sm:w-auto sm:text-sm transition-colors flex items-center">
                <i data-feather="log-out" class="ml-1 w-4 h-4"></i>
                نعم، تسجيل الخروج
            </a>
        </div>
    </div>
</div>

    <script>
    // ----------------- دوال التحكم في Modal الخروج -----------------
    const logoutModal = document.getElementById('logoutModal');

    function openLogoutModal(event) {
        event.preventDefault(); 
        logoutModal.classList.remove('hidden');
        logoutModal.classList.add('flex'); 
        feather.replace(); // لضمان ظهور أيقونة الـ modal عند الفتح
    }

    function closeLogoutModal() {
        logoutModal.classList.remove('flex');
        logoutModal.classList.add('hidden');
    }
</script>
</body>
</html>