<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= dir %>">

<head>
    <meta charset="utf-8">
    <title><%= settings.academyName %> - تغيير كلمة المرور</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <link href="/img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&family=Alexandria:wght@300;400;500;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root { --primary: #FE5D37; --secondary: #FFF0ED; --light: #F8F9FA; --dark: #000B1C; }
        body { font-family: 'Cairo', sans-serif; background-color: #f7f9fc; font-size: 0.9rem; }
        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }
        .main-content { margin-right: 260px; padding: 1.5rem; min-height: 100vh; transition: all 0.3s; }
        @media (max-width: 991.98px) { .main-content { margin-right: 0; } }

        .section-card {
            background: #fff;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            padding: 2rem;
            border: 1px solid rgba(0,0,0,0.05);
            margin-bottom: 1.5rem;
        }

        .btn-kider {
            background-color: var(--primary);
            color: #fff;
            border-radius: 0.75rem;
            padding: 0.75rem 1.5rem;
            font-weight: 700;
            border: none;
            font-size: 0.85rem;
            transition: all 0.3s;
        }
        .btn-kider:hover { background-color: #e44d2d; transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(254, 93, 55, 0.2); color: #fff; }

        .form-control-custom {
            background: #fdfdfd;
            border: 1.5px solid #F3F4F6;
            padding: 0.85rem 1.25rem;
            border-radius: 1rem;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s;
        }
        .form-control-custom:focus {
            border-color: var(--primary);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(254, 93, 55, 0.1);
        }

        .password-wrapper { position: relative; }
        .password-toggle {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #adb5bd;
            cursor: pointer;
            padding: 0;
            font-size: 0.85rem;
            transition: color 0.3s;
        }
        .password-toggle:hover { color: var(--primary); }

        .strength-bar { height: 4px; border-radius: 10px; transition: all 0.3s; }
    </style>
</head>

<body>
    <%- include('./_teacher_sidebar.ejs', { currentPage: 'settings', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-900 lobster-font" style="font-size: 1.2em;">تغيير كلمة المرور</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;">Change Your Password</small>
                    </div>
                </div>
                <a href="/teacher/settings" class="btn btn-light rounded-pill px-3 py-2 fw-bold small">
                    <i class="fas fa-arrow-right me-1"></i> العودة للإعدادات
                </a>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6">
                <!-- Lock Icon -->
                <div class="text-center mb-4 animate__animated animate__fadeIn">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mx-auto" style="width: 80px; height: 80px;">
                        <i class="fas fa-lock text-primary" style="font-size: 1.8rem;"></i>
                    </div>
                    <h5 class="fw-bold text-dark mt-3 mb-1">تأمين حسابك</h5>
                    <p class="text-muted small">تأكد من استخدام كلمة مرور قوية ومختلفة عن كلمات المرور السابقة</p>
                </div>

                <div class="section-card animate__animated animate__fadeInUp">
                    <form id="changePasswordForm">
                        <!-- Current Password -->
                        <div class="mb-4">
                            <label class="form-label text-muted fw-bold outfit-font" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">
                                <i class="fas fa-key me-1 text-primary"></i> كلمة المرور الحالية
                            </label>
                            <div class="password-wrapper">
                                <input type="password" id="currentPassword" name="currentPassword" required
                                       class="form-control form-control-custom" placeholder="أدخل كلمة المرور الحالية" dir="ltr">
                                <button type="button" class="password-toggle" onclick="togglePassword('currentPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <!-- New Password -->
                        <div class="mb-4">
                            <label class="form-label text-muted fw-bold outfit-font" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">
                                <i class="fas fa-lock me-1 text-primary"></i> كلمة المرور الجديدة
                            </label>
                            <div class="password-wrapper">
                                <input type="password" id="newPassword" name="newPassword" required minlength="6"
                                       class="form-control form-control-custom" placeholder="6 أحرف على الأقل" dir="ltr"
                                       oninput="checkStrength(this.value)">
                                <button type="button" class="password-toggle" onclick="togglePassword('newPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <!-- Strength Indicator -->
                            <div class="d-flex gap-1 mt-2">
                                <div id="str1" class="strength-bar flex-fill bg-light"></div>
                                <div id="str2" class="strength-bar flex-fill bg-light"></div>
                                <div id="str3" class="strength-bar flex-fill bg-light"></div>
                                <div id="str4" class="strength-bar flex-fill bg-light"></div>
                            </div>
                            <small id="strengthText" class="text-muted d-block mt-1" style="font-size: 0.65rem;"></small>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-4">
                            <label class="form-label text-muted fw-bold outfit-font" style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px;">
                                <i class="fas fa-check-circle me-1 text-primary"></i> تأكيد كلمة المرور الجديدة
                            </label>
                            <div class="password-wrapper">
                                <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6"
                                       class="form-control form-control-custom" placeholder="أعد كتابة كلمة المرور الجديدة" dir="ltr"
                                       oninput="checkMatch()">
                                <button type="button" class="password-toggle" onclick="togglePassword('confirmPassword', this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <small id="matchText" class="d-block mt-1" style="font-size: 0.65rem;"></small>
                        </div>

                        <!-- Submit -->
                        <button type="submit" id="submitBtn" class="btn btn-kider w-100 py-3">
                            <i class="fas fa-shield-alt me-2"></i>
                            <span class="btn-text">تحديث كلمة المرور</span>
                        </button>
                    </form>
                </div>

                <!-- Security Tips -->
                <div class="section-card p-3 animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                    <h6 class="fw-bold mb-3 small"><i class="fas fa-lightbulb text-warning me-2"></i>نصائح أمنية</h6>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-check text-success" style="font-size: 0.6rem;"></i>
                            <small class="text-muted">استخدم 6 أحرف على الأقل</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-check text-success" style="font-size: 0.6rem;"></i>
                            <small class="text-muted">أضف أرقام ورموز لزيادة الأمان</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-check text-success" style="font-size: 0.6rem;"></i>
                            <small class="text-muted">لا تستخدم نفس كلمة المرور في مواقع أخرى</small>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-check text-success" style="font-size: 0.6rem;"></i>
                            <small class="text-muted">استخدم مزيج من الأحرف الكبيرة والصغيرة</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="mt-auto py-4 text-center text-muted border-top">
            <small>&copy; <%= settings.academyName %> <%= new Date().getFullYear() %></small>
        </footer>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle password visibility
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }

        // Password strength checker
        function checkStrength(val) {
            let score = 0;
            if (val.length >= 6) score++;
            if (val.length >= 10) score++;
            if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
            if (/[0-9]/.test(val) && /[^A-Za-z0-9]/.test(val)) score++;

            const colors = ['#ef4444', '#f59e0b', '#3b82f6', '#10b981'];
            const labels = ['ضعيفة', 'مقبولة', 'جيدة', 'قوية جداً'];
            const textColors = ['text-danger', 'text-warning', 'text-primary', 'text-success'];

            for (let i = 1; i <= 4; i++) {
                document.getElementById('str' + i).style.background = i <= score ? colors[score - 1] : '#e9ecef';
            }
            const strengthText = document.getElementById('strengthText');
            if (val.length > 0 && score > 0) {
                strengthText.textContent = labels[score - 1];
                strengthText.className = `d-block mt-1 fw-bold ${textColors[score - 1]}`;
                strengthText.style.fontSize = '0.65rem';
            } else {
                strengthText.textContent = '';
            }
        }

        // Check if passwords match
        function checkMatch() {
            const newPass = document.getElementById('newPassword').value;
            const confirm = document.getElementById('confirmPassword').value;
            const matchText = document.getElementById('matchText');

            if (confirm.length === 0) {
                matchText.textContent = '';
                return;
            }
            if (newPass === confirm) {
                matchText.textContent = '✓ كلمتا المرور متطابقتان';
                matchText.className = 'text-success d-block mt-1 fw-bold';
                matchText.style.fontSize = '0.65rem';
            } else {
                matchText.textContent = '✗ كلمتا المرور غير متطابقتين';
                matchText.className = 'text-danger d-block mt-1 fw-bold';
                matchText.style.fontSize = '0.65rem';
            }
        }

        // Form submit
        document.getElementById('changePasswordForm').addEventListener('submit', async function(e) {
            e.preventDefault();

            const currentPassword = document.getElementById('currentPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (newPassword !== confirmPassword) {
                Swal.fire({ icon: 'error', title: 'خطأ', text: 'كلمتا المرور غير متطابقتين', confirmButtonColor: '#FE5D37' });
                return;
            }
            if (newPassword.length < 6) {
                Swal.fire({ icon: 'error', title: 'خطأ', text: 'كلمة المرور يجب أن تكون 6 أحرف على الأقل', confirmButtonColor: '#FE5D37' });
                return;
            }

            const btn = document.getElementById('submitBtn');
            const btnText = btn.querySelector('.btn-text');
            btn.disabled = true;
            btnText.textContent = 'جاري التحديث...';

            try {
                const res = await fetch('/teacher/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ currentPassword, newPassword })
                });

                const data = await res.json();

                if (res.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'تم بنجاح!',
                        text: 'تم تغيير كلمة المرور بنجاح',
                        showConfirmButton: false,
                        timer: 2000,
                        customClass: { popup: 'rounded-4' }
                    });
                    setTimeout(() => window.location.href = '/teacher/settings', 2000);
                } else {
                    throw new Error(data.message || 'حدث خطأ');
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'خطأ', text: err.message, confirmButtonColor: '#FE5D37' });
            } finally {
                btn.disabled = false;
                btnText.textContent = 'تحديث كلمة المرور';
            }
        });
    </script>
</body>
</html>
