<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الطلاب - لوحة التحكم</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/feather-icons"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body { font-family: 'Tajawal', sans-serif; background-color: #f8fafc; }
        .swal2-popup { border-radius: 1.5rem !important; width: 35em !important; }
    </style>
</head>
<body class="text-gray-800">

    <div class="flex h-screen overflow-hidden">
        <%- include('./_admin_sidebar.ejs', { currentPage: 'students', user: user }) %>
        
        <div class="flex-1 flex flex-col overflow-hidden">
            <header class="h-16 bg-white border-b border-gray-200 flex items-center px-8 justify-between shadow-sm">
                <h2 class="text-xl font-black text-gray-800">إدارة الطلاب</h2>
                <button onclick="showAddStudentPopup()" class="bg-indigo-600 text-white px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-indigo-700 transition-all flex items-center shadow-lg">
                    <i data-feather="user-plus" class="ml-2 w-4 h-4"></i> إضافة طالب جديد
                </button>
            </header>

            <main class="flex-1 overflow-y-auto p-8">
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <table class="w-full text-right border-collapse">
                        <thead class="bg-gray-50 text-gray-500 text-[11px] font-black uppercase tracking-widest border-b border-gray-100">
                            <tr>
                                <th class="px-6 py-4">الطالب</th>
                                <th class="px-6 py-4">البريد</th>
                                <th class="px-6 py-4">الهاتف</th>
                                <th class="px-6 py-4">الحالة</th>
                                <th class="px-6 py-4 text-left">الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50 text-sm">
                            <% students.forEach(student => { %>
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="px-6 py-4">
                                        <a href="/admin/student/profile/<%= student.id %>" class="font-bold text-indigo-600 hover:text-indigo-800 hover:underline">
                                            <%= student.name %>
                                        </a>
                                    </td>
                                    <td class="px-6 py-4 text-gray-500"><%= student.email %></td>
                                    <td class="px-6 py-4 text-gray-500"><%= student.country_code %> <%= student.phone_number %></td>
                                    <td class="px-6 py-4">
                                    <% if (student.isActive == false) { %>
    <span class="px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-600">
        غير نشط
    </span>
<% } else { %> 
    <span class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-600">
        نشط
    </span>
<% } %>
                                    </td>
                                    <td class="px-6 py-4 flex justify-end gap-2">
                                        <% if (student.isActive == true) { %>
                                        <button onclick="handleAccountStatus('<%= student._id %>', 'archive')" class="p-3 text-slate-400 hover:text-orange-500 hover:bg-orange-50 rounded-xl transition-all" title="أرشفة">
                                            <i data-feather="user-x" class="w-4 h-4"></i>
                                        </button>
                                    <% } else { %>
                                        <button onclick="handleAccountStatus('<%= student._id %>', 'activate')" class="p-3 text-slate-400 hover:text-green-500 hover:bg-green-50 rounded-xl transition-all" title="تفعيل">
                                            <i data-feather="user-check" class="w-4 h-4"></i>
                                        </button>
                                    <% } %>
                                        
                                        <button onclick="confirmDelete('<%= student._id %>', '<%= student.name %>')" class="p-2 text-rose-500 hover:bg-rose-50 rounded-lg transition-colors">
                                            <i data-feather="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </main>
        </div>
    </div>

    <script>
        feather.replace();

        // دالة إضافة طالب (نفس الحقول الـ 8)
    async function showAddStudentPopup() {
    const { value: formValues } = await Swal.fire({
        title: '<span class="font-black text-2xl text-gray-800">تسجيل طالب جديد</span>',
        html: `
            <div class="text-right mt-6 space-y-4 px-2">
                <div class="space-y-1">
                    <label class="text-[11px] font-black text-gray-400 uppercase mr-1">الاسم الكامل</label>
                    <input id="sw-name" class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all font-bold text-sm" placeholder="أدخل اسم الطالب الثلاثي">
                </div>

                <div class="space-y-1">
                    <label class="text-[11px] font-black text-gray-400 uppercase mr-1">البريد الإلكتروني</label>
                    <input id="sw-email" type="email" class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all font-bold text-sm" placeholder="example@mail.com">
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div class="col-span-1 space-y-1">
                        <label class="text-[11px] font-black text-gray-400 uppercase mr-1">الكود</label>
                        <input id="sw-code" class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all font-bold text-sm text-center" value="+966">
                    </div>
                    <div class="col-span-2 space-y-1">
                        <label class="text-[11px] font-black text-gray-400 uppercase mr-1">رقم الهاتف</label>
                        <input id="sw-phone" class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 outline-none transition-all font-bold text-sm" placeholder="50xxxxxxx">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-black text-gray-400 uppercase mr-1">الجنس</label>
                        <select id="sw-gender" class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:bg-white outline-none transition-all font-bold text-sm appearance-none">
                            <option value="male">ذكر</option>
                            <option value="female">أنثى</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-black text-gray-400 uppercase mr-1">المنطقة الزمنية</label>
                        <input id="sw-timezone" class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:bg-white outline-none transition-all font-bold text-sm text-center" value="Asia/Riyadh">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1">
                        <label class="text-[11px] font-black text-gray-400 uppercase mr-1">كلمة المرور</label>
                        <input id="sw-pass" type="password" class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:bg-white outline-none transition-all font-bold text-sm" placeholder="******">
                    </div>
                    <div class="space-y-1">
                        <label class="text-[11px] font-black text-gray-400 uppercase mr-1">تأكيد الكلمة</label>
                        <input id="sw-conf-pass" type="password" class="w-full px-4 py-3 rounded-xl border border-gray-100 bg-gray-50 focus:bg-white outline-none transition-all font-bold text-sm" placeholder="******">
                    </div>
                </div>
            </div>`,
        padding: '2rem',
        background: '#fff',
        borderRadius: '2rem',
        confirmButtonText: 'إتمام التسجيل',
        confirmButtonColor: '#4f46e5',
        cancelButtonText: 'إلغاء',
        showCancelButton: true,
        customClass: {
            confirmButton: 'rounded-xl px-8 py-3 text-sm font-black shadow-lg shadow-indigo-200',
            cancelButton: 'rounded-xl px-8 py-3 text-sm font-bold text-gray-400'
        },
        preConfirm: async () => {
            // ... (نفس منطق الجلب الخاص بك)
            const data = {
                name: document.getElementById('sw-name').value,
                email: document.getElementById('sw-email').value,
                country_code: document.getElementById('sw-code').value,
                phone_number: document.getElementById('sw-phone').value,
                gender: document.getElementById('sw-gender').value,
                password: document.getElementById('sw-pass').value,
                confirm_Password: document.getElementById('sw-conf-pass').value,
                timezone: document.getElementById('sw-timezone').value
            };

            if (!data.name || !data.email || !data.password) return Swal.showValidationMessage('يرجى ملء الحقول الأساسية');
            if (data.password !== data.confirm_Password) return Swal.showValidationMessage('كلمات المرور غير متطابقة');
            
            try {
                const res = await fetch('/student/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await res.json();
                if (!res.ok) throw new Error(result.message || 'حدث خطأ أثناء التسجيل');
                return result;
            } catch (e) { Swal.showValidationMessage(e.message); }
        }
    });
    if (formValues) {
        Swal.fire({ icon: 'success', title: 'تمت الإضافة', showConfirmButton: false, timer: 1500 });
        setTimeout(() => location.reload(), 1500);
    }
}
   async function handleAccountStatus(studentId, action) {
            const isArchiving = action === 'archive';
            const { value: confirm } = await Swal.fire({
                title: isArchiving ? 'أرشفة حساب الطالب؟' : 'إعادة تفعيل الحساب؟',
                text: isArchiving ? 'لن يظهر الطالب في القوائم النشطة، ولكن بياناته محفوظة.' : 'سيعود الطالب للعمل والظهور في القوائم مرة أخرى.',
                icon: isArchiving ? 'warning' : 'info',
                showCancelButton: true,
                confirmButtonColor: isArchiving ? '#f97316' : '#22c55e',
                confirmButtonText: isArchiving ? 'نعم، أرشِف' : 'نعم، تفعيل',
                cancelButtonText: 'إلغاء',
                customClass: { popup: 'rounded-[2rem]' }
            });

            if (confirm) {
                try {
                    const response = await fetch(`/student/update-status`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ studentId, isActive: !isArchiving })
                    });
                    const data = await response.json();
                    if (response.ok) location.reload();
                    else Swal.fire({ title: 'تنبيه', text: data.error, icon: 'error', customClass: { popup: 'rounded-[2rem]' } });
                } catch (err) { Swal.fire('خطأ', 'تعذر الاتصال بالسيرفر', 'error'); }
            }
        }

        // --- 2. نظام الحذف ال
        // دالة الأرشفة (Toggle Archive)
       
        // --- 2. نظام الحذف النهائي (SweetAlert2 - نفس التصميم) ---
        async function handleDeleteTeacher(teacherId, teacherName) {
            const { value: confirm } = await Swal.fire({
                title: 'حذف المعلم نهائياً؟',
                text: `هل أنت متأكد من حذف المدرب (${teacherName})؟ لا يمكن التراجع عن هذا الإجراء وسيتم مسح كافة البيانات.`,
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'نعم، احذف نهائياً',
                cancelButtonText: 'تراجع',
                customClass: { popup: 'rounded-[2rem]' }
            });

            if (confirm) {
                try {
                    const response = await fetch(`/admin/teachers/delete/${teacherId}`, { method: 'POST' });
                    const data = await response.json();
                    if (data.success) location.reload();
                    else Swal.fire({ title: 'فشل الحذف', text: data.message, icon: 'error', customClass: { popup: 'rounded-[2rem]' } });
                } catch (err) { Swal.fire('خطأ', 'فشل الاتصال بالسيرفر', 'error'); }
            }
        }

        async function confirmDelete(id, name) {
            const result = await Swal.fire({
                title: 'حذف نهائي؟',
                text: `سيتم حذف ${name} تماماً من قاعدة البيانات`,
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444'
            });
            if (result.isConfirmed) {
                const res = await fetch(`/student/delete/${id}`, { method: 'POST' });
                if (res.ok) location.reload();
            }
        }
    </script>
</body>
</html>