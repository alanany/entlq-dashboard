<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8">
    <title>إنشاء حساب المدير العام</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <style>
        :root {
            --primary: #5856d6;
            --primary-dark: #4644b1;
            --secondary: #f0f0f7;
            --dark: #1c1c1e;
            --success: #34c759;
            --danger: #ff3b30;
        }

        * { box-sizing: border-box; }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .setup-container {
            max-width: 520px;
            width: 100%;
        }

        .setup-card {
            border: none;
            border-radius: 2rem;
            overflow: hidden;
            box-shadow: 0 2rem 6rem rgba(0,0,0,.2);
            background: #fff;
            padding: 3rem;
            animation: slideUp .6s ease-out;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .logo-box {
            width: 90px;
            height: 90px;
            background: linear-gradient(135deg, var(--primary), #764ba2);
            color: white;
            border-radius: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 1.5rem;
            box-shadow: 0 .5rem 2rem rgba(88, 86, 214, .3);
        }

        .setup-title {
            font-weight: 900;
            font-size: 1.6rem;
            color: var(--dark);
        }

        .setup-subtitle {
            color: #8e8e93;
            font-size: .9rem;
            margin-bottom: 2rem;
        }

        .form-floating > .form-control {
            border-radius: 1rem;
            border: 2px solid #e5e5ea;
            padding: 1.2rem 1rem .6rem;
            font-size: .95rem;
            transition: all .3s ease;
        }

        .form-floating > .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 .25rem rgba(88, 86, 214, .1);
        }

        .form-floating > label {
            color: #8e8e93;
        }

        .btn-setup {
            background: linear-gradient(135deg, var(--primary), #764ba2);
            border: none;
            color: #fff;
            padding: 1rem;
            font-weight: 800;
            font-size: 1.05rem;
            border-radius: 1rem;
            transition: all .3s ease;
            letter-spacing: .5px;
        }

        .btn-setup:hover {
            transform: translateY(-3px);
            box-shadow: 0 .8rem 2rem rgba(88, 86, 214, .3);
            color: #fff;
        }

        .btn-setup:active {
            transform: translateY(0);
        }

        .password-strength {
            height: 4px;
            border-radius: 2px;
            margin-top: .4rem;
            transition: all .3s ease;
            background: #e5e5ea;
        }

        .password-strength .bar {
            height: 100%;
            border-radius: 2px;
            transition: all .4s ease;
            width: 0%;
        }

        .info-badge {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            background: rgba(88, 86, 214, .08);
            color: var(--primary);
            padding: .4rem .8rem;
            border-radius: .5rem;
            font-size: .78rem;
            font-weight: 600;
        }

        .permissions-list {
            list-style: none;
            padding: 0;
            margin: 1.2rem 0;
        }

        .permissions-list li {
            padding: .35rem 0;
            font-size: .85rem;
            color: #48484a;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .permissions-list li i {
            color: var(--success);
            font-size: .7rem;
        }

        .divider {
            border: none;
            height: 1px;
            background: #e5e5ea;
            margin: 1.5rem 0;
        }

        .already-exists {
            text-align: center;
            padding: 3rem 2rem;
        }

        .already-exists .icon-wrap {
            width: 80px;
            height: 80px;
            background: rgba(52, 199, 89, .1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem;
        }

        .already-exists .icon-wrap i {
            font-size: 2rem;
            color: var(--success);
        }
    </style>
</head>

<body>
    <div class="setup-container">
        <% if (superadminExists) { %>
        <!-- Already Exists State -->
        <div class="setup-card">
            <div class="already-exists">
                <div class="icon-wrap">
                    <i class="fa-solid fa-shield-check"></i>
                </div>
                <h3 class="fw-800 mb-2">حساب المدير العام موجود</h3>
                <p class="text-muted mb-4">تم إنشاء حساب المدير العام مسبقاً. يمكنك تسجيل الدخول مباشرة.</p>
                <a href="/superadmin/login" class="btn btn-setup w-100 mb-3">
                    <i class="fa fa-sign-in-alt me-2"></i> تسجيل الدخول
                </a>
                <a href="/" class="text-muted small text-decoration-none">العودة للرئيسية</a>
            </div>
        </div>
        <% } else { %>
        <!-- Setup Form -->
        <div class="setup-card">
            <div class="text-center">
                <div class="logo-box">
                    <i class="fa-solid fa-crown"></i>
                </div>
                <h2 class="setup-title">إنشاء حساب المدير العام</h2>
                <p class="setup-subtitle">هذا الحساب سيحصل على كامل الصلاحيات في النظام</p>
            </div>

            <!-- Permissions Preview -->
            <div class="bg-light p-3 rounded-4 mb-4">
                <div class="info-badge mb-2">
                    <i class="fa fa-shield-halved"></i> صلاحيات كاملة
                </div>
                <ul class="permissions-list mb-0">
                    <li><i class="fa-solid fa-circle"></i> إنشاء وإدارة الأكاديميات</li>
                    <li><i class="fa-solid fa-circle"></i> إدارة جميع المستخدمين والأدوار</li>
                    <li><i class="fa-solid fa-circle"></i> الوصول لجميع التقارير المالية</li>
                    <li><i class="fa-solid fa-circle"></i> التحكم الكامل في إعدادات النظام</li>
                    <li><i class="fa-solid fa-circle"></i> إدارة الاشتراكات والدورات</li>
                </ul>
            </div>

            <hr class="divider">

            <form id="setupForm" onsubmit="handleSetup(event)">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="name" placeholder="الاسم الكامل" required minlength="3">
                    <label for="name"><i class="fa fa-user me-1"></i> الاسم الكامل</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
                    <label for="email"><i class="fa fa-envelope me-1"></i> البريد الإلكتروني</label>
                </div>

                <div class="form-floating mb-2">
                    <input type="password" class="form-control" id="password" placeholder="كلمة المرور" required minlength="8"
                        oninput="checkPasswordStrength(this.value)">
                    <label for="password"><i class="fa fa-lock me-1"></i> كلمة المرور</label>
                </div>
                <div class="password-strength mb-3">
                    <div class="bar" id="strengthBar"></div>
                </div>
                <small class="text-muted d-block mb-3" id="strengthText" style="font-size:.78rem">يجب أن تكون 8 أحرف على الأقل</small>

                <div class="form-floating mb-4">
                    <input type="password" class="form-control" id="confirmPassword" placeholder="تأكيد كلمة المرور" required>
                    <label for="confirmPassword"><i class="fa fa-lock me-1"></i> تأكيد كلمة المرور</label>
                </div>

                <div class="form-floating mb-4">
                    <input type="text" class="form-control" id="setupKey" placeholder="مفتاح الإعداد" required>
                    <label for="setupKey"><i class="fa fa-key me-1"></i> مفتاح الإعداد السري</label>
                    <small class="text-muted d-block mt-1" style="font-size:.75rem">المفتاح المحدد في ملف .env (SETUP_KEY)</small>
                </div>

                <button id="setupBtn" type="submit" class="btn btn-setup w-100 mb-3 shadow">
                    <i class="fa-solid fa-rocket me-2"></i> إنشاء الحساب
                </button>

                <div class="text-center">
                    <a href="/" class="text-muted small text-decoration-none">العودة للرئيسية</a>
                </div>
            </form>
        </div>
        <% } %>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="position-fixed bottom-0 end-0 p-4" style="z-index: 1050"></div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            let bgClass = 'bg-primary';
            if (type === 'success') bgClass = 'bg-success';
            if (type === 'error') bgClass = 'bg-danger';

            const toastElem = document.createElement('div');
            toastElem.className = `toast align-items-center text-white ${bgClass} border-0 mb-3 show`;
            toastElem.innerHTML = `
                <div class="d-flex p-2">
                    <div class="toast-body fw-bold">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>`;
            container.appendChild(toastElem);
            setTimeout(() => toastElem.remove(), 4000);
        }

        function checkPasswordStrength(password) {
            const bar = document.getElementById('strengthBar');
            const text = document.getElementById('strengthText');
            let strength = 0;

            if (password.length >= 8) strength++;
            if (password.length >= 12) strength++;
            if (/[A-Z]/.test(password)) strength++;
            if (/[0-9]/.test(password)) strength++;
            if (/[^A-Za-z0-9]/.test(password)) strength++;

            const levels = [
                { width: '0%', color: '#e5e5ea', label: 'يجب أن تكون 8 أحرف على الأقل' },
                { width: '20%', color: '#ff3b30', label: '🔴 ضعيفة جداً' },
                { width: '40%', color: '#ff9500', label: '🟠 ضعيفة' },
                { width: '60%', color: '#ffcc00', label: '🟡 متوسطة' },
                { width: '80%', color: '#34c759', label: '🟢 قوية' },
                { width: '100%', color: '#30d158', label: '✅ قوية جداً' },
            ];

            const level = levels[strength];
            bar.style.width = level.width;
            bar.style.background = level.color;
            text.textContent = level.label;
        }

        async function handleSetup(event) {
            event.preventDefault();
            const btn = document.getElementById('setupBtn');
            
            const password = document.getElementById('password').value;
            const confirmPassword = document.getElementById('confirmPassword').value;

            if (password !== confirmPassword) {
                showToast('كلمتا المرور غير متطابقتين', 'error');
                return;
            }

            if (password.length < 8) {
                showToast('كلمة المرور يجب أن تكون 8 أحرف على الأقل', 'error');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> جاري الإنشاء...';

            const data = {
                name: document.getElementById('name').value.trim(),
                email: document.getElementById('email').value.trim(),
                password: password,
                setupKey: document.getElementById('setupKey').value.trim()
            };

            try {
                const response = await fetch('/superadmin/setup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.message || 'حدث خطأ غير متوقع');
                }

                showToast('🎉 تم إنشاء حساب المدير العام بنجاح!', 'success');
                setTimeout(() => window.location.href = '/superadmin/login', 1500);
            } catch (error) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-rocket me-2"></i> إنشاء الحساب';
                showToast(error.message, 'error');
            }
        }
    </script>
</body>

</html>
