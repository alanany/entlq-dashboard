<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8">
    <title><%= t('brand_name') %> - إدارة الاشتراكات</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Favicon -->
    <link href="/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700&family=Lobster+Two:wght@700&display=swap" rel="stylesheet">
    
    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="/lib/animate/animate.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/css/style.css" rel="stylesheet">

    <style>
        :root {
            --primary: #FE5D37;
            --secondary: #FFF0ED;
            --light: #F8F9FA;
            --dark: #000B1C;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f7f9fc;
            font-size: 0.9rem;
        }

        .lobster-font { font-family: 'Lobster Two', cursive; }
        .outfit-font { font-family: 'Outfit', sans-serif; }

        .main-content {
            margin-right: 260px;
            padding: 1.5rem;
            min-height: 100vh;
            transition: all 0.3s;
        }

        @media (max-width: 991.98px) {
            .main-content { margin-right: 0; }
        }

        .top-nav {
            background: #fff;
            padding: 1rem 2rem;
            border-radius: 1.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.05);
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .stats-card-sub {
            background: #fff;
            border-radius: 1.25rem;
            box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.03);
            padding: 1.25rem;
            height: 100%;
            transition: all 0.3s;
            border: 1px solid rgba(0,0,0,0.05);
            display: flex;
            align-items: center;
            gap: 1rem;
            cursor: pointer;
        }

        .stats-card-sub:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,0.08);
        }

        .stats-icon-sub {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
        }

        .table-custom thead th {
            background-color: #f8f9fa;
            border-bottom: none;
            color: #6c757d;
            font-weight: 700;
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table-custom tbody td {
            padding: 0.75rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid #f1f1f1;
            font-size: 0.8rem;
        }

        .critical-pulse { animation: pulse-bg 2s infinite; }
        @keyframes pulse-bg {
            0% { background-color: rgba(254, 226, 226, 0.4); }
            50% { background-color: rgba(254, 202, 202, 0.7); }
            100% { background-color: rgba(254, 226, 226, 0.4); }
        }
    </style>
</head>
<body class="bg-light">
    <%- include('./_admin_sidebar.ejs', { currentPage: 'subscriptions', user: user }) %>

    <div class="main-content">
        <!-- Top Nav -->
        <div class="top-nav px-4 py-3 mb-4 rounded-4 shadow-sm bg-white border border-light animate__animated animate__fadeInDown">
            <div class="container-fluid d-flex align-items-center justify-content-between p-0">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-primary border-0 rounded-3 d-lg-none me-4" id="sidebarCollapse">
                        <i class="fas fa-bars fs-5"></i>
                    </button>
                    <div>
                        <h4 class="mb-0 text-primary fw-500 lobster-font" style="font-size: 1.0rem;">إدارة طلبات الاشتراك</h4>
                        <small class="text-muted outfit-font fw-600" style="font-size: 0.7rem;" id="currentDateDisplay"></small>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2 ps-3 border-start border-light">
                        <button onclick="openLogoutModal(event)" class="btn btn-light rounded-circle p-2 text-danger" title="تسجيل الخروج">
                            <i class="fas fa-search text-muted ms-2 ps-2 border-start"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>


        <!-- Stats Section -->
        <div class="row g-4 mb-4 animate__animated animate__fadeInUp">
            <div class="col-md-3">
  <div onclick="filterByCard('all')" class="stats-card-sub">
  <div class="stats-icon-sub bg-primary">
    <i class="fas fa-file-alt text-white"></i>
  </div>
  <div>

                        <small class="text-muted d-block" style="font-size: 0.7rem;">إجمالي الطلبات</small>
                        <h4 class="mb-0 fw-bold"><%= stats.totalRequests %></h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div onclick="filterByCard('pending')" class="stats-card-sub border-start border-warning border-4">
                    <div class="stats-icon-sub bg-warning bg-opacity-10 text-warning">
                        <i class="fas fa-clock text-white"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block" style="font-size: 0.7rem;">قيد المراجعة</small>
                        <h4 class="mb-0 fw-bold text-warning"><%= stats.pendingRequests %></h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div onclick="filterByCard('critical')" class="stats-card-sub border-start border-danger border-4 shadow-sm">
                    <div class="stats-icon-sub bg-danger bg-opacity-10 text-danger">
                        <i class="fas fa-exclamation-circle text-white"></i>
                    </div>
                    <div>
                        <small class="text-danger fw-bold d-block" style="font-size: 0.7rem;">تطلب تجديد</small>
                        <h4 class="mb-0 fw-bold text-danger"><%= stats.criticalSubscriptions %></h4>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div onclick="filterByCard('confirmed')" class="stats-card-sub border-start border-success border-4">
                    <div class="stats-icon-sub bg-success bg-opacity-10 text-success">
                        <i class="fas fa-check-circle text-white"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block" style="font-size: 0.7rem;">الفعالة</small>
                        <h4 class="mb-0 fw-bold text-success"><%= stats.acceptedRequests %></h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter & Table Section -->
        <div class="bg-white rounded-4 shadow-sm border border-light overflow-hidden animate__animated animate__fadeInUp">
            <div class="p-4 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div class="input-group search-input-group w-100" style="max-width: 400px;">
                    <span class="input-group-text bg-transparent border-0"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" id="searchInput" placeholder="بحث باسم الطالب أو الدورة..." class="form-control border-0 bg-transparent" style="font-size: 0.85rem;">
                </div>
                <select id="statusFilter" class="form-select border-0 bg-light rounded-pill px-4" style="max-width: 200px; font-size: 0.8rem;">
                    <option value="all">كل الحالات</option>
                    <option value="critical">⚠️ تطلب تجديد</option>
                    <option value="pending">قيد المراجعة</option>
                    <option value="confirmed">تم الموافقة</option>
                    <option value="rejected">مرفوض</option>
                </select>
            </div>

            <div class="table-responsive">
                <table class="table table-custom mb-0 text-end">
                    <thead>
                        <tr>
                            <th class="px-4 py-3">الطالب والمعلم</th>
                            <th class="px-4 py-3">الدورة</th>
                            <th class="px-4 py-3">البدء / المتبقي</th>
                            <th class="px-4 py-3 text-center">الحالة</th>
                        </tr>
                    </thead>
                    <tbody id="bookingsTableBody" class="bg-white">
                        <!-- Rows will be injected by JS -->
                    </tbody>
                </table>
            </div>
        </div>
        
        <footer class="mt-5 py-4 text-center text-muted border-top">
            <small>&copy; منصة <%= t('brand_name') %> التعليمية 2024 - جميع الحقوق محفوظة</small>
        </footer>
    </div>
</div>

<!-- Renew Modal (Bootstrap Style) -->
<div class="modal fade" id="renewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 1.5rem;">
            <div class="modal-body p-4 text-center">
                <div class="bg-primary bg-opacity-10 text-primary mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; border-radius: 30px; font-size: 1.5rem;">
                    <i class="fas fa-sync-alt"></i>
                </div>
                <h5 class="fw-bold mb-3">تأكيد تجديد الاشتراك</h5>
                <div class="p-3 bg-light rounded-3 mb-4 text-end">
                    <p class="small text-muted mb-2">سيتم إنشاء طلب جديد للبيانات التالية:</p>
                    <div class="fw-bold text-primary small">
                        <p class="mb-1">الطالب: <span id="mdlName" class="text-dark"></span></p>
                        <p class="mb-0">الدورة: <span id="mdlCourse" class="text-dark"></span></p>
                    </div>
                </div>
                <p class="text-danger small mb-4 fw-bold">⚠️ سيتم نسخ أيام ومواعيد الحصص القديمة تلقائياً.</p>
            <div class="d-flex flex-column gap-2">
                    <button onclick="confirmRenewal()" id="mdlConfirmBtn" class="btn btn-primary rounded-3 py-2 fw-bold"> <i class="fas fa-check-circle me-1"></i> تجديد بنفس الإعدادات الحالية</button>
                    <a href="#" id="mdlChangeBtn" class="btn btn-outline-secondary rounded-3 py-2 fw-bold"> <i class="fas fa-cog me-1"></i> تغيير الإعدادات وتجديد</a>
                    <button class="btn btn-light rounded-3 py-2 text-muted" data-bs-dismiss="modal">إلغاء الأمر</button>
            </div>
            </div>
        </div>
    </div>
</div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    const allBookings = <%- JSON.stringify(bookings) %>;
    console.log('Bookings loaded:', allBookings);
    let currentRenewId = null;

    const renewModal = new bootstrap.Modal(document.getElementById('renewModal'));
    document.getElementById('currentDateDisplay').textContent = new Date().toLocaleDateString('ar-EG', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

    function buildRow(b) {
        const isCritical = b.isCritical;
        const daysLeft = b.daysRemaining;

        const statusMap = {
            pending:   { t: 'قيد المراجعة', badge: 'bg-warning'  },
            confirmed: { t: 'فعال',          badge: 'bg-success'  },
            rejected:  { t: 'مرفوض',         badge: 'bg-secondary'},
            cancelled: { t: 'ملغي',           badge: 'bg-danger'  },
            completed: { t: 'مكتمل',          badge: 'bg-info'    }
        };
        const st = statusMap[b.status] || { t: b.status, badge: 'bg-secondary' };

        return `
            <tr class="booking-row ${isCritical ? 'critical-pulse' : ''}"
                onclick="goToDetails('${b._id}', event)"
                style="cursor:pointer; transition: background 0.2s;"
                onmouseover="this.style.background='#fafbff'"
                onmouseout="this.style.background=''">
                <td class="px-3 py-3">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 fw-800"
                             style="width:36px;height:36px;background:#fff0ed;color:#FE5D37;font-size:0.85rem;">
                            ${(b.studentId?.name || '؟')[0]}
                        </div>
                        <div>
                            <div class="fw-bold text-dark" style="font-size:0.85rem;">${b.studentId?.name || '---'}</div>
                            <div class="text-primary" style="font-size:0.7rem;">المعلم: ${b.teacherId?.name || 'غير محدد'}</div>
                        </div>
                    </div>
                </td>
                <td class="px-3 py-3">
                    <div class="fw-bold text-dark" style="font-size:0.85rem;">${b.courseId?.title || '---'}</div>
                    <div class="text-muted" style="font-size:0.7rem;">${b.selectedPriceOption || ''} دقيقة &bull; ${b.numberOfSessionsPerMonth || ''} حصة</div>
                </td>
                <td class="px-3 py-3 text-center">
                    <div class="small fw-bold text-dark">${b.startDate ? new Date(b.startDate).toLocaleDateString('ar-EG') : 'لم يبدأ'}</div>
                    ${getBadge(daysLeft)}
                </td>
                <td class="px-3 py-3 text-center">
                    <span class="badge ${st.badge} rounded-pill px-3 py-2" style="font-size:0.72rem;">${st.t}</span>
                    ${(isCritical || (daysLeft !== null && daysLeft <= 0)) ? `
                        <div class="mt-1">
                            <span class="badge bg-danger bg-opacity-10 text-danger" style="font-size:0.65rem;"><i class="fas fa-exclamation-circle me-1"></i>يحتاج تجديد</span>
                        </div>` : ''}
                </td>
            </tr>
        `;
    }

    function goToDetails(id, event) {
        // Allow links inside row to work normally
        if (event.target.closest('a, button')) return;
        window.location.href = `/booking/${id}/details`;
    }

    function getBadge(days) {
        if (days === null) return '';
        if (days > 7) return `<span class="text-gray-400 text-[10px] block mt-1">متبقي ${days} يوم</span>`;
        if (days >= 0) return `<span class="text-red-600 font-bold text-[10px] block mt-1 animate-pulse italic">⚠️ ينتهي خلال ${days} يوم</span>`;
        return `<span class="text-gray-300 font-bold text-[10px] block mt-1">منتهي</span>`;
    }

    function renderTable() {
        const query = document.getElementById('searchInput').value.toLowerCase();
        const filter = document.getElementById('statusFilter').value;
        const filtered = allBookings.filter(b => {
            const match = (b.studentId?.name || "").toLowerCase().includes(query) || (b.courseId?.title || "").toLowerCase().includes(query);
            if (filter === 'critical') return match && b.isCritical;
            if (filter !== 'all') return match && b.status === filter;
            return match;
        });
        document.getElementById('bookingsTableBody').innerHTML = filtered.length ? filtered.map(buildRow).join('') : '<tr><td colspan="4" class="py-5 text-center text-muted"><i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i> لا توجد نتائج مطابقة</td></tr>';
    }

    function filterByCard(s) { document.getElementById('statusFilter').value = s; renderTable(); }

    function openRenewModal(id) {
            // Fetch booking details
            const b = allBookings.find(x => x._id === id);
            if(b) {
                document.getElementById('mdlName').textContent = b.studentId?.name;
                document.getElementById('mdlCourse').textContent = b.courseId?.title;
                
                // Set data for renewal
                window.renewParams = {
                    studentId: b.studentId._id,
                    courseId: b.courseId._id,
                    selectedPriceOption: b.selectedPriceOption || "",
                    numberOfSessionsPerMonth: b.numberOfSessionsPerMonth || 0,
                    totalAmount: b.totalAmount || 0,
                    renewFromId: b._id // 🔴 إضافة ID الاشتراك للنسخ
                };
                
                // Set change settings link
                const changeLink = `/student/book_plan/${b.courseId._id}/${b.studentId._id}`;
                document.getElementById('mdlChangeBtn').setAttribute('href', changeLink);
                
                renewModal.show();
            }
        }
    
        function closeRenewModal() { renewModal.hide(); }
    
        async function confirmRenewal() {
            const btn = document.getElementById('mdlConfirmBtn');
            btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm ms-2"></span> جاري...';
            try {
                const res = await fetch('/student/checkout', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(window.renewParams)
                });
                const data = await res.json();
                
                if(res.ok && (data.success || data.data)) { 
                    alert('تم إنشاء طلب تجديد جديد بنجاح'); 
                    window.location.reload(); 
                }
                else {
                    alert('فشل التجديد: ' + (data.message || 'Error'));
                }
            } catch (e) { 
                console.error(e);
                alert('حدث خطأ في الاتصال'); 
            }
            finally { 
                btn.disabled = false; btn.textContent = 'تجديد بنفس الإعدادات'; 
                closeRenewModal(); 
            }
        }

    document.getElementById('searchInput').addEventListener('input', renderTable);
    document.getElementById('statusFilter').addEventListener('change', renderTable);
    
    // Initial render
    renderTable();

    // Ensure it renders when coming back from cache (bfcache)
    window.addEventListener('pageshow', function(event) {
        renderTable();
    });
</script>
</body>
</html>